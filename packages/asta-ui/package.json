{
  "name": "asta-ui",
  "version": "0.6.0",
  "description": "Astabyte UI: motion-first React + Tailwind v4 components (Radix or Base UI). Install as a package, or copy the source with the CLI.",
  "keywords": [
    "astabyte",
    "base-ui",
    "cli",
    "component-library",
    "components",
    "design-system",
    "motion",
    "radix",
    "react",
    "shadcn",
    "tailwindcss",
    "ui"
  ],
  "homepage": "https://ui.astabyte.com",
  "bugs": "https://github.com/astabyteidn/asta-ui/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astabyteidn/asta-ui.git",
    "directory": "packages/asta-ui"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/styles.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./base": {
      "types": "./dist/base.d.ts",
      "import": "./dist/base.js"
    },
    "./styles.css": {
      "style": "./dist/styles.css",
      "default": "./dist/styles.css"
    },
    "./base/*": {
      "types": "./dist/base/*.d.ts",
      "import": "./dist/base/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "asta-ui": "bin/asta-ui.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "cd ../.. && bun packages/asta-ui/build.ts",
    "prepublishOnly": "node -e \"require('node:fs').existsSync('dist/index.js')||(console.error('Run the build first: bun packages/asta-ui/build.ts (from the repo root)'),process.exit(1))\""
  },
  "engines": {
    "node": ">=18.17"
  },
  "peerDependencies": {
    "react": ">=18.3",
    "react-dom": ">=18.3",
    "radix-ui": ">=1.4",
    "@base-ui/react": ">=1.0"
  },
  "peerDependenciesMeta": {
    "radix-ui": {
      "optional": true
    },
    "@base-ui/react": {
      "optional": true
    }
  }
}
