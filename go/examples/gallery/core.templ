package main

import (
	"fmt"

	ui "github.com/astabyteidn/asta-ui/go/ui"
)

templ coreGallery() {
	@demo("button", "Button") {
		@ui.Button(ui.ButtonProps{}) {
			Solid
		}
		@ui.Button(ui.ButtonProps{Variant: "accent", Attrs: templ.Attributes{"hx-post": "/demo/toast", "hx-swap": "none"}}) {
			Toast
		}
		@ui.Button(ui.ButtonProps{Variant: "outline"}) {
			Outline
		}
		@ui.Button(ui.ButtonProps{Variant: "soft"}) {
			Soft
		}
		@ui.Button(ui.ButtonProps{Variant: "ghost"}) {
			Ghost
		}
		@ui.Button(ui.ButtonProps{Variant: "danger"}) {
			Danger
		}
		@ui.Button(ui.ButtonProps{Loading: true}) {
			Loading
		}
	}
	@demo("field", "Field + Input") {
		<div class="w-full max-w-[360px]">
			@ui.Field(ui.FieldProps{Label: "Email", For: "g-email", Hint: "We never share it."}) {
				@ui.Input(ui.InputProps{ID: "g-email", Name: "email", Type: "email", Placeholder: "you@astabyte.com"})
			}
		</div>
	}
	@demo("badge", "Badge") {
		@ui.Badge(ui.BadgeProps{}) {
			Neutral
		}
		@ui.Badge(ui.BadgeProps{Tone: "accent"}) {
			Accent
		}
		@ui.Badge(ui.BadgeProps{Tone: "success", Dot: true}) {
			Live
		}
		@ui.Badge(ui.BadgeProps{Tone: "danger", Variant: "solid"}) {
			Failed
		}
	}
	@demo("dialog", "Dialog") {
		@ui.Button(ui.ButtonProps{Variant: "outline", Attrs: ui.Opens("g-dialog")}) {
			Open dialog
		}
		@ui.Dialog(ui.DialogProps{ID: "g-dialog", Title: "Delete project?", Description: "This can't be undone."}) {
			@ui.DialogFooter() {
				@ui.Button(ui.ButtonProps{Variant: "ghost", Attrs: ui.Closes()}) {
					Cancel
				}
				@ui.Button(ui.ButtonProps{Variant: "danger", Attrs: ui.Closes()}) {
					Delete
				}
			}
		}
	}
	@demo("tabs", "Tabs") {
		<div class="w-full">
			@ui.Tabs(ui.TabsProps{ID: "g-tabs", Tabs: []ui.Tab{
				{Value: "a", Label: "Overview", Content: text("Overview panel")},
				{Value: "b", Label: "Activity", Count: "3", Content: text("Activity panel")},
				{Value: "c", Label: "Settings", Content: text("Settings panel")},
			}})
		</div>
	}
	@demo("menu", "Menu") {
		@ui.Menu(ui.MenuProps{Label: "Actions", Variant: "outline"}) {
			@ui.MenuItem(ui.MenuItemProps{Shortcut: "⌘E"}) {
				Edit
			}
			@ui.MenuItem(ui.MenuItemProps{}) {
				Duplicate
			}
			@ui.MenuSeparator()
			@ui.MenuItem(ui.MenuItemProps{Danger: true}) {
				Delete
			}
		}
	}
	@demo("textarea", "Textarea") {
		<div class="w-full max-w-[420px]">
			@ui.Field(ui.FieldProps{Label: "Bio", For: "g-bio"}) {
				@ui.Textarea(ui.TextareaProps{ID: "g-bio", Name: "bio", Placeholder: "Tell the Astabyte team about you", AutoGrow: true})
			}
		</div>
	}
	@demo("checkbox", "Checkbox") {
		<div class="flex flex-col gap-3">
			@ui.Checkbox(ui.CheckboxProps{ID: "g-terms", Name: "terms", Label: "I agree to the Astabyte terms", Required: true})
			@ui.Checkbox(ui.CheckboxProps{ID: "g-news", Name: "news", Label: "Send me product news", Checked: true})
		</div>
	}
	@demo("radio-group", "Radio group") {
		<div class="w-full max-w-[480px]">
			@ui.RadioGroup(ui.RadioGroupProps{Name: "plan", Value: "pro", Label: "Plan", Options: []ui.RadioOption{
				{Value: "free", Label: "Free", Aside: "$0"},
				{Value: "pro", Label: "Pro", Aside: "$12"},
				{Value: "team", Label: "Team", Aside: "$29"},
			}})
		</div>
	}
	@demo("select", "Select") {
		<div class="w-full max-w-[280px]">
			@ui.Field(ui.FieldProps{Label: "Plan", For: "g-plan"}) {
				@ui.Select(ui.SelectProps{ID: "g-plan", Name: "plan", Placeholder: "Pick a plan", Options: []ui.SelectOption{
					{Value: "free", Label: "Free"}, {Value: "pro", Label: "Pro"}, {Value: "team", Label: "Team"},
				}})
			}
		</div>
	}
	@demo("switch", "Switch") {
		<div class="w-full max-w-[420px]">
			@ui.Switch(ui.SwitchProps{ID: "g-digest", Name: "digest", Label: "Weekly digest", Description: "A short Astabyte summary every Monday.", Checked: true})
		</div>
	}
	@demo("slider", "Slider") {
		<div class="w-full max-w-[360px]">
			@ui.Slider(ui.SliderProps{ID: "g-volume", Name: "volume", Value: 40, Label: "Volume"})
		</div>
	}
	@demo("avatar", "Avatar") {
		@ui.Avatar(ui.AvatarProps{Name: "Ayu Lestari", Status: "online"})
		@ui.Avatar(ui.AvatarProps{Name: "Budi Santoso", Status: "away"})
		@ui.Avatar(ui.AvatarProps{Name: "Citra Dewi"})
	}
	@demo("avatar-group", "Avatar group") {
		@ui.AvatarGroup(ui.AvatarGroupProps{Max: 3, People: []ui.AvatarPerson{
			{Name: "Ayu Lestari"}, {Name: "Budi Santoso"}, {Name: "Citra Dewi"}, {Name: "Dimas Putra"}, {Name: "Eka Sari"},
		}})
	}
	@demo("kbd", "Kbd") {
		@ui.KbdCombo(ui.KbdComboProps{Keys: []string{"⌘", "K"}})
		@ui.Kbd(ui.KbdProps{}) {
			Esc
		}
	}
	@demo("spinner", "Spinner") {
		@ui.Spinner(ui.SpinnerProps{Class: "h-5 w-5"})
		@ui.Spinner(ui.SpinnerProps{Variant: "dots", Class: "h-5 w-5 text-brand"})
	}
	@demo("tooltip", "Tooltip") {
		@ui.Tooltip(ui.TooltipProps{ID: "g-tip", Text: "Save draft", Shortcut: "⌘S"}) {
			@ui.Button(ui.ButtonProps{Variant: "outline", Attrs: templ.Attributes{"aria-describedby": "g-tip"}}) {
				Save
			}
		}
	}
	@demo("skeleton", "Skeleton") {
		<div class="flex w-full max-w-[360px] items-start gap-3">
			@ui.Skeleton(ui.SkeletonProps{Shape: "circle", Width: "36px"})
			<div class="flex-1">
				@ui.SkeletonText(3, "")
			</div>
		</div>
	}
	@demo("progress", "Progress") {
		<div class="flex w-full max-w-[420px] items-center gap-6">
			<div class="flex-1">
				@ui.ProgressBar(ui.ProgressBarProps{Label: "Uploading", Value: 42, ShowValue: true})
			</div>
			@ui.ProgressRing(ui.ProgressRingProps{Label: "Storage used", Value: 68, ShowValue: true})
		</div>
	}
	@demo("alert", "Alert") {
		<div class="w-full max-w-[480px]">
			@ui.Alert(ui.AlertProps{Tone: "success", Title: "Invite sent", Dismissible: true}) {
				We emailed the Astabyte team.
			}
		</div>
	}
	@demo("toast", "Toast") {
		@ui.Button(ui.ButtonProps{Variant: "outline", Attrs: templ.Attributes{"hx-post": "/demo/toast", "hx-swap": "none"}}) {
			Show a toast
		}
	}
	@demo("breadcrumb", "Breadcrumb") {
		@ui.Breadcrumb(ui.BreadcrumbProps{Max: 4, Items: []ui.Crumb{
			{Label: "Astabyte", Href: "/"}, {Label: "Projects", Href: "/projects"}, {Label: "Website", Href: "/projects/website"}, {Label: "Settings"},
		}})
	}
	@demo("pagination", "Pagination") {
		<div class="max-w-full overflow-x-auto">
			@ui.Pagination(ui.PaginationProps{Page: 4, Total: 12, Href: pageHref})
		</div>
	}
	@demo("accordion", "Accordion") {
		<div class="w-full max-w-[480px]">
			@ui.Accordion(ui.AccordionProps{Name: "faq", Items: []ui.AccordionItem{
				{Title: "What does Astabyte build?", Content: templ.Raw("Sites, apps and design systems."), Open: true},
				{Title: "How long does a project take?", Content: templ.Raw("Most take six to ten weeks.")},
			}})
		</div>
	}
	@demo("stat-card", "Stat card") {
		<div class="w-full max-w-[320px]">
			@ui.StatCard(ui.StatCardProps{Label: "Revenue", Value: "$12,480", Delta: 8.2, ShowDelta: true, DeltaLabel: "vs last week", Data: []float64{4, 6, 5, 8, 9}})
		</div>
	}
	@demo("empty-state", "Empty state") {
		<div class="w-full max-w-[480px]">
			@ui.EmptyState(ui.EmptyStateProps{Variant: "no-results", Query: "invoices", Secondary: &ui.EmptyStateAction{Label: "Clear search", Href: "/"}})
		</div>
	}
}

templ text(s string) {
	<p class="py-3 text-[14px] text-ink-2">{ s }</p>
}

// pageHref is the link of a page in the pagination demo.
func pageHref(n int) string { return fmt.Sprintf("?page=%d#pagination", n) }
