package main

import "github.com/astabyteidn/asta-ui/go/ui"

// formsIcon draws a 16px stroke icon for the toggle and segmented demos.
templ formsIcon(d string) {
	<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d={ d }></path>
	</svg>
}

// formsOut is where the echo endpoint shows what the form posted.
templ formsOut(id string) {
	<output id={ id } data-forms-out class="block min-h-5 max-w-full break-all font-mono text-[12px] text-mute">Change something to see what it posts.</output>
}

// formsCard wraps a demo form that posts on every change and shows the result below.
templ formsCard(id string) {
	<form
		hx-post="/demo/forms/echo"
		hx-trigger="change, submit"
		hx-target={ "#" + id + "-out" }
		hx-encoding="multipart/form-data"
		class="flex w-full min-w-0 max-w-full flex-col items-start gap-4"
	>
		{ children... }
		@formsOut(id + "-out")
	</form>
}

// formsGallery shows the forms components. Each demo is wrapped in @demo("<id>", "<Title>").
templ formsGallery() {
	@demo("combobox", "Combobox") {
		@formsCard("combo") {
			<div class="flex flex-wrap gap-6">
				<div class="w-64 max-w-full">
					@ui.Combobox(ui.ComboboxProps{ID: "combo-one", Name: "framework", Label: "Framework", Value: "htmx", Options: []ui.ComboboxOption{
						{Value: "htmx", Label: "htmx", Hint: "Hypermedia"},
						{Value: "templ", Label: "templ", Hint: "Go"},
						{Value: "alpine", Label: "Alpine.js"},
						{Value: "react", Label: "React", Disabled: true},
						{Value: "svelte", Label: "Svelte"},
						{Value: "solid", Label: "Solid"},
					}})
				</div>
				<div class="w-72 max-w-full">
					@ui.Combobox(ui.ComboboxProps{ID: "combo-many", Name: "team", Label: "Team", Multiple: true, Values: []string{"design"}, Placeholder: "Add teams…", Options: []ui.ComboboxOption{
						{Value: "design", Label: "Design"},
						{Value: "eng", Label: "Engineering"},
						{Value: "ops", Label: "Operations"},
						{Value: "sales", Label: "Sales"},
						{Value: "support", Label: "Support"},
					}})
				</div>
			</div>
		}
	}
	@demo("date-picker", "Date picker") {
		@formsCard("date") {
			<div class="flex flex-wrap gap-6">
				<div class="w-60 max-w-full">
					@ui.DatePicker(ui.DatePickerProps{ID: "date-one", Name: "due", Label: "Due date", Value: "2026-11-24", Min: "2026-11-01"})
				</div>
				<div class="w-72 max-w-full">
					@ui.DatePicker(ui.DatePickerProps{ID: "date-range", Name: "stay", Label: "Stay", Range: true, WeekStartsOn: 1, Placeholder: "Pick dates"})
				</div>
			</div>
		}
	}
	@demo("color-picker", "Color picker") {
		@formsCard("color") {
			@ui.ColorPicker(ui.ColorPickerProps{ID: "color-brand", Name: "accent", Label: "Accent", Value: "#2563eb"})
		}
	}
	@demo("number-input", "Number input") {
		@formsCard("number") {
			<div class="flex flex-wrap gap-6">
				@ui.NumberInput(ui.NumberInputProps{ID: "seats", Name: "seats", Label: "Seats", Value: 9, Min: 1, Max: 120})
				@ui.NumberInput(ui.NumberInputProps{ID: "nights", Name: "nights", Label: "Nights", Value: 2, Min: 1, Max: 14, Suffix: "nights", Size: "sm"})
			</div>
		}
	}
	@demo("otp-input", "OTP input") {
		<div class="flex w-full flex-col gap-4">
			@ui.OtpInput(ui.OtpInputProps{ID: "otp", Name: "code", GroupSize: 3, Attrs: templ.Attributes{
				"hx-post": "/demo/forms/otp", "hx-trigger": "asta:complete", "hx-target": "#otp-out",
			}})
			@formsOut("otp-out")
			<p class="text-[13px] text-mute">The demo code is 246810.</p>
		</div>
	}
	@demo("password-input", "Password input") {
		@formsCard("pw") {
			<div class="w-80 max-w-full">
				@ui.PasswordInput(ui.PasswordInputProps{ID: "pw", Name: "password", Label: "Password"})
			</div>
		}
	}
	@demo("tag-input", "Tag input") {
		@formsCard("tags") {
			@ui.TagInput(ui.TagInputProps{ID: "tags", Name: "tag", Value: []string{"design", "go"}, Max: 6, Class: "w-96 max-w-full"})
		}
	}
	@demo("range-slider", "Range slider") {
		@formsCard("range") {
			@ui.RangeSlider(ui.RangeSliderProps{Names: [2]string{"min_price", "max_price"}, Value: [2]float64{120, 640}, Max: 1000, Step: 10, MinGap: 50, Prefix: "$", Labels: [2]string{"Minimum price", "Maximum price"}, Class: "w-80 max-w-full"})
		}
	}
	@demo("rating", "Rating") {
		@formsCard("rating") {
			<div class="flex flex-wrap items-center gap-8">
				@ui.Rating(ui.RatingProps{Name: "stars", Value: 3, Label: "Rate Astabyte"})
				@ui.Rating(ui.RatingProps{Name: "half", Value: 3.5, AllowHalf: true, Size: "lg", Label: "Rate the docs"})
				@ui.Rating(ui.RatingProps{Value: 4.5, ReadOnly: true, Size: "sm", Label: "Average rating"})
			</div>
		}
	}
	@demo("file-upload", "File upload") {
		@formsCard("upload") {
			@ui.FileUpload(ui.FileUploadProps{ID: "files", Name: "files", Accept: "image/*,.pdf,.txt", MaxSize: 5 << 20, MaxFiles: 3, Class: "w-full max-w-md"})
			<div>
				@ui.Button(ui.ButtonProps{Type: "submit", Size: "sm"}) {
					Upload
				}
			</div>
		}
	}
	@demo("inline-edit", "Inline edit") {
		<div class="flex flex-col gap-3">
			@ui.InlineEdit(ui.InlineEditProps{Name: "project", Label: "Project name", Value: "Astabyte site", Size: "lg", Required: true, Attrs: templ.Attributes{
				"hx-post": "/demo/forms/save", "hx-trigger": "asta:save", "hx-swap": "none",
			}})
			@ui.InlineEdit(ui.InlineEditProps{Name: "note", Label: "Note", Placeholder: "Add a note", CancelOnBlur: true})
			<p class="text-[13px] text-mute">Saving “fail” shows the error state.</p>
		</div>
	}
	@demo("segmented-control", "Segmented control") {
		@formsCard("seg") {
			<div class="flex flex-wrap gap-4">
				@ui.SegmentedControl(ui.SegmentedControlProps{Name: "view", Label: "View", Value: "board", Segments: []ui.Segment{
					{Value: "list", Label: "List", Icon: formsIcon("M3 4h10M3 8h10M3 12h10")},
					{Value: "board", Label: "Board", Icon: formsIcon("M3 3h4v10H3zM9 3h4v6H9z")},
					{Value: "calendar", Label: "Calendar", Icon: formsIcon("M3 4h10v9H3zM3 7h10M6 2v3M10 2v3")},
				}})
				@ui.SegmentedControl(ui.SegmentedControlProps{Name: "plan", Label: "Billing", Size: "sm", Segments: []ui.Segment{{Value: "monthly", Label: "Monthly"}, {Value: "yearly", Label: "Yearly"}}})
			</div>
		}
	}
	@demo("toggle-group", "Toggle group") {
		@formsCard("toggle") {
			<div class="flex flex-wrap gap-4">
				@ui.ToggleGroup(ui.ToggleGroupProps{Name: "align", Label: "Text alignment", Value: "left", AllowEmpty: true, Options: []ui.ToggleOption{
					{Value: "left", AriaLabel: "Align left", Icon: formsIcon("M3 4h10M3 8h6M3 12h8")},
					{Value: "center", AriaLabel: "Align center", Icon: formsIcon("M3 4h10M5 8h6M4 12h8")},
					{Value: "right", AriaLabel: "Align right", Icon: formsIcon("M3 4h10M7 8h6M5 12h8")},
				}})
				@ui.ToggleGroup(ui.ToggleGroupProps{Name: "style", Label: "Text style", Multiple: true, Values: []string{"bold"}, Options: []ui.ToggleOption{
					{Value: "bold", Label: "Bold"},
					{Value: "italic", Label: "Italic"},
					{Value: "underline", Label: "Underline"},
				}})
			</div>
		}
	}
	@demo("copy-button", "Copy button") {
		<div class="flex flex-wrap items-center gap-4">
			<code id="copy-key" class="rounded-md bg-paper px-2.5 py-1.5 font-mono text-[13px] text-ink">ab_live_7f3c91</code>
			@ui.CopyButton(ui.CopyButtonProps{From: "#copy-key"})
			@ui.CopyButton(ui.CopyButtonProps{Value: "https://astabyte.com", Label: "Copy link", Variant: "outline"})
			@ui.CopyButton(ui.CopyButtonProps{Value: "npm i asta-ui", Label: "Copy", Variant: "soft", Size: "sm"})
		</div>
	}
}
