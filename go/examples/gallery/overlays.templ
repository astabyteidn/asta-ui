package main

import "github.com/astabyteidn/asta-ui/go/ui"

// ovI draws a 16px stroke icon for the overlays demos.
templ ovI(d string) {
	<svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d={ d }></path>
	</svg>
}

const (
	ovIcPlus     = "M8 3.5v9M3.5 8h9"
	ovIcFile     = "M4 2.5h5l3 3v8H4zM9 2.5v3h3"
	ovIcGear     = "M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM8 1.5v2M8 12.5v2M1.5 8h2M12.5 8h2M3.4 3.4l1.4 1.4M11.2 11.2l1.4 1.4M3.4 12.6l1.4-1.4M11.2 4.8l1.4-1.4"
	ovIcUser     = "M8 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5zM3 13.5c.8-2.3 2.7-3.5 5-3.5s4.2 1.2 5 3.5"
	ovIcInbox    = "M2.5 9.5h3l1 1.5h3l1-1.5h3M2.5 9.5 4 3.5h8l1.5 6v3h-11z"
	ovIcHome     = "M2.5 7 8 2.5 13.5 7v6.5h-11z"
	ovIcChart    = "M3 13V8M8 13V3M13 13V6"
	ovIcCopy     = "M5.5 5.5h7v7h-7zM3.5 10.5v-7h7"
	ovIcTrash    = "M3 4.5h10M6.5 4.5V3h3v1.5M4.5 4.5l.5 9h6l.5-9"
	ovIcShare    = "M8 2.5v8M5 5.5l3-3 3 3M3.5 9v4.5h9V9"
	ovIcMove     = "M3 2.5l9 4-4 1.5-1.5 4z"
	ovIcFrame    = "M5 2v12M11 2v12M2 5h12M2 11h12"
	ovIcRect     = "M3 3.5h10v9H3z"
	ovIcPen      = "M10.5 2.5l3 3-8 8h-3v-3z"
	ovIcText     = "M3.5 4V3h9v1M8 3v10M6 13h4"
	ovIcHand     = "M5.5 8V3.5a1 1 0 0 1 2 0V7m0-3.5a1 1 0 0 1 2 0V7m0-2.5a1 1 0 0 1 2 0V9c0 2.5-1.5 4.5-4 4.5S4 12 3.5 10.5L2.5 8a1 1 0 0 1 1.8-.8z"
	ovIcComment  = "M2.5 3.5h11v7.5H7l-3 2.5v-2.5H2.5z"
	ovIcSearch   = "M7 2.5a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9zM10.5 10.5 13.5 13.5"
	ovIcLogout   = "M6 2.5H3v11h3M10 5l3 3-3 3M13 8H6"
	ovIcCalendar = "M2.5 4h11v9.5h-11zM2.5 7h11M5.5 2.5v3M10.5 2.5v3"
)

templ ovBrand() {
	<span class="grid h-6 w-6 place-items-center rounded-md bg-brand text-[12px] font-semibold text-white">A</span>
	<span class="text-[15px] font-semibold tracking-[-0.02em]">Astabyte</span>
}

templ ovLegal() {
	<span>© 2026 Astabyte</span>
	<span class="flex gap-4">
		<a href="#footer" class="hover:text-paper">Privacy</a>
		<a href="#footer" class="hover:text-paper">Terms</a>
	</span>
}

templ ovStepBody(text string) {
	<div class="rounded-xl bg-paper p-5 text-[14px] text-ink-2">{ text }</div>
}

templ ovStepDone() {
	<div class="rounded-xl bg-paper p-5 text-[14px] text-ink">All set. Your workspace is ready.</div>
}

templ ovContextMenu() {
	@ui.MenuItem(ui.MenuItemProps{Icon: ovI(ovIcCopy), Shortcut: "⌘C"}) {
		Copy
	}
	@ui.MenuItem(ui.MenuItemProps{Icon: ovI(ovIcShare), Shortcut: "⌘⇧S"}) {
		Share
	}
	@ui.MenuSub(ui.MenuSubProps{Label: "Move to", Icon: ovI(ovIcFile)}) {
		@ui.MenuItem(ui.MenuItemProps{}) {
			Design
		}
		@ui.MenuItem(ui.MenuItemProps{}) {
			Engineering
		}
		@ui.MenuItem(ui.MenuItemProps{}) {
			Archive
		}
	}
	@ui.MenuSeparator()
	@ui.MenuCheckbox(ui.MenuCheckboxProps{Checked: true, KeepOpen: true}) {
		Show grid
	}
	@ui.MenuCheckbox(ui.MenuCheckboxProps{KeepOpen: true}) {
		Snap to pixels
	}
	@ui.MenuSeparator()
	@ui.MenuItem(ui.MenuItemProps{Icon: ovI(ovIcTrash), Danger: true, Shortcut: "⌫"}) {
		Delete
	}
}

// overlaysGallery shows the overlays components. Each demo is wrapped in @demo("<id>", "<Title>").
templ overlaysGallery() {
	@demo("drawer", "Drawer") {
		@ui.Button(ui.ButtonProps{Variant: "outline", Attrs: ui.Opens("drawer-right")}) {
			Open right
		}
		@ui.Button(ui.ButtonProps{Variant: "outline", Attrs: ui.Opens("drawer-left")}) {
			Open left
		}
		@ui.Button(ui.ButtonProps{Variant: "outline", Attrs: ui.Opens("drawer-bottom")}) {
			Bottom sheet
		}
		@ui.Drawer(ui.DrawerProps{ID: "drawer-right", Title: "Invite people", Description: "They get an email with a link to join Astabyte.", Footer: ovDrawerFooter()}) {
			<div class="flex flex-col gap-3 text-[14px] text-ink-2">
				<label class="flex flex-col gap-1.5">
					<span class="text-[13px] text-ink">Email</span>
					<input type="email" placeholder="sam@astabyte.com" class="h-10 rounded-lg bg-paper-2 px-3 text-ink outline-none focus:ring-2 focus:ring-brand/40"/>
				</label>
				<p>Invites expire after seven days.</p>
			</div>
		}
		@ui.Drawer(ui.DrawerProps{ID: "drawer-left", Side: "left", Title: "Filters"}) {
			<p class="text-[14px] text-ink-2">Pick what to show in the list.</p>
		}
		@ui.Drawer(ui.DrawerProps{ID: "drawer-bottom", Side: "bottom", Title: "Share file", Description: "Drag the handle down to close."}) {
			<p class="text-[14px] text-ink-2">Anyone with the link can view.</p>
		}
	}
	@demo("popover", "Popover") {
		@ui.Button(ui.ButtonProps{Variant: "outline", Attrs: ui.PopoverTarget("pop-one")}) {
			Set reminder
		}
		@ui.Popover(ui.PopoverProps{ID: "pop-one", Arrow: true, Label: "Reminder", Class: "w-64"}) {
			<p class="text-[13px] font-medium text-ink">Remind me</p>
			<input type="time" value="09:00" class="mt-2 h-9 w-full rounded-lg bg-paper-2 px-2 text-[13px] text-ink outline-none"/>
			@ui.Button(ui.ButtonProps{Variant: "accent", Size: "sm", Class: "mt-3 w-full", Attrs: templ.Attributes{"popovertarget": "pop-one", "popovertargetaction": "hide"}}) {
				Save
			}
		}
		@ui.Button(ui.ButtonProps{Variant: "outline", Attrs: ui.PopoverTarget("pop-two")}) {
			Right side
		}
		@ui.Popover(ui.PopoverProps{ID: "pop-two", Side: "right", Arrow: true, Label: "Info"}) {
			<p class="max-w-[200px] text-[13px] text-ink-2">Popovers flip when there is no room.</p>
		}
	}
	@demo("hover-card", "Hover card") {
		<p class="text-[14px] text-ink-2">
			Built by
			<a href="#hover-card" class="font-medium text-ink underline decoration-[color-mix(in_srgb,var(--ink)_30%,transparent)] underline-offset-4" { ui.HoverCardTarget("hc-one")... }>{ "@astabyte" }</a>
			in Jakarta.
		</p>
		@ui.HoverCard(ui.HoverCardProps{ID: "hc-one", Label: "Astabyte"}) {
			<div class="flex gap-3">
				@ui.Avatar(ui.AvatarProps{Name: "Astabyte"})
				<div class="min-w-0">
					<p class="text-[14px] font-medium text-ink">Astabyte</p>
					<p class="text-[12.5px] text-mute">{ "@astabyte" }</p>
					<p class="mt-2 text-[13px] text-ink-2">A small studio making web apps and the kit behind them.</p>
				</div>
			</div>
		}
	}
	@demo("context-menu", "Context menu") {
		@ui.ContextMenu(ui.ContextMenuProps{ID: "ctx-one", Menu: ovContextMenu(), Class: "grid h-40 w-full max-w-md place-items-center rounded-xl bg-paper px-4 text-center text-[13px] text-mute"}) {
			Right-click, long-press, or focus and press Shift+F10
		}
	}
	@demo("dropdown-menu", "Dropdown menu") {
		@ui.DropdownMenu(ui.DropdownMenuProps{ID: "dd-one", Label: "View", Variant: "outline"}) {
			@ui.MenuLabel("Layout")
			@ui.MenuRadio(ui.MenuRadioProps{Name: "layout", Value: "grid", Checked: true}) {
				Grid
			}
			@ui.MenuRadio(ui.MenuRadioProps{Name: "layout", Value: "list"}) {
				List
			}
			@ui.MenuSeparator()
			@ui.MenuCheckbox(ui.MenuCheckboxProps{Name: "show", Value: "hidden", KeepOpen: true}) {
				Show hidden files
			}
			@ui.MenuCheckbox(ui.MenuCheckboxProps{Name: "show", Value: "sizes", Checked: true, KeepOpen: true}) {
				Show sizes
			}
			@ui.MenuSeparator()
			@ui.MenuSub(ui.MenuSubProps{Label: "Sort by", Icon: ovI(ovIcChart)}) {
				@ui.MenuRadio(ui.MenuRadioProps{Name: "sort", Value: "name", Checked: true}) {
					Name
				}
				@ui.MenuRadio(ui.MenuRadioProps{Name: "sort", Value: "date"}) {
					Date
				}
				@ui.MenuRadio(ui.MenuRadioProps{Name: "sort", Value: "size"}) {
					Size
				}
			}
		}
		@ui.DropdownMenu(ui.DropdownMenuProps{ID: "dd-two", Icon: ovI(ovIcGear), IconOnly: true, AriaLabel: "Settings", Variant: "ghost", Align: "end"}) {
			@ui.MenuItem(ui.MenuItemProps{Icon: ovI(ovIcUser)}) {
				Profile
			}
			@ui.MenuItem(ui.MenuItemProps{Icon: ovI(ovIcLogout), Danger: true}) {
				Sign out
			}
		}
	}
	@demo("command-palette", "Command palette") {
		@ui.Button(ui.ButtonProps{Variant: "outline", Kbd: "⌘K", Attrs: ui.Opens("cmd-one")}) {
			Search
		}
		@ui.Button(ui.ButtonProps{Variant: "outline", Attrs: ui.Opens("cmd-two")}) {
			Server search
		}
		@ui.CommandPalette(ui.CommandPaletteProps{ID: "cmd-one"}) {
			@ui.CommandGroup(ui.CommandGroupProps{Heading: "Pages"}) {
				@ui.CommandItem(ui.CommandItemProps{Label: "Home", Icon: ovI(ovIcHome), Href: "#command-palette"})
				@ui.CommandItem(ui.CommandItemProps{Label: "Inbox", Icon: ovI(ovIcInbox), Keywords: "mail messages", Shortcut: "G I"})
				@ui.CommandItem(ui.CommandItemProps{Label: "Reports", Icon: ovI(ovIcChart), Keywords: "analytics"})
			}
			@ui.CommandGroup(ui.CommandGroupProps{Heading: "Actions"}) {
				@ui.CommandItem(ui.CommandItemProps{Label: "New project", Icon: ovI(ovIcPlus), Shortcut: "⌘N"})
				@ui.CommandItem(ui.CommandItemProps{Label: "Invite people", Icon: ovI(ovIcUser), Attrs: ui.Opens("drawer-right")})
				@ui.CommandItem(ui.CommandItemProps{Label: "Settings", Icon: ovI(ovIcGear), Keywords: "preferences"})
			}
		}
		@ui.CommandPalette(ui.CommandPaletteProps{ID: "cmd-two", Hotkey: "-", Search: "/demo/overlays/search", Placeholder: "Search the docs…"}) {
			@ovSearchResults("")
		}
	}
	@demo("navbar", "Navbar") {
		<div class="w-full overflow-hidden rounded-xl bg-paper">
			@ui.Navbar(ui.NavbarProps{ID: "nav-demo", Brand: ovBrand(), BrandHref: "#navbar", Items: ovNavItems(), Docs: ui.NavLink{Label: "Docs", Href: "#navbar"}, CTA: ui.NavLink{Label: "Get started", Href: "#navbar"}, Class: "static"})
			<div class="h-[460px]"></div>
		</div>
	}
	@demo("sidebar", "Sidebar") {
		<div class="flex h-[520px] w-full overflow-hidden rounded-xl bg-paper">
			@ui.Sidebar(ui.SidebarProps{
				Workspaces: []ui.SidebarWorkspace{{ID: "studio", Name: "Astabyte", Plan: "Pro plan"}, {ID: "labs", Name: "Astabyte Labs", Plan: "Free"}},
				Groups: []ui.SidebarGroup{
					{Items: []ui.SidebarItem{{ID: "home", Label: "Home", Icon: ovI(ovIcHome)}, {ID: "inbox", Label: "Inbox", Icon: ovI(ovIcInbox), Badge: 4}, {ID: "search", Label: "Search", Icon: ovI(ovIcSearch)}}},
					{Label: "Workspace", Items: []ui.SidebarItem{{ID: "reports", Label: "Reports", Icon: ovI(ovIcChart)}, {ID: "calendar", Label: "Calendar", Icon: ovI(ovIcCalendar)}, {ID: "settings", Label: "Settings", Icon: ovI(ovIcGear)}}},
				},
				Active: "inbox",
				User:   ui.SidebarUser{Name: "Sam Rivera", Email: "sam@astabyte.com"},
			})
			<div class="flex-1 p-6 text-[14px] text-mute">Content</div>
		</div>
	}
	@demo("workspace-switcher", "Workspace switcher") {
		<div class="w-64 max-w-full rounded-xl bg-paper p-2">
			@ui.WorkspaceSwitcher(ui.WorkspaceSwitcherProps{
				ID:           "ws-one",
				Workspaces:   []ui.Workspace{{ID: "studio", Name: "Astabyte", Plan: "Pro", Meta: "12 members"}, {ID: "labs", Name: "Astabyte Labs", Meta: "3 members"}, {ID: "client", Name: "Client work", Plan: "Team", Meta: "8 members"}},
				Current:      "studio",
				AccountName:  "Sam Rivera",
				AccountEmail: "sam@astabyte.com",
				CreateHref:   "#workspace-switcher",
				Footer:       ovWsFooter(),
			})
		</div>
	}
	@demo("footer", "Footer") {
		@ui.Footer(ui.FooterProps{
			Brand:    ovBrand(),
			Tagline:  "Web apps and the kit behind them.",
			Wordmark: "Astabyte",
			Columns: []ui.FooterColumn{
				{Heading: "Product", Links: []ui.NavLink{{Label: "Kit", Href: "#footer"}, {Label: "Motion", Href: "#footer"}, {Label: "Changelog", Href: "#footer"}}},
				{Heading: "Company", Links: []ui.NavLink{{Label: "About", Href: "#footer"}, {Label: "Work", Href: "#footer"}, {Label: "Contact", Href: "#footer"}}},
				{Heading: "Resources", Links: []ui.NavLink{{Label: "Docs", Href: "#footer"}, {Label: "GitHub", Href: "#footer"}}},
			},
			Subscribe: "/demo/overlays/subscribe",
			Legal:     ovLegal(),
			Class:     "w-full",
		})
	}
	@demo("announcement-bar", "Announcement bar") {
		<div class="flex w-full flex-col gap-3">
			@ui.AnnouncementBar(ui.AnnouncementBarProps{Messages: []ui.AnnouncementMessage{
				{Badge: "New", Text: "Astabyte UI now ships Go templ components.", Href: "#announcement-bar"},
				{Text: "Dark mode follows your system.", Href: "#announcement-bar", LinkLabel: "Try it"},
				{Text: "Every motion respects reduced motion."},
			}, Interval: 3500, Class: "rounded-lg"})
			@ui.AnnouncementBar(ui.AnnouncementBarProps{Variant: "brand", Messages: []ui.AnnouncementMessage{{Text: "Launch week starts Monday.", Href: "#announcement-bar"}}, Class: "rounded-lg"})
			@ui.AnnouncementBar(ui.AnnouncementBarProps{Variant: "subtle", NoDismiss: true, Messages: []ui.AnnouncementMessage{{Badge: "Beta", Text: "Server search in the command palette."}}, Class: "rounded-lg"})
		</div>
	}
	@demo("stepper", "Stepper") {
		<div class="w-full max-w-xl">
			@ui.Stepper(ui.StepperProps{ID: "step-one", Steps: []ui.Step{
				{Title: "Account", Description: "Your details", Content: ovStepBody("Name, email and a password.")},
				{Title: "Workspace", Description: "Name it", Content: ovStepBody("Pick a name your team will see.")},
				{Title: "Invite", Description: "Bring people", Content: ovStepBody("Add teammates by email, or skip for now.")},
			}, Complete: ovStepDone()}) {
				@ui.StepperControls(ui.StepperControlsProps{})
			}
		</div>
	}
	@demo("tool-dock", "Tool dock") {
		<div class="flex w-full flex-col items-center gap-3 rounded-xl bg-paper py-16">
			@ui.ToolDock(ui.ToolDockProps{ID: "dock-one", Tools: []ui.DockTool{
				{ID: "move", Label: "Move", Icon: ovI(ovIcMove), Shortcut: "V"},
				{ID: "frame", Label: "Frame", Icon: ovI(ovIcFrame), Shortcut: "F"},
				{ID: "rect", Label: "Rectangle", Icon: ovI(ovIcRect), Shortcut: "R"},
				{ID: "pen", Label: "Pen", Icon: ovI(ovIcPen), Shortcut: "P"},
				{ID: "text", Label: "Text", Icon: ovI(ovIcText), Shortcut: "T"},
				{Separator: true},
				{ID: "hand", Label: "Hand", Icon: ovI(ovIcHand), Shortcut: "H"},
				{ID: "comment", Label: "Comment", Icon: ovI(ovIcComment), Shortcut: "C", Disabled: true},
			}})
			<p class="text-[12px] text-mute">Press V, F, R, P, T or H.</p>
		</div>
	}
}

templ ovDrawerFooter() {
	@ui.Button(ui.ButtonProps{Variant: "ghost", Attrs: ui.Closes()}) {
		Cancel
	}
	@ui.Button(ui.ButtonProps{Variant: "accent", Attrs: ui.Closes()}) {
		Send invite
	}
}

templ ovWsFooter() {
	@ui.MenuSeparator()
	@ui.MenuItem(ui.MenuItemProps{Icon: ovI(ovIcGear)}) {
		Settings
	}
	@ui.MenuItem(ui.MenuItemProps{Icon: ovI(ovIcLogout)}) {
		Sign out
	}
}

// ovSearchResults is what the server search endpoint returns for q.
templ ovSearchResults(q string) {
	if hits := ovSearch(q); len(hits) > 0 {
		@ui.CommandGroup(ui.CommandGroupProps{Heading: "Docs"}) {
			for _, h := range hits {
				@ui.CommandItem(ui.CommandItemProps{Label: h, Icon: ovI(ovIcFile), Href: "#command-palette"})
			}
		}
	}
}
