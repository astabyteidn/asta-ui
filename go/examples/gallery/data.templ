package main

import (
	"time"

	ui "github.com/astabyteidn/asta-ui/go/ui"
)

// dataGallery shows the data components. Each demo is wrapped in @demo("<id>", "<Title>").
templ dataGallery() {
	@demo("data-table", "Data table") {
		<div class="w-full min-w-0">
			@dataInvoiceTable(dataTableView(dataEmptyRequest()))
		</div>
	}
	@demo("tree-view", "Tree view") {
		<div class="w-full max-w-[320px] rounded-xl bg-paper p-2">
			@ui.TreeView(ui.TreeViewProps{Label: "Files", Selected: "src/app/page", Name: "file", Nodes: dataFiles()})
		</div>
	}
	@demo("timeline", "Timeline") {
		<div class="w-full max-w-[420px] rounded-xl bg-paper p-5">
			@ui.Timeline(ui.TimelineProps{Label: "Order history", Items: []ui.TimelineItem{
				{Title: "Order placed", Description: "Astabyte Pro, yearly plan", Time: "09:41"},
				{Title: "Payment confirmed", Description: "Visa ending 4242", Time: "09:42"},
				{Title: "Workspace ready", Description: "Invites sent to 4 teammates", Time: "09:44", State: "active"},
				{Title: "First project", Description: "Create one to finish setup", State: "pending"},
			}})
		</div>
	}
	@demo("kanban", "Kanban") {
		<div class="w-full min-w-0">
			@ui.Kanban(ui.KanbanProps{
				ID:      "board",
				Label:   "Sprint board",
				MoveURL: "/demo/data/kanban",
				Columns: []ui.KanbanColumn{{ID: "todo", Title: "To do"}, {ID: "doing", Title: "In progress"}, {ID: "done", Title: "Done"}},
				Cards:   dataBoardCards(),
			})
		</div>
	}
	@demo("event-calendar", "Event calendar") {
		<div class="w-full min-w-0">
			@dataEventCalendar(dataToday(), dataToday(), dataToday())
		</div>
	}
	@demo("file-card", "File card") {
		<div class="grid w-full grid-cols-1 gap-4 sm:grid-cols-3">
			@ui.FileCard(ui.FileCardProps{Title: "Brand guide.pdf", Meta: "PDF · 4.2 MB", Preview: dataArt(0), Star: true, Starred: true, StarURL: "/demo/data/star", Href: "#file-card"})
			@ui.FileCard(ui.FileCardProps{Title: "Homepage hero.png", Meta: "PNG · 1.8 MB", Preview: dataArt(1), Star: true, StarURL: "/demo/data/star", Href: "#file-card"})
			@ui.FileCard(ui.FileCardProps{Title: "Q4 report.xlsx", Meta: "Sheet · 310 KB", Star: true, StarURL: "/demo/data/star", Selected: true})
		</div>
		<div class="flex w-full flex-col gap-1 rounded-xl bg-paper p-2">
			@ui.FileCard(ui.FileCardProps{View: "list", Title: "Pitch deck.key", Meta: "Keynote · 12 MB · Edited 2h ago", Preview: dataArt(2), Star: true, StarURL: "/demo/data/star"})
			@ui.FileCard(ui.FileCardProps{View: "list", Title: "Contract draft.docx", Meta: "Doc · 88 KB · Edited yesterday", Star: true, Starred: true, StarURL: "/demo/data/star"})
		</div>
	}
	@demo("image-compare", "Image compare") {
		<div class="w-full max-w-[640px]">
			@ui.ImageCompare(ui.ImageCompareProps{
				BeforeContent: dataArt(3),
				AfterContent:  dataArt(1),
				BeforeLabel:   "Before",
				AfterLabel:    "After",
				Label:         "Homepage redesign",
			})
		</div>
	}
	@demo("carousel", "Carousel") {
		<div class="w-full max-w-[640px]">
			@ui.Carousel(ui.CarouselProps{Label: "Featured work", Loop: true, Autoplay: 5000, Slides: []templ.Component{
				dataSlide(0, "Astabyte Studio", "Brand and site for a design studio"),
				dataSlide(1, "Astabyte Pay", "Checkout that loads in under a second"),
				dataSlide(2, "Astabyte Docs", "Docs that read like a good blog"),
				dataSlide(3, "Astabyte Ops", "One dashboard for every deploy"),
			}})
		</div>
	}
	@demo("notification-center", "Notification center") {
		<div class="flex w-full justify-end rounded-xl bg-paper p-2">
			@ui.NotificationCenter(ui.NotificationCenterProps{Notifications: dataNotes(), MarkReadURL: "/demo/data/notifications", Ring: true})
		</div>
	}
	@demo("comments", "Comments") {
		<div class="w-full rounded-xl bg-paper p-5 sm:p-6">
			@ui.Comments(ui.CommentsProps{
				ID:      "comments-one",
				User:    dataMe,
				PostURL: "/demo/data/comments",
				LikeURL: "/demo/data/comments/like",
				Comments: []ui.Comment{
					{ID: "c1", Author: ui.CommentAuthor{Name: "Maya Chen"}, Time: "2h", Body: "The new pricing table reads much better. Can we try the yearly toggle on the left?", Likes: 4, Liked: true,
						Replies: []ui.Comment{
							{ID: "c2", Author: ui.CommentAuthor{Name: "Leo Park"}, Time: "1h", Body: "Agreed. I'll push a version with it on the left today.", Likes: 1},
						}},
					{ID: "c3", Author: ui.CommentAuthor{Name: "Ana Ruiz"}, Time: "35m", Body: "Dark mode screenshots are in the Astabyte drive.", Likes: 0},
				},
			})
		</div>
	}
	@demo("motion-button", "Motion button") {
		<div class="flex flex-wrap items-center gap-3">
			@ui.MotionButton(ui.MotionButtonProps{Variant: "roll", Label: "Get started"})
			@ui.MotionButton(ui.MotionButtonProps{Variant: "fill", Label: "View the work"})
			@ui.MotionButton(ui.MotionButtonProps{Variant: "arrow", Label: "Start a project", Href: "#motion-button"})
			@ui.MotionButton(ui.MotionButtonProps{Variant: "shine", Label: "Upgrade to Pro"})
			@ui.MotionButton(ui.MotionButtonProps{Variant: "beam", Label: "Try Astabyte"})
			@ui.MotionButton(ui.MotionButtonProps{Variant: "press", Label: "Press me"})
			@ui.MotionButton(ui.MotionButtonProps{Variant: "copy", Label: "Copy install", Value: "go get github.com/astabyteidn/asta-ui/go"})
			@ui.MotionButton(ui.MotionButtonProps{Variant: "confirm", Label: "Delete project"})
		</div>
	}
}

// dataInvoiceTable is the table the gallery and /demo/data/table both render.
templ dataInvoiceTable(v dtView) {
	@ui.DataTable(ui.DataTableProps{
		ID:                "invoices",
		URL:               "/demo/data/table",
		NoPushURL:         true,
		Label:             "Invoices",
		Searchable:        true,
		SearchPlaceholder: "Search invoices",
		Selectable:        true,
		Query:             v.q,
		Sort:              v.sort,
		Dir:               v.dir,
		Page:              v.page,
		PageSize:          dtPageSize,
		Total:             v.total,
		Actions:           dataArchiveButton(),
		Columns: []ui.DataTableColumn{
			{Key: "id", Header: "Invoice"},
			{Key: "client", Header: "Client", Sortable: true},
			{Key: "status", Header: "Status"},
			{Key: "due", Header: "Due", Sortable: true},
			{Key: "amount", Header: "Amount", Sortable: true, Align: "right"},
		},
	}) {
		for _, inv := range v.rows {
			@ui.DataTableRow(ui.DataTableRowProps{ID: inv.ID}) {
				@ui.TD(ui.TDProps{Class: "font-mono text-[12.5px] text-mute"}) {
					{ inv.ID }
				}
				@ui.TD(ui.TDProps{Class: "text-ink"}) {
					{ inv.Client }
				}
				@ui.TD() {
					@ui.Badge(ui.BadgeProps{Tone: dataTone(inv.Status), Dot: true, Size: "sm"}) {
						{ inv.Status }
					}
				}
				@ui.TD() {
					{ inv.Due.Format("Jan 2, 2006") }
				}
				@ui.TD(ui.TDProps{Align: "right"}) {
					{ money(inv.Amount) }
				}
			}
		}
	}
}

templ dataArchiveButton() {
	@ui.Button(ui.ButtonProps{Variant: "outline", Size: "sm", Attrs: templ.Attributes{
		"hx-post":    "/demo/data/table/archive",
		"hx-include": "#invoices-rows",
		"hx-target":  "#invoices",
		"hx-select":  "#invoices",
		"hx-swap":    "outerHTML",
	}}) {
		Archive
	}
}

templ dataEventCalendar(month, day, today time.Time) {
	@ui.EventCalendar(ui.EventCalendarProps{
		ID:        "schedule",
		URL:       "/demo/data/calendar",
		NoPushURL: true,
		Month:     month,
		Selected:  day,
		Today:     today,
		Name:      "day",
		Events:    dataEvents(month, today),
	})
}

// dataArt is a flat gradient picture with a few shapes, standing in for an image.
templ dataArt(n int) {
	{{ c := dataPalettes[n%len(dataPalettes)] }}
	<svg viewBox="0 0 640 400" preserveAspectRatio="xMidYMid slice" class="block h-full w-full" aria-hidden="true">
		<defs>
			<linearGradient id={ dataArtID(n) } x1="0" y1="0" x2="1" y2="1">
				<stop offset="0" stop-color={ c[0] }></stop>
				<stop offset="1" stop-color={ c[1] }></stop>
			</linearGradient>
		</defs>
		<rect width="640" height="400" fill={ "url(#" + dataArtID(n) + ")" }></rect>
		<circle cx={ dataNum(180 + n*60) } cy="210" r="110" fill={ c[2] } opacity="0.55"></circle>
		<rect x="330" y="120" width="210" height="150" rx="18" fill="#fff" opacity="0.18"></rect>
		<rect x="360" y="150" width="120" height="12" rx="6" fill="#fff" opacity="0.6"></rect>
		<rect x="360" y="176" width="80" height="12" rx="6" fill="#fff" opacity="0.4"></rect>
	</svg>
}

templ dataSlide(n int, title, text string) {
	<div class="relative aspect-[16/9] overflow-hidden rounded-xl">
		@dataArt(n)
		<div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/55 to-transparent p-5 pt-12 text-white">
			<p class="text-[17px] font-medium tracking-[-0.01em]">{ title }</p>
			<p class="mt-0.5 text-[13px] text-white/80">{ text }</p>
		</div>
	</div>
}
