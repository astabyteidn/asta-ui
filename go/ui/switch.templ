package ui

// SwitchProps configures Switch. Attrs go on the native <input type="checkbox" role="switch">.
type SwitchProps struct {
	// ID links the description to the switch for screen readers.
	ID   string
	Name string
	// Value is what the form posts when on. The browser default is "on".
	Value   string
	Checked bool
	// Size: "sm", "md" (default) or "lg".
	Size     string
	Disabled bool
	Required bool
	// Label sits on the left. Without it, give the switch an aria-label in Attrs.
	Label       string
	Description string
	Class       string
	Attrs       templ.Attributes
}

type switchDim struct{ track, thumb, on string }

// Track and thumb sizes match the React kit: 30×18/14, 40×24/20 and 52×30/26 px, with 2px padding.
var switchSize = map[string]switchDim{
	"sm": {"h-[18px] w-[30px]", "h-[14px] w-[14px]", "peer-checked:translate-x-[12px]"},
	"md": {"h-6 w-10", "h-5 w-5", "peer-checked:translate-x-4"},
	"lg": {"h-[30px] w-[52px]", "h-[26px] w-[26px]", "peer-checked:translate-x-[22px]"},
}

func switchDims(size string) switchDim {
	if d, ok := switchSize[size]; ok {
		return d
	}
	return switchSize["md"]
}

// Switch is an on/off switch on a native checkbox, so it posts with the form and works without JavaScript.
// While pressed, the thumb stretches toward where it is about to go.
//
//	@ui.Switch(ui.SwitchProps{ID: "digest", Name: "digest", Label: "Weekly digest", Description: "A short Astabyte summary every Monday.", Checked: true})
templ Switch(p SwitchProps) {
	if p.Label == "" {
		<span class={ cx("inline-flex", p.Class) }>
			@switchControl(p)
		</span>
	} else {
		<label class={ cx("flex items-center justify-between gap-4", or(when(p.Disabled, "opacity-60"), "cursor-pointer"), p.Class) }>
			<span class="min-w-0">
				<span class="block select-none text-[14px] leading-5 text-ink">{ p.Label }</span>
				if p.Description != "" {
					<span
						if p.ID != "" {
							id={ p.ID + "-d" }
						}
						class="mt-0.5 block text-[13px] leading-snug text-mute"
					>{ p.Description }</span>
				}
			</span>
			@switchControl(p)
		</label>
	}
}

templ switchControl(p SwitchProps) {
	{{ d := switchDims(p.Size) }}
	<span class={ cx("relative inline-flex shrink-0", d.track) }>
		<input
			type="checkbox"
			role="switch"
			if p.ID != "" {
				id={ p.ID }
			}
			if p.Name != "" {
				name={ p.Name }
			}
			if p.Value != "" {
				value={ p.Value }
			}
			if p.ID != "" && p.Description != "" && p.Label != "" {
				aria-describedby={ p.ID + "-d" }
			}
			checked?={ p.Checked }
			disabled?={ p.Disabled }
			required?={ p.Required }
			class={ cx("peer absolute inset-0 h-full w-full cursor-pointer appearance-none rounded-full outline-none transition-[background-color,box-shadow] duration-300",
				"bg-[color-mix(in_srgb,var(--ink)_14%,var(--paper))] shadow-[inset_0_1px_2px_rgb(0_0_0/0.08)] checked:bg-brand checked:shadow-[inset_0_1px_2px_rgb(0_0_0/0.15)]",
				"focus-visible:ring-2 focus-visible:ring-brand/50 focus-visible:ring-offset-2 focus-visible:ring-offset-paper disabled:cursor-not-allowed disabled:opacity-45") }
			{ p.Attrs... }
		/>
		<span
			aria-hidden="true"
			class={ cx("pointer-events-none absolute left-[2px] top-[2px] block origin-left rounded-full bg-white shadow-[0_1px_2px_rgb(0_0_0/0.2),0_2px_6px_-1px_rgb(0_0_0/0.18)]",
				"transition-[translate,scale] duration-[450ms] ease-[cubic-bezier(.16,1,.3,1)] peer-checked:origin-right peer-active:scale-x-[1.3] motion-reduce:transition-none",
				d.thumb, d.on) }
		></span>
	</span>
}
