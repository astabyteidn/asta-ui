package ui

import "strconv"

// RatingProps configures Rating.
type RatingProps struct {
	// Name is the form field. Each step is a native radio with this name; "0" means no rating.
	Name  string
	Value float64
	// Max is the number of stars. Default 5.
	Max int
	// AllowHalf allows half stars (3.5). The left half of a star sets the half.
	AllowHalf bool
	// NoClear stops a click on the current value from clearing it to 0.
	NoClear bool
	// ReadOnly shows the value without letting anyone change it.
	ReadOnly bool
	// Size: "sm" or "md" (default).
	Size string
	// Label is the accessible name, e.g. "Rate this course". Default "Rating".
	Label string
	Class string
	// Attrs go on the root. With hx-post, add hx-trigger="change" and hx-include="this".
	Attrs templ.Attributes
}

const ratingStar = "M12 3.2l2.6 5.28 5.83.85-4.22 4.11 1 5.8L12 16.5l-5.21 2.74 1-5.8-4.22-4.11 5.83-.85L12 3.2z"

func ratingMax(p RatingProps) int {
	if p.Max <= 0 {
		return 5
	}
	return p.Max
}

func ratingFill(v float64, i int) string {
	switch {
	case v >= float64(i):
		return "full"
	case v >= float64(i)-0.5:
		return "half"
	}
	return "none"
}

func ratingNum(f float64) string { return strconv.FormatFloat(f, 'f', -1, 64) }

func ratingText(p RatingProps) string {
	return ratingNum(p.Value) + " out of " + strconv.Itoa(ratingMax(p)) + " stars"
}

func ratingSize(p RatingProps) templ.SafeCSS {
	if p.Size == "sm" {
		return "width:16px;height:16px"
	}
	return "width:24px;height:24px"
}

// Rating is a star rating on native radios, so it posts with the form and arrow keys step it.
// Hover previews, click sets, a click on the current value clears it, and the filled stars pop one after another.
//
//	@ui.Rating(ui.RatingProps{Name: "score", Value: 4, Label: "Rate this course"})
templ Rating(p RatingProps) {
	{{ n, gap := ratingMax(p), or(when(p.Size == "sm", "gap-0.5"), "gap-1") }}
	if p.ReadOnly {
		<span role="img" aria-label={ or(p.Label, "Rating") + ": " + ratingText(p) } class={ cx("inline-flex items-center", gap, p.Class) } { p.Attrs... }>
			for i := 1; i <= n; i++ {
				@ratingIcon(p, i)
			}
		</span>
	} else {
		<div
			role="radiogroup"
			aria-label={ or(p.Label, "Rating") }
			data-asta-rating
			data-value={ ratingNum(p.Value) }
			if !p.NoClear {
				data-clear
			}
			class={ cx("inline-flex select-none items-center rounded-md outline-none [touch-action:manipulation] has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-brand/50 has-[:focus-visible]:ring-offset-2 has-[:focus-visible]:ring-offset-paper", gap, p.Class) }
			{ p.Attrs... }
		>
			<input type="radio" name={ p.Name } value="0" checked?={ p.Value <= 0 } aria-label="No rating" class="sr-only"/>
			for i := 1; i <= n; i++ {
				@ratingIcon(p, i) {
					if p.AllowHalf {
						<label class="absolute inset-y-0 left-0 w-1/2 cursor-pointer">
							<input type="radio" name={ p.Name } value={ ratingNum(float64(i) - 0.5) } checked?={ p.Value == float64(i)-0.5 } aria-label={ ratingNum(float64(i)-0.5) + " stars" } class="sr-only"/>
						</label>
					}
					<label class={ cx("absolute inset-y-0 right-0 cursor-pointer", or(when(p.AllowHalf, "w-1/2"), "w-full")) }>
						<input type="radio" name={ p.Name } value={ strconv.Itoa(i) } checked?={ p.Value == float64(i) } aria-label={ strconv.Itoa(i) + " stars" } class="sr-only"/>
					</label>
				}
			}
		</div>
	}
}

templ ratingIcon(p RatingProps, i int) {
	<span class="group/star relative block shrink-0" style={ ratingSize(p) } data-asta-star data-fill={ ratingFill(p.Value, i) }>
		<span class="pointer-events-none relative block h-full w-full" data-asta-star-pop style={ templ.SafeCSS("animation-delay:" + strconv.Itoa((i-1)*45) + "ms") }>
			<svg viewBox="0 0 24 24" class="absolute inset-0 h-full w-full text-[color-mix(in_srgb,var(--ink)_13%,transparent)]" aria-hidden="true">
				<path d={ ratingStar } fill="currentColor" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
			</svg>
			<svg
				viewBox="0 0 24 24"
				class="absolute inset-0 h-full w-full text-brand opacity-0 transition-opacity duration-200 group-data-[fill=full]/star:opacity-100 group-data-[fill=half]/star:opacity-100 group-data-[fill=half]/star:[clip-path:inset(0_50%_0_0)] group-data-[preview]/star:text-[color-mix(in_srgb,var(--brand)_62%,transparent)]"
				aria-hidden="true"
			>
				<path d={ ratingStar } fill="currentColor" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
			</svg>
		</span>
		{ children... }
	</span>
}
