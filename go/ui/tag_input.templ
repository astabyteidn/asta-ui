package ui

import "strconv"

// TagInputProps configures TagInput.
type TagInputProps struct {
	// ID is the text field's id. Default "tags".
	ID string
	// Name is the form field. Each tag posts as its own hidden input with this name.
	Name  string
	Value []string
	// Max is the most tags allowed. Default 8.
	Max int
	// Placeholder shows while there are no tags. Default "Add a tag".
	Placeholder string
	// Label is shown above the field. Default "Tags".
	Label string
	// NoHint hides the keyboard hint under the field.
	NoHint bool
	Class  string
	// Attrs go on the root. It fires "change" whenever the tags change: hx-post with hx-trigger="change" and hx-include="this".
	Attrs templ.Attributes
}

func tagMax(p TagInputProps) int {
	if p.Max <= 0 {
		return 8
	}
	return p.Max
}

// TagInput is a field of tags. Type and press Enter or comma to add one. Backspace on an empty field marks the last
// tag, a second Backspace removes it. Pasting "a, b, c" adds all three, and a duplicate makes the existing tag shake.
//
//	@ui.TagInput(ui.TagInputProps{Name: "tags", Value: []string{"design", "go"}})
templ TagInput(p TagInputProps) {
	{{ id, n, full := or(p.ID, "tags"), tagMax(p), len(p.Value) >= tagMax(p) }}
	<div data-asta-tags data-name={ p.Name } data-max={ strconv.Itoa(n) } data-placeholder={ or(p.Placeholder, "Add a tag") } class={ cx("w-full", p.Class) } { p.Attrs... }>
		<div class="mb-2 flex items-baseline justify-between">
			<label for={ id } class="text-[13px] font-medium text-ink">{ or(p.Label, "Tags") }</label>
			<span data-asta-tags-count aria-live="polite" class={ cx("font-mono text-[11px] tabular-nums transition-colors", or(when(full, "text-[#e5484d]"), "text-mute")) }>
				{ strconv.Itoa(len(p.Value)) }/{ strconv.Itoa(n) }
			</span>
		</div>
		<div
			data-asta-tags-box
			class={ cx("flex min-h-11 w-full cursor-text flex-wrap items-center gap-1.5 rounded-[9px] bg-paper p-1.5 transition-shadow duration-200",
				"shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_14%,transparent)]",
				"focus-within:shadow-[inset_0_0_0_1px_var(--brand),0_0_0_4px_color-mix(in_srgb,var(--brand)_14%,transparent)]") }
		>
			<ul class="contents" aria-label={ or(p.Label, "Tags") } data-asta-tags-list>
				for _, t := range p.Value {
					@tagChip(p.Name, t, false)
				}
			</ul>
			<input
				id={ id }
				data-asta-tags-input
				autocomplete="off"
				disabled?={ full }
				placeholder={ tagPlaceholder(p, full) }
				class="h-8 min-w-[4rem] flex-1 bg-transparent px-2 text-[14px] text-ink outline-none placeholder:text-mute disabled:cursor-not-allowed"
			/>
		</div>
		if !p.NoHint {
			<p class="mt-2 text-[12px] text-mute">
				<kbd class="font-sans text-ink-2">Enter</kbd> or <kbd class="font-sans text-ink-2">,</kbd> to add ·
				<kbd class="font-sans text-ink-2">⌫</kbd> twice to remove
			</p>
		}
		<template data-asta-tags-tpl>
			@tagChip(p.Name, "", true)
		</template>
	</div>
}

func tagPlaceholder(p TagInputProps, full bool) string {
	if full {
		return "Limit reached"
	}
	if len(p.Value) > 0 {
		return ""
	}
	return or(p.Placeholder, "Add a tag")
}

// tagChip is one tag. The template copy is cloned by forms.js for new tags.
templ tagChip(name, t string, fresh bool) {
	<li
		data-asta-tag={ t }
		class={ cx("group/tag flex h-8 items-center gap-1 rounded-md bg-paper-2 pl-3 pr-1 text-[13px] text-ink transition-colors duration-200 data-[armed]:bg-[#e5484d] data-[armed]:text-white",
			when(fresh, "asta-tag-in")) }
	>
		<span data-asta-tag-text>{ t }</span>
		<button
			type="button"
			aria-label={ "Remove " + t }
			data-asta-tag-remove
			class="flex h-6 w-6 items-center justify-center rounded-[5px] text-mute outline-none transition-colors hover:bg-[color-mix(in_srgb,var(--ink)_8%,transparent)] hover:text-ink focus-visible:ring-2 focus-visible:ring-brand/50 group-data-[armed]/tag:text-white group-data-[armed]/tag:hover:bg-white/20"
		>
			<svg viewBox="0 0 16 16" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="m4.5 4.5 7 7M11.5 4.5l-7 7"></path></svg>
		</button>
		if name != "" {
			<input type="hidden" name={ name } value={ t }/>
		}
	</li>
}
