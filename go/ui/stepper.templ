package ui

import "strconv"

// StepperProps configures Stepper. Children go under the content, e.g. StepperControls.
type StepperProps struct {
	// ID names the stepper. Optional.
	ID string
	// Steps are the steps, in order.
	Steps []Step
	// Current is the step shown first, 0-based. len(Steps) means every step is done.
	Current int
	// NoGoBack stops people from clicking a finished step to go back to it.
	NoGoBack bool
	// Complete is shown in place of the step content once every step is done.
	Complete templ.Component
	// Class is merged onto the root element.
	Class string
	// Attrs go on the root. It fires "asta:step" (detail: step) on every change.
	Attrs templ.Attributes
}

// Step is one step of Stepper.
type Step struct {
	// Title is the heading text.
	Title string
	// Description is the muted line under the title.
	Description string
	// Content is the step's panel.
	Content templ.Component
}

// StepperControlsProps configures StepperControls.
type StepperControlsProps struct {
	// BackLabel defaults to "Back", NextLabel to "Continue", FinishLabel (on the last step) to "Finish".
	BackLabel string
	// NextLabel is the Continue button text.
	NextLabel string
	// FinishLabel is the button text on the last step.
	FinishLabel string
	// Class is merged onto the root element.
	Class string
}

// StepNext returns the attributes that make a button inside a Stepper go to the next step.
func StepNext() templ.Attributes { return templ.Attributes{"data-asta-step-next": true} }

// StepBack returns the attributes that make a button inside a Stepper go to the previous step.
func StepBack() templ.Attributes { return templ.Attributes{"data-asta-step-back": true} }

// StepGoTo returns the attributes that make a button inside a Stepper jump to step n (0-based).
func StepGoTo(n int) templ.Attributes {
	return templ.Attributes{"data-asta-step-goto": strconv.Itoa(n)}
}

func stepCurrent(p StepperProps) int {
	return max(0, min(len(p.Steps), p.Current))
}

func stepState(i, cur int) string {
	switch {
	case i < cur:
		return "done"
	case i == cur:
		return "current"
	}
	return "todo"
}

// Stepper is a step header plus the step's content, all rendered on the server and switched in the browser.
// Finished steps turn into a check that draws itself in, the line between steps fills with blue, and the
// content slides in from the side you're heading. Buttons with StepNext, StepBack or StepGoTo drive it.
//
//	@ui.Stepper(ui.StepperProps{Steps: steps, Complete: doneMsg()}) {
//		@ui.StepperControls(ui.StepperControlsProps{})
//	}
templ Stepper(p StepperProps) {
	{{ cur := stepCurrent(p) }}
	<div
		data-asta-stepper
		if p.ID != "" {
			id={ p.ID }
		}
		data-step={ strconv.Itoa(cur) }
		data-count={ strconv.Itoa(len(p.Steps)) }
		data-first?={ cur == 0 }
		data-last?={ cur == len(p.Steps)-1 }
		data-complete?={ cur >= len(p.Steps) }
		data-no-back?={ p.NoGoBack }
		class={ cx("group/stepper flex w-full flex-col", p.Class) }
		{ p.Attrs... }
	>
		<ol aria-label="Progress" class="flex items-start">
			for i, s := range p.Steps {
				<li
					data-asta-step={ strconv.Itoa(i) }
					data-state={ stepState(i, cur) }
					if i == cur {
						aria-current="step"
					}
					class={ cx("group/step flex min-w-0 items-center", when(i < len(p.Steps)-1, "flex-1")) }
				>
					<button
						type="button"
						data-asta-step-goto={ strconv.Itoa(i) }
						disabled?={ p.NoGoBack || i >= cur || cur >= len(p.Steps) }
						class="-m-1 flex min-w-0 items-center gap-2.5 rounded-lg p-1 text-left outline-none transition-[opacity,transform] duration-200 hover:opacity-80 focus-visible:ring-2 focus-visible:ring-brand/50 active:scale-[0.98] disabled:cursor-default disabled:hover:opacity-100 disabled:active:scale-100"
					>
						@stepMark(i)
						<span class="hidden min-w-0 flex-col text-left group-data-[state=current]/step:flex sm:flex">
							<span class="truncate text-[13px] font-medium tracking-[-0.01em] text-ink transition-colors duration-300 group-data-[state=todo]/step:text-mute">{ s.Title }</span>
							if s.Description != "" {
								<span class="truncate text-[12px] text-mute">{ s.Description }</span>
							}
						</span>
						<span class="sr-only hidden group-data-[state=done]/step:inline">, done</span>
						<span class="sr-only hidden group-data-[state=todo]/step:inline">, not started</span>
					</button>
					if i < len(p.Steps)-1 {
						<span aria-hidden="true" class="relative mx-3 h-[2px] min-w-6 flex-1 overflow-hidden rounded-full bg-[color-mix(in_srgb,var(--ink)_10%,transparent)]">
							<span class="absolute inset-0 origin-left scale-x-0 rounded-full bg-brand transition-transform duration-500 ease-[cubic-bezier(.16,1,.3,1)] group-data-[state=done]/step:scale-x-100 motion-reduce:transition-none"></span>
						</span>
					}
				</li>
			}
		</ol>
		<div class="mt-6 overflow-hidden">
			for i, s := range p.Steps {
				<div role="region" aria-label={ s.Title } data-asta-step-panel={ strconv.Itoa(i) } hidden?={ i != cur }>
					if s.Content != nil {
						@s.Content
					}
				</div>
			}
			<div role="region" aria-label="Done" data-asta-step-panel={ strconv.Itoa(len(p.Steps)) } hidden?={ cur < len(p.Steps) }>
				if p.Complete != nil {
					@p.Complete
				}
			</div>
		</div>
		<div class="mt-6 empty:hidden">
			{ children... }
		</div>
	</div>
}

templ stepMark(i int) {
	<span
		class={ "relative flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-[13px] font-medium tabular-nums transition-[background-color,box-shadow,color] duration-300",
			"bg-paper text-mute shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_16%,transparent)]",
			"group-data-[state=current]/step:text-brand group-data-[state=current]/step:shadow-[inset_0_0_0_1.5px_var(--brand),0_0_0_4px_color-mix(in_srgb,var(--brand)_14%,transparent)]",
			"group-data-[state=done]/step:bg-brand group-data-[state=done]/step:text-white group-data-[state=done]/step:shadow-none" }
	>
		<span class="transition-[opacity,transform] duration-300 ease-[cubic-bezier(.16,1,.3,1)] group-data-[state=done]/step:scale-50 group-data-[state=done]/step:opacity-0 motion-reduce:transition-none">{ strconv.Itoa(i + 1) }</span>
		<svg viewBox="0 0 16 16" class="absolute h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="m3.5 8.5 3 3 6-7" pathLength="1" stroke-dasharray="1" class="[stroke-dashoffset:1] transition-[stroke-dashoffset] delay-150 duration-[450ms] ease-[cubic-bezier(.16,1,.3,1)] group-data-[state=done]/step:[stroke-dashoffset:0] motion-reduce:transition-none"></path>
		</svg>
	</span>
}

// StepperControls is a Back and a Continue button for a Stepper. Continue reads Finish on the last step,
// Back is off on the first, and both hide once every step is done.
templ StepperControls(p StepperControlsProps) {
	<div class={ cx("flex items-center justify-between gap-2 group-data-[complete]/stepper:hidden", p.Class) }>
		@Button(ButtonProps{Variant: "outline", Class: "group-data-[first]/stepper:pointer-events-none group-data-[first]/stepper:opacity-45", Attrs: StepBack()}) {
			{ or(p.BackLabel, "Back") }
		}
		@Button(ButtonProps{Variant: "accent", Attrs: StepNext()}) {
			<span class="group-data-[last]/stepper:hidden">{ or(p.NextLabel, "Continue") }</span>
			<span class="hidden group-data-[last]/stepper:inline">{ or(p.FinishLabel, "Finish") }</span>
		}
	</div>
}
