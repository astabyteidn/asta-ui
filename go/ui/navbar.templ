package ui

import "strconv"

// NavbarProps configures Navbar.
type NavbarProps struct {
	// ID prefixes the panel and sheet ids. Default "nav".
	ID string
	// Brand is the logo and name on the left.
	Brand templ.Component
	// BrandHref is where the brand links. Default "/".
	BrandHref string
	// Items are rendered in order.
	Items []NavItem
	// Docs is a quiet link that folds away once the page scrolls. Empty Label hides it.
	Docs NavLink
	// CTA is the pill button on the right. Empty Label hides it.
	CTA NavLink
	// Class is merged onto the root element.
	Class string
	// Attrs are spread onto the root element (hx-*, data-*).
	Attrs templ.Attributes
}

// NavLink is a plain link of the Navbar.
type NavLink struct {
	// Label is the visible text.
	Label string
	// Href makes it a link.
	Href string
}

// NavItem is one entry of the Navbar: a link, or a trigger for a mega menu when Menu is set.
type NavItem struct {
	// Label is the visible text.
	Label string
	// Href makes it a link.
	Href string
	// Menu turns the item into a mega-menu trigger.
	Menu *NavMenu
}

// NavMenu is the content of one mega menu: tiles on top, then link columns and a feature card.
type NavMenu struct {
	// Width is the panel width in px, clamped to the space available. Default 560.
	Width int
	// Tiles are the large tiles with optional previews.
	Tiles []NavTile
	// Columns are the link columns.
	Columns []NavColumn
	// Feature is an optional highlighted card at the end.
	Feature *NavFeature
}

// NavTile is a tile, or a link in a column.
type NavTile struct {
	// Title is the heading text.
	Title string
	// Description is the muted line under the title.
	Description string
	// Href makes it a link.
	Href string
	// Icon is an optional leading icon.
	Icon templ.Component
	// Preview draws a small mock in the corner of a tile: "chart", "list" or "code". A menu with one previewed
	// tile makes all its tiles tall.
	Preview string
}

// NavColumn is a headed list of links in a mega menu.
type NavColumn struct {
	// Heading is the small label above the links.
	Heading string
	// Links are the column's links.
	Links []NavTile
}

// NavFeature is the brand-coloured card at the end of a mega menu.
type NavFeature struct {
	// Title is the heading text.
	Title string
	// Description is the muted line under the title.
	Description string
	// Href makes it a link.
	Href string
	// CTA is the feature card's link text.
	CTA string
}

const (
	navRing    = "shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_12%,transparent)]"
	navEase    = "ease-[cubic-bezier(.16,1,.3,1)]"
	navTrigger = "flex h-8 items-center gap-1 rounded-md px-2.5 text-[13.5px] font-medium text-ink-2 outline-none transition-colors duration-200 hover:bg-paper-2 hover:text-ink focus-visible:ring-2 focus-visible:ring-brand/50 aria-expanded:bg-paper-2 aria-expanded:text-ink"
)

var navCols = map[int]string{1: "grid-cols-1", 2: "grid-cols-2", 3: "grid-cols-3", 4: "grid-cols-4"}

func navGrid(n int) string {
	if n == 4 {
		return "grid-cols-2"
	}
	return or(navCols[n], "grid-cols-4")
}

func navTall(m *NavMenu) bool {
	for _, t := range m.Tiles {
		if t.Preview != "" {
			return true
		}
	}
	return false
}

func navWidth(m *NavMenu) templ.SafeCSS {
	w := m.Width
	if w <= 0 {
		w = 560
	}
	return templ.SafeCSS("width:min(" + strconv.Itoa(w) + "px,calc(100cqw - 24px))")
}

func navColCount(m *NavMenu) int {
	n := len(m.Columns)
	if m.Feature != nil {
		n++
	}
	return n
}

func navLinks(m *NavMenu) []NavTile {
	out := append([]NavTile{}, m.Tiles...)
	for _, c := range m.Columns {
		out = append(out, c.Links...)
	}
	return out
}

func navDelay(ms int) templ.SafeCSS {
	return templ.SafeCSS("transition-delay:" + strconv.Itoa(ms) + "ms")
}

func navBar(height, ms int) templ.SafeCSS {
	return templ.SafeCSS("height:" + strconv.Itoa(height) + "%;transition-delay:" + strconv.Itoa(ms) + "ms")
}

func navLine(width, ms int) templ.SafeCSS {
	return templ.SafeCSS("width:" + strconv.Itoa(width) + "%;transition-delay:" + strconv.Itoa(ms) + "ms")
}

// Navbar is a site header with mega menus. One shared panel sits under the bar: it reshapes between menus while
// the new content slides in from the side you moved toward, and hovering a tile dims the rest. Hover, click,
// arrows, Escape and outside clicks work. Below 560px of its own width it folds to a burger and a sheet of
// accordion sections. The docs link folds away once the page scrolls.
//
//	@ui.Navbar(ui.NavbarProps{Brand: logo(), Items: items, Docs: ui.NavLink{Label: "Docs", Href: "/docs"}, CTA: ui.NavLink{Label: "Get started", Href: "/signup"}})
templ Navbar(p NavbarProps) {
	{{ id := or(p.ID, "nav") }}
	<header
		data-asta-navbar
		class={ cx("group/nav @container sticky top-0 z-30 w-full bg-paper/85 backdrop-blur-md",
			"after:pointer-events-none after:absolute after:inset-x-0 after:bottom-0 after:h-px after:bg-[color-mix(in_srgb,var(--ink)_10%,transparent)] after:opacity-0 after:transition-opacity after:duration-300 after:content-['']",
			"data-[scrolled]:after:opacity-100 data-[sheet]:after:opacity-100", p.Class) }
		{ p.Attrs... }
	>
		<div class="relative flex h-14 items-center gap-3 px-4">
			<a href={ templ.SafeURL(or(p.BrandHref, "/")) } class="flex flex-1 items-center gap-2 rounded-md text-[15px] font-semibold tracking-[-0.02em] text-ink outline-none focus-visible:ring-2 focus-visible:ring-brand/50">
				if p.Brand != nil {
					@p.Brand
				}
			</a>
			<nav aria-label="Main" data-asta-nav-zone class="hidden @min-[560px]:block">
				<ul class="flex items-center gap-0.5">
					for i, it := range p.Items {
						<li>
							if it.Menu != nil {
								<button type="button" data-asta-nav-trigger={ strconv.Itoa(i) } aria-expanded="false" aria-controls={ id + "-panel" } class={ cx(navTrigger, "group/trig pr-2") }>
									{ it.Label }
									@ovIcon("m6 4 4 4-4 4", "h-3.5 w-3.5 rotate-90 text-mute transition-transform duration-300 "+navEase+" group-aria-expanded/trig:-rotate-90")
								</button>
							} else {
								<a href={ templ.SafeURL(it.Href) } data-asta-nav-link class={ navTrigger }>{ it.Label }</a>
							}
						</li>
					}
				</ul>
			</nav>
			<div class="flex flex-1 items-center justify-end gap-1.5">
				<div class="relative flex items-center">
					if p.Docs.Label != "" {
						<a
							href={ templ.SafeURL(p.Docs.Href) }
							data-asta-nav-docs
							class={ ButtonClass(ButtonProps{Variant: "ghost", Size: "sm", Pill: true, Class: "absolute right-full mr-1.5 hidden transition-[opacity,translate] duration-500 " + navEase + " @min-[680px]:inline-flex group-data-[scrolled]/nav:pointer-events-none group-data-[scrolled]/nav:translate-x-2 group-data-[scrolled]/nav:opacity-0"}) }
						>{ p.Docs.Label }</a>
					}
					if p.CTA.Label != "" {
						@Button(ButtonProps{Href: p.CTA.Href, Size: "sm", Pill: true, Nudge: true, IconRight: ovIcon("m6 4 4 4-4 4", ""), Class: "@max-[399px]:hidden"}) {
							{ p.CTA.Label }
						}
					}
				</div>
				<button
					type="button"
					data-asta-nav-burger
					aria-label="Open menu"
					aria-expanded="false"
					aria-controls={ id + "-sheet" }
					class="relative flex h-8 w-8 items-center justify-center rounded-md outline-none transition-colors hover:bg-paper-2 focus-visible:ring-2 focus-visible:ring-brand/50 @min-[560px]:hidden"
				>
					<span class={ "absolute h-[1.5px] w-4 -translate-y-[3.5px] rounded-full bg-ink transition-[translate,rotate] duration-500 " + navEase + " group-data-[sheet]/nav:translate-y-0 group-data-[sheet]/nav:rotate-45" }></span>
					<span class={ "absolute h-[1.5px] w-4 translate-y-[3.5px] rounded-full bg-ink transition-[translate,rotate] duration-500 " + navEase + " group-data-[sheet]/nav:translate-y-0 group-data-[sheet]/nav:-rotate-45" }></span>
				</button>
			</div>
			<div id={ id + "-panel" } data-asta-nav-zone data-asta-nav-surface class="pointer-events-none absolute left-1/2 top-[calc(100%-2px)] hidden -translate-x-1/2 @min-[560px]:block group-data-[open]/nav:pointer-events-auto">
				<div class={ "relative origin-top -translate-y-1 scale-[.98] opacity-0 transition-[opacity,translate,scale] duration-300 " + navEase + " group-data-[open]/nav:translate-y-0 group-data-[open]/nav:scale-100 group-data-[open]/nav:opacity-100" }>
					<div data-asta-nav-bg class={ cx("absolute inset-0 origin-top rounded-xl bg-paper shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_12%,transparent),0_16px_40px_-12px_rgb(0_0_0/0.22)] transition-transform duration-300", navEase) }></div>
					<div class="relative">
						for i, it := range p.Items {
							if it.Menu != nil {
								<div data-asta-nav-panel={ strconv.Itoa(i) } hidden class="w-max" style={ navWidth(it.Menu) }>
									@navPanel(it.Menu)
								</div>
							}
						}
					</div>
				</div>
			</div>
		</div>
		<div id={ id + "-sheet" } data-asta-nav-sheet hidden class="absolute inset-x-0 top-full max-h-[calc(100svh-3.5rem)] overflow-y-auto bg-paper px-3 pb-6 pt-2 @min-[560px]:hidden">
			<ul class="flex flex-col">
				for _, it := range p.Items {
					<li>
						if it.Menu != nil {
							<details class="group/sec">
								<summary class="flex h-12 w-full cursor-pointer list-none items-center justify-between rounded-[10px] px-3 text-[15px] font-medium text-ink outline-none focus-visible:bg-paper-2 [&::-webkit-details-marker]:hidden">
									{ it.Label }
									@ovIcon("m6 4 4 4-4 4", "h-3.5 w-3.5 rotate-90 text-mute transition-transform duration-300 "+navEase+" group-open/sec:-rotate-90")
								</summary>
								<div class="asta-nav-sec flex flex-col gap-0.5 pb-2 pl-2">
									for _, l := range navLinks(it.Menu) {
										<a href={ templ.SafeURL(l.Href) } class="flex items-center gap-3 rounded-lg px-3 py-2 outline-none hover:bg-paper-2 focus-visible:bg-paper-2">
											if l.Icon != nil {
												<span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-paper-2 text-ink [&_svg]:h-3.5 [&_svg]:w-3.5">
													@l.Icon
												</span>
											}
											<span class="flex flex-col">
												<span class="text-[14px] text-ink">{ l.Title }</span>
												if l.Description != "" {
													<span class="text-[12px] leading-snug text-mute">{ l.Description }</span>
												}
											</span>
										</a>
									}
								</div>
							</details>
						} else {
							<a href={ templ.SafeURL(it.Href) } class="flex h-12 items-center rounded-[10px] px-3 text-[15px] font-medium text-ink outline-none focus-visible:bg-paper-2">{ it.Label }</a>
						}
					</li>
				}
			</ul>
			<div class="mt-4 flex flex-col gap-2 px-1">
				if p.Docs.Label != "" {
					@Button(ButtonProps{Href: p.Docs.Href, Variant: "outline", Pill: true, Class: "w-full"}) {
						{ p.Docs.Label }
					}
				}
				if p.CTA.Label != "" {
					@Button(ButtonProps{Href: p.CTA.Href, Pill: true, Class: "w-full"}) {
						{ p.CTA.Label }
					}
				}
			</div>
		</div>
	</header>
}

templ navPanel(m *NavMenu) {
	{{ tall := navTall(m) }}
	<div class="group/menu flex flex-col gap-2 p-2">
		if len(m.Tiles) > 0 {
			<div class={ cx("grid gap-2", navGrid(len(m.Tiles))) }>
				for _, t := range m.Tiles {
					@navTile(t, tall)
				}
			</div>
		}
		if len(m.Columns) > 0 || m.Feature != nil {
			<div class={ cx("grid gap-2", navGrid(navColCount(m))) }>
				for _, col := range m.Columns {
					<div class="flex flex-col gap-0.5 p-2">
						<span class="mb-1.5 px-2 text-[11.5px] text-mute">{ col.Heading }</span>
						for _, l := range col.Links {
							<a href={ templ.SafeURL(l.Href) } data-asta-nav-link class="group/link flex flex-col rounded-lg px-2 py-1.5 outline-none transition-[background-color,opacity] duration-200 hover:bg-paper-2 hover:!opacity-100 focus-visible:bg-paper-2 group-has-[a:hover]/menu:opacity-60">
								<span class="flex items-center gap-1 text-[13.5px] font-medium text-ink">
									{ l.Title }
									@ovIcon("m6 4 4 4-4 4", "h-3 w-3 -translate-x-1 text-mute opacity-0 transition-[translate,opacity] duration-300 "+navEase+" group-hover/link:translate-x-0 group-hover/link:opacity-100")
								</span>
								if l.Description != "" {
									<span class="text-[12px] leading-snug text-mute">{ l.Description }</span>
								}
							</a>
						}
					</div>
				}
				if m.Feature != nil {
					<a href={ templ.SafeURL(m.Feature.Href) } data-asta-nav-link class="group/feat relative flex min-h-[200px] flex-col justify-end overflow-hidden rounded-[10px] bg-brand p-4 text-white outline-none transition-opacity duration-300 hover:!opacity-100 focus-visible:ring-2 focus-visible:ring-brand/50 focus-visible:ring-offset-2 focus-visible:ring-offset-paper group-has-[a:hover]/menu:opacity-70">
						<span aria-hidden="true" class={ "absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/15 transition-transform duration-700 group-hover/feat:scale-125 " + navEase }></span>
						<span aria-hidden="true" class={ "absolute -right-2 top-12 h-20 w-20 rounded-full bg-white/10 transition-transform duration-700 group-hover/feat:-translate-x-3 " + navEase }></span>
						<span class="relative text-[15px] font-medium tracking-[-0.01em]">{ m.Feature.Title }</span>
						<span class="relative mt-1 text-[12.5px] leading-snug text-white/80">{ m.Feature.Description }</span>
						<span class="relative mt-3 flex items-center gap-1 text-[13px] font-medium">
							{ m.Feature.CTA }
							@ovIcon("m6 4 4 4-4 4", "h-3.5 w-3.5 transition-transform duration-300 "+navEase+" group-hover/feat:translate-x-0.5")
						</span>
					</a>
				}
			</div>
		}
	</div>
}

templ navTile(t NavTile, tall bool) {
	<a href={ templ.SafeURL(t.Href) } data-asta-nav-link class={ cx("group/tile relative flex flex-col gap-1.5 overflow-hidden rounded-[10px] bg-paper-2 p-4 outline-none transition-[opacity,background-color] duration-300 hover:!opacity-100 focus-visible:ring-2 focus-visible:ring-brand/50 group-has-[a:hover]/menu:opacity-55", or(when(tall, "min-h-[184px]"), "min-h-[92px]")) }>
		<span class="flex items-center gap-2 text-[14px] font-medium tracking-[-0.01em] text-ink">
			if t.Icon != nil {
				<span class={ "flex h-6 w-6 items-center justify-center rounded-md bg-paper text-ink [&_svg]:h-3.5 [&_svg]:w-3.5 " + navRing }>
					@t.Icon
				</span>
			}
			{ t.Title }
			@ovIcon("m6 4 4 4-4 4", "h-3.5 w-3.5 -translate-x-0.5 text-mute transition-[translate,color] duration-300 "+navEase+" group-hover/tile:translate-x-0 group-hover/tile:text-ink")
		</span>
		if t.Description != "" {
			<span class={ cx("text-[12.5px] leading-snug text-mute", when(tall, "max-w-[22ch]")) }>{ t.Description }</span>
		}
		if tall && t.Preview != "" {
			@navPreview(t.Preview)
		}
	</a>
}

const navBarCls = "rounded-full bg-[color-mix(in_srgb,var(--ink)_12%,transparent)] transition-colors duration-500"

templ navPreview(kind string) {
	<div aria-hidden="true" class={ "absolute -bottom-px -right-px h-[46%] w-[72%] rounded-tl-xl bg-paper p-3 transition-transform duration-500 group-hover/tile:-translate-x-1 group-hover/tile:-translate-y-1 " + navRing + " " + navEase }>
		switch kind {
			case "chart":
				<div class="flex h-full items-end gap-1.5">
					for i, h := range []int{40, 64, 52, 80, 70, 96} {
						<span class={ navBarCls + " w-full rounded-[3px] group-hover/tile:bg-brand" } style={ navBar(h, i*40) }></span>
					}
				</div>
			case "list":
				<div class="flex flex-col gap-2">
					for i, w := range []int{80, 56, 68} {
						<div class="flex items-center gap-2">
							<span class={ navBarCls + " h-3 w-3 shrink-0 group-hover/tile:bg-brand" } style={ navDelay(i * 60) }></span>
							<span class={ navBarCls + " h-1.5" } style={ navLine(w, 0) }></span>
						</div>
					}
				</div>
			default:
				<div class="flex flex-col gap-1.5">
					for i, ab := range [][2]int{{20, 50}, {36, 30}, {28, 44}, {20, 24}} {
						<div class="flex gap-1.5">
							<span class={ navBarCls + " h-1.5 group-hover/tile:bg-brand" } style={ navLine(ab[0], i*50) }></span>
							<span class={ navBarCls + " h-1.5" } style={ navLine(ab[1], 0) }></span>
						</div>
					}
				</div>
		}
	</div>
}
