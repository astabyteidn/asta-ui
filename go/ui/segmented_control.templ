package ui

// Segment is one option of a SegmentedControl.
type Segment struct {
	Value string
	Label string
	// Icon sits before the label.
	Icon templ.Component
}

// SegmentedControlProps configures SegmentedControl.
type SegmentedControlProps struct {
	// Name is the form field. Each segment is a native radio with this name.
	Name     string
	Segments []Segment
	// Value is the picked segment. Default: the first one.
	Value string
	// Size: "sm" or "md" (default).
	Size string
	// Full stretches the control to its parent's width, segments sharing it evenly.
	Full bool
	// Label is the accessible name of the group.
	Label string
	Class string
	// Attrs go on the root. With hx-post, add hx-trigger="change" and hx-include="this".
	Attrs templ.Attributes
}

const (
	segmentedRoot = "relative isolate inline-flex rounded-[10px] bg-paper-2 p-1 shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_6%,transparent)]"
	segmentedPill = "pointer-events-none absolute inset-0 -z-10 rounded-[7px] bg-paper opacity-0 peer-checked:opacity-100 " +
		"shadow-[0_1px_2px_rgb(0_0_0/0.08),0_3px_10px_-4px_rgb(0_0_0/0.18),inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_8%,transparent)]"
)

func segmentedValue(p SegmentedControlProps) string {
	for _, s := range p.Segments {
		if s.Value == p.Value {
			return p.Value
		}
	}
	if len(p.Segments) > 0 {
		return p.Segments[0].Value
	}
	return ""
}

// SegmentedControl is a row of native radios with a pill that slides to the picked one. While it travels it
// squashes a little and settles back. Arrow keys move and pick, like any radio group, and it posts with the form.
//
//	@ui.SegmentedControl(ui.SegmentedControlProps{Name: "view", Label: "View", Segments: []ui.Segment{{Value: "list", Label: "List"}, {Value: "board", Label: "Board"}}})
templ SegmentedControl(p SegmentedControlProps) {
	{{ cur := segmentedValue(p) }}
	<div
		role="radiogroup"
		data-asta-segmented
		if p.Label != "" {
			aria-label={ p.Label }
		}
		class={ cx(segmentedRoot, when(p.Full, "flex w-full"), p.Class) }
		{ p.Attrs... }
	>
		for _, s := range p.Segments {
			<label
				class={ cx("relative inline-flex cursor-pointer select-none items-center justify-center whitespace-nowrap rounded-[7px] font-medium tracking-[-0.01em] text-mute transition-colors duration-300 hover:text-ink has-[:checked]:text-ink",
					"has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-brand/50",
					or(when(p.Size == "sm", "h-8 px-3 text-[13px]"), "h-10 px-4 text-[14px]"), when(p.Full, "flex-1")) }
			>
				<input type="radio" name={ p.Name } value={ s.Value } checked?={ s.Value == cur } class="peer sr-only"/>
				<span aria-hidden="true" data-asta-ind class={ segmentedPill }></span>
				<span class="relative inline-flex items-center gap-1.5 [&_svg]:h-[1.05em] [&_svg]:w-[1.05em]">
					if s.Icon != nil {
						@s.Icon
					}
					{ s.Label }
				</span>
			</label>
		}
	</div>
}
