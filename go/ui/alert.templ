package ui

// AlertProps configures Alert. Every field is optional. The message goes in children.
type AlertProps struct {
	// Tone: "info" (default), "success", "warning" or "neutral".
	Tone  string
	Title string
	// Action is a button or link shown under the message.
	Action templ.Component
	// Icon replaces the tone icon.
	Icon templ.Component
	// NoIcon hides the icon.
	NoIcon bool
	// Dismissible shows a close button. It hides the alert with CSS only, so it comes back on reload.
	Dismissible bool
	// DismissAttrs go on the close control, e.g. hx-post to remember the dismissal. It fires on "change".
	DismissAttrs templ.Attributes
	Class        string
	Attrs        templ.Attributes
}

// The tone shows in the icon shape and the surface, never in hue: blue for info and success, ink for warnings.
var alertSurface = map[string]string{
	"info":    "bg-[color-mix(in_srgb,var(--brand)_7%,var(--paper))]",
	"success": "bg-paper-2",
	"warning": "bg-paper-2 shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_16%,transparent)]",
	"neutral": "bg-paper-2",
}

func alertRole(tone string) string {
	if tone == "warning" {
		return "alert"
	}
	return "status"
}

// Alert is an inline callout for something the reader should know. It rises in when it renders.
// Dismissing fades it out, then it leaves the layout.
//
//	@ui.Alert(ui.AlertProps{Tone: "success", Title: "Invite sent", Dismissible: true}) { We emailed the Astabyte team. }
templ Alert(p AlertProps) {
	<div
		role={ alertRole(p.Tone) }
		class={ cx("flex items-start gap-3 rounded-xl px-4 py-3.5",
			"animate-[asta-field-in_.36s_cubic-bezier(.16,1,.3,1)_backwards] motion-reduce:animate-none",
			"transition-[opacity,scale,display] transition-discrete duration-200 ease-[cubic-bezier(.16,1,.3,1)] motion-reduce:transition-none",
			"has-[[data-asta-dismiss]:checked]:hidden has-[[data-asta-dismiss]:checked]:scale-[.98] has-[[data-asta-dismiss]:checked]:opacity-0",
			pick(alertSurface, p.Tone, "info"), p.Class) }
		{ p.Attrs... }
	>
		if !p.NoIcon {
			<span class="mt-px flex shrink-0 text-ink">
				if p.Icon != nil {
					@p.Icon
				} else {
					@alertIcon(p.Tone)
				}
			</span>
		}
		<div class="min-w-0 flex-1 pt-px">
			if p.Title != "" {
				<p class="text-[13.5px] font-medium tracking-[-0.01em] text-ink">{ p.Title }</p>
			}
			<div class={ cx("text-[13px] leading-relaxed text-ink-2 empty:hidden", when(p.Title != "", "mt-0.5")) }>
				{ children... }
			</div>
			if p.Action != nil {
				<div class="mt-2.5 flex flex-wrap items-center gap-2">
					@p.Action
				</div>
			}
		</div>
		if p.Dismissible || p.DismissAttrs != nil {
			<label class="-mr-1.5 -mt-0.5 flex h-7 w-7 shrink-0 cursor-pointer items-center justify-center rounded-md text-mute transition-colors hover:bg-[color-mix(in_srgb,var(--ink)_7%,transparent)] hover:text-ink has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-brand/50">
				<input type="checkbox" data-asta-dismiss aria-label="Dismiss" class="sr-only" { p.DismissAttrs... }/>
				<svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
					<path d="m4 4 8 8M12 4l-8 8"></path>
				</svg>
			</label>
		}
	</div>
}

templ alertIcon(tone string) {
	switch tone {
		case "success":
			<svg viewBox="0 0 20 20" class="h-5 w-5" aria-hidden="true">
				<circle cx="10" cy="10" r="8" class="fill-brand"></circle>
				<path d="m6.6 10.2 2.3 2.3 4.5-5" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
			</svg>
		case "warning":
			<svg viewBox="0 0 20 20" class="h-5 w-5" aria-hidden="true">
				<path d="M10 2.8c.5 0 .9.25 1.15.68l6.3 11.1c.5.9-.14 2-1.15 2H3.7c-1 0-1.65-1.1-1.15-2l6.3-11.1c.25-.43.65-.68 1.15-.68z" class="fill-ink"></path>
				<path d="M10 7.4v4" class="stroke-paper" stroke-width="1.8" stroke-linecap="round"></path>
				<circle cx="10" cy="14" r="1" class="fill-paper"></circle>
			</svg>
		default:
			{{ c := or(when(tone == "neutral", "mute"), "brand") }}
			<svg viewBox="0 0 20 20" class="h-5 w-5" fill="none" aria-hidden="true">
				<circle cx="10" cy="10" r="7.6" stroke-width="1.6" class={ or(when(c == "mute", "stroke-mute"), "stroke-brand") }></circle>
				<path d="M10 9v4.4" stroke-width="1.7" stroke-linecap="round" class={ or(when(c == "mute", "stroke-mute"), "stroke-brand") }></path>
				<circle cx="10" cy="6.4" r="1" class={ or(when(c == "mute", "fill-mute"), "fill-brand") }></circle>
			</svg>
	}
}
