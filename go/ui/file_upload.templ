package ui

import (
	"fmt"
	"strconv"
	"strings"
)

// FileUploadProps configures FileUpload.
type FileUploadProps struct {
	// ID is the file input's id. Default "files".
	ID string
	// Name is the form field. The files post with the form; set enctype="multipart/form-data" (htmx: hx-encoding).
	Name string
	// Accept is the input's accept list: "image/*", "application/pdf", ".csv".
	Accept string
	// MaxSize is the largest file in bytes. Check it again on the server.
	MaxSize int64
	// MaxFiles is the most files allowed.
	MaxFiles int
	// Single takes one file. The default is several.
	Single bool
	// Label is the main line in the drop zone. Default "Drop files here or browse".
	Label string
	// Hint is the small line under it. Default: the accepted types and size limit.
	Hint     string
	Required bool
	Disabled bool
	Class    string
	// Attrs go on the file input.
	Attrs templ.Attributes
}

// FormatBytes prints a size the way FileUpload does: "820 B", "4.2 KB", "12 MB".
func FormatBytes(n int64) string {
	switch {
	case n < 1024:
		return strconv.FormatInt(n, 10) + " B"
	case n < 1024*1024:
		if n < 10240 {
			return fmt.Sprintf("%.1f KB", float64(n)/1024)
		}
		return fmt.Sprintf("%.0f KB", float64(n)/1024)
	}
	return fmt.Sprintf("%.1f MB", float64(n)/(1024*1024))
}

func uploadHint(p FileUploadProps) string {
	if p.Hint != "" {
		return p.Hint
	}
	var parts []string
	if p.Accept != "" {
		var types []string
		for _, a := range strings.Split(p.Accept, ",") {
			a = strings.TrimPrefix(strings.TrimSpace(a), ".")
			a = strings.TrimSuffix(a, "/*")
			if i := strings.Index(a, "/"); i >= 0 {
				a = a[i+1:]
			}
			if a != "" {
				types = append(types, strings.ToUpper(a))
			}
		}
		parts = append(parts, strings.Join(types, ", "))
	}
	if p.MaxSize > 0 {
		parts = append(parts, "up to "+FormatBytes(p.MaxSize))
	}
	if len(parts) == 0 {
		return "Any file"
	}
	return strings.Join(parts, " · ")
}

const (
	uploadZone = "group/drop relative flex cursor-pointer select-none flex-col items-center justify-center gap-3 rounded-xl px-6 py-9 text-center outline-none " +
		"transition-[transform,box-shadow,background-color] duration-300 ease-[cubic-bezier(.16,1,.3,1)] motion-reduce:transition-none has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-brand/50 " +
		"bg-paper-2 shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_8%,transparent)] hover:shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_18%,transparent)] " +
		"data-[over]:-translate-y-1 data-[over]:bg-[color-mix(in_srgb,var(--brand)_6%,var(--paper))] data-[over]:shadow-[inset_0_0_0_1.5px_var(--brand),0_14px_30px_-14px_color-mix(in_srgb,var(--brand)_55%,transparent)]"
)

// FileUpload is a drop zone on a native file input, so the files post with the form. Drag files over it (it lifts
// and turns blue) or click to browse. Each file gets a row with a remove button, and Accept, MaxSize and MaxFiles
// turn away what doesn't fit and say why. When an htmx request sends the form, the rows show its upload progress.
//
//	@ui.FileUpload(ui.FileUploadProps{Name: "files", Accept: "image/*,.pdf", MaxSize: 5 << 20, MaxFiles: 3})
templ FileUpload(p FileUploadProps) {
	{{ id := or(p.ID, "files") }}
	<div
		data-asta-upload
		data-accept={ p.Accept }
		data-max-size={ strconv.FormatInt(p.MaxSize, 10) }
		data-max-files={ strconv.Itoa(p.MaxFiles) }
		class={ cx("flex w-full flex-col", p.Class) }
	>
		<label data-asta-upload-zone class={ cx(uploadZone, when(p.Disabled, "pointer-events-none opacity-45")) }>
			<span class="flex h-11 w-11 items-center justify-center rounded-[10px] bg-paper text-ink-2 shadow-[0_0_0_1px_color-mix(in_srgb,var(--ink)_8%,transparent),0_2px_6px_-2px_rgb(0_0_0/0.12)] transition-[transform,color,box-shadow] duration-300 ease-[cubic-bezier(.16,1,.3,1)] group-hover/drop:-translate-y-0.5 group-data-[over]/drop:-translate-y-0.5 group-data-[over]/drop:scale-105 group-data-[over]/drop:text-brand">
				<svg viewBox="0 0 20 20" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M10 13V4M6.5 7.5 10 4l3.5 3.5"></path>
					<path d="M4 12.5v2A1.5 1.5 0 0 0 5.5 16h9a1.5 1.5 0 0 0 1.5-1.5v-2"></path>
				</svg>
			</span>
			<span class="block">
				<span class="block text-[14px] font-medium tracking-[-0.01em] text-ink">
					<span class="group-data-[over]/drop:hidden">
						if p.Label != "" {
							{ p.Label }
						} else {
							Drop files here or <span class="text-brand">browse</span>
						}
					</span>
					<span class="hidden group-data-[over]/drop:inline">Drop to upload</span>
				</span>
				<span id={ id + "-hint" } class="mt-1 block text-[12.5px] text-mute">{ uploadHint(p) }</span>
			</span>
			<input
				type="file"
				id={ id }
				name={ p.Name }
				if p.Accept != "" {
					accept={ p.Accept }
				}
				multiple?={ !p.Single }
				required?={ p.Required }
				disabled?={ p.Disabled }
				aria-describedby={ id + "-hint " + id + "-err" }
				data-asta-upload-input
				class="sr-only"
				{ p.Attrs... }
			/>
		</label>
		<p id={ id + "-err" } role="alert" hidden data-asta-upload-error class="mt-2 flex items-start gap-1.5 text-[12.5px] leading-snug text-ink">
			<svg viewBox="0 0 16 16" class="mt-px h-3.5 w-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
				<circle cx="8" cy="8" r="6"></circle>
				<path d="M8 5v3.5M8 11h0"></path>
			</svg>
			<span data-asta-upload-error-text></span>
		</p>
		<ul aria-label="Files" data-asta-upload-list class="mt-3 flex flex-col gap-1.5 empty:hidden"></ul>
		<template data-asta-upload-tpl>
			<li class="asta-upload-row group/row flex items-center gap-3 rounded-[10px] bg-paper p-2.5 pr-2 shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_9%,transparent)]" data-status="done">
				<span aria-hidden="true" data-ext class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-paper-2 text-[9.5px] font-semibold tracking-[0.02em] text-ink-2 transition-colors duration-300 group-data-[status=done]/row:bg-[color-mix(in_srgb,var(--brand)_10%,transparent)] group-data-[status=done]/row:text-brand"></span>
				<div class="min-w-0 flex-1">
					<div class="flex items-baseline justify-between gap-3">
						<p class="truncate text-[13px] font-medium text-ink" data-file-name></p>
						<p class="shrink-0 text-[12px] tabular-nums text-mute" aria-live="polite" data-file-meta></p>
					</div>
					<div role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="100" class="relative mt-1.5 h-1 overflow-hidden rounded-full bg-[color-mix(in_srgb,var(--ink)_8%,transparent)] transition-opacity duration-500 group-data-[status=done]/row:opacity-0">
						<span data-file-bar class="absolute inset-0 origin-left rounded-full bg-brand transition-transform duration-300 ease-[cubic-bezier(.16,1,.3,1)] group-data-[status=error]/row:bg-ink-2 motion-reduce:transition-none"></span>
					</div>
				</div>
				<button type="button" data-asta-upload-remove class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md text-mute outline-none transition-[background-color,color,transform] duration-150 hover:bg-paper-2 hover:text-ink focus-visible:ring-2 focus-visible:ring-brand/50 active:scale-90">
					<svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="m4.5 4.5 7 7M11.5 4.5l-7 7"></path></svg>
				</button>
			</li>
		</template>
	</div>
}
