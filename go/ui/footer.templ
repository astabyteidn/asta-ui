package ui

// FooterProps configures Footer.
type FooterProps struct {
	// Brand is the logo and name at the top left.
	Brand templ.Component
	// Wordmark is the big word along the bottom edge. Empty hides it.
	Wordmark string
	// Columns are the link columns.
	Columns []FooterColumn
	// Tagline is the line under the brand.
	Tagline string
	// Subscribe is the URL the newsletter form posts to (hx-post, field "email"). Empty fakes a success, for demos.
	Subscribe string
	// NoNewsletter hides the newsletter form.
	NoNewsletter bool
	// Legal is the small print row, e.g. a copyright and a few links.
	Legal templ.Component
	// Class is merged onto the root element.
	Class string
	// Attrs are spread onto the root element (hx-*, data-*).
	Attrs templ.Attributes
}

// FooterColumn is a headed list of Footer links.
type FooterColumn struct {
	// Heading is the small label above the links.
	Heading string
	// Links are the column's links.
	Links []NavLink
}

// NewsletterProps configures Newsletter.
type NewsletterProps struct {
	// ID is the email input's id. Default "newsletter-email".
	ID string
	// Action is the URL the form posts to with hx-post. Any 2xx shows the confirmation, anything else the error.
	// Empty fakes a success after a moment, for demos.
	Action string
	// Done is the confirmation text. Default "You're in. First letter lands next week."
	Done string
	// Class is merged onto the root element.
	Class string
	// Attrs go on the form, e.g. hx-vals or hx-headers.
	Attrs templ.Attributes
}

// Footer is a footer on an inverted panel: brand and newsletter, link columns, a legal row and a big wordmark
// whose letters lift near the pointer. Columns go 2-up below 620px of its own width.
//
//	@ui.Footer(ui.FooterProps{Brand: logo(), Wordmark: "Astabyte", Columns: cols, Subscribe: "/newsletter"})
templ Footer(p FooterProps) {
	<footer class={ cx("@container overflow-hidden rounded-2xl bg-ink px-6 pt-8 text-paper sm:px-8", p.Class) } { p.Attrs... }>
		<div class="grid gap-8 @min-[620px]:grid-cols-[1.3fr_2fr]">
			<div class="flex min-w-0 flex-col gap-4">
				if p.Brand != nil {
					<div class="flex items-center gap-2 text-[15px] font-semibold tracking-[-0.02em]">
						@p.Brand
					</div>
				}
				if p.Tagline != "" {
					<p class="max-w-[30ch] text-[13.5px] leading-relaxed text-paper/60">{ p.Tagline }</p>
				}
				if !p.NoNewsletter {
					@Newsletter(NewsletterProps{Action: p.Subscribe})
				}
			</div>
			<nav aria-label="Footer" class="grid grid-cols-2 gap-6 @min-[420px]:grid-cols-3">
				for _, c := range p.Columns {
					<div>
						<p class="text-[12px] text-paper/45">{ c.Heading }</p>
						<ul class="mt-3 flex flex-col gap-2">
							for _, l := range c.Links {
								<li>
									<a href={ templ.SafeURL(l.Href) } class="group/fl inline-flex items-center gap-1 rounded text-[13.5px] text-paper/80 outline-none transition-colors hover:text-paper focus-visible:ring-2 focus-visible:ring-brand/60">
										{ l.Label }
										<span aria-hidden="true" class="-translate-x-1 text-[11px] opacity-0 transition-[translate,opacity] duration-300 ease-[cubic-bezier(.16,1,.3,1)] group-hover/fl:translate-x-0 group-hover/fl:opacity-60">↗</span>
									</a>
								</li>
							}
						</ul>
					</div>
				}
			</nav>
		</div>
		if p.Legal != nil {
			<div class="mt-8 flex flex-wrap justify-between gap-2 text-[12px] text-paper/45">
				@p.Legal
			</div>
		}
		if p.Wordmark != "" {
			<div data-asta-wordmark aria-hidden="true" class="relative -mb-[0.18em] mt-6 flex select-none justify-center overflow-hidden pt-[0.1em] text-[clamp(3rem,19.5cqw,13rem)] font-semibold leading-[0.9] tracking-[-0.06em]">
				for _, r := range p.Wordmark {
					<span data-l class="inline-block text-[color-mix(in_srgb,var(--paper)_24%,var(--ink))] transition-transform duration-500 ease-[cubic-bezier(.16,1,.3,1)]">{ string(r) }</span>
				}
			</div>
		}
	</footer>
}

// Newsletter is an email field that turns into a confirmation in place. It checks the address before it posts,
// shows the button's spinner while the request runs, and an error if the server says no. It is styled for a
// dark surface such as Footer.
templ Newsletter(p NewsletterProps) {
	{{ id := or(p.ID, "newsletter-email") }}
	<div data-asta-newsletter data-state="idle" class={ cx("group/nl relative", p.Class) }>
		<form
			novalidate
			if p.Action != "" {
				hx-post={ p.Action }
				hx-swap="none"
				hx-indicator="find button"
			}
			class="flex h-11 items-center gap-1 rounded-[10px] bg-paper/10 p-1 pl-4 shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--paper)_14%,transparent)] transition-[opacity,transform,box-shadow] duration-500 ease-[cubic-bezier(.16,1,.3,1)] focus-within:shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--paper)_45%,transparent)] group-data-[state=done]/nl:pointer-events-none group-data-[state=done]/nl:-translate-y-2 group-data-[state=done]/nl:opacity-0 group-data-[state=error]/nl:shadow-[inset_0_0_0_1px_#e5484d]"
			{ p.Attrs... }
		>
			<label for={ id } class="sr-only">Email address</label>
			<input id={ id } type="email" name="email" placeholder="you@company.com" autocomplete="email" aria-describedby={ id + "-msg" } class="min-w-0 flex-1 bg-transparent text-[14px] text-paper outline-none placeholder:text-paper/40"/>
			@Button(ButtonProps{Type: "submit", Variant: "accent", Size: "sm", Pill: true, Class: "shadow-none"}) {
				Subscribe
			}
		</form>
		<p aria-hidden="true" data-asta-newsletter-done class="pointer-events-none absolute inset-0 flex translate-y-2 items-center gap-2 pl-1 text-[14px] text-paper opacity-0 transition-[opacity,transform] duration-500 ease-[cubic-bezier(.16,1,.3,1)] group-data-[state=done]/nl:pointer-events-auto group-data-[state=done]/nl:translate-y-0 group-data-[state=done]/nl:opacity-100">
			<span class="flex h-6 w-6 items-center justify-center rounded-full bg-brand text-white">
				<svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="m3.5 8.5 3 3 6-7" pathLength="1" stroke-dasharray="1" class="[stroke-dashoffset:1] transition-[stroke-dashoffset] delay-200 duration-500 group-data-[state=done]/nl:[stroke-dashoffset:0]"></path>
				</svg>
			</span>
			{ or(p.Done, "You're in. First letter lands next week.") }
		</p>
		<p id={ id + "-msg" } role="status" class="mt-2 h-4 text-[12px] text-[#ff8a8d]">
			<span class="hidden group-data-[state=error]/nl:inline">That doesn't look like an email address.</span>
			<span class="sr-only hidden group-data-[state=done]/nl:inline">{ or(p.Done, "You're in. First letter lands next week.") }</span>
		</p>
	</div>
}
