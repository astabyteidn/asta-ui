package ui

import "strconv"

// KanbanColumn is one column of a Kanban board.
type KanbanColumn struct {
	ID    string
	Title string
}

// KanbanCard is one card on a Kanban board. Cards show in the order you pass them.
type KanbanCard struct {
	ID string
	// Column is the ID of the column the card is in.
	Column string
	Title  string
	// Tag is a small label, e.g. "Design".
	Tag string
	// Assignee shows as an avatar with initials.
	Assignee string
	// Due is a short date label, e.g. "Nov 21".
	Due string
}

// KanbanProps configures Kanban.
type KanbanProps struct {
	// ID names the board. Optional.
	ID      string
	Columns []KanbanColumn
	Cards   []KanbanCard
	// MoveURL gets an hx-post after every drop, with card, column and position (0-based, among that column's cards).
	// The move shows at once; save it and answer 204, or re-render the board.
	MoveURL string
	// Label is the board's accessible name. Default "Board".
	Label string
	Class string
	// Attrs go on the board, a <form>. Add hx-target and hx-swap to swap in a re-rendered board, or hidden inputs.
	// The board fires "asta:move" with detail {card, column, position} on every drop, with or without MoveURL.
	Attrs templ.Attributes
}

func kanbanAttrs(p KanbanProps) templ.Attributes {
	a := templ.Attributes{}
	if p.MoveURL != "" {
		a["hx-post"] = p.MoveURL
		a["hx-trigger"] = "asta:move"
		a["hx-swap"] = "none"
	}
	for k, v := range p.Attrs {
		a[k] = v
	}
	return a
}

func kanbanHint(p KanbanProps) string { return or(p.ID, "asta-kanban") + "-hint" }

func kanbanIn(cards []KanbanCard, col string) []KanbanCard {
	out := []KanbanCard{}
	for _, c := range cards {
		if c.Column == col {
			out = append(out, c)
		}
	}
	return out
}

func kanbanGrid(n int) templ.SafeCSS {
	return templ.SafeCSS("grid-template-columns:repeat(" + strconv.Itoa(max(1, n)) + ",minmax(0,1fr))")
}

const kanbanCard = "rounded-[10px] bg-paper p-3 shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_9%,transparent),0_1px_2px_rgb(0_0_0/0.04)] " +
	"relative cursor-grab select-none outline-none focus-visible:ring-2 focus-visible:ring-brand/50 " +
	"data-[dragging]:opacity-40 " +
	"data-[picked]:z-10 data-[picked]:scale-[1.02] data-[picked]:!shadow-[inset_0_0_0_1.5px_var(--brand),0_14px_30px_-14px_rgb(0_0_0/0.3)] " +
	"transition-[scale,box-shadow,opacity] duration-300 ease-[cubic-bezier(.16,1,.3,1)] motion-reduce:transition-none"

	// Kanban is a board with columns of cards. Drag a card to another place (native drag and drop) and a gap opens
	// where it will land. With the keyboard: focus a card, Space picks it up, arrows move it, Space drops and Escape
	// cancels. Counts follow along, every move is announced, and each drop posts to MoveURL so your server keeps it.
	//
	//	@ui.Kanban(ui.KanbanProps{MoveURL: "/board/move",
	//		Columns: []ui.KanbanColumn{{ID: "todo", Title: "To do"}, {ID: "done", Title: "Done"}},
	//		Cards:   []ui.KanbanCard{{ID: "c1", Column: "todo", Title: "Write the Astabyte launch post", Tag: "Copy"}}})

templ Kanban(p KanbanProps) {
	<form
		data-asta-kanban
		if p.ID != "" {
			id={ p.ID }
		}
		aria-label={ or(p.Label, "Board") }
		class={ cx("asta-kanban w-full overflow-x-auto", p.Class) }
		{ kanbanAttrs(p)... }
	>
		<input type="hidden" name="card" value="" data-asta-kanban-field="card"/>
		<input type="hidden" name="column" value="" data-asta-kanban-field="column"/>
		<input type="hidden" name="position" value="" data-asta-kanban-field="position"/>
		<p class="sr-only" id={ kanbanHint(p) }>Press Space to pick up a card. Use the arrow keys to move it, Space to drop, Escape to cancel.</p>
		<p class="sr-only" aria-live="polite" data-asta-kanban-status></p>
		<div class="relative grid min-w-[620px] gap-3 pb-1" style={ kanbanGrid(len(p.Columns)) }>
			for _, col := range p.Columns {
				{{ list := kanbanIn(p.Cards, col.ID) }}
				<section aria-label={ col.Title } data-asta-kanban-col={ col.ID } class="flex min-h-[340px] flex-col rounded-xl bg-paper-2 p-2">
					<header class="flex items-center gap-2 px-1.5 pb-2.5 pt-1">
						<h4 class="text-[13px] font-medium text-ink">{ col.Title }</h4>
						<span data-asta-kanban-count class="text-[12px] tabular-nums text-mute">{ strconv.Itoa(len(list)) }</span>
					</header>
					<ul data-asta-kanban-list class="relative flex flex-1 flex-col gap-2">
						for _, c := range list {
							<li
								data-asta-kanban-card={ c.ID }
								data-title={ c.Title }
								draggable="true"
								tabindex="0"
								aria-roledescription="draggable card"
								aria-describedby={ kanbanHint(p) }
								class={ kanbanCard }
							>
								<p class="text-[13.5px] leading-snug text-ink">{ c.Title }</p>
								if c.Tag != "" || c.Assignee != "" || c.Due != "" {
									<div class="mt-3 flex items-center gap-2 text-[11.5px] text-mute">
										if c.Tag != "" {
											<span class="rounded-md bg-paper-2 px-1.5 leading-5">{ c.Tag }</span>
										}
										if c.Due != "" {
											<span class="tabular-nums">{ c.Due }</span>
										}
										if c.Assignee != "" {
											@Avatar(AvatarProps{Name: c.Assignee, Size: "xs", Class: "ml-auto"})
										}
									</div>
								}
							</li>
						}
					</ul>
				</section>
			}
		</div>
	</form>
}
