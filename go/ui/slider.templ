package ui

import "strconv"

// SliderProps configures Slider. Attrs go on the native <input type="range"> (hx-post, hx-trigger…).
type SliderProps struct {
	ID    string
	Name  string
	Value float64
	// Min defaults to 0.
	Min float64
	// Max defaults to 100.
	Max float64
	// Step defaults to 1.
	Step float64
	// Ticks draws this many evenly spaced marks under the track.
	Ticks int
	// Label is the accessible name, for sliders without a visible label.
	Label string
	// ValueText is read by screen readers instead of the number, e.g. "40 percent".
	ValueText string
	Disabled  bool
	// Class goes on the wrapper.
	Class string
	Attrs templ.Attributes
}

func sliderNum(f float64) string { return strconv.FormatFloat(f, 'f', -1, 64) }

func sliderMax(p SliderProps) float64 {
	if p.Max <= p.Min {
		return p.Min + 100
	}
	return p.Max
}

func sliderStep(p SliderProps) float64 {
	if p.Step <= 0 {
		return 1
	}
	return p.Step
}

// sliderFill is the filled share of the track as a CSS variable, so Chrome and Safari can paint it before any script runs.
func sliderFill(p SliderProps) templ.SafeCSS {
	lo, hi := p.Min, sliderMax(p)
	f := (min(max(p.Value, lo), hi) - lo) / (hi - lo) * 100
	return templ.SafeCSS("--asta-fill:" + strconv.FormatFloat(f, 'f', 2, 64) + "%")
}

func sliderTick(i, n int) templ.SafeCSS {
	return templ.SafeCSS("left:" + strconv.FormatFloat(float64(i)/float64(n-1)*100, 'f', 2, 64) + "%")
}

const (
	sliderInput = "block h-6 w-full cursor-pointer appearance-none bg-transparent outline-none disabled:cursor-not-allowed disabled:opacity-45 " +
		// WebKit and Blink
		"[&::-webkit-slider-runnable-track]:h-1.5 [&::-webkit-slider-runnable-track]:rounded-full [&::-webkit-slider-runnable-track]:bg-[linear-gradient(to_right,var(--brand)_var(--asta-fill,0%),color-mix(in_srgb,var(--ink)_12%,transparent)_var(--asta-fill,0%))] " +
		"[&::-webkit-slider-thumb]:-mt-[7px] [&::-webkit-slider-thumb]:h-5 [&::-webkit-slider-thumb]:w-5 [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:bg-white " +
		"[&::-webkit-slider-thumb]:shadow-[0_0_0_1px_color-mix(in_srgb,var(--ink)_14%,transparent),0_1px_3px_rgb(0_0_0/0.2),0_4px_10px_-2px_rgb(0_0_0/0.2)] " +
		"[&::-webkit-slider-thumb]:transition-[scale] [&::-webkit-slider-thumb]:duration-300 [&::-webkit-slider-thumb]:ease-[cubic-bezier(.16,1,.3,1)] motion-reduce:[&::-webkit-slider-thumb]:transition-none " +
		"hover:[&::-webkit-slider-thumb]:scale-105 active:[&::-webkit-slider-thumb]:scale-110 " +
		"focus-visible:[&::-webkit-slider-thumb]:ring-4 focus-visible:[&::-webkit-slider-thumb]:ring-brand/30 " +
		// Firefox
		"[&::-moz-range-track]:h-1.5 [&::-moz-range-track]:rounded-full [&::-moz-range-track]:bg-[color-mix(in_srgb,var(--ink)_12%,transparent)] " +
		"[&::-moz-range-progress]:h-1.5 [&::-moz-range-progress]:rounded-full [&::-moz-range-progress]:bg-brand " +
		"[&::-moz-range-thumb]:h-5 [&::-moz-range-thumb]:w-5 [&::-moz-range-thumb]:rounded-full [&::-moz-range-thumb]:border-0 [&::-moz-range-thumb]:bg-white " +
		"[&::-moz-range-thumb]:shadow-[0_0_0_1px_color-mix(in_srgb,var(--ink)_14%,transparent),0_1px_3px_rgb(0_0_0/0.2),0_4px_10px_-2px_rgb(0_0_0/0.2)] " +
		"[&::-moz-range-thumb]:transition-[scale] [&::-moz-range-thumb]:duration-300 [&::-moz-range-thumb]:ease-[cubic-bezier(.16,1,.3,1)] motion-reduce:[&::-moz-range-thumb]:transition-none " +
		"hover:[&::-moz-range-thumb]:scale-105 active:[&::-moz-range-thumb]:scale-110 " +
		"focus-visible:[&::-moz-range-thumb]:ring-4 focus-visible:[&::-moz-range-thumb]:ring-brand/30"
)

// Slider is a native range input with the kit's track and thumb.
// The track fills up to the thumb: natively in Firefox, through a --asta-fill variable in Chrome and Safari that the
// server sets and asta.js keeps in step while dragging.
// The React value bubble needs JavaScript too, so it is left out. Show the value next to the slider if it matters.
//
//	@ui.Slider(ui.SliderProps{ID: "volume", Name: "volume", Value: 40, Label: "Volume"})
templ Slider(p SliderProps) {
	<div class={ cx("relative w-full select-none", p.Class) } style={ sliderFill(p) }>
		<input
			type="range"
			data-asta-slider
			if p.ID != "" {
				id={ p.ID }
			}
			if p.Name != "" {
				name={ p.Name }
			}
			min={ sliderNum(p.Min) }
			max={ sliderNum(sliderMax(p)) }
			step={ sliderNum(sliderStep(p)) }
			value={ sliderNum(p.Value) }
			if p.Label != "" {
				aria-label={ p.Label }
			}
			if p.ValueText != "" {
				aria-valuetext={ p.ValueText }
			}
			disabled?={ p.Disabled }
			class={ sliderInput }
			{ p.Attrs... }
		/>
		if p.Ticks > 1 {
			<div aria-hidden="true" class="pointer-events-none relative mx-[10px] h-1">
				for i := 0; i < p.Ticks; i++ {
					<span class="absolute top-0 h-1 w-1 -translate-x-1/2 rounded-full bg-[color-mix(in_srgb,var(--ink)_28%,transparent)]" style={ sliderTick(i, p.Ticks) }></span>
				}
			</div>
		}
	</div>
}
