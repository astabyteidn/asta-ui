package ui

import "strconv"

// OtpInputProps configures OtpInput.
type OtpInputProps struct {
	ID string
	// Name is the form field. One real input holds the whole code.
	Name string
	// Length is the number of boxes. Default 6.
	Length int
	Value  string
	// Letters allows letters too (upper-cased). By default only digits are accepted.
	Letters bool
	// Error marks the code as wrong. The boxes shake once when it renders, e.g. after an htmx swap.
	Error    bool
	Disabled bool
	// GroupSize puts a small dash after every N boxes, e.g. 3 for "123–456".
	GroupSize int
	// Label is the accessible name. Default "One-time code".
	Label string
	Class string
	// Attrs go on the input. It fires "asta:complete" once every box is filled, so
	// hx-post with hx-trigger="asta:complete" checks the code as soon as it is typed.
	Attrs templ.Attributes
}

func otpLen(p OtpInputProps) int {
	if p.Length <= 0 {
		return 6
	}
	return p.Length
}

func otpChars(p OtpInputProps) []string {
	n := otpLen(p)
	out := make([]string, n)
	i := 0
	for _, r := range p.Value {
		if i >= n {
			break
		}
		out[i] = string(r)
		i++
	}
	return out
}

func otpValue(p OtpInputProps) string {
	r := []rune(p.Value)
	if len(r) > otpLen(p) {
		r = r[:otpLen(p)]
	}
	return string(r)
}

// otpBox is the box ring. forms.js sets data-state on each box as you type: active, filled, full or error.
const otpBox = "grid h-12 w-10 place-items-center rounded-[10px] bg-paper text-[22px] font-medium tabular-nums tracking-[-0.02em] text-ink transition-shadow duration-200 sm:h-14 sm:w-12 sm:text-[24px] " +
	"shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_14%,transparent)] " +
	"data-[state=filled]:shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_26%,transparent)] " +
	"data-[state=full]:shadow-[inset_0_0_0_1.5px_color-mix(in_srgb,var(--brand)_55%,transparent)] " +
	"data-[state=active]:shadow-[inset_0_0_0_1.5px_var(--brand),0_0_0_4px_color-mix(in_srgb,var(--brand)_16%,transparent)] " +
	"data-[state=error]:shadow-[inset_0_0_0_1.5px_var(--ink)]"

func otpState(p OtpInputProps, ch string) string {
	switch {
	case p.Error:
		return "error"
	case len([]rune(otpValue(p))) == otpLen(p):
		return "full"
	case ch != "":
		return "filled"
	}
	return ""
}

// OtpInput is a one-time code input. One real input sits over the boxes, so typing, Backspace, paste and the
// phone's SMS autofill all just work. Digits drop in, the active box blinks a caret, a full code makes the boxes
// wave, and Error shakes them.
//
//	@ui.OtpInput(ui.OtpInputProps{Name: "code", GroupSize: 3, Attrs: templ.Attributes{"hx-post": "/verify", "hx-trigger": "asta:complete"}})
templ OtpInput(p OtpInputProps) {
	<div data-asta-otp class={ cx("relative inline-flex", when(p.Disabled, "opacity-45"), p.Class) }>
		<div aria-hidden="true" data-asta-otp-boxes class={ cx("flex items-center gap-2", when(p.Error, "asta-otp-shake")) }>
			for i, ch := range otpChars(p) {
				if p.GroupSize > 0 && i > 0 && i%p.GroupSize == 0 {
					<span class="mx-0.5 h-[2px] w-2.5 rounded-full bg-[color-mix(in_srgb,var(--ink)_22%,transparent)]"></span>
				}
				<span class="block" data-asta-otp-wave style={ otpDelay(i) }>
					<span class={ otpBox } data-asta-otp-box data-state={ otpState(p, ch) }>{ ch }</span>
				</span>
			}
		</div>
		<input
			if p.ID != "" {
				id={ p.ID }
			}
			name={ p.Name }
			value={ otpValue(p) }
			maxlength={ strconv.Itoa(otpLen(p)) }
			if p.Letters {
				inputmode="text"
				autocapitalize="characters"
				data-letters
			} else {
				inputmode="numeric"
				pattern="[0-9]*"
			}
			autocomplete="one-time-code"
			spellcheck="false"
			aria-label={ or(p.Label, "One-time code") }
			if p.Error {
				aria-invalid="true"
			}
			disabled?={ p.Disabled }
			class="absolute inset-0 h-full w-full cursor-text bg-transparent text-[16px] text-transparent caret-transparent opacity-0 outline-none disabled:cursor-not-allowed"
			{ p.Attrs... }
		/>
	</div>
}

func otpDelay(i int) templ.SafeCSS {
	return templ.SafeCSS("--asta-otp-i:" + strconv.Itoa(i*45) + "ms")
}
