package ui

// ButtonProps configures Button. Every field is optional.
type ButtonProps struct {
	// Variant: "solid" (default), "accent", "outline", "soft", "ghost", "link" or "danger".
	Variant string
	// Size: "xs", "sm", "md" (default) or "lg".
	Size string
	// Pill rounds the button fully.
	Pill bool
	// IconOnly makes a square button for a single icon. Give it an aria-label in Attrs.
	IconOnly bool
	// Loading shows a spinner over the label. htmx requests show it too, on their own.
	Loading  bool
	Disabled bool
	// Href renders an <a> instead of a <button>.
	Href string
	// Type is the button type. Default "button". Use "submit" inside a form.
	Type      string
	IconLeft  templ.Component
	IconRight templ.Component
	// Nudge slides IconRight a little on hover.
	Nudge bool
	// Kbd is a keyboard hint at the end, e.g. "⌘K".
	Kbd   string
	Class string
	// Attrs go on the element as is: hx-post, hx-target, aria-label, name, value…
	Attrs templ.Attributes
}

const buttonBase = "group/btn relative inline-flex shrink-0 select-none items-center [&_svg]:shrink-0 justify-center whitespace-nowrap font-medium tracking-[-0.01em] outline-none " +
	"transition-[background-color,color,box-shadow,transform,opacity] duration-200 ease-out active:scale-[0.97] " +
	"focus-visible:ring-2 focus-visible:ring-brand/50 focus-visible:ring-offset-2 focus-visible:ring-offset-paper " +
	"disabled:pointer-events-none disabled:opacity-45 aria-disabled:pointer-events-none aria-disabled:opacity-45 [&.htmx-request]:pointer-events-none"

// A light top edge and a soft drop give the filled buttons a little body without a gradient.
const buttonLift = "shadow-[inset_0_1px_0_rgb(255_255_255/0.18),0_1px_2px_rgb(0_0_0/0.16),0_6px_14px_-8px_rgb(0_0_0/0.45)]"

var buttonVariant = map[string]string{
	"solid":  "bg-ink text-paper " + buttonLift + " hover:bg-[color-mix(in_srgb,var(--ink)_84%,var(--paper))]",
	"accent": "bg-brand text-white " + buttonLift + " hover:bg-[color-mix(in_srgb,var(--brand)_88%,black)]",
	"danger": "bg-[#e5484d] text-white " + buttonLift + " hover:bg-[#d13d42]",
	"outline": "bg-paper text-ink shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_14%,transparent),0_1px_2px_rgb(0_0_0/0.05)] " +
		"hover:bg-paper-2 hover:shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_24%,transparent),0_1px_2px_rgb(0_0_0/0.05)]",
	"soft":  "bg-paper-2 text-ink hover:bg-[color-mix(in_srgb,var(--ink)_8%,var(--paper-2))]",
	"ghost": "text-ink-2 hover:bg-paper-2 hover:text-ink",
	"link": "!h-auto !px-0 text-ink bg-[linear-gradient(currentColor,currentColor)] bg-[length:0%_1px] bg-[position:0_100%] bg-no-repeat " +
		"transition-[background-size,color] duration-300 hover:bg-[length:100%_1px] active:scale-100",
}

var buttonSize = map[string]string{
	"xs": "h-7 gap-1.5 rounded-md px-2.5 text-[12px]",
	"sm": "h-8 gap-1.5 rounded-md px-3 text-[13px]",
	"md": "h-10 gap-2 rounded-lg px-4 text-[14px]",
	"lg": "h-12 gap-2.5 rounded-[9px] px-5 text-[15px]",
}

var buttonIconOnly = map[string]string{"xs": "w-7 !px-0", "sm": "w-8 !px-0", "md": "w-10 !px-0", "lg": "w-12 !px-0"}

// ButtonClass returns the classes of a button, for elements you render yourself.
func ButtonClass(p ButtonProps) string {
	return cx(buttonBase, pick(buttonSize, p.Size, "md"), pick(buttonVariant, p.Variant, "solid"),
		when(p.IconOnly, pick(buttonIconOnly, p.Size, "md")), when(p.Pill, "!rounded-full"), p.Class)
}

func buttonFilled(v string) bool { return v == "" || v == "solid" || v == "accent" || v == "danger" }

// Button is a button, or a link styled as one when Href is set.
//
//	@ui.Button(ui.ButtonProps{Variant: "accent", Attrs: templ.Attributes{"hx-post": "/save"}}) { Save }
templ Button(p ButtonProps) {
	if p.Href != "" {
		<a href={ templ.SafeURL(p.Href) } class={ ButtonClass(p) } aria-disabled?={ p.Loading || p.Disabled } aria-busy?={ p.Loading } { p.Attrs... }>
			@buttonContent(p) {
				{ children... }
			}
		</a>
	} else {
		<button type={ or(p.Type, "button") } class={ ButtonClass(p) } disabled?={ p.Disabled || p.Loading } aria-busy?={ p.Loading } { p.Attrs... }>
			@buttonContent(p) {
				{ children... }
			}
		</button>
	}
}

templ buttonContent(p ButtonProps) {
	<span class={ cx("inline-flex items-center gap-[inherit] transition-opacity duration-200 [&>svg]:h-[1.15em] [&>svg]:w-[1.15em] group-[.htmx-request]/btn:opacity-0", when(p.Loading, "opacity-0")) }>
		if p.IconLeft != nil {
			<span class="-ml-0.5 inline-flex shrink-0 [&_svg]:h-[1.1em] [&_svg]:w-[1.1em]">
				@p.IconLeft
			</span>
		}
		{ children... }
		if p.IconRight != nil {
			<span class={ cx("-mr-0.5 inline-flex shrink-0 [&_svg]:h-[1.1em] [&_svg]:w-[1.1em]", when(p.Nudge, "transition-transform duration-300 ease-[cubic-bezier(.16,1,.3,1)] group-hover/btn:translate-x-0.5")) }>
				@p.IconRight
			</span>
		}
		if p.Kbd != "" {
			<kbd class={ cx("-mr-1.5 ml-1 rounded-md px-1.5 font-sans text-[0.8em] leading-[1.6]", buttonKbd(p.Variant)) }>{ p.Kbd }</kbd>
		}
	</span>
	<span class={ cx("pointer-events-none absolute inset-0 flex items-center justify-center transition-opacity duration-200 group-[.htmx-request]/btn:opacity-100", when(!p.Loading, "opacity-0")) } aria-hidden="true">
		@spinnerIcon("h-4 w-4")
	</span>
}

func buttonKbd(v string) string {
	if buttonFilled(v) {
		return "bg-white/15 text-current"
	}
	return "bg-[color-mix(in_srgb,var(--ink)_7%,transparent)] text-mute"
}

templ spinnerIcon(class string) {
	<svg viewBox="0 0 16 16" class={ cx("animate-spin", class) } fill="none" aria-hidden="true">
		<circle cx="8" cy="8" r="6" stroke="currentColor" stroke-opacity="0.25" stroke-width="2"></circle>
		<path d="M14 8a6 6 0 0 0-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
	</svg>
}
