package ui

import (
	"strconv"
	"strings"
)

// ColorSwatch is one colour of a ColorPicker.
type ColorSwatch struct {
	// Value is a hex colour, e.g. "#2f54eb".
	Value string
	// Name is read to screen readers and shown on hover, e.g. "Ocean".
	Name string
}

// DefaultColorSwatches are the swatches ColorPicker shows when Swatches is nil.
var DefaultColorSwatches = []ColorSwatch{
	{"#111113", "Ink"}, {"#52525b", "Graphite"}, {"#a1a1aa", "Stone"}, {"#e4e4e7", "Mist"}, {"#2f54eb", "Blue"},
	{"#4f8ef7", "Sky"}, {"#93b4ff", "Haze"}, {"#5b5bd6", "Indigo"}, {"#7c5cd6", "Violet"}, {"#b4a7e8", "Lilac"},
}

// ColorPickerProps configures ColorPicker.
type ColorPickerProps struct {
	// ID prefixes the ids inside. Default "color".
	ID string
	// Name is the form field. It posts the picked colour as lowercase #rrggbb.
	Name string
	// Value is the picked colour. Default: the first swatch.
	Value    string
	Swatches []ColorSwatch
	// NoCustom hides the hex field for a custom colour.
	NoCustom bool
	// Columns is the number of swatches per row. Default 5.
	Columns int
	// Size: "sm" or "md" (default).
	Size string
	// Label is the accessible name, e.g. "Label colour". Default "Colour".
	Label    string
	Disabled bool
	Class    string
	// Attrs go on the root. With hx-post, add hx-trigger="change" and hx-include="this".
	Attrs templ.Attributes
}

// ParseHex reads "#abc", "abc", "#aabbcc" or "aabbcc" as lowercase "#aabbcc". It returns "" when s isn't a hex colour.
func ParseHex(s string) string {
	s = strings.ToLower(strings.TrimPrefix(strings.TrimSpace(s), "#"))
	for _, c := range s {
		if !strings.ContainsRune("0123456789abcdef", c) {
			return ""
		}
	}
	switch len(s) {
	case 3:
		return "#" + string([]byte{s[0], s[0], s[1], s[1], s[2], s[2]})
	case 6:
		return "#" + s
	}
	return ""
}

func colorSwatches(p ColorPickerProps) []ColorSwatch {
	src := p.Swatches
	if src == nil {
		src = DefaultColorSwatches
	}
	out := make([]ColorSwatch, len(src))
	for i, s := range src {
		out[i] = ColorSwatch{or(ParseHex(s.Value), s.Value), s.Name}
	}
	return out
}

func colorValue(p ColorPickerProps) string {
	if v := ParseHex(p.Value); v != "" {
		return v
	}
	if sw := colorSwatches(p); len(sw) > 0 {
		return sw[0].Value
	}
	return "#000000"
}

func colorCustom(p ColorPickerProps) bool {
	v := colorValue(p)
	for _, s := range colorSwatches(p) {
		if s.Value == v {
			return false
		}
	}
	return true
}

// colorLight is true for pale swatches, which get a hairline so they don't vanish on a white ground.
func colorLight(hex string) bool {
	n, err := strconv.ParseUint(strings.TrimPrefix(hex, "#"), 16, 32)
	if err != nil || len(hex) != 7 {
		return false
	}
	r, g, b := float64(n>>16&255), float64(n>>8&255), float64(n&255)
	return 0.2126*r+0.7152*g+0.0722*b > 200
}

func colorGrid(p ColorPickerProps) templ.SafeCSS {
	cols := colorCols(p)
	px, gap := "28px", "10px"
	if p.Size == "sm" {
		px, gap = "22px", "8px"
	}
	return templ.SafeCSS("grid-template-columns:repeat(" + strconv.Itoa(cols) + "," + px + ");gap:" + gap)
}

func colorBg(hex string) templ.SafeCSS {
	if ParseHex(hex) == "" {
		return ""
	}
	return templ.SafeCSS("background:" + hex)
}

const (
	colorRing = "pointer-events-none absolute -inset-[4px] scale-75 rounded-full opacity-0 shadow-[0_0_0_1.5px_var(--ink)] transition-[opacity,scale] duration-300 ease-[cubic-bezier(.16,1,.3,1)] motion-reduce:transition-none " +
		"peer-checked:scale-100 peer-checked:opacity-100 " +
		"peer-focus-visible:scale-100 peer-focus-visible:opacity-100 peer-focus-visible:shadow-[0_0_0_1.5px_var(--brand),0_0_0_4px_color-mix(in_srgb,var(--brand)_22%,transparent)]"
)

// ColorPicker is a calm swatch picker on native radios, so it posts with the form. The ring around the picked swatch
// scales in, arrow keys move through the grid, and the hex field takes any colour: it previews as you type and only
// commits a valid hex.
//
//	@ui.ColorPicker(ui.ColorPickerProps{Name: "color", Value: "#2f54eb", Label: "Label colour"})
templ ColorPicker(p ColorPickerProps) {
	{{ id, cur, custom := or(p.ID, "color"), colorValue(p), colorCustom(p) }}
	<div
		data-asta-color
		data-columns={ strconv.Itoa(colorCols(p)) }
		class={ cx("inline-flex flex-col gap-3", when(p.Disabled, "pointer-events-none opacity-50"), p.Class) }
		{ p.Attrs... }
	>
		<div role="radiogroup" aria-label={ or(p.Label, "Colour") } class="grid w-max" style={ colorGrid(p) }>
			for _, s := range colorSwatches(p) {
				<label
					title={ or(s.Name, s.Value) }
					class={ cx("relative cursor-pointer rounded-full transition-[scale] duration-200 ease-[cubic-bezier(.16,1,.3,1)] hover:scale-110 active:scale-95 motion-reduce:transition-none",
						or(when(p.Size == "sm", "h-[22px] w-[22px]"), "h-7 w-7")) }
				>
					<input
						type="radio"
						name={ p.Name }
						value={ s.Value }
						checked?={ s.Value == cur }
						disabled?={ p.Disabled }
						aria-label={ colorAria(s) }
						class="peer sr-only"
					/>
					<span aria-hidden="true" class={ colorRing }></span>
					<span aria-hidden="true" class={ cx("absolute inset-0 rounded-full", when(colorLight(s.Value), "shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_14%,transparent)]")) } style={ colorBg(s.Value) }></span>
				</label>
			}
			<input type="radio" name={ p.Name } value={ when(custom, cur) } checked?={ custom } disabled?={ p.Disabled } hidden data-asta-color-custom tabindex="-1" aria-hidden="true"/>
		</div>
		if !p.NoCustom {
			<div class="flex items-center gap-2.5">
				<span
					aria-hidden="true"
					data-asta-color-preview
					class="relative grid h-8 w-8 shrink-0 place-items-center rounded-[8px] text-[12px] text-transparent shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_12%,transparent)] transition-[background-color] duration-200 data-[empty]:text-mute"
					style={ colorBg(cur) }
				>?</span>
				<label for={ id + "-hex" } class="sr-only">Custom hex colour</label>
				<div class="flex h-8 min-w-0 flex-1 items-center rounded-[8px] bg-paper-2 pl-2.5 shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_8%,transparent)] transition-shadow duration-200 focus-within:shadow-[inset_0_0_0_1.5px_var(--brand)]">
					<span aria-hidden="true" class="text-[13px] text-mute">#</span>
					<input
						id={ id + "-hex" }
						value={ strings.TrimPrefix(cur, "#") }
						data-asta-color-hex
						spellcheck="false"
						autocomplete="off"
						maxlength="7"
						placeholder="2F54EB"
						disabled?={ p.Disabled }
						aria-describedby={ id + "-hint" }
						class="h-full w-full min-w-0 bg-transparent pl-1 pr-2.5 font-mono text-[13px] uppercase tracking-[0.02em] text-ink outline-none placeholder:text-mute"
					/>
				</div>
				<span id={ id + "-hint" } aria-live="polite" data-asta-color-hint class="w-14 text-[12px] text-mute opacity-0 transition-opacity duration-200 data-[on]:opacity-100"></span>
			</div>
		}
	</div>
}

func colorAria(s ColorSwatch) string {
	if s.Name != "" {
		return s.Name + ", " + s.Value
	}
	return s.Value
}

func colorCols(p ColorPickerProps) int {
	if p.Columns <= 0 {
		return 5
	}
	return p.Columns
}
