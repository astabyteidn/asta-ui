package ui

// SpinnerProps configures Spinner. Every field is optional.
type SpinnerProps struct {
	// Variant: "ring" (default), "dots", "bars" or "orbit".
	Variant string
	// Label is read by screen readers. Default "Loading".
	Label string
	// Class sizes it. By default it is 1em, so it follows the font size.
	Class string
	Attrs templ.Attributes
}

// Spinner is a loader in currentColor. With reduced motion it slows right down instead of stopping.
//
//	@ui.Spinner(ui.SpinnerProps{Variant: "dots", Class: "h-5 w-5 text-brand"})
templ Spinner(p SpinnerProps) {
	<span role="status" aria-label={ or(p.Label, "Loading") } class={ cx("relative inline-flex h-[1em] w-[1em] shrink-0 items-center justify-center motion-reduce:[&_*]:![animation-duration:2.4s]", p.Class) } { p.Attrs... }>
		switch p.Variant {
			case "dots":
				<span class="flex h-full w-full items-center justify-between" aria-hidden="true">
					<span class="h-[26%] w-[26%] rounded-full bg-current animate-[asta-spinner-dot_1.1s_cubic-bezier(.16,1,.3,1)_infinite]"></span>
					<span class="h-[26%] w-[26%] rounded-full bg-current animate-[asta-spinner-dot_1.1s_cubic-bezier(.16,1,.3,1)_infinite] [animation-delay:.16s]"></span>
					<span class="h-[26%] w-[26%] rounded-full bg-current animate-[asta-spinner-dot_1.1s_cubic-bezier(.16,1,.3,1)_infinite] [animation-delay:.32s]"></span>
				</span>
			case "bars":
				<span class="flex h-[80%] w-full items-center justify-between" aria-hidden="true">
					<span class="h-full w-[16%] rounded-full bg-current animate-[asta-spinner-bar_.9s_ease-in-out_infinite]"></span>
					<span class="h-full w-[16%] rounded-full bg-current animate-[asta-spinner-bar_.9s_ease-in-out_infinite] [animation-delay:.12s]"></span>
					<span class="h-full w-[16%] rounded-full bg-current animate-[asta-spinner-bar_.9s_ease-in-out_infinite] [animation-delay:.24s]"></span>
					<span class="h-full w-[16%] rounded-full bg-current animate-[asta-spinner-bar_.9s_ease-in-out_infinite] [animation-delay:.36s]"></span>
				</span>
			case "orbit":
				<span class="relative h-full w-full" aria-hidden="true">
					<span class="absolute inset-[30%] rounded-full bg-current opacity-25"></span>
					<span class="absolute inset-0 animate-[spin_1.2s_cubic-bezier(.6,.1,.4,.9)_infinite]">
						<span class="absolute left-1/2 top-0 h-[24%] w-[24%] -translate-x-1/2 rounded-full bg-current"></span>
					</span>
					<span class="absolute inset-0 animate-[spin_1.8s_linear_infinite_reverse]">
						<span class="absolute bottom-[6%] left-1/2 h-[16%] w-[16%] -translate-x-1/2 rounded-full bg-current opacity-60"></span>
					</span>
				</span>
			default:
				<svg viewBox="0 0 24 24" class="h-full w-full animate-[spin_.8s_linear_infinite]" fill="none" aria-hidden="true">
					<circle cx="12" cy="12" r="9.5" stroke="currentColor" stroke-opacity=".18" stroke-width="2.5"></circle>
					<path d="M21.5 12A9.5 9.5 0 0 0 12 2.5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path>
				</svg>
		}
	</span>
}
