package ui

import (
	"math"
	"strconv"
)

// ProgressBarProps configures ProgressBar. Every field is optional.
type ProgressBarProps struct {
	// Value is the current amount, from 0 to Max.
	Value float64
	// Max defaults to 100.
	Max float64
	// Indeterminate ignores Value and sweeps a short segment across the track.
	Indeterminate bool
	// Label is the accessible name, also shown above the bar. Default "Progress".
	Label string
	// HideLabel keeps the label for screen readers only.
	HideLabel bool
	// ShowValue shows the percentage on the right.
	ShowValue bool
	// ValueText replaces the percentage, e.g. "3 of 8 files".
	ValueText string
	// Size: "md" (default) or "sm".
	Size string
	// ID goes on the bar. With an ID, htmx can ease the fill to the new value when it swaps the bar.
	ID    string
	Class string
	Attrs templ.Attributes
}

// progressPct clamps value to [0, max] and returns it with its percentage.
func progressPct(value, max float64) (float64, float64) {
	if max <= 0 {
		max = 100
	}
	if math.IsNaN(value) {
		value = 0
	}
	v := math.Max(0, math.Min(max, value))
	return v, v / max * 100
}

func progressMax(max float64) string {
	if max <= 0 {
		max = 100
	}
	return progressNum(max)
}

func progressNum(f float64) string { return strconv.FormatFloat(f, 'f', -1, 64) }

func progressText(valueText string, pct float64) string {
	if valueText != "" {
		return valueText
	}
	return strconv.Itoa(int(math.Round(pct))) + "%"
}

func progressFill(pct float64) templ.SafeCSS {
	return templ.SafeCSS("transform:translateX(" + strconv.FormatFloat(pct-100, 'f', 2, 64) + "%)")
}

// ProgressBar is a linear progress bar. Give it an ID and the fill eases to each new value when htmx swaps it.
// Indeterminate sweeps a short segment, and with reduced motion it breathes in place instead.
//
//	@ui.ProgressBar(ui.ProgressBarProps{Label: "Uploading", Value: 42, ShowValue: true})
templ ProgressBar(p ProgressBarProps) {
	{{ v, pct := progressPct(p.Value, p.Max) }}
	{{ label := or(p.Label, "Progress") }}
	<div class={ cx("w-full", p.Class) } { p.Attrs... }>
		if !p.HideLabel || p.ShowValue {
			<div class="mb-2 flex items-baseline justify-between gap-4 text-[13px]">
				<span class={ cx("text-ink-2", when(p.HideLabel, "sr-only")) }>{ label }</span>
				if p.ShowValue && !p.Indeterminate {
					<span class="tabular-nums text-mute">{ progressText(p.ValueText, pct) }</span>
				}
			</div>
		}
		<div
			if p.ID != "" {
				id={ p.ID }
			}
			role="progressbar"
			aria-label={ label }
			aria-valuemin="0"
			aria-valuemax={ progressMax(p.Max) }
			if p.Indeterminate {
				aria-valuetext="Loading"
				aria-busy="true"
			} else {
				aria-valuenow={ progressNum(v) }
				aria-valuetext={ progressText(p.ValueText, pct) }
			}
			class={ cx("relative w-full overflow-hidden rounded-full bg-[color-mix(in_srgb,var(--ink)_9%,transparent)]", or(when(p.Size == "sm", "h-1"), "h-1.5")) }
		>
			if p.Indeterminate {
				<span class="absolute inset-y-0 left-0 w-[38%] rounded-full bg-brand animate-[asta-progress-sweep_1.5s_cubic-bezier(.16,1,.3,1)_infinite] motion-reduce:w-full motion-reduce:animate-pulse"></span>
			} else {
				<span
					if p.ID != "" {
						id={ p.ID + "-fill" }
					}
					class="absolute inset-0 rounded-full bg-brand transition-transform duration-700 ease-[cubic-bezier(.16,1,.3,1)] motion-reduce:transition-none"
					style={ progressFill(pct) }
				></span>
			}
		</div>
	</div>
}

// ProgressRingProps configures ProgressRing. Every field is optional.
type ProgressRingProps struct {
	// Value is the current amount, from 0 to Max.
	Value float64
	// Max defaults to 100.
	Max float64
	// Indeterminate ignores Value and spins a quarter arc.
	Indeterminate bool
	// Label is the accessible name. Default "Progress".
	Label string
	// ShowValue shows the percentage in the middle.
	ShowValue bool
	// ValueText replaces the percentage, e.g. "3/8".
	ValueText string
	// Center replaces what sits in the middle.
	Center templ.Component
	// Size is the diameter in px. Default 44.
	Size int
	// Thickness is the ring width in px. Default 3.5.
	Thickness float64
	Class     string
	Attrs     templ.Attributes
}

type ringGeom struct{ size, box, c, r, w string }

func ringGeometry(p ProgressRingProps) ringGeom {
	size := p.Size
	if size <= 0 {
		size = 44
	}
	t := p.Thickness
	if t <= 0 {
		t = 3.5
	}
	s := float64(size)
	return ringGeom{
		size: strconv.Itoa(size),
		box:  "0 0 " + strconv.Itoa(size) + " " + strconv.Itoa(size),
		c:    progressNum(s / 2),
		r:    progressNum((s - t) / 2),
		w:    progressNum(t),
	}
}

func ringBox(g ringGeom) templ.SafeCSS {
	return templ.SafeCSS("width:" + g.size + "px;height:" + g.size + "px")
}

func ringOffset(p ProgressRingProps, pct float64) string {
	if p.Indeterminate {
		return "75"
	}
	return strconv.FormatFloat(100-pct, 'f', 2, 64)
}

// ProgressRing is a circular progress ring. The arc jumps to new values. Easing it would animate stroke-dashoffset.
// Indeterminate spins a quarter arc, and with reduced motion it breathes in place instead.
//
//	@ui.ProgressRing(ui.ProgressRingProps{Label: "Storage used", Value: 68, ShowValue: true})
templ ProgressRing(p ProgressRingProps) {
	{{ v, pct := progressPct(p.Value, p.Max) }}
	{{ g := ringGeometry(p) }}
	<span
		role="progressbar"
		aria-label={ or(p.Label, "Progress") }
		aria-valuemin="0"
		aria-valuemax={ progressMax(p.Max) }
		if p.Indeterminate {
			aria-valuetext="Loading"
			aria-busy="true"
		} else {
			aria-valuenow={ progressNum(v) }
			aria-valuetext={ progressText(p.ValueText, pct) }
		}
		class={ cx("relative inline-flex shrink-0 items-center justify-center", p.Class) }
		style={ ringBox(g) }
		{ p.Attrs... }
	>
		<svg
			viewBox={ g.box }
			width={ g.size }
			height={ g.size }
			aria-hidden="true"
			class={ cx("absolute inset-0", or(when(p.Indeterminate, "animate-spin motion-reduce:animate-pulse"), "-rotate-90")) }
		>
			<circle cx={ g.c } cy={ g.c } r={ g.r } fill="none" stroke-width={ g.w } class="stroke-[color-mix(in_srgb,var(--ink)_9%,transparent)]"></circle>
			<circle
				cx={ g.c }
				cy={ g.c }
				r={ g.r }
				fill="none"
				stroke-width={ g.w }
				stroke-linecap="round"
				pathLength="100"
				stroke-dasharray="100 100"
				stroke-dashoffset={ ringOffset(p, pct) }
				class={ cx("stroke-brand", when(!p.Indeterminate && pct == 0, "opacity-0")) }
			></circle>
		</svg>
		if p.Center != nil {
			<span class="relative text-[11px] font-medium text-ink">
				@p.Center
			</span>
		} else if p.ShowValue && !p.Indeterminate {
			<span class="relative text-[11px] font-medium tabular-nums text-ink">{ progressText(p.ValueText, pct) }</span>
		}
	</span>
}
