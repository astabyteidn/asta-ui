package ui

import (
	"strconv"
	"time"
)

// Notification is one entry in a NotificationCenter.
type Notification struct {
	// ID is posted as id when the notification is marked read.
	ID    string
	Title string
	Body  string
	Time  time.Time
	Read  bool
	// Actor is who did it. Their avatar shows; without it a neutral bell shows.
	Actor    string
	ActorSrc string
	// Href makes the notification a link. Opening it marks it read.
	Href string
}

// NotificationCenterProps configures NotificationCenter.
type NotificationCenterProps struct {
	// ID names the panel. Default "notifications". Set it when a page has more than one.
	ID            string
	Notifications []Notification
	// MarkReadURL gets an hx-post with id=<ID> when one is marked read, and all=1 for "Mark all read".
	// The change shows at once; answer 204.
	MarkReadURL string
	// Now is the time used for grouping by day and for relative times. Default time.Now().
	Now time.Time
	// Ring rings the bell once, e.g. when you re-render it after new ones arrived.
	Ring bool
	// Align: "end" (default) opens the panel from the bell's right edge, "start" from its left.
	Align string
	// Label is the title and the bell's accessible name. Default "Notifications".
	Label string
	// Class goes on the bell.
	Class string
	// Attrs go on the root.
	Attrs templ.Attributes
}

type ncGroup struct {
	label string
	items []Notification
}

func ncNow(p NotificationCenterProps) time.Time {
	if p.Now.IsZero() {
		return time.Now()
	}
	return p.Now
}

func ncDay(t time.Time) time.Time {
	return time.Date(t.Year(), t.Month(), t.Day(), 0, 0, 0, 0, time.UTC)
}

// ncGroups sorts newest first and groups by day: Today, Yesterday, then dates.
func ncGroups(p NotificationCenterProps) []ncGroup {
	now := ncNow(p)
	list := append([]Notification(nil), p.Notifications...)
	for i := 1; i < len(list); i++ {
		for j := i; j > 0 && list[j].Time.After(list[j-1].Time); j-- {
			list[j], list[j-1] = list[j-1], list[j]
		}
	}
	today := ncDay(now)
	out := []ncGroup{}
	for _, n := range list {
		d := ncDay(n.Time)
		label := n.Time.Format("Mon, Jan 2")
		if d.Equal(today) {
			label = "Today"
		} else if d.Equal(today.AddDate(0, 0, -1)) {
			label = "Yesterday"
		}
		if len(out) > 0 && out[len(out)-1].label == label {
			out[len(out)-1].items = append(out[len(out)-1].items, n)
		} else {
			out = append(out, ncGroup{label, []Notification{n}})
		}
	}
	return out
}

// ncAgo is "now", "5m", "3h" today, else the clock time.
func ncAgo(now, t time.Time) string {
	s := now.Sub(t).Seconds()
	switch {
	case s < 60:
		return "now"
	case s < 3600:
		return strconv.Itoa(int(s/60)) + "m"
	case ncDay(t).Equal(ncDay(now)):
		return strconv.Itoa(int(s/3600)) + "h"
	}
	return t.Format("3:04 PM")
}

func ncUnread(list []Notification) int {
	n := 0
	for _, x := range list {
		if !x.Read {
			n++
		}
	}
	return n
}

func ncCount(n int) string {
	if n > 99 {
		return "99+"
	}
	return strconv.Itoa(n)
}

func ncBell(label string, unread int) string {
	if unread > 0 {
		return label + ", " + strconv.Itoa(unread) + " unread"
	}
	return label
}

func ncPost(p NotificationCenterProps, vals string) templ.Attributes {
	if p.MarkReadURL == "" {
		return nil
	}
	return templ.Attributes{"hx-post": p.MarkReadURL, "hx-vals": vals, "hx-swap": "none"}
}

func ncVals(id string) string {
	b := []byte(`{"id":`)
	b = strconv.AppendQuote(b, id)
	return string(append(b, '}'))
}

// NotificationCenter is a bell with an unread count that opens a panel of notifications grouped by day.
// Switch between All and Unread, open one, or mark one or all as read: the blue dot fades out and the count
// drops at once, while an hx-post tells your server. Arrow keys move through the list and Escape closes it.
//
//	@ui.NotificationCenter(ui.NotificationCenterProps{Notifications: list, MarkReadURL: "/notifications/read"})
templ NotificationCenter(p NotificationCenterProps) {
	{{ id := or(p.ID, "notifications") }}
	{{ label := or(p.Label, "Notifications") }}
	{{ unread := ncUnread(p.Notifications) }}
	{{ groups := ncGroups(p) }}
	{{ now := ncNow(p) }}
	<span
		data-asta-nc
		data-label={ label }
		data-url={ p.MarkReadURL }
		if p.Align == "start" {
			data-align="start"
		}
		class="asta-nc relative inline-flex"
		{ p.Attrs... }
	>
		<button
			type="button"
			data-asta-nc-trigger
			aria-haspopup="dialog"
			aria-expanded="false"
			aria-controls={ id }
			aria-label={ ncBell(label, unread) }
			class={ cx("relative grid h-9 w-9 place-items-center rounded-lg text-ink-2 outline-none transition-colors duration-200 hover:bg-paper-2 hover:text-ink focus-visible:ring-2 focus-visible:ring-brand/50 aria-expanded:bg-paper-2 aria-expanded:text-ink", p.Class) }
		>
			<span class={ cx("grid origin-[50%_15%] place-items-center", when(p.Ring, "asta-nc-ring")) }>
				@ncBellIcon("h-[18px] w-[18px]")
			</span>
			<span aria-hidden="true" data-asta-nc-badge hidden?={ unread == 0 } class="asta-nc-badge absolute -right-0.5 -top-0.5 flex h-[18px] min-w-[18px] items-center justify-center overflow-hidden rounded-full bg-brand px-1 text-[10.5px] font-medium tabular-nums text-white shadow-[0_0_0_2px_var(--paper)]">
				<span data-asta-nc-count class="block">{ ncCount(unread) }</span>
			</span>
		</button>
		<div
			id={ id }
			role="dialog"
			aria-label={ label }
			data-asta-nc-panel
			data-tab="all"
			hidden
			class={ cx("absolute top-full z-50 mt-2 w-[380px] max-w-[calc(100vw-32px)] overflow-hidden rounded-xl bg-paper text-left shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_10%,transparent),0_16px_40px_-14px_rgb(0_0_0/0.3),0_4px_10px_-6px_rgb(0_0_0/0.12)]",
				or(when(p.Align == "start", "left-0"), "right-0")) }
		>
			<div class="flex max-h-[min(520px,calc(100vh-96px))] flex-col">
				<p class="sr-only" aria-live="polite" data-asta-nc-status></p>
				<div class="flex items-center justify-between gap-3 px-4 pb-2 pt-3.5">
					<h3 class="text-[14px] font-medium tracking-[-0.01em] text-ink">{ label }</h3>
					<button
						type="button"
						data-asta-nc-all
						aria-disabled?={ unread == 0 }
						class="rounded-md px-2 py-1 text-[12.5px] text-brand outline-none transition-[color,opacity] duration-200 hover:bg-[color-mix(in_srgb,var(--brand)_8%,transparent)] focus-visible:ring-2 focus-visible:ring-brand/50 aria-disabled:pointer-events-none aria-disabled:text-mute aria-disabled:opacity-50"
						{ ncPost(p, `{"all":"1"}`)... }
					>Mark all read</button>
				</div>
				<div role="tablist" aria-label="Filter" class="relative mx-4 grid grid-cols-2 rounded-lg bg-paper-2 p-0.5">
					<span aria-hidden="true" class="asta-nc-thumb absolute bottom-0.5 left-0.5 top-0.5 w-[calc(50%-2px)] rounded-[7px] bg-paper shadow-[0_1px_2px_rgb(0_0_0/0.08),inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_7%,transparent)] transition-transform duration-500 ease-[cubic-bezier(.16,1,.3,1)]"></span>
					@ncTab("all", "All", true, 0)
					@ncTab("unread", "Unread", false, unread)
				</div>
				<div role="tabpanel" aria-label="Notifications" class="mt-2 min-h-0 flex-1 overflow-y-auto pb-2 [scrollbar-width:thin]">
					<ul data-asta-nc-list aria-label="All notifications">
						for _, g := range groups {
							<li data-asta-nc-group>
								<p class="px-4 pb-1 pt-3 text-[11.5px] font-medium text-mute">{ g.label }</p>
								<ul>
									for _, n := range g.items {
										@ncItem(p, n, now)
									}
								</ul>
							</li>
						}
					</ul>
					<div data-asta-nc-empty hidden?={ len(groups) > 0 } class="flex flex-col items-center px-6 py-12 text-center">
						<span class="grid h-11 w-11 place-items-center rounded-full bg-paper-2 text-mute">
							@ncBellIcon("h-5 w-5")
						</span>
						<p class="mt-4 text-[14px] font-medium text-ink" data-asta-nc-empty-title data-unread="You're all caught up">No notifications yet</p>
						<p class="mt-1 text-[12.5px] text-mute" data-asta-nc-empty-text data-unread="New activity will show up here.">When something happens, you'll see it here.</p>
					</div>
				</div>
			</div>
		</div>
	</span>
}

templ ncTab(value, text string, on bool, count int) {
	<button
		type="button"
		role="tab"
		data-asta-nc-tab={ value }
		aria-selected={ dataBool(on) }
		if on {
			tabindex="0"
		} else {
			tabindex="-1"
		}
		class="relative z-10 flex h-7 items-center justify-center gap-1.5 rounded-[7px] text-[12.5px] text-mute outline-none transition-colors duration-300 hover:text-ink focus-visible:ring-2 focus-visible:ring-brand/50 aria-selected:text-ink"
	>
		{ text }
		if value == "unread" {
			<span data-asta-nc-tabcount hidden?={ count == 0 } class="text-[11.5px] tabular-nums text-mute">{ strconv.Itoa(count) }</span>
		}
	</button>
}

templ ncItem(p NotificationCenterProps, n Notification, now time.Time) {
	<li data-asta-nc-entry={ n.ID } data-read?={ n.Read } class="group relative px-1.5">
		if n.Href != "" {
			<a href={ templ.SafeURL(n.Href) } data-asta-nc-item class={ ncItemClass }>
				@ncItemBody(n, now)
			</a>
		} else {
			<button type="button" data-asta-nc-item class={ ncItemClass }>
				@ncItemBody(n, now)
			</button>
		}
		<button
			type="button"
			data-asta-nc-dot
			aria-label={ "Mark “" + n.Title + "” as read" }
			if n.Read {
				tabindex="-1"
				aria-hidden="true"
			}
			class="absolute right-3 top-3.5 grid h-6 w-6 place-items-center rounded-full outline-none transition-[opacity,transform] duration-500 ease-[cubic-bezier(.16,1,.3,1)] hover:scale-110 focus-visible:ring-2 focus-visible:ring-brand/50 group-data-[read]:pointer-events-none group-data-[read]:scale-50 group-data-[read]:opacity-0"
			{ ncPost(p, ncVals(n.ID))... }
		>
			<span class="h-2 w-2 rounded-full bg-brand"></span>
		</button>
	</li>
}

const ncItemClass = "flex w-full gap-3 rounded-[10px] py-2.5 pl-2.5 pr-9 text-left outline-none transition-colors duration-200 hover:bg-paper-2 focus-visible:bg-paper-2 focus-visible:ring-2 focus-visible:ring-brand/50"

templ ncItemBody(n Notification, now time.Time) {
	if n.Actor != "" {
		@Avatar(AvatarProps{Name: n.Actor, Src: n.ActorSrc, Size: "sm"})
	} else {
		<span aria-hidden="true" class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-paper-2 text-mute">
			@ncBellIcon("h-4 w-4")
		</span>
	}
	<span class="min-w-0 flex-1">
		<span class="block text-[13px] leading-snug text-ink transition-colors duration-300 group-data-[read]:text-ink-2">
			<span class="sr-only group-data-[read]:hidden">Unread: </span>
			{ n.Title }
		</span>
		if n.Body != "" {
			<span class="mt-0.5 line-clamp-2 block text-[12.5px] leading-snug text-mute">{ n.Body }</span>
		}
		<span class="mt-1 block text-[11.5px] tabular-nums text-mute">{ ncAgo(now, n.Time) }</span>
	</span>
}

templ ncBellIcon(class string) {
	<svg viewBox="0 0 20 20" class={ class } fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M5 8a5 5 0 0 1 10 0c0 4 1.5 5.5 1.5 5.5h-13S5 12 5 8Z"></path>
		<path d="M8.5 16.5a1.6 1.6 0 0 0 3 0"></path>
	</svg>
}
