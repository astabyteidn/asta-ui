package ui

import "strconv"

// PaginationProps configures Pagination. Pages are links, so it works with plain requests, hx-boost or HxTarget.
type PaginationProps struct {
	// Page is the current page, 1-based.
	Page int
	// Total is the number of pages.
	Total int
	// Href returns the URL of a page, e.g. func(n int) string { return fmt.Sprintf("/orders?page=%d", n) }.
	Href func(page int) string
	// Siblings is how many pages show on each side of the current one. 0 means 1.
	Siblings int
	// Boundaries is how many pages always show at the start and the end. 0 means 1.
	Boundaries int
	// Size: "sm" or "md" (default).
	Size string
	// HxTarget makes every link load with hx-get into this target (e.g. "#orders") and push the URL.
	HxTarget string
	// LinkAttrs go on every page link, e.g. hx-swap or hx-select.
	LinkAttrs templ.Attributes
	// Label is the accessible name. Default "Pagination".
	Label string
	Class string
	Attrs templ.Attributes
}

// PageRange returns the page numbers to show, with 0 where pages are skipped. A gap never hides just one page.
func PageRange(page, total, siblings, boundaries int) []int {
	rng := func(a, b int) []int {
		out := []int{}
		for i := a; i <= b; i++ {
			out = append(out, i)
		}
		return out
	}
	slots := boundaries*2 + siblings*2 + 3
	if total <= slots {
		return rng(1, total)
	}
	left := max(page-siblings, boundaries+2)
	right := min(page+siblings, total-boundaries-1)
	head := rng(1, boundaries)
	tail := rng(total-boundaries+1, total)
	if left <= boundaries+2 {
		return append(append(rng(1, slots-boundaries-1), 0), tail...)
	}
	if right >= total-boundaries-1 {
		return append(append(head, 0), rng(total-(slots-boundaries-2), total)...)
	}
	return append(append(append(append(head, 0), rng(left, right)...), 0), tail...)
}

func pageHref(p PaginationProps, n int) string {
	if p.Href == nil {
		return "?page=" + strconv.Itoa(n)
	}
	return p.Href(n)
}

func pageAttrs(p PaginationProps, n int) templ.Attributes {
	a := templ.Attributes{}
	if p.HxTarget != "" {
		a["hx-get"] = pageHref(p, n)
		a["hx-target"] = p.HxTarget
		a["hx-push-url"] = "true"
	}
	for k, v := range p.LinkAttrs {
		a[k] = v
	}
	return a
}

func pageCurrent(p PaginationProps) (int, int) {
	total := max(1, p.Total)
	return min(total, max(1, p.Page)), total
}

func pageBtn(size string) string {
	h := "h-9 min-w-9 text-[13.5px]"
	if size == "sm" {
		h = "h-8 min-w-8 text-[13px]"
	}
	return cx("relative flex items-center justify-center rounded-lg px-2 tabular-nums outline-none transition-colors duration-200 focus-visible:ring-2 focus-visible:ring-brand/50", h)
}

func pageGap(size string) string {
	if size == "sm" {
		return "flex h-8 min-w-8 items-center justify-center text-mute"
	}
	return "flex h-9 min-w-9 items-center justify-center text-mute"
}

const pageIdle = "text-ink-2 hover:bg-paper-2 hover:text-ink"

// Pagination renders page links with previous and next. Skipped pages collapse into an ellipsis.
//
//	@ui.Pagination(ui.PaginationProps{Page: page, Total: pages, HxTarget: "#orders", Href: func(n int) string { return fmt.Sprintf("/orders?page=%d", n) }})
templ Pagination(p PaginationProps) {
	{{ page, total := pageCurrent(p) }}
	<nav aria-label={ or(p.Label, "Pagination") } class={ cx("flex items-center gap-1", p.Class) } { p.Attrs... }>
		@pageStep(p, page-1, page == 1, "Previous page", "M10 3.5 5.5 8l4.5 4.5")
		<ul class="flex items-center gap-1">
			for _, n := range PageRange(page, total, or1(p.Siblings), or1(p.Boundaries)) {
				if n == 0 {
					<li aria-hidden="true" class={ pageGap(p.Size) }>…</li>
				} else if n == page {
					<li>
						<a href={ templ.SafeURL(pageHref(p, n)) } aria-current="page" aria-label={ "Page " + strconv.Itoa(n) } class={ cx(pageBtn(p.Size), "bg-[color-mix(in_srgb,var(--brand)_11%,transparent)] font-medium text-brand") } { pageAttrs(p, n)... }>{ strconv.Itoa(n) }</a>
					</li>
				} else {
					<li>
						<a href={ templ.SafeURL(pageHref(p, n)) } aria-label={ "Page " + strconv.Itoa(n) } class={ cx(pageBtn(p.Size), pageIdle) } { pageAttrs(p, n)... }>{ strconv.Itoa(n) }</a>
					</li>
				}
			}
		</ul>
		@pageStep(p, page+1, page == total, "Next page", "m6 3.5 4.5 4.5L6 12.5")
	</nav>
}

templ pageStep(p PaginationProps, n int, off bool, label, d string) {
	if off {
		<span role="link" aria-disabled="true" aria-label={ label } class={ cx(pageBtn(p.Size), "text-ink-2 opacity-35") }>
			@pageArrow(d)
		</span>
	} else {
		<a href={ templ.SafeURL(pageHref(p, n)) } aria-label={ label } class={ cx(pageBtn(p.Size), pageIdle) } { pageAttrs(p, n)... }>
			@pageArrow(d)
		</a>
	}
}

templ pageArrow(d string) {
	<svg viewBox="0 0 16 16" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d={ d }></path>
	</svg>
}

func or1(n int) int {
	if n < 1 {
		return 1
	}
	return n
}
