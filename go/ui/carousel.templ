package ui

import (
	"fmt"
	"strconv"
)

// CarouselProps configures Carousel.
type CarouselProps struct {
	// ID names the carousel and its slides. Default "carousel". Set it when a page has more than one.
	ID string
	// Slides are the slides, one component each.
	Slides []templ.Component
	// Loop wraps from the last slide to the first and back.
	Loop bool
	// Autoplay is the time per slide in milliseconds. It pauses on hover, keyboard focus and off screen,
	// and stays off with reduced motion.
	Autoplay int
	// Label is the accessible name, e.g. "Featured work". Default "Carousel".
	Label string
	Class string
	// Attrs go on the root. It fires "asta:slide" with detail {index} when the slide changes.
	Attrs templ.Attributes
}

// Dot slot and active bar widths, in px.
const (
	carDot = 14
	carBar = 30
)

func carID(p CarouselProps) string { return or(p.ID, "carousel") }

func carDotStyle(i, cur int) templ.SafeCSS {
	w, x := carDot, i*carDot
	if i == cur {
		w = carBar
	}
	if i > cur {
		x += carBar - carDot
	}
	return templ.SafeCSS(fmt.Sprintf("width:%dpx;transform:translateX(%dpx)", w, x))
}

func carDotsWidth(n int) templ.SafeCSS {
	return templ.SafeCSS(fmt.Sprintf("width:%dpx", (n-1)*carDot+carBar))
}

const carArrow = "flex h-8 w-8 items-center justify-center rounded-lg text-ink outline-none transition-[background-color,opacity,transform] duration-200 hover:bg-paper-2 focus-visible:ring-2 focus-visible:ring-brand/50 active:scale-95 disabled:pointer-events-none disabled:opacity-30"

// Carousel is slides you swipe or scroll (native scroll snap), step with the arrows, or jump to with the dots.
// The active dot stretches into a bar; with Autoplay the bar fills as the slide's time runs out.
// Arrow keys, Home and End work once the carousel has focus.
//
//	@ui.Carousel(ui.CarouselProps{Label: "Featured work", Loop: true, Autoplay: 5000, Slides: []templ.Component{slideA(), slideB()}})
templ Carousel(p CarouselProps) {
	{{ id := carID(p) }}
	{{ n := len(p.Slides) }}
	<div
		data-asta-carousel
		data-index="0"
		if p.Loop {
			data-loop
		}
		if p.Autoplay > 0 && n > 1 {
			data-autoplay={ strconv.Itoa(p.Autoplay) }
		}
		role="region"
		aria-roledescription="carousel"
		aria-label={ or(p.Label, "Carousel") }
		tabindex="0"
		class={ cx("asta-carousel flex w-full min-w-0 flex-col gap-4 rounded-[14px] outline-none focus-visible:ring-2 focus-visible:ring-brand/50 focus-visible:ring-offset-4 focus-visible:ring-offset-paper", p.Class) }
		{ p.Attrs... }
	>
		<div data-asta-carousel-track class="asta-carousel-track flex snap-x snap-mandatory gap-3 overflow-x-auto overscroll-x-contain rounded-[14px]" aria-live="polite">
			for i, s := range p.Slides {
				<div
					id={ id + "-slide-" + strconv.Itoa(i) }
					data-asta-carousel-slide
					role="group"
					aria-roledescription="slide"
					aria-label={ strconv.Itoa(i+1) + " of " + strconv.Itoa(n) }
					if i != 0 {
						aria-hidden="true"
						inert
					}
					class="w-full shrink-0 snap-start snap-always"
				>
					@s
				</div>
			}
		</div>
		if n > 1 {
			<div class="flex items-center justify-between gap-4">
				<div class="relative h-6" style={ carDotsWidth(n) }>
					for i := range p.Slides {
						<button
							type="button"
							data-asta-carousel-dot={ strconv.Itoa(i) }
							aria-label={ "Go to slide " + strconv.Itoa(i+1) }
							aria-controls={ id + "-slide-" + strconv.Itoa(i) }
							if i == 0 {
								aria-current="true"
							}
							style={ carDotStyle(i, 0) }
							class="group absolute left-0 top-0 h-6 rounded-md outline-none transition-transform duration-500 ease-[cubic-bezier(.16,1,.3,1)] focus-visible:ring-2 focus-visible:ring-brand/50 motion-reduce:transition-none"
						>
							<span class="absolute left-1 top-[9px] h-1.5 w-1.5 rounded-full bg-[color-mix(in_srgb,var(--ink)_22%,transparent)] transition-[opacity,background-color] duration-300 group-hover:bg-[color-mix(in_srgb,var(--ink)_40%,transparent)] group-aria-[current]:opacity-0"></span>
							<span class="absolute left-1 top-[9px] h-1.5 w-[22px] origin-left scale-x-[0.2727] overflow-hidden rounded-full bg-[color-mix(in_srgb,var(--ink)_14%,transparent)] opacity-0 transition-[opacity,transform] duration-500 ease-[cubic-bezier(.16,1,.3,1)] group-aria-[current]:scale-x-100 group-aria-[current]:opacity-100 motion-reduce:transition-none">
								<span data-asta-carousel-fill class="asta-carousel-fill absolute inset-0 origin-left rounded-full bg-brand"></span>
							</span>
						</button>
					}
				</div>
				<div class="flex items-center gap-1">
					<button type="button" data-asta-carousel-step="-1" aria-label="Previous slide" disabled?={ !p.Loop } class={ carArrow }>
						@calArrow("M10 3.5 5.5 8l4.5 4.5")
					</button>
					<button type="button" data-asta-carousel-step="1" aria-label="Next slide" class={ carArrow }>
						@calArrow("m6 3.5 4.5 4.5L6 12.5")
					</button>
				</div>
			</div>
		}
	</div>
}
