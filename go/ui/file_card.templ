package ui

import "strings"

// FileCardProps configures FileCard. Title is required.
type FileCardProps struct {
	Title string
	// Meta is a short line under the title, e.g. "Edited 2 h ago".
	Meta string
	// Thumbnail is an image URL for the preview.
	Thumbnail string
	// Preview is any component that fills the preview instead, e.g. an inline SVG. Without either the first letter shows.
	Preview templ.Component
	// Icon is a small icon in front of the title that says what kind of file it is.
	Icon templ.Component
	// Href makes the whole card a link.
	Href string
	// OpenAttrs makes the whole card a button with these attributes instead, e.g. hx-get and hx-target.
	OpenAttrs templ.Attributes
	// Star shows the star button.
	Star    bool
	Starred bool
	// StarURL posts starred=true|false with hx-post every time the star is toggled. The toggle shows at once.
	StarURL string
	// StarAttrs go on the star button, e.g. hx-vals with the file id.
	StarAttrs templ.Attributes
	// Actions sit on the right of the footer (grid) or the row (list), e.g. a Menu.
	Actions templ.Component
	// View: "grid" (default) or "list" for a compact row.
	View     string
	Selected bool
	Class    string
	Attrs    templ.Attributes
}

func fileInitial(title string) string {
	for _, r := range title {
		return strings.ToUpper(string(r))
	}
	return ""
}

func fileStarAttrs(p FileCardProps) templ.Attributes {
	a := attrs(p.StarAttrs)
	if p.StarURL != "" {
		a["hx-post"] = p.StarURL
		a["hx-trigger"] = "asta:star"
		if _, ok := a["hx-swap"]; !ok {
			a["hx-swap"] = "none"
		}
	}
	return a
}

// fileRing draws the outline on an overlay, so the preview doesn't paint over it.
func fileRing(selected bool) string {
	base := "after:pointer-events-none after:absolute after:inset-0 after:z-[3] after:rounded-[inherit] after:transition-shadow after:duration-150 "
	if selected {
		return base + "after:shadow-[inset_0_0_0_2px_var(--brand)]"
	}
	return base + "after:shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_10%,transparent)] hover:after:shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_22%,transparent)] has-[:focus-visible]:after:shadow-[inset_0_0_0_2px_var(--brand)]"
}

const fileZoom = "absolute inset-0 transition-transform duration-500 ease-[cubic-bezier(.16,1,.3,1)] group-hover/file:scale-[1.03] motion-reduce:transition-none"

// FileCard is a file in a file browser: a big preview with the name, a kind icon and when it was last edited.
// The preview zooms a little on hover and the star pops when you star it. View "list" renders the same data as a row.
//
//	@ui.FileCard(ui.FileCardProps{Title: "Brand guide.pdf", Meta: "Edited 2 h ago", Href: "/files/12",
//		Star: true, StarURL: "/files/12/star"})
templ FileCard(p FileCardProps) {
	if p.View == "list" {
		<div class={ cx("group/file relative flex h-14 items-center gap-3 rounded-[10px] px-2 transition-[box-shadow,background-color] duration-150 hover:bg-[color-mix(in_srgb,var(--ink)_4%,transparent)]", when(p.Selected, "bg-[color-mix(in_srgb,var(--brand)_8%,transparent)]"), p.Class) } { p.Attrs... }>
			@fileOpen(p)
			<span class="relative h-10 w-16 shrink-0 overflow-hidden rounded-[6px] bg-paper-2 shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_8%,transparent)]">
				@fileThumb(p)
			</span>
			if p.Icon != nil {
				<span class="h-4 w-4 shrink-0 text-mute [&>svg]:h-full [&>svg]:w-full">
					@p.Icon
				</span>
			}
			<span class="min-w-0 flex-1 truncate text-[13.5px] font-medium text-ink">{ p.Title }</span>
			if p.Meta != "" {
				<span class="hidden shrink-0 text-[12.5px] text-mute sm:block">{ p.Meta }</span>
			}
			<span class="relative z-[2] flex shrink-0 items-center gap-1">
				if p.Star {
					@fileStar(p)
				}
				if p.Actions != nil {
					@p.Actions
				}
			</span>
		</div>
	} else {
		<div class={ cx("group/file relative overflow-hidden rounded-[12px] bg-paper", fileRing(p.Selected), p.Class) } { p.Attrs... }>
			@fileOpen(p)
			<div class="relative aspect-[16/10] overflow-hidden bg-paper-2">
				@fileThumb(p)
				if p.Star {
					<span class="absolute right-2.5 top-2.5 z-[2]">
						@fileStar(p)
					</span>
				}
			</div>
			<div class="flex items-center gap-2.5 px-3.5 py-3">
				if p.Icon != nil {
					<span class="h-4 w-4 shrink-0 text-mute [&>svg]:h-full [&>svg]:w-full">
						@p.Icon
					</span>
				}
				<span class="min-w-0 flex-1">
					<span class="block truncate text-[13.5px] font-medium text-ink">{ p.Title }</span>
					if p.Meta != "" {
						<span class="mt-0.5 block truncate text-[12px] text-mute">{ p.Meta }</span>
					}
				</span>
				if p.Actions != nil {
					<span class="relative z-[2] shrink-0">
						@p.Actions
					</span>
				}
			</div>
		</div>
	}
}

// One link covers the card. Buttons sit above it so they stay clickable and focusable on their own.
templ fileOpen(p FileCardProps) {
	if p.Href != "" {
		<a href={ templ.SafeURL(p.Href) } class="absolute inset-0 z-[1] rounded-[inherit] outline-none" aria-label={ "Open " + p.Title }></a>
	} else if p.OpenAttrs != nil {
		<button type="button" class="absolute inset-0 z-[1] cursor-pointer rounded-[inherit] outline-none" aria-label={ "Open " + p.Title } { p.OpenAttrs... }></button>
	}
}

templ fileThumb(p FileCardProps) {
	if p.Thumbnail != "" {
		<img src={ p.Thumbnail } alt="" width="640" height="400" loading="lazy" decoding="async" class={ cx(fileZoom, "h-full w-full object-cover") }/>
	} else if p.Preview != nil {
		<div class={ fileZoom }>
			@p.Preview
		</div>
	} else {
		<span class="absolute inset-0 grid place-items-center text-[28px] font-semibold tracking-[-0.04em] text-mute">{ fileInitial(p.Title) }</span>
	}
}

templ fileStar(p FileCardProps) {
	<button
		type="button"
		data-asta-file-star
		name="starred"
		value={ dataBool(p.Starred) }
		aria-label={ "Star " + p.Title }
		aria-pressed={ dataBool(p.Starred) }
		class={ cx("group/star relative z-[2] grid h-7 w-7 cursor-pointer place-items-center rounded-[7px] outline-none transition-[opacity,color,background-color] duration-150",
			"focus-visible:opacity-100 focus-visible:shadow-[0_0_0_2px_var(--brand)]",
			"text-ink-2 opacity-0 hover:text-ink group-hover/file:opacity-100 aria-pressed:text-brand aria-pressed:opacity-100",
			when(p.View != "list", "bg-paper shadow-[0_1px_3px_rgb(0_0_0/0.12)]")) }
		{ fileStarAttrs(p)... }
	>
		<svg viewBox="0 0 24 24" class="asta-file-star h-4 w-4 fill-none group-aria-pressed/star:fill-current" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true">
			<path d="m12 3.6 2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.2-4.1 5.8-.8z"></path>
		</svg>
	</button>
}

func dataBool(b bool) string {
	if b {
		return "true"
	}
	return "false"
}
