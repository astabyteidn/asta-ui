package ui

import "strconv"

// PropertiesPanelProps configures PropertiesPanel. Children are PropSection blocks.
type PropertiesPanelProps struct {
	// ID goes on the panel.
	ID string
	// Title is shown in the header, e.g. the selected layer's name.
	Title string
	// Kind is a small tag before the title, e.g. "Text" or "Frame".
	Kind string
	// Actions are buttons on the right of the header.
	Actions templ.Component
	// Action makes the panel a form that posts to this URL on every change (hx-post, hx-trigger="change",
	// hx-swap="none"). Answer with ui.Toast or an empty 204. Without it the panel is a plain <div>.
	Action string
	Class  string
	// Attrs go on the panel, e.g. hx-target and hx-swap to re-render it.
	Attrs templ.Attributes
}

const propsPanel = "w-full overflow-hidden rounded-[12px] bg-paper text-ink shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_10%,transparent),0_12px_32px_-16px_rgb(0_0_0/0.22)]"

// PropertiesPanel is the inspector of a design editor: a header for the selection, collapsible sections,
// compact number fields you can drag to scrub (Shift for ×10, Alt for ×0.1) and colour fields.
// Each control posts once its value settles (on release, Enter or blur), so the server sees one change.
//
//	@ui.PropertiesPanel(ui.PropertiesPanelProps{Kind: "Frame", Title: "Hero", Action: "/layers/1"}) {
//		@ui.PropSection(ui.PropSectionProps{Title: "Layout"}) {
//			@ui.PropRow(ui.PropRowProps{Label: "Position"}) {
//				@ui.PropNumber(ui.PropNumberProps{Name: "x", Label: "X", Value: 24})
//				@ui.PropNumber(ui.PropNumberProps{Name: "y", Label: "Y", Value: 80})
//			}
//		}
//	}
templ PropertiesPanel(p PropertiesPanelProps) {
	if p.Action != "" {
		<form
			if p.ID != "" {
				id={ p.ID }
			}
			data-asta-props
			action={ templ.SafeURL(p.Action) }
			method="post"
			hx-post={ p.Action }
			hx-trigger="change"
			hx-swap="none"
			class={ cx(propsPanel, p.Class) }
			{ p.Attrs... }
		>
			@propsBody(p) {
				{ children... }
			}
		</form>
	} else {
		<div
			if p.ID != "" {
				id={ p.ID }
			}
			data-asta-props
			class={ cx(propsPanel, p.Class) }
			{ p.Attrs... }
		>
			@propsBody(p) {
				{ children... }
			}
		</div>
	}
}

templ propsBody(p PropertiesPanelProps) {
	if p.Title != "" || p.Kind != "" || p.Actions != nil {
		<div class="flex h-11 items-center gap-2 px-3.5">
			if p.Kind != "" {
				<span class="rounded-[5px] bg-[color-mix(in_srgb,var(--ink)_7%,transparent)] px-1.5 py-0.5 text-[11px] text-ink-2">{ p.Kind }</span>
			}
			<span class="min-w-0 flex-1 truncate text-[13px] font-medium text-ink">{ p.Title }</span>
			if p.Actions != nil {
				@p.Actions
			}
		</div>
	}
	<div class="pb-1.5">
		{ children... }
	</div>
}

// PropSectionProps configures PropSection.
type PropSectionProps struct {
	Title string
	// Closed starts the section folded.
	Closed bool
	// Action is a button on the right of the title, e.g. "+" to add a fill.
	Action templ.Component
}

// PropSection is a collapsible group of PropRows. It is a native <details>, so it folds without JavaScript.
templ PropSection(p PropSectionProps) {
	<details class="group/sec relative px-3.5 pt-2.5" open?={ !p.Closed }>
		<summary class="flex h-7 w-max cursor-pointer list-none items-center gap-1 rounded-[4px] text-[11.5px] font-medium text-ink outline-none focus-visible:shadow-[0_0_0_2px_var(--brand)]">
			<svg viewBox="0 0 24 24" class="h-3 w-3 text-mute transition-transform duration-200 ease-[cubic-bezier(.16,1,.3,1)] group-open/sec:rotate-90 motion-reduce:transition-none" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
				<path d="m9 6 6 6-6 6"></path>
			</svg>
			{ p.Title }
		</summary>
		if p.Action != nil {
			<div class="absolute right-3.5 top-2.5 flex h-7 items-center">
				@p.Action
			</div>
		}
		<div data-asta-props-body class="space-y-1.5 pb-2 pt-1">
			{ children... }
		</div>
	</details>
}

// PropRowProps configures PropRow.
type PropRowProps struct {
	// Label is muted text on the left. Leave it empty to give the fields the full width.
	Label string
	// Cols is how many equal columns the fields share: 1 to 4. Default 2.
	Cols int
}

var propCols = map[int]string{1: "grid-cols-1", 2: "grid-cols-2", 3: "grid-cols-3", 4: "grid-cols-4"}

// PropRow lines up a label and one to four fields.
templ PropRow(p PropRowProps) {
	{{ cols, ok := propCols[p.Cols] }}
	if !ok {
		{{ cols = propCols[2] }}
	}
	<div class={ cx("grid items-center gap-2", or(when(p.Label != "", "grid-cols-[64px_1fr]"), "grid-cols-1")) }>
		if p.Label != "" {
			<span class="truncate text-[11.5px] text-mute">{ p.Label }</span>
		}
		<div class={ cx("grid gap-1.5", cols) }>
			{ children... }
		</div>
	</div>
}

const (
	propField = "h-7 rounded-[6px] bg-[color-mix(in_srgb,var(--ink)_5%,transparent)] text-[12px] text-ink transition-[background-color,box-shadow] duration-150 " +
		"hover:bg-[color-mix(in_srgb,var(--ink)_8%,transparent)] focus-within:bg-paper focus-within:shadow-[inset_0_0_0_1.5px_var(--brand)]"
)

// PropNumberProps configures PropNumber.
type PropNumberProps struct {
	// Name is the posted field name.
	Name string
	// Label is a short prefix, e.g. "X" or "W". Drag it left and right to change the value.
	Label string
	// Icon replaces Label with an icon.
	Icon templ.Component
	// AriaLabel names the field when Label is a single letter or an icon. Default Label.
	AriaLabel string
	Value     float64
	// Step per 2px of drag and per arrow key. Default 1.
	Step float64
	// Min and Max clamp the value when HasMin / HasMax are set.
	Min, Max       float64
	HasMin, HasMax bool
	// Precision is how many decimals are kept. Default 0.
	Precision int
	// Unit is shown after the number, e.g. "px" or "°".
	Unit     string
	Disabled bool
	Attrs    templ.Attributes
}

func propNum(f float64, prec int) string { return strconv.FormatFloat(f, 'f', prec, 64) }

// PropNumber is a compact number field. Drag its label to scrub (Shift ×10, Alt ×0.1), or type and press
// Enter. Arrow Up and Down step it. It posts once, when the value settles.
templ PropNumber(p PropNumberProps) {
	<label class={ cx(propField, "flex min-w-0 items-center data-[scrubbing]:bg-paper data-[scrubbing]:shadow-[inset_0_0_0_1.5px_var(--brand)]", when(p.Disabled, "pointer-events-none opacity-45")) } data-asta-prop-scrub>
		<span data-asta-prop-handle class="grid h-full w-6 shrink-0 cursor-ew-resize touch-none select-none place-items-center text-[11px] text-mute [&>svg]:h-3.5 [&>svg]:w-3.5" aria-hidden="true">
			if p.Icon != nil {
				@p.Icon
			} else {
				{ p.Label }
			}
		</span>
		<input
			name={ p.Name }
			value={ propNum(p.Value, p.Precision) }
			inputmode="decimal"
			autocomplete="off"
			aria-label={ or(p.AriaLabel, p.Label) }
			data-step={ propNum(propOr0(p.Step, 1), 6) }
			data-precision={ strconv.Itoa(p.Precision) }
			if p.HasMin {
				data-min={ propNum(p.Min, 6) }
			}
			if p.HasMax {
				data-max={ propNum(p.Max, 6) }
			}
			disabled?={ p.Disabled }
			class="h-full min-w-0 flex-1 bg-transparent pr-1.5 font-mono text-[11.5px] tabular-nums outline-none"
			{ p.Attrs... }
		/>
		if p.Unit != "" {
			<span class="shrink-0 pr-2 text-[11px] text-mute">{ p.Unit }</span>
		}
	</label>
}

func propOr0(f, def float64) float64 {
	if f == 0 {
		return def
	}
	return f
}

// PropColorProps configures PropColor.
type PropColorProps struct {
	// Name is the posted field name. The value posts as "#rrggbb".
	Name string
	// Value is a hex colour, e.g. "#2f54eb".
	Value string
	// Label names the field for screen readers. Default "Colour".
	Label    string
	Disabled bool
	Attrs    templ.Attributes
}

// PropColor is a colour field: a swatch that opens the system picker and a hex input. Bad hex reverts on blur.
templ PropColor(p PropColorProps) {
	{{ label := or(p.Label, "Colour") }}
	{{ hex := propHex(p.Value) }}
	<div data-asta-prop-color class={ cx(propField, "flex min-w-0 items-center", when(p.Disabled, "pointer-events-none opacity-45")) }>
		<label data-asta-prop-swatch class="relative ml-1 h-5 w-5 shrink-0 cursor-pointer overflow-hidden rounded-[4px] shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_15%,transparent)]" style={ templ.SafeCSS("background:" + hex) }>
			<input type="color" aria-label={ label + " picker" } value={ hex } disabled?={ p.Disabled } class="absolute inset-0 cursor-pointer opacity-0"/>
		</label>
		<input
			name={ p.Name }
			value={ hex }
			aria-label={ label + " hex" }
			spellcheck="false"
			autocomplete="off"
			data-asta-prop-hex
			disabled?={ p.Disabled }
			class="h-full min-w-0 flex-1 bg-transparent px-2 font-mono text-[11.5px] uppercase outline-none"
			{ p.Attrs... }
		/>
	</div>
}

// propHex normalises "#abc", "abc" or "#AABBCC" to "#aabbcc", or returns "#000000".
func propHex(v string) string {
	if len(v) > 0 && v[0] == '#' {
		v = v[1:]
	}
	if len(v) == 3 {
		v = string([]byte{v[0], v[0], v[1], v[1], v[2], v[2]})
	}
	if len(v) != 6 {
		return "#000000"
	}
	out := make([]byte, 6)
	for i := 0; i < 6; i++ {
		c := v[i]
		switch {
		case c >= '0' && c <= '9', c >= 'a' && c <= 'f':
			out[i] = c
		case c >= 'A' && c <= 'F':
			out[i] = c + 32
		default:
			return "#000000"
		}
	}
	return "#" + string(out)
}
