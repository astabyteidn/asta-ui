package ui

import "strconv"

// TeamMember is one person in TeamMembers.
type TeamMember struct {
	// ID is posted as member=<ID> by the row's actions.
	ID    string
	Name  string
	Email string
	// Role is a value from TeamMembersProps.Roles.
	Role string
	// Src is the avatar image URL. Initials show without it.
	Src string
	// You marks the signed-in person. Their role is locked and they can't be removed.
	You bool
	// Removed shows the row as "Removed <name>" with Undo and a countdown, until it fades out.
	Removed bool
}

// TeamInvite is one pending invite.
type TeamInvite struct {
	// ID is posted as invite=<ID> by Resend and Revoke.
	ID    string
	Email string
	Role  string
	// Sent is already formatted, e.g. "2d ago".
	Sent string
	// Resent swaps Resend for "Sent", right after it was pressed.
	Resent bool
	// New fades the row in, for invites the last answer added.
	New bool
}

// TeamMembersProps configures TeamMembers. Every action posts to its URL and the server answers with
// TeamMembers again, which replaces the whole block.
type TeamMembersProps struct {
	// ID goes on the block. Default "team".
	ID string
	// Title is the heading. Default "Team".
	Title   string
	Members []TeamMember
	Invites []TeamInvite
	// Roles default to Owner, Admin, Member and Viewer.
	Roles []SelectOption
	// InviteRole is picked for new invites. Default: the last role.
	InviteRole string
	// InviteEmails keeps the typed addresses when the server answers with InviteError.
	InviteEmails string
	// InviteError replaces the hint under the invite field, e.g. "a@b is already on the team."
	InviteError string
	// InviteMessage replaces the hint after a send, e.g. "Invited 2 people as Member."
	InviteMessage string
	// InviteAction gets emails (comma, space or line separated) and role. Without it there is no invite form.
	InviteAction string
	// RoleAction gets member and role when a role picker changes.
	RoleAction string
	// RemoveAction gets member. Mark the person Removed in the answer; they stay restorable until the countdown ends.
	RemoveAction string
	// UndoAction gets member, to bring a Removed person back.
	UndoAction string
	// ResendAction and RevokeAction get invite.
	ResendAction string
	RevokeAction string
	// UndoSeconds is how long the Undo row stays. Default 5.
	UndoSeconds int
	Class       string
	// Attrs go on the block.
	Attrs templ.Attributes
}

var teamDefaultRoles = []SelectOption{
	{Value: "owner", Label: "Owner"},
	{Value: "admin", Label: "Admin"},
	{Value: "member", Label: "Member"},
	{Value: "viewer", Label: "Viewer"},
}

func teamRoles(p TeamMembersProps) []SelectOption {
	if len(p.Roles) > 0 {
		return p.Roles
	}
	return teamDefaultRoles
}

func teamRoleLabel(p TeamMembersProps, v string) string {
	for _, r := range teamRoles(p) {
		if r.Value == v {
			return r.Label
		}
	}
	return v
}

func teamID(p TeamMembersProps) string { return or(p.ID, "team") }

func teamCounts(p TeamMembersProps) string {
	n := 0
	for _, m := range p.Members {
		if !m.Removed {
			n++
		}
	}
	s := strconv.Itoa(n) + " member" + when(n != 1, "s")
	if len(p.Invites) > 0 {
		s += " · " + strconv.Itoa(len(p.Invites)) + " pending"
	}
	return s
}

// teamAction posts one value to url and swaps the whole block with the answer.
func teamAction(p TeamMembersProps, url, key, val string) templ.Attributes {
	return templ.Attributes{
		"hx-post":   url,
		"hx-vals":   `{` + strconv.Quote(key) + `:` + strconv.Quote(val) + `}`,
		"hx-target": "#" + teamID(p),
		"hx-swap":   "outerHTML",
	}
}

func teamUndo(p TeamMembersProps) templ.SafeCSS {
	s := p.UndoSeconds
	if s <= 0 {
		s = 5
	}
	return templ.SafeCSS("animation:asta-blk-count " + strconv.Itoa(s) + "s linear forwards")
}

const teamIconBtn = "grid h-8 w-8 shrink-0 place-items-center rounded-md text-mute outline-none transition-colors duration-200 hover:bg-paper-2 hover:text-ink focus-visible:ring-2 focus-visible:ring-brand/50 disabled:pointer-events-none disabled:opacity-30"

// TeamMembers is a team list: avatar, name, email and a role picker per person, an invite form for several
// addresses at once, and pending invites that can be resent or revoked. Removing someone leaves an Undo row
// with a countdown. Everything is server-driven: each action posts and the block is swapped with the answer.
//
//	@ui.TeamMembers(ui.TeamMembersProps{Members: team, Invites: invites, InviteAction: "/team/invite", RoleAction: "/team/role", RemoveAction: "/team/remove", UndoAction: "/team/undo"})
templ TeamMembers(p TeamMembersProps) {
	{{ id := teamID(p) }}
	{{ roles := teamRoles(p) }}
	<div id={ id } data-asta-team class={ cx("@container w-full text-ink", p.Class) } { p.Attrs... }>
		<header class="flex items-baseline justify-between gap-4">
			<h3 class="text-[17px] font-medium tracking-[-0.02em] text-ink">{ or(p.Title, "Team") }</h3>
			<p class="text-[12.5px] tabular-nums text-mute">{ teamCounts(p) }</p>
		</header>
		if p.InviteAction != "" {
			<form
				action={ templ.SafeURL(p.InviteAction) }
				method="post"
				hx-post={ p.InviteAction }
				hx-target={ "#" + id }
				hx-swap="outerHTML"
				hx-indicator="find button[type=submit]"
				class="mt-5 rounded-[12px] bg-paper-2 p-3"
			>
				<div class="flex flex-col gap-2 sm:flex-row sm:items-start">
					<div class="min-w-0 flex-1">
						<label for={ id + "-emails" } class="sr-only">Email addresses to invite</label>
						@Input(InputProps{ID: id + "-emails", Name: "emails", Type: "text", Value: p.InviteEmails, Placeholder: "name@company.com, another@company.com", State: when(p.InviteError != "", "error"), Attrs: templ.Attributes{"autocomplete": "off", "spellcheck": "false", "aria-describedby": id + "-invite-hint"}})
					</div>
					<div class="flex gap-2">
						<div class="w-[124px] shrink-0">
							@Select(SelectProps{ID: id + "-invite-role", Name: "role", Label: "Role for new invites", Options: roles, Value: or(p.InviteRole, roles[len(roles)-1].Value)})
						</div>
						@Button(ButtonProps{Type: "submit", Variant: "accent"}) {
							Invite
						}
					</div>
				</div>
				<p id={ id + "-invite-hint" } class={ cx("mt-2 min-h-4 px-1 text-[12px]", or(when(p.InviteError != "", "text-[#e5484d]"), "text-mute")) } aria-live="polite">
					{ or(p.InviteError, or(p.InviteMessage, "Separate addresses with a comma, space or Enter.")) }
				</p>
			</form>
		}
		<h4 class="mb-1 mt-7 px-1 text-[12px] font-medium text-mute">Members</h4>
		<ul>
			for _, m := range p.Members {
				<li class="relative" data-asta-team-row={ m.ID }>
					if m.Removed {
						<div data-asta-team-removed class="relative flex h-[60px] items-center gap-3 overflow-hidden rounded-[10px] bg-paper-2 px-3 transition-opacity duration-300 animate-[asta-blk-in_.35s_cubic-bezier(.16,1,.3,1)] data-[gone]:opacity-0">
							<p class="min-w-0 flex-1 truncate text-[13px] text-ink-2" role="status">Removed <span class="text-ink">{ m.Name }</span></p>
							if p.UndoAction != "" {
								@Button(ButtonProps{Variant: "ghost", Size: "xs", Class: "text-brand hover:text-brand", Attrs: teamAction(p, p.UndoAction, "member", m.ID)}) {
									Undo
								}
							}
							<span aria-hidden="true" data-asta-team-countdown class="absolute inset-x-0 bottom-0 h-0.5 origin-left bg-brand/40" style={ teamUndo(p) }></span>
						</div>
					} else {
						<div class="flex h-[60px] items-center gap-3 rounded-[10px] px-1 transition-colors duration-200 hover:bg-[color-mix(in_srgb,var(--paper-2)_55%,transparent)] sm:px-3">
							<span class="shrink-0 @max-[400px]:hidden">
								@Avatar(AvatarProps{Name: m.Name, Src: m.Src, Size: "sm"})
							</span>
							<div class="min-w-0 flex-1">
								<p class="flex items-center gap-2 truncate text-[13.5px] text-ink">
									<span class="truncate">{ m.Name }</span>
									if m.You {
										<span class="shrink-0 rounded-md bg-paper-2 px-1.5 text-[11px] leading-5 text-mute">You</span>
									}
								</p>
								<p class="truncate text-[12.5px] text-mute">{ m.Email }</p>
							</div>
							<div class="w-[112px] shrink-0 @max-[400px]:w-[96px]">
								@Select(SelectProps{Name: "role", Label: "Role for " + m.Name, Size: "sm", Options: roles, Value: m.Role, Disabled: m.You || p.RoleAction == "", Attrs: teamRoleAttrs(p, m)})
							</div>
							if p.RemoveAction != "" {
								<button
									type="button"
									aria-label={ "Remove " + m.Name }
									title={ or(when(m.You, "You can't remove yourself"), "Remove "+m.Name) }
									disabled?={ m.You }
									class={ teamIconBtn }
									{ teamAction(p, p.RemoveAction, "member", m.ID)... }
								>
									<svg viewBox="0 0 16 16" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
										<path d="M4.5 4.5l7 7M11.5 4.5l-7 7"></path>
									</svg>
								</button>
							}
						</div>
					}
				</li>
			}
		</ul>
		if len(p.Invites) > 0 {
			<h4 class="mb-1 mt-7 px-1 text-[12px] font-medium text-mute">Pending invites</h4>
			<ul>
				for _, inv := range p.Invites {
					<li class={ cx("flex h-[52px] items-center gap-3 px-1 sm:px-3", when(inv.New, "animate-[asta-blk-in_.4s_cubic-bezier(.16,1,.3,1)]")) }>
						<span aria-hidden="true" class="grid h-8 w-8 shrink-0 place-items-center rounded-full @max-[400px]:hidden text-mute shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_14%,transparent)]">
							<svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true">
								<rect x="2" y="3.5" width="12" height="9" rx="1.6"></rect>
								<path d="m2.5 4.5 5.5 4 5.5-4"></path>
							</svg>
						</span>
						<div class="min-w-0 flex-1">
							<p class="truncate text-[13.5px] text-ink">{ inv.Email }</p>
							<p class="truncate text-[12px] text-mute">
								{ teamRoleLabel(p, inv.Role) + when(inv.Sent != "", " · Sent "+inv.Sent) }
							</p>
						</div>
						if p.ResendAction != "" {
							if inv.Resent {
								@Button(ButtonProps{Variant: "ghost", Size: "xs", Attrs: templ.Attributes{"aria-disabled": "true"}}) {
									<span class="animate-[asta-blk-in_.3s_cubic-bezier(.16,1,.3,1)]">Sent</span>
								}
							} else {
								@Button(ButtonProps{Variant: "ghost", Size: "xs", Attrs: teamAction(p, p.ResendAction, "invite", inv.ID)}) {
									Resend
								}
							}
						}
						if p.RevokeAction != "" {
							@Button(ButtonProps{Variant: "ghost", Size: "xs", Attrs: teamAction(p, p.RevokeAction, "invite", inv.ID)}) {
								Revoke
							}
						}
					</li>
				}
			</ul>
		}
	</div>
}

func teamRoleAttrs(p TeamMembersProps, m TeamMember) templ.Attributes {
	if p.RoleAction == "" || m.You {
		return nil
	}
	a := teamAction(p, p.RoleAction, "member", m.ID)
	a["hx-trigger"] = "change"
	return a
}
