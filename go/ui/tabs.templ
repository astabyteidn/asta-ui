package ui

// Tab is one tab of Tabs.
type Tab struct {
	// Value names the tab. It must be unique within the Tabs and safe in an id.
	Value string
	Label string
	// Icon sits before the label.
	Icon templ.Component
	// Count is a small badge after the label, e.g. "12". Empty hides it.
	Count string
	// Content is the panel. With Load set, it is shown until the panel loads, e.g. a skeleton.
	Content templ.Component
	// Load is a URL. htmx fetches it into the panel the first time the tab is shown.
	Load     string
	Disabled bool
	// Attrs go on the tab button, e.g. hx-get with hx-target set to TabPanelID(id, value).
	Attrs templ.Attributes
}

// TabsProps configures Tabs.
type TabsProps struct {
	// ID prefixes the tab and panel ids. Give each Tabs on a page its own.
	ID   string
	Tabs []Tab
	// Active is the Value of the selected tab. Default the first one that is not disabled.
	Active string
	// Variant: "underline" (default), "pill" (a soft slab behind the active tab) or "segmented" (a segmented control).
	Variant string
	// Size is for "segmented" only: "sm" or "md" (default).
	Size string
	// Full stretches a "segmented" list to the parent's width, tabs sharing it evenly.
	Full bool
	// Label is the accessible name of the tab list.
	Label string
	// PanelClass goes on every panel.
	PanelClass string
	// Class goes on the root.
	Class string
	Attrs templ.Attributes
}

// TabID returns the id of a tab button.
func TabID(tabsID, value string) string { return or(tabsID, "tabs") + "-tab-" + value }

// TabPanelID returns the id of a tab panel, e.g. for hx-target.
func TabPanelID(tabsID, value string) string { return or(tabsID, "tabs") + "-panel-" + value }

var tabsList = map[string]string{
	"underline": "relative flex gap-5 overflow-x-auto [scrollbar-width:none] sm:gap-6",
	"pill":      "relative flex gap-1 overflow-x-auto rounded-[10px] bg-paper-2 p-1 [scrollbar-width:none]",
	"segmented": "relative inline-flex rounded-[10px] bg-paper-2 p-1 shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_6%,transparent)]",
}

var tabsIndicator = map[string]string{
	"underline": "bottom-0 h-0.5 rounded-full bg-ink",
	"pill":      "top-1 bottom-1 rounded-[7px] bg-paper shadow-[0_1px_2px_rgb(0_0_0/0.08),inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_8%,transparent)]",
	"segmented": "top-1 bottom-1 rounded-[7px] bg-paper shadow-[0_1px_2px_rgb(0_0_0/0.08),0_3px_10px_-4px_rgb(0_0_0/0.18),inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_8%,transparent)]",
}

var tabsTrigger = map[string]string{
	"underline": "h-11 gap-2 rounded-md text-[14px]",
	"pill":      "h-8 gap-2 rounded-[7px] px-3.5 text-[14px]",
	"segmented": "justify-center gap-1.5 rounded-[7px] [&_svg]:h-[1.05em] [&_svg]:w-[1.05em]",
}

var tabsSegSize = map[string]string{
	"sm": "h-8 px-3 text-[13px]",
	"md": "h-10 px-4 text-[14px]",
}

func tabsVariant(v string) string {
	if _, ok := tabsList[v]; ok {
		return v
	}
	return "underline"
}

func tabsActive(p TabsProps) string {
	for _, t := range p.Tabs {
		if t.Value == p.Active && !t.Disabled {
			return t.Value
		}
	}
	for _, t := range p.Tabs {
		if !t.Disabled {
			return t.Value
		}
	}
	return ""
}

func tabTriggerClass(p TabsProps) string {
	v := tabsVariant(p.Variant)
	return cx("group/tab relative z-10 inline-flex shrink-0 items-center whitespace-nowrap font-medium tracking-[-0.01em] text-mute outline-none",
		"transition-colors duration-300 hover:text-ink focus-visible:ring-2 focus-visible:ring-brand/50 aria-selected:text-ink",
		"disabled:pointer-events-none disabled:opacity-40",
		tabsTrigger[v], when(v == "segmented", pick(tabsSegSize, p.Size, "md")), when(v == "segmented" && p.Full, "flex-1"))
}

func tabPanelTrigger(active bool) string {
	if active {
		return "load"
	}
	return "asta:show once"
}

// Tabs switches between panels. The selected tab has a sliding indicator, and a panel fades in when shown.
// Arrow keys, Home and End move between tabs. Panels are server-rendered, or loaded by htmx with Load.
//
//	@ui.Tabs(ui.TabsProps{ID: "project", Label: "Project", Tabs: []ui.Tab{
//		{Value: "overview", Label: "Overview", Content: overview()},
//		{Value: "activity", Label: "Activity", Count: "4", Load: "/projects/astabyte/activity"},
//	}})
templ Tabs(p TabsProps) {
	{{ v := tabsVariant(p.Variant) }}
	{{ active := tabsActive(p) }}
	<div data-asta-tabs class={ cx(when(v == "segmented" && !p.Full, "inline-flex flex-col"), p.Class) } { p.Attrs... }>
		<div role="tablist" aria-label={ p.Label } class={ cx(tabsList[v], when(v == "segmented" && p.Full, "flex w-full")) }>
			if v == "underline" {
				<span aria-hidden="true" class="absolute inset-x-0 bottom-0 h-px bg-[color-mix(in_srgb,var(--ink)_10%,transparent)]"></span>
			}
			<span aria-hidden="true" data-asta-tab-indicator class={ cx("pointer-events-none absolute left-0 origin-left opacity-0 transition-transform duration-500 ease-[cubic-bezier(.16,1,.3,1)] motion-reduce:!transition-none", tabsIndicator[v]) }></span>
			for _, t := range p.Tabs {
				<button
					type="button"
					role="tab"
					id={ TabID(p.ID, t.Value) }
					aria-controls={ TabPanelID(p.ID, t.Value) }
					aria-selected={ boolString(t.Value == active) }
					tabindex={ tabIndex(t.Value == active) }
					disabled?={ t.Disabled }
					class={ tabTriggerClass(p) }
					{ t.Attrs... }
				>
					if t.Icon != nil {
						<span class="inline-flex shrink-0 [&_svg]:h-4 [&_svg]:w-4">
							@t.Icon
						</span>
					}
					{ t.Label }
					if t.Count != "" {
						<span class="rounded-[5px] bg-[color-mix(in_srgb,var(--ink)_7%,transparent)] px-1.5 text-[11px] leading-[18px] tabular-nums text-mute transition-colors duration-300 group-aria-selected/tab:bg-brand group-aria-selected/tab:text-white">{ t.Count }</span>
					}
				</button>
			}
		</div>
		for _, t := range p.Tabs {
			<div
				role="tabpanel"
				id={ TabPanelID(p.ID, t.Value) }
				aria-labelledby={ TabID(p.ID, t.Value) }
				tabindex="0"
				hidden?={ t.Value != active }
				if t.Load != "" {
					hx-get={ t.Load }
					hx-trigger={ tabPanelTrigger(t.Value == active) }
				}
				class={ cx("rounded-md pt-5 outline-none focus-visible:ring-2 focus-visible:ring-brand/50",
					"transition-[opacity,translate] duration-[450ms] ease-[cubic-bezier(.16,1,.3,1)] starting:translate-y-1.5 starting:opacity-0 motion-reduce:transition-none",
					p.PanelClass) }
			>
				if t.Content != nil {
					@t.Content
				}
			</div>
		}
	</div>
}

func boolString(b bool) string {
	if b {
		return "true"
	}
	return "false"
}

func tabIndex(on bool) string {
	if on {
		return "0"
	}
	return "-1"
}
