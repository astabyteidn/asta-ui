package ui

// CardProps configures Card. Every field is optional. The body goes in children.
type CardProps struct {
	Title       string
	Description string
	// Class goes on the panel, e.g. "p-6" or "max-w-md".
	Class string
	Attrs templ.Attributes
}

// Card is a plain panel with an optional title and description over its body.
//
//	@ui.Card(ui.CardProps{Title: "Billing", Description: "Your Astabyte plan and invoices."}) {
//		<p>Pro plan, renews monthly.</p>
//		@ui.CardFooter() { @ui.Button(ui.ButtonProps{}) { Manage } }
//	}
templ Card(p CardProps) {
	<div class={ cx("rounded-[12px] bg-paper p-5 text-ink shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_10%,transparent)]", p.Class) } { p.Attrs... }>
		if p.Title != "" || p.Description != "" {
			<div class="mb-4">
				if p.Title != "" {
					<h3 class="text-[15px] font-medium tracking-[-0.01em] text-ink">{ p.Title }</h3>
				}
				if p.Description != "" {
					<p class="mt-1 text-[13px] leading-relaxed text-mute">{ p.Description }</p>
				}
			</div>
		}
		{ children... }
	</div>
}

// CardFooter lines up a card's actions at the bottom right.
templ CardFooter() {
	<div class="mt-5 flex flex-wrap items-center justify-end gap-2">
		{ children... }
	</div>
}
