package ui

import "strconv"

// OnboardingStep is one item of an Onboarding checklist.
type OnboardingStep struct {
	// ID is posted as step=<ID> when its button is pressed.
	ID    string
	Title string
	// Description is the text in the open step.
	Description string
	// Action is the label of the button that completes the step. Default "Mark as done".
	Action string
	// Duration is a rough time shown while the step is to do, e.g. "2 min".
	Duration string
	Done     bool
}

// OnboardingProps configures Onboarding. The server owns the state: which steps are done and which is open.
type OnboardingProps struct {
	// ID goes on the card. A step's button swaps the whole card with the server's answer. Default "onboarding".
	ID string
	// Title is the heading. Default "Get set up".
	Title    string
	Subtitle string
	Steps    []OnboardingStep
	// Current is the ID of the open step. Default: the first step still to do.
	Current string
	// Action is the URL a step's button posts step=<id> to. Answer with Onboarding again, with that step Done
	// and Current moved on. Without it, step buttons are not shown.
	Action string
	// Error shows under the open step's text, e.g. when completing it failed.
	Error string
	// FinishHref shows a button in the done state, labelled FinishLabel (default "Go to dashboard").
	FinishHref  string
	FinishLabel string
	Class       string
	// Attrs go on the card.
	Attrs templ.Attributes
}

func onboardingID(p OnboardingProps) string { return or(p.ID, "onboarding") }

func onboardingCount(p OnboardingProps) int {
	n := 0
	for _, s := range p.Steps {
		if s.Done {
			n++
		}
	}
	return n
}

func onboardingCurrent(p OnboardingProps) string {
	if p.Current != "" {
		return p.Current
	}
	for _, s := range p.Steps {
		if !s.Done {
			return s.ID
		}
	}
	return ""
}

func onboardingStepVals(id string) string {
	return `{"step":` + strconv.Quote(id) + `}`
}

const (
	onboardingCard = "relative w-full max-w-[440px] overflow-hidden rounded-[14px] bg-paper text-ink " +
		"shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_10%,transparent),0_18px_40px_-24px_rgb(0_0_0/0.3)]"
)

// Onboarding is a setup checklist. One step is open at a time and the bar shows how many are done.
// Completing a step posts it, and the server answers with the card for the next step: htmx keeps the ids,
// so the bar and the ticks ease to their new state. When every step is done the card turns into a done state.
//
//	@ui.Onboarding(ui.OnboardingProps{Action: "/onboarding", Steps: steps})
templ Onboarding(p OnboardingProps) {
	{{ id := onboardingID(p) }}
	{{ count := onboardingCount(p) }}
	{{ total := len(p.Steps) }}
	{{ cur := onboardingCurrent(p) }}
	{{ finished := total > 0 && count == total }}
	<div id={ id } data-asta-onboarding class={ cx(onboardingCard, p.Class) } { p.Attrs... }>
		if finished {
			<div data-asta-onboarding-done class="flex flex-col items-center px-8 py-12 text-center animate-[asta-rise_.5s_cubic-bezier(.16,1,.3,1)_both] motion-reduce:animate-none">
				<span class="flex h-12 w-12 items-center justify-center rounded-full bg-brand text-white animate-[asta-blk-pop_.6s_.1s_cubic-bezier(.16,1,.3,1)_both] motion-reduce:animate-none">
					@onboardingCheck("h-6 w-6")
				</span>
				<h3 class="mt-5 text-[18px] font-medium tracking-[-0.02em] text-ink">You are all set</h3>
				<p class="mt-1.5 max-w-[30ch] text-[13.5px] leading-relaxed text-mute">Every step is done. You can come back to this list from Settings.</p>
				<div class="mt-6 flex gap-2">
					@Button(ButtonProps{Variant: "ghost", Size: "sm", Attrs: templ.Attributes{"data-asta-onboarding-review": true}}) {
						Review steps
					}
					if p.FinishHref != "" {
						@Button(ButtonProps{Size: "sm", Href: p.FinishHref}) {
							{ or(p.FinishLabel, "Go to dashboard") }
						}
					}
				</div>
			</div>
		}
		<div data-asta-onboarding-list hidden?={ finished } class={ when(finished, "animate-[asta-rise_.4s_cubic-bezier(.16,1,.3,1)_both] motion-reduce:animate-none") }>
			<div class="px-5 pb-4 pt-5">
				<div class="flex items-baseline justify-between gap-4">
					<h3 class="text-[15px] font-medium tracking-[-0.01em] text-ink">{ or(p.Title, "Get set up") }</h3>
					<span class="text-[12.5px] tabular-nums text-mute">{ strconv.Itoa(count) } of { strconv.Itoa(total) }</span>
				</div>
				if p.Subtitle != "" {
					<p class="mt-1 text-[13px] text-mute">{ p.Subtitle }</p>
				}
				@ProgressBar(ProgressBarProps{ID: id + "-bar", Label: "Setup progress", HideLabel: true, Size: "sm", Value: float64(count), Max: float64(max(total, 1)), ValueText: strconv.Itoa(count) + " of " + strconv.Itoa(total) + " steps", Class: "mt-4"})
			</div>
			<ol class="px-2 pb-2">
				for _, s := range p.Steps {
					@onboardingItem(p, id, s, s.ID == cur)
				}
			</ol>
		</div>
	</div>
}

templ onboardingItem(p OnboardingProps, id string, s OnboardingStep, open bool) {
	{{ panel := id + "-" + s.ID }}
	<li data-asta-onboarding-step class={ cx("rounded-[10px] transition-colors duration-300", when(open, "bg-paper-2")) }>
		<button
			type="button"
			data-asta-onboarding-toggle
			aria-expanded={ boolString(open) }
			aria-controls={ panel }
			class="group/obt flex w-full items-center gap-3 rounded-[10px] px-3 py-3 text-left outline-none focus-visible:ring-2 focus-visible:ring-brand/50"
		>
			@onboardingMark(panel+"-mark", s.Done)
			<span class={ cx("flex-1 text-[14px] transition-colors duration-300", or(when(s.Done, "text-mute group-aria-expanded/obt:text-ink"), "text-ink")) }>
				{ s.Title }
				if s.Done {
					<span class="sr-only">(done)</span>
				}
			</span>
			if s.Duration != "" && !s.Done {
				<span class="text-[12px] tabular-nums text-mute">{ s.Duration }</span>
			}
			<svg viewBox="0 0 16 16" class="h-3.5 w-3.5 shrink-0 text-mute transition-transform duration-300 ease-[cubic-bezier(.16,1,.3,1)] group-aria-expanded/obt:rotate-180 motion-reduce:transition-none" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
				<path d="m4.5 6.5 3.5 3.5 3.5-3.5"></path>
			</svg>
		</button>
		<div id={ panel } role="region" aria-label={ s.Title } hidden?={ !open } class="pb-4 pl-11 pr-4 animate-[asta-rise_.45s_cubic-bezier(.16,1,.3,1)_both] motion-reduce:animate-none">
			<div class="text-[13px] leading-relaxed text-mute">{ s.Description }</div>
			if open && p.Error != "" {
				<p role="alert" class="mt-2 text-[12.5px] text-[#e5484d]">{ p.Error }</p>
			}
			<div class="mt-3.5 flex items-center gap-2">
				if s.Done {
					<span class="flex items-center gap-1.5 text-[12.5px] text-mute">
						@onboardingCheck("h-3.5 w-3.5 text-brand")
						Done
					</span>
				} else if p.Action != "" {
					@Button(ButtonProps{Size: "sm", Attrs: templ.Attributes{
						"hx-post":   p.Action,
						"hx-vals":   onboardingStepVals(s.ID),
						"hx-target": "#" + id,
						"hx-swap":   "outerHTML",
					}}) {
						{ or(s.Action, "Mark as done") }
					}
				}
			</div>
		</div>
	</li>
}

// onboardingMark is the ring that turns into a filled tick. The ids let htmx ease both when the step is done.
templ onboardingMark(id string, done bool) {
	<span class="relative flex h-5 w-5 shrink-0 items-center justify-center" aria-hidden="true">
		<span
			id={ id + "-ring" }
			class={ cx("absolute inset-0 rounded-full transition-[opacity,transform] duration-300 ease-[cubic-bezier(.16,1,.3,1)]",
				"shadow-[inset_0_0_0_1.5px_color-mix(in_srgb,var(--ink)_22%,transparent)] group-aria-expanded/obt:shadow-[inset_0_0_0_1.5px_var(--ink)]",
				or(when(done, "scale-75 opacity-0"), "scale-100 opacity-100")) }
		></span>
		<span
			id={ id + "-tick" }
			class={ cx("absolute inset-0 flex items-center justify-center rounded-full bg-brand text-white transition-[opacity,transform] duration-500 ease-[cubic-bezier(.16,1,.3,1)]",
				or(when(done, "scale-100 opacity-100"), "scale-50 opacity-0")) }
		>
			@onboardingCheck("h-3 w-3")
		</span>
	</span>
}

templ onboardingCheck(class string) {
	<svg viewBox="0 0 16 16" class={ class } fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M4 8.5l2.5 2.5 5.5-6"></path>
	</svg>
}
