package ui

import (
	"context"
	"io"
	"net/url"
	"strconv"
)

// DataTableColumn is one column of a DataTable.
type DataTableColumn struct {
	// Key is the value sent as ?sort= when this column is sorted.
	Key string
	// Header is the column title.
	Header string
	// Sortable makes the header a link that cycles ascending, descending, off.
	Sortable bool
	// Align: "left" (default), "center" or "right".
	Align string
	// Width is a CSS width, e.g. "120px" or "30%".
	Width string
}

// DataTableProps configures DataTable. Sorting, search and paging are links and a GET form that load
// with htmx, so your handler does the work and renders the table again. Children are DataTableRow.
type DataTableProps struct {
	// ID is required. htmx swaps the element with this id, so your handler may return the whole page or just the table.
	ID string
	// URL is the page the table loads from, e.g. "/invoices". Empty means the current page.
	URL string
	// Params are kept in every link the table builds, e.g. a filter. q, sort, dir and page are set by the table.
	Params url.Values
	// Label is the table's accessible name.
	Label   string
	Columns []DataTableColumn
	// Query is the current search (?q=).
	Query string
	// Sort is the key of the sorted column (?sort=), Dir is "asc" or "desc" (?dir=).
	Sort string
	Dir  string
	// Page is the current page, 1-based (?page=).
	Page int
	// PageSize is the number of rows per page. 0 means one page with everything.
	PageSize int
	// Total is the number of rows that match the search, across all pages. 0 shows the empty state.
	Total int
	// Searchable shows a search box. It loads ?q= as you type.
	Searchable        bool
	SearchPlaceholder string
	// Selectable adds a checkbox to every row and a select-all for the page.
	Selectable bool
	// SelectName is the name of the row checkboxes. Default "ids". Each posts its row ID.
	SelectName string
	// Actions sit on the right of the toolbar. To post the selected rows, give a button
	// hx-post and hx-include="#<ID>-rows", or form="<ID>-rows" with formaction.
	Actions templ.Component
	// Empty is shown when there are no rows and no search. Default "No rows yet.".
	Empty templ.Component
	// MaxHeight scrolls the body past this height, e.g. "420px". The header sticks.
	MaxHeight string
	// NoPushURL keeps the address bar as it is. By default every sort, search and page is pushed to history.
	NoPushURL bool
	// Class goes on the root.
	Class string
	// Attrs go on the root.
	Attrs templ.Attributes
}

// DataTableRowProps configures DataTableRow. Children are TD cells, one per column.
type DataTableRowProps struct {
	// ID is the row's value for its checkbox.
	ID string
	// Selected checks the row's checkbox.
	Selected bool
	Class    string
	// Attrs go on the <tr>.
	Attrs templ.Attributes
}

type dataTableKey struct{}

type dataTableCtx struct {
	selectable bool
	name       string
	id         string
}

func dtState(ctx context.Context) dataTableCtx {
	c, _ := ctx.Value(dataTableKey{}).(dataTableCtx)
	return c
}

// dtRows renders the rows with the table's settings in the context, so DataTableRow knows about selection.
func dtRows(p DataTableProps) templ.Component {
	return templ.ComponentFunc(func(ctx context.Context, w io.Writer) error {
		children := templ.GetChildren(ctx)
		ctx = templ.ClearChildren(ctx)
		c := dataTableCtx{selectable: p.Selectable, name: or(p.SelectName, "ids"), id: p.ID}
		return children.Render(context.WithValue(ctx, dataTableKey{}, c), w)
	})
}

// DataTableHref returns the URL of the table with this search, sort and page, keeping Params.
func DataTableHref(p DataTableProps, q, sort, dir string, page int) string {
	v := url.Values{}
	for k, vs := range p.Params {
		v[k] = vs
	}
	set := func(k, s string) {
		if s == "" {
			v.Del(k)
		} else {
			v.Set(k, s)
		}
	}
	set("q", q)
	set("sort", sort)
	if sort == "" {
		dir = ""
	}
	set("dir", dir)
	if page > 1 {
		set("page", strconv.Itoa(page))
	} else {
		v.Del("page")
	}
	if enc := v.Encode(); enc != "" {
		return p.URL + "?" + enc
	}
	return or(p.URL, "?")
}

// dtSortHref cycles a column: ascending, descending, then off. Sorting goes back to page 1.
func dtSortHref(p DataTableProps, c DataTableColumn) string {
	switch {
	case p.Sort != c.Key:
		return DataTableHref(p, p.Query, c.Key, "asc", 1)
	case p.Dir != "desc":
		return DataTableHref(p, p.Query, c.Key, "desc", 1)
	}
	return DataTableHref(p, p.Query, "", "", 1)
}

func dtSort(p DataTableProps, c DataTableColumn) string {
	if p.Sort != c.Key || !c.Sortable {
		return ""
	}
	return or(when(p.Dir == "desc", "desc"), "asc")
}

func dtPages(p DataTableProps) int {
	if p.PageSize <= 0 || p.Total <= 0 {
		return 1
	}
	return (p.Total + p.PageSize - 1) / p.PageSize
}

func dtPage(p DataTableProps) int {
	return min(max(1, p.Page), dtPages(p))
}

func dtRange(p DataTableProps) string {
	if p.Total <= 0 {
		return "0 rows"
	}
	if p.PageSize <= 0 {
		return strconv.Itoa(p.Total) + " rows"
	}
	pg := dtPage(p)
	from := (pg-1)*p.PageSize + 1
	to := min(p.Total, pg*p.PageSize)
	return strconv.Itoa(from) + "–" + strconv.Itoa(to) + " of " + strconv.Itoa(p.Total)
}

func dtCols(p DataTableProps) int {
	if p.Selectable {
		return len(p.Columns) + 1
	}
	return len(p.Columns)
}

func dtRoot(p DataTableProps) templ.Attributes {
	a := templ.Attributes{
		"hx-boost":    "true",
		"hx-target":   "#" + p.ID,
		"hx-select":   "#" + p.ID,
		"hx-swap":     "outerHTML show:none",
		"hx-push-url": "true",
	}
	if p.NoPushURL {
		a["hx-push-url"] = "false"
	}
	for k, v := range p.Attrs {
		a[k] = v
	}
	return a
}

const (
	dtSearch = "flex h-9 min-w-0 flex-1 items-center gap-2 rounded-lg bg-paper px-3 shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_14%,transparent)] " +
		"transition-shadow duration-200 focus-within:shadow-[inset_0_0_0_1px_var(--brand),0_0_0_4px_color-mix(in_srgb,var(--brand)_16%,transparent)] sm:max-w-[280px]"
	dtStep = "grid h-7 w-7 place-items-center rounded-md text-ink-2 outline-none transition-[background-color,transform,opacity] hover:bg-paper-2 hover:text-ink " +
		"focus-visible:ring-2 focus-visible:ring-brand/50 active:scale-90 aria-disabled:pointer-events-none aria-disabled:opacity-30"
)

// DataTable is a table your server sorts, searches and pages. Header links cycle the sort, the search box
// loads as you type, and the pager steps through pages, all with htmx (hx-boost) and without a full reload.
// Rows slide in after every swap. With Selectable, a select-all covers the page and the footer counts
// what is checked. The rows sit in a form with id "<ID>-rows", so a button can post the checked ones.
//
//	@ui.DataTable(ui.DataTableProps{ID: "invoices", URL: "/invoices", Columns: cols, Sort: sort, Dir: dir,
//		Page: page, PageSize: 8, Total: total, Searchable: true, Selectable: true}) {
//		for _, inv := range rows {
//			@ui.DataTableRow(ui.DataTableRowProps{ID: inv.ID}) {
//				@ui.TD() { { inv.Client } }
//				@ui.TD(ui.TDProps{Align: "right"}) { { inv.Amount } }
//			}
//		}
//	}
templ DataTable(p DataTableProps) {
	<div id={ p.ID } data-asta-dt class={ cx("flex w-full min-w-0 flex-col gap-3", p.Class) } { dtRoot(p)... }>
		if p.Searchable || p.Actions != nil {
			<div class="flex flex-wrap items-center gap-2">
				if p.Searchable {
					<form role="search" method="get" action={ templ.SafeURL(or(p.URL, "?")) } class={ dtSearch } hx-get={ or(p.URL, "?") } hx-trigger="input changed delay:300ms from:find input, search from:find input, submit">
						<svg viewBox="0 0 16 16" class="h-3.5 w-3.5 shrink-0 text-mute" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
							<circle cx="7" cy="7" r="4.5"></circle>
							<path d="m10.5 10.5 3 3"></path>
						</svg>
						<input
							id={ p.ID + "-q" }
							type="search"
							name="q"
							value={ p.Query }
							placeholder={ or(p.SearchPlaceholder, "Search…") }
							aria-label={ or(p.SearchPlaceholder, "Search") }
							autocomplete="off"
							class="h-full min-w-0 flex-1 bg-transparent text-[13.5px] text-ink outline-none placeholder:text-mute [&::-webkit-search-cancel-button]:hidden"
						/>
						for k, vs := range p.Params {
							if k != "q" && k != "page" && k != "sort" && k != "dir" {
								for _, v := range vs {
									<input type="hidden" name={ k } value={ v }/>
								}
							}
						}
						if p.Sort != "" {
							<input type="hidden" name="sort" value={ p.Sort }/>
							<input type="hidden" name="dir" value={ or(p.Dir, "asc") }/>
						}
					</form>
				}
				if p.Actions != nil {
					<div class="ml-auto flex items-center gap-2">
						@p.Actions
					</div>
				}
			</div>
		}
		<form id={ p.ID + "-rows" } class="contents">
			@Table(TableProps{Label: p.Label, MaxHeight: p.MaxHeight}) {
				<thead>
					<tr>
						if p.Selectable {
							<th scope="col" class="sticky top-0 z-10 w-11 bg-paper-2 py-2.5 pl-4 pr-1 text-left">
								@Checkbox(CheckboxProps{Attrs: templ.Attributes{"data-asta-dt-all": true, "aria-label": "Select all rows on this page"}})
							</th>
						}
						for _, c := range p.Columns {
							if c.Sortable {
								@TH(THProps{Align: c.Align, Width: c.Width, SortHref: dtSortHref(p, c), Sort: dtSort(p, c)}) {
									{ c.Header }
								}
							} else {
								@TH(THProps{Align: c.Align, Width: c.Width}) {
									{ c.Header }
								}
							}
						}
					</tr>
				</thead>
				<tbody>
					if p.Total <= 0 {
						if p.Query != "" {
							@TableEmpty(TableEmptyProps{Cols: dtCols(p), Title: "No matches", Text: "Nothing matches “" + p.Query + "”."}) {
								<a href={ templ.SafeURL(DataTableHref(p, "", p.Sort, p.Dir, 1)) } class={ ButtonClass(ButtonProps{Variant: "outline", Size: "sm"}) }>Clear search</a>
							}
						} else if p.Empty != nil {
							<tr>
								<td colspan={ strconv.Itoa(max(1, dtCols(p))) } class="px-4 py-14 text-center">
									@p.Empty
								</td>
							</tr>
						} else {
							@TableEmpty(TableEmptyProps{Cols: dtCols(p)})
						}
					} else {
						@dtRows(p) {
							{ children... }
						}
					}
				</tbody>
			}
		</form>
		<div class="flex flex-wrap items-center justify-between gap-3 px-1 text-[12.5px] text-mute">
			<p class="tabular-nums" aria-live="polite">
				<span data-asta-dt-range>{ dtRange(p) }</span>
				if p.Selectable {
					<span data-asta-dt-picked hidden>
						<span data-asta-dt-count class="font-medium text-ink">0</span> selected
						<button type="button" data-asta-dt-clear class="ml-2 rounded px-1 text-ink-2 underline-offset-2 outline-none hover:text-ink hover:underline focus-visible:ring-2 focus-visible:ring-brand/50">Clear</button>
					</span>
				}
			</p>
			if pages := dtPages(p); pages > 1 {
				{{ pg := dtPage(p) }}
				<nav aria-label="Pagination" class="flex items-center gap-1">
					@dtStepLink(DataTableHref(p, p.Query, p.Sort, p.Dir, pg-1), pg <= 1, "Previous page", "M10 3.5 5.5 8l4.5 4.5")
					<span class="min-w-[70px] text-center tabular-nums">
						Page <span class="text-ink">{ strconv.Itoa(pg) }</span> of { strconv.Itoa(pages) }
					</span>
					@dtStepLink(DataTableHref(p, p.Query, p.Sort, p.Dir, pg+1), pg >= pages, "Next page", "M6 3.5 10.5 8 6 12.5")
				</nav>
			}
		</div>
	</div>
}

templ dtStepLink(href string, off bool, label, d string) {
	if off {
		<span aria-disabled="true" aria-label={ label } class={ dtStep }>
			@dtChevron(d)
		</span>
	} else {
		<a href={ templ.SafeURL(href) } aria-label={ label } class={ dtStep }>
			@dtChevron(d)
		</a>
	}
}

templ dtChevron(d string) {
	<svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d={ d }></path>
	</svg>
}

// DataTableRow is one row of a DataTable. In a selectable table it starts with a checkbox named
// SelectName whose value is ID, and the row tints while it is checked.
templ DataTableRow(p DataTableRowProps) {
	{{ c := dtState(ctx) }}
	@TR(TRProps{Class: cx("has-[[data-asta-dt-row]:checked]:!bg-[color-mix(in_srgb,var(--brand)_7%,transparent)]", p.Class), Attrs: p.Attrs}) {
		if c.selectable {
			<td class="py-3 pl-4 pr-1 align-middle">
				@Checkbox(CheckboxProps{Name: c.name, Value: p.ID, Checked: p.Selected, Attrs: templ.Attributes{"data-asta-dt-row": true, "aria-label": "Select " + p.ID}})
			</td>
		}
		{ children... }
	}
}
