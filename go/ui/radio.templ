package ui

// RadioOption is one choice in a RadioGroup.
type RadioOption struct {
	Value       string
	Label       string
	Description string
	// Aside sits on the right of the option, e.g. a price.
	Aside    string
	Disabled bool
}

// RadioGroupProps configures RadioGroup. Name is required, so the choice posts with the form.
type RadioGroupProps struct {
	Name    string
	Options []RadioOption
	// Value is the selected option's value.
	Value string
	// Variant: "cards" (default) or "list" for compact rows.
	Variant string
	// Columns is the number of cards per row from sm up: 1, 2 or 3 (default).
	Columns int
	// Label is the group's accessible name.
	Label    string
	Required bool
	Disabled bool
	// InputAttrs go on every native radio, e.g. hx-post with hx-trigger "change".
	InputAttrs templ.Attributes
	Class      string
	// Attrs go on the group. The change event bubbles up to it, so hx-* with hx-trigger="change" works here too.
	Attrs templ.Attributes
}

const radioRing = "shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_14%,transparent)]"

var radioCols = map[int]string{1: "", 2: "sm:grid-cols-2", 3: "sm:grid-cols-3"}

func radioGroupClass(p RadioGroupProps) string {
	if p.Variant == "list" {
		return cx("flex flex-col rounded-xl bg-paper p-1.5", radioRing, p.Class)
	}
	cols, ok := radioCols[p.Columns]
	if !ok {
		cols = radioCols[3]
	}
	return cx("grid gap-2.5", cols, p.Class)
}

func radioOptionClass(variant string) string {
	base := "group/radio relative flex cursor-pointer text-left transition-[background-color,box-shadow,opacity] duration-300 ease-[cubic-bezier(.16,1,.3,1)] " +
		"has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-brand/50 has-[:disabled]:cursor-not-allowed has-[:disabled]:opacity-45"
	if variant == "list" {
		return cx(base, "flex-col gap-0.5 rounded-lg px-3 py-2.5 hover:bg-paper-2/60 has-[:checked]:bg-paper-2")
	}
	return cx(base, "flex-col gap-1 rounded-xl bg-paper p-4", radioRing,
		"hover:bg-paper-2 has-[:checked]:bg-paper has-[:checked]:shadow-[inset_0_0_0_2px_var(--brand),0_0_0_4px_color-mix(in_srgb,var(--brand)_14%,transparent)]")
}

// RadioGroup picks one of several options. Each option is a native radio, so arrow keys and forms just work.
// The React version glides one ring between cards. Here each card lights its own ring, since gliding needs measuring.
//
//	@ui.RadioGroup(ui.RadioGroupProps{Name: "plan", Value: "pro", Label: "Plan", Options: []ui.RadioOption{{Value: "pro", Label: "Pro", Aside: "$12"}}})
templ RadioGroup(p RadioGroupProps) {
	<div
		role="radiogroup"
		if p.Label != "" {
			aria-label={ p.Label }
		}
		aria-required?={ p.Required }
		class={ radioGroupClass(p) }
		{ p.Attrs... }
	>
		for _, o := range p.Options {
			<label class={ radioOptionClass(p.Variant) }>
				<span class="flex w-full items-center gap-3">
					@radioDot(p, o)
					<span class="min-w-0 flex-1 text-[14px] font-medium tracking-[-0.01em] text-ink">{ o.Label }</span>
					if o.Aside != "" {
						<span class="text-[13px] tabular-nums text-ink-2">{ o.Aside }</span>
					}
				</span>
				if o.Description != "" {
					<span class="pl-7 text-[13px] leading-snug text-mute">{ o.Description }</span>
				}
			</label>
		}
	</div>
}

// radioDot is the circle. The inner dot pops in when it is checked.
templ radioDot(p RadioGroupProps, o RadioOption) {
	<span class="relative flex h-4 w-4 shrink-0">
		<input
			type="radio"
			name={ p.Name }
			value={ o.Value }
			checked?={ o.Value == p.Value }
			disabled?={ p.Disabled || o.Disabled }
			required?={ p.Required }
			class="peer h-4 w-4 cursor-[inherit] appearance-none rounded-full bg-paper outline-none shadow-[inset_0_0_0_1.5px_color-mix(in_srgb,var(--ink)_24%,transparent)] transition-[background-color,box-shadow] duration-300 group-hover/radio:shadow-[inset_0_0_0_1.5px_color-mix(in_srgb,var(--ink)_40%,transparent)] checked:bg-brand checked:!shadow-none"
			{ p.InputAttrs... }
		/>
		<span aria-hidden="true" class="pointer-events-none absolute inset-0 m-auto h-1.5 w-1.5 scale-0 rounded-full bg-white transition-[scale] duration-300 ease-[cubic-bezier(.16,1,.3,1)] peer-checked:scale-100 motion-reduce:transition-none"></span>
	</span>
}
