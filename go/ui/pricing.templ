package ui

import "strconv"

// PricingPlan is one card of Pricing.
type PricingPlan struct {
	Name        string
	Description string
	// Monthly and Yearly are the price per month for each billing period, in whole units.
	Monthly int
	Yearly  int
	// Features are the lines with a tick.
	Features []string
	// CTALabel and CTAHref make the button. CTAAttrs go on it too.
	CTALabel string
	CTAHref  string
	CTAAttrs templ.Attributes
	// Highlight puts the plan on the dark card with this badge, e.g. "Popular".
	Highlight string
}

// PricingProps configures Pricing.
type PricingProps struct {
	// ID names the billing radios, so several Pricing blocks can share a page. Default "pricing".
	ID    string
	Plans []PricingPlan
	// Currency goes before the price. Default "$".
	Currency string
	// Saving is a badge next to "Yearly", e.g. "−20%".
	Saving string
	// Yearly starts on yearly billing.
	Yearly bool
	// Name is the billing radios' name, posted as "monthly" or "yearly" if Pricing sits in a form. Default ID + "-billing".
	Name  string
	Class string
	// Attrs go on the root.
	Attrs templ.Attributes
}

// pricingDigits pads a and b to the same number of digits. 10 is a blank digit.
func pricingDigits(a, b int) ([]int, []int) {
	sa, sb := strconv.Itoa(max(a, 0)), strconv.Itoa(max(b, 0))
	n := max(len(sa), len(sb))
	pad := func(s string) []int {
		out := make([]int, n)
		for i := range out {
			j := i - (n - len(s))
			if j < 0 {
				out[i] = 10
			} else {
				out[i] = int(s[j] - '0')
			}
		}
		return out
	}
	return pad(sa), pad(sb)
}

// pricingDigit sets which cell each billing period shows and a right-to-left delay.
func pricingDigit(m, y, i, n int) templ.SafeCSS {
	return templ.SafeCSS("--m:" + strconv.Itoa(m) + ";--y:" + strconv.Itoa(y) + ";--dl:" + strconv.Itoa((n-1-i)*60) + "ms")
}

const pricingCard = "relative flex flex-col rounded-xl p-4 @min-[700px]:p-5 transition-transform duration-500 ease-[cubic-bezier(.16,1,.3,1)]"

// Pricing shows plans with a monthly / yearly switch. The switch is two native radios and CSS does the rest,
// so it needs no server round trip and no JavaScript: the pill slides and the prices roll digit by digit.
// Cards stack below 540px of the block's own width.
//
//	@ui.Pricing(ui.PricingProps{Saving: "−20%", Plans: []ui.PricingPlan{{Name: "Pro", Monthly: 12, Yearly: 10, CTALabel: "Start trial", CTAHref: "/signup"}}})
templ Pricing(p PricingProps) {
	{{ id := or(p.ID, "pricing") }}
	{{ name := or(p.Name, id+"-billing") }}
	{{ cur := or(p.Currency, "$") }}
	<div id={ id } data-asta-pricing class={ cx("@container flex w-full flex-col items-center gap-6 text-ink", p.Class) } { p.Attrs... }>
		<div role="radiogroup" aria-label="Billing period" class="relative grid grid-cols-2 rounded-[10px] bg-paper-2 p-1 shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_8%,transparent)]">
			<span aria-hidden="true" data-asta-pricing-pill class="absolute bottom-1 left-1 top-1 w-[calc(50%-4px)] rounded-[7px] bg-paper shadow-[0_1px_2px_rgb(0_0_0/0.12),0_0_0_1px_color-mix(in_srgb,var(--ink)_8%,transparent)]"></span>
			@pricingOption(name, "monthly", "Monthly", "", !p.Yearly)
			@pricingOption(name, "yearly", "Yearly", p.Saving, p.Yearly)
		</div>
		<div class="grid w-full gap-3 @min-[540px]:grid-cols-3">
			for _, pl := range p.Plans {
				@pricingCardView(pl, cur)
			}
		</div>
	</div>
}

templ pricingOption(name, value, label, saving string, checked bool) {
	<label class="relative z-10 flex h-8 cursor-pointer items-center justify-center gap-1.5 rounded-[7px] px-4 text-[13px] font-medium text-mute transition-colors duration-300 hover:text-ink has-[:checked]:text-ink has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-brand/50">
		<input type="radio" name={ name } value={ value } checked?={ checked } class="sr-only"/>
		{ label }
		if saving != "" {
			<span class="rounded-[4px] bg-brand px-1.5 text-[10.5px] leading-[18px] text-white">{ saving }</span>
		}
	</label>
}

templ pricingCardView(pl PricingPlan, cur string) {
	{{ hi := pl.Highlight != "" }}
	<div class={ cx(pricingCard, or(when(hi, "bg-ink text-paper shadow-[0_24px_50px_-24px_rgb(0_0_0/0.5)] @min-[540px]:-translate-y-2"), "bg-paper text-ink shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_12%,transparent)]")) }>
		<div class="flex items-center justify-between gap-2">
			<h3 class="text-[15px] font-medium tracking-[-0.01em]">{ pl.Name }</h3>
			if hi {
				<span class="rounded-[5px] bg-brand px-2 py-0.5 text-[11px] font-medium text-white">{ pl.Highlight }</span>
			}
		</div>
		if pl.Description != "" {
			<p class={ cx("mt-1 text-[12.5px] leading-snug", or(when(hi, "text-paper/60"), "text-mute")) }>{ pl.Description }</p>
		}
		<div class="mt-5 flex items-end gap-1">
			<span class="flex items-start font-medium leading-none tracking-[-0.04em]">
				<span class="mr-0.5 mt-1 text-[20px]">{ cur }</span>
				@pricingNumber(pl.Monthly, pl.Yearly)
			</span>
			<span class={ cx("pb-1 text-[12px]", or(when(hi, "text-paper/55"), "text-mute")) }>/ month</span>
		</div>
		<p data-asta-pricing-yearly-note class={ cx("mt-1.5 h-4 text-[11.5px]", or(when(hi, "text-paper/55"), "text-mute"), when(pl.Yearly <= 0, "invisible")) }>
			Billed { cur }{ strconv.Itoa(pl.Yearly * 12) } a year
		</p>
		@Button(ButtonProps{Href: pl.CTAHref, Variant: or(when(hi, "accent"), "outline"), Pill: true, Class: cx("mt-5 w-full", when(hi, "shadow-none")), Attrs: pl.CTAAttrs}) {
			{ pl.CTALabel }
		}
		if len(pl.Features) > 0 {
			<ul class="mt-5 flex flex-col gap-2">
				for _, f := range pl.Features {
					<li class={ cx("flex gap-2 text-[13px] leading-snug", or(when(hi, "text-paper/85"), "text-ink-2")) }>
						<span class={ or(when(hi, "text-brand"), "text-ink") }>
							<svg viewBox="0 0 16 16" class="mt-[3px] h-3.5 w-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="m3.5 8.5 3 3 6-7"></path>
							</svg>
						</span>
						{ f }
					</li>
				}
			</ul>
		}
	</div>
}

// pricingNumber rolls each digit to the price of the checked billing period. Screen readers get the plain value.
templ pricingNumber(monthly, yearly int) {
	{{ m, y := pricingDigits(monthly, yearly) }}
	<span class="inline-flex text-[40px] tabular-nums">
		<span class="sr-only" data-asta-pricing-for="monthly">{ strconv.Itoa(monthly) }</span>
		<span class="sr-only" data-asta-pricing-for="yearly">{ strconv.Itoa(yearly) }</span>
		<span aria-hidden="true" class="inline-flex">
			for i := range m {
				<span
					class="asta-pricing-digit relative inline-block h-[1em] w-[0.62em] overflow-hidden"
					if m[i] == 10 {
						data-mblank
					}
					if y[i] == 10 {
						data-yblank
					}
					style={ pricingDigit(m[i], y[i], i, len(m)) }
				>
					<span class="asta-pricing-strip absolute inset-x-0 top-0 flex flex-col">
						for n := 0; n < 10; n++ {
							<span class="block h-[1em] text-center leading-[1em]">{ strconv.Itoa(n) }</span>
						}
						<span class="block h-[1em]"></span>
					</span>
				</span>
			}
		</span>
	</span>
}
