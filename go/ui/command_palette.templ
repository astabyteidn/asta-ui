package ui

// CommandPaletteProps configures CommandPalette. Children are CommandGroup blocks holding CommandItem rows.
type CommandPaletteProps struct {
	// ID is required. Any element opens it with Opens(ID).
	ID string
	// Placeholder is the search box hint. Default "Type a command or search…".
	Placeholder string
	// Hotkey opens and closes it with ⌘ or Ctrl plus this key. Default "k". "-" turns it off.
	Hotkey string
	// Search is a URL for server search. The box then sends hx-get with q=<query> as you type and swaps the
	// response (CommandGroup and CommandItem markup) into the list, instead of filtering in the browser.
	Search string
	// Class goes on the panel.
	Class string
	// Attrs are spread onto the root element (hx-*, data-*).
	Attrs templ.Attributes
}

// CommandGroupProps configures CommandGroup. Children are CommandItem rows.
type CommandGroupProps struct {
	// Heading is the small label over the group.
	Heading string
	// Class is merged onto the root element.
	Class string
	// Attrs are spread onto the root element (hx-*, data-*).
	Attrs templ.Attributes
}

// CommandItemProps configures CommandItem.
type CommandItemProps struct {
	// Label is the text that is matched and highlighted.
	Label string
	// Keywords are extra words that match as a plain substring, e.g. synonyms.
	Keywords string
	// Icon is an optional leading icon.
	Icon templ.Component
	// Shortcut is shown on the right, e.g. "⌘N". Display only.
	Shortcut string
	// Href makes the row a link.
	Href string
	// KeepOpen leaves the palette open after the row runs.
	KeepOpen bool
	// Class is merged onto the root element.
	Class string
	// Attrs go on the row, e.g. hx-post. Enter or a click runs it.
	Attrs templ.Attributes
}

// CommandListID returns the id of the result list, e.g. as the hx-target of a server search response.
func CommandListID(id string) string { return id + "-list" }

// CommandPalette is a command menu on the native <dialog>: grouped rows, fuzzy filtering in the browser with
// the matched letters highlighted, ↑ ↓ and Enter, and ⌘K (Ctrl+K) to open it from anywhere. With Search set
// the server answers instead. Escape or a click outside closes it and focus goes back to the opener.
//
//	@ui.CommandPalette(ui.CommandPaletteProps{ID: "cmdk"}) {
//		@ui.CommandGroup(ui.CommandGroupProps{Heading: "Projects"}) {
//			@ui.CommandItem(ui.CommandItemProps{Label: "New project", Shortcut: "⌘N", Attrs: templ.Attributes{"hx-post": "/projects"}})
//		}
//	}
templ CommandPalette(p CommandPaletteProps) {
	<dialog
		id={ p.ID }
		data-asta-command
		data-hotkey={ or(p.Hotkey, "k") }
		if p.Search != "" {
			data-server
		}
		aria-label="Command palette"
		class={ cx("asta-dialog asta-cmd mx-auto mb-auto mt-[10vh] w-[calc(100%-1.5rem)] max-w-[560px] overflow-hidden rounded-xl bg-paper p-0 text-ink outline-none",
			"shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_12%,transparent),0_24px_60px_-20px_rgb(0_0_0/0.4)]", p.Class) }
		{ p.Attrs... }
	>
		<div class="flex max-h-[min(440px,calc(100dvh-10vh-1rem))] flex-col">
			<div class="flex items-center gap-2.5 px-4 shadow-[inset_0_-1px_0_color-mix(in_srgb,var(--ink)_8%,transparent)]">
				<svg viewBox="0 0 16 16" class="h-4 w-4 shrink-0 text-mute" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
					<circle cx="7" cy="7" r="4.5"></circle>
					<path d="m10.5 10.5 3 3" stroke-linecap="round"></path>
				</svg>
				<input
					type="text"
					name="q"
					data-asta-command-input
					autocomplete="off"
					spellcheck="false"
					placeholder={ or(p.Placeholder, "Type a command or search…") }
					role="combobox"
					aria-expanded="true"
					aria-controls={ CommandListID(p.ID) }
					aria-autocomplete="list"
					if p.Search != "" {
						hx-get={ p.Search }
						hx-trigger="input changed delay:150ms, search"
						hx-target={ "#" + CommandListID(p.ID) }
						hx-swap="innerHTML"
					}
					class="h-12 min-w-0 flex-1 bg-transparent text-[15px] text-ink outline-none placeholder:text-mute"
				/>
				<kbd class="rounded-md bg-paper-2 px-1.5 font-sans text-[11px] leading-5 text-mute">Esc</kbd>
			</div>
			<div class="min-h-0 flex-1 overflow-y-auto overscroll-contain p-1.5" data-asta-command-scroll>
				<div id={ CommandListID(p.ID) } role="listbox" aria-label="Results" data-asta-command-list>
					{ children... }
				</div>
				<div data-asta-command-empty hidden role="status" class="flex flex-col items-center px-4 py-10 text-center">
					<span class="flex h-10 w-10 items-center justify-center rounded-full bg-paper-2 text-mute">
						<svg viewBox="0 0 16 16" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
							<circle cx="7" cy="7" r="4.5"></circle>
							<path d="m10.5 10.5 3 3M5.5 7h3"></path>
						</svg>
					</span>
					<p class="mt-3 text-[14px] text-ink">No results for “<span data-asta-command-q></span>”</p>
					<p class="mt-1 text-[13px] text-mute">Try a shorter word, or fewer letters.</p>
				</div>
			</div>
			<div class="flex items-center gap-4 px-4 py-2.5 text-[12px] text-mute shadow-[inset_0_1px_0_color-mix(in_srgb,var(--ink)_8%,transparent)]">
				@commandHint("↑↓", "Navigate")
				@commandHint("↵", "Open")
				@commandHint("Esc", "Close")
				<span class="ml-auto hidden tabular-nums sm:inline" data-asta-command-count></span>
			</div>
		</div>
	</dialog>
}

templ commandHint(key, label string) {
	<span class="flex items-center gap-1.5">
		<kbd class="min-w-5 rounded-md bg-paper-2 px-1 text-center font-sans text-[11px] leading-5 text-ink-2">{ key }</kbd>
		{ label }
	</span>
}

// CommandGroup is a titled block of rows. Groups with no matching rows hide while filtering.
templ CommandGroup(p CommandGroupProps) {
	<div role="group" aria-label={ p.Heading } data-asta-command-group class={ cx("mb-1 last:mb-0", p.Class) } { p.Attrs... }>
		if p.Heading != "" {
			<p aria-hidden="true" class="px-2.5 pb-1 pt-2 text-[11.5px] font-medium text-mute">{ p.Heading }</p>
		}
		<div data-asta-command-items>
			{ children... }
		</div>
	</div>
}

func commandItemClass(p CommandItemProps) string {
	return cx("group/opt relative flex h-10 cursor-pointer select-none items-center gap-3 rounded-[10px] px-2.5 text-[14px] text-ink-2 no-underline outline-none transition-colors duration-150",
		"aria-selected:bg-paper-2 aria-selected:text-ink",
		"before:absolute before:inset-y-2.5 before:left-0 before:w-0.5 before:rounded-full before:bg-brand before:opacity-0 before:content-[''] aria-selected:before:opacity-100", p.Class)
}

// CommandItem is one row of the palette: a link with Href, or an action through its Attrs (hx-post…).
templ CommandItem(p CommandItemProps) {
	if p.Href != "" {
		<a role="option" aria-selected="false" href={ templ.SafeURL(p.Href) } data-asta-command-item data-keywords={ p.Keywords } data-keep-open?={ p.KeepOpen } class={ commandItemClass(p) } { p.Attrs... }>
			@commandItemBody(p)
		</a>
	} else {
		<div role="option" aria-selected="false" data-asta-command-item data-keywords={ p.Keywords } data-keep-open?={ p.KeepOpen } class={ commandItemClass(p) } { p.Attrs... }>
			@commandItemBody(p)
		</div>
	}
}

templ commandItemBody(p CommandItemProps) {
	if p.Icon != nil {
		<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-paper-2 text-mute group-aria-selected/opt:bg-paper group-aria-selected/opt:text-ink [&_svg]:h-3.5 [&_svg]:w-3.5">
			@p.Icon
		</span>
	}
	<span class="min-w-0 flex-1 truncate" data-asta-command-label>{ p.Label }</span>
	if p.Shortcut != "" {
		<kbd class="font-sans text-[11.5px] text-mute">{ p.Shortcut }</kbd>
	}
	@ovIcon("M13 4v4.5a1.5 1.5 0 0 1-1.5 1.5H3.5M6 7l-2.5 3L6 13", "hidden h-3.5 w-3.5 text-mute group-aria-selected/opt:block")
}
