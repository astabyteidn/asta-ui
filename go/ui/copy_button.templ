package ui

// CopyButtonProps configures CopyButton.
type CopyButtonProps struct {
	// Value is the text to copy.
	Value string
	// From is a CSS selector of an element whose text (or value, for inputs) is copied at click time, e.g. "#api-key".
	// It wins over Value.
	From string
	// Label is the visible text. Leave it out for an icon-only button.
	Label string
	// CopiedLabel shows while the check is up. Default "Copied".
	CopiedLabel string
	// Timeout is how long the check stays, in milliseconds. Default 1600.
	Timeout int
	// Variant: "ghost" (default), "outline" or "soft".
	Variant string
	// Size: "sm" or "md" (default).
	Size     string
	Disabled bool
	Class    string
	// Attrs go on the <button>, e.g. aria-label for an icon-only button (default "Copy").
	Attrs templ.Attributes
}

var copyVariant = map[string]string{
	"ghost":   "text-mute hover:bg-paper-2 hover:text-ink",
	"outline": "text-ink-2 shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_14%,transparent)] hover:text-ink hover:shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_26%,transparent)]",
	"soft":    "bg-paper-2 text-ink-2 hover:text-ink",
}

func copyClass(p CopyButtonProps) string {
	md := p.Size != "sm"
	size := "h-7 text-[12.5px]"
	if md {
		size = "h-9 text-[13px]"
	}
	pad := or(when(md, "w-9"), "w-7")
	if p.Label != "" {
		pad = or(when(md, "px-3"), "px-2.5")
	}
	return cx("group/copy inline-flex shrink-0 select-none items-center justify-center gap-1.5 rounded-lg font-medium outline-none",
		"transition-[color,background-color,box-shadow,transform] duration-200 focus-visible:ring-2 focus-visible:ring-brand/50 active:scale-[.96] disabled:pointer-events-none disabled:opacity-40",
		size, pad, pick(copyVariant, p.Variant, "ghost"), p.Class)
}

func copyTimeout(p CopyButtonProps) string {
	if p.Timeout > 0 {
		return sliderNum(float64(p.Timeout))
	}
	return "1600"
}

const copyMotion = "transition-[opacity,transform] duration-300 ease-[cubic-bezier(.16,1,.3,1)] motion-reduce:transition-none"

// CopyButton copies text on click. The copy icon turns away as a check draws itself in, the label rolls to
// "Copied", and both settle back after a moment. Screen readers hear the result.
// It fires "asta:copy" (detail: { text }) on success, so hx-trigger="asta:copy" can log it.
//
//	@ui.CopyButton(ui.CopyButtonProps{Value: "go get github.com/astabyteidn/asta-ui/go", Label: "Copy", Variant: "outline"})
templ CopyButton(p CopyButtonProps) {
	<button
		type="button"
		data-asta-copy={ p.Value }
		if p.From != "" {
			data-asta-copy-from={ p.From }
		}
		data-timeout={ copyTimeout(p) }
		data-state="idle"
		data-copied={ or(p.CopiedLabel, "Copied") }
		if p.Label == "" {
			aria-label="Copy"
		}
		disabled?={ p.Disabled }
		class={ copyClass(p) }
		{ p.Attrs... }
	>
		<span class={ cx("relative flex items-center justify-center", or(when(p.Size == "sm", "h-3.5 w-3.5"), "h-4 w-4")) } aria-hidden="true">
			<svg viewBox="0 0 16 16" class={ cx("absolute inset-0 group-data-[state=copied]/copy:rotate-[-30deg] group-data-[state=copied]/copy:scale-50 group-data-[state=copied]/copy:opacity-0", copyMotion) } fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
				<rect x="5.25" y="5.25" width="8" height="8" rx="2"></rect>
				<path d="M10.75 3.5V3.75A1.75 1.75 0 0 0 9 2H4A2 2 0 0 0 2 4v5a1.75 1.75 0 0 0 1.75 1.75H4" stroke-linecap="round"></path>
			</svg>
			<svg viewBox="0 0 16 16" class={ cx("absolute inset-0 scale-75 text-brand opacity-0 group-data-[state=copied]/copy:scale-100 group-data-[state=copied]/copy:opacity-100", copyMotion) } fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
				<path d="m3.5 8.5 3 3 6-7" pathLength="1" class="asta-copy-tick"></path>
			</svg>
		</span>
		if p.Label != "" {
			<span class="relative grid overflow-hidden" aria-hidden="true">
				<span class={ cx("col-start-1 row-start-1 group-data-[state=copied]/copy:-translate-y-full group-data-[state=copied]/copy:opacity-0 group-data-[state=failed]/copy:-translate-y-full group-data-[state=failed]/copy:opacity-0", copyMotion) }>{ p.Label }</span>
				<span class={ cx("col-start-1 row-start-1 translate-y-full opacity-0 group-data-[state=copied]/copy:translate-y-0 group-data-[state=copied]/copy:opacity-100 group-data-[state=failed]/copy:translate-y-0 group-data-[state=failed]/copy:opacity-100", copyMotion) }>
					<span class="group-data-[state=failed]/copy:hidden">{ or(p.CopiedLabel, "Copied") }</span>
					<span class="hidden group-data-[state=failed]/copy:inline">Couldn't copy</span>
				</span>
			</span>
			<span class="sr-only">{ p.Label }</span>
		}
	</button>
	<span class="sr-only" role="status" aria-live="polite" data-asta-copy-status></span>
}
