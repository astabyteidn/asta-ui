package ui

// WorkspaceSwitcherProps configures WorkspaceSwitcher.
type WorkspaceSwitcherProps struct {
	// ID names the menu panel. Optional.
	ID string
	// Workspaces are the choices, in order.
	Workspaces []Workspace
	// Current is the ID of the current workspace. Default the first one.
	Current string
	// Name adds a hidden input with this name and the picked workspace's ID, for a surrounding form.
	Name string
	// AccountName and AccountEmail show who is signed in at the top of the menu.
	AccountName string
	// AccountEmail is shown under AccountName in the menu header.
	AccountEmail string
	// CreateLabel is the text of the "New workspace" row. The row shows when CreateHref or CreateAttrs is set.
	CreateLabel string
	// CreateHref makes the create row a link.
	CreateHref string
	// CreateAttrs are spread onto the create row (hx-*, data-*).
	CreateAttrs templ.Attributes
	// Footer holds extra rows under the list, e.g. MenuItem rows for settings or sign out.
	Footer templ.Component
	// Class is merged onto the root element.
	Class string
	// Attrs go on the root. Picking a workspace fires "asta:change" (detail: value) on its row.
	Attrs templ.Attributes
}

// Workspace is one entry of WorkspaceSwitcher.
type Workspace struct {
	// ID identifies it.
	ID string
	// Name is the display name.
	Name string
	// Plan is a short tag after the name, e.g. "Pro".
	Plan string
	// Logo is an image URL. The first letter shows without it.
	Logo string
	// Meta is muted text under the name in the list, e.g. "4 members".
	Meta string
	// Href makes picking it a link. Without it, use Attrs (hx-post…) or listen for "asta:change".
	Href string
	// Attrs are spread onto the root element (hx-*, data-*).
	Attrs templ.Attributes
}

const (
	wsRow    = "group/item flex w-full cursor-pointer items-center gap-2.5 rounded-[8px] px-2 py-1.5 text-left no-underline outline-none transition-colors duration-100 hover:bg-[color-mix(in_srgb,var(--ink)_6%,transparent)] focus:bg-[color-mix(in_srgb,var(--ink)_6%,transparent)]"
	wsLogoSm = "[&>*]:h-6 [&>*]:w-6 [&>*]:rounded-[6px] [&>*]:text-[11.5px]"
	wsLogoMd = "[&>*]:h-8 [&>*]:w-8 [&>*]:rounded-[8px] [&>*]:text-[13px]"
)

func wsCurrent(p WorkspaceSwitcherProps) Workspace {
	for _, w := range p.Workspaces {
		if w.ID == p.Current {
			return w
		}
	}
	if len(p.Workspaces) > 0 {
		return p.Workspaces[0]
	}
	return Workspace{}
}

// WorkspaceSwitcher is the account and workspace picker at the top of an app sidebar. The menu drops in from the
// trigger and is as wide as it, ↑ ↓ move, Enter picks, Escape or a click outside closes it, and the current
// workspace carries a check. Picking one updates the trigger at once.
//
//	@ui.WorkspaceSwitcher(ui.WorkspaceSwitcherProps{Workspaces: ws, Current: "studio", CreateHref: "/workspaces/new"})
templ WorkspaceSwitcher(p WorkspaceSwitcherProps) {
	{{ cur := wsCurrent(p) }}
	<div data-asta-dropdown data-asta-ws data-match class={ cx("group/dd relative", p.Class) } { p.Attrs... }>
		<button
			type="button"
			data-asta-dropdown-trigger
			aria-haspopup="menu"
			aria-expanded="false"
			if p.ID != "" {
				id={ p.ID + "-trigger" }
				aria-controls={ p.ID }
			}
			class="flex w-full cursor-pointer items-center gap-2.5 rounded-[9px] px-2 py-1.5 text-left outline-none transition-colors duration-150 hover:bg-[color-mix(in_srgb,var(--ink)_6%,transparent)] focus-visible:shadow-[0_0_0_2px_var(--brand)] group-data-[open]/dd:bg-[color-mix(in_srgb,var(--ink)_6%,transparent)]"
		>
			<span data-ws-logo-out class={ cx("flex shrink-0", wsLogoSm) }>
				@wsLogo(cur)
			</span>
			<span data-ws-name-out class="min-w-0 flex-1 truncate text-[13.5px] font-medium text-ink">{ cur.Name }</span>
			<span data-ws-plan-out hidden?={ cur.Plan == "" } class="shrink-0 rounded-[5px] bg-[color-mix(in_srgb,var(--brand)_12%,transparent)] px-1.5 py-0.5 text-[11px] font-medium text-brand">{ cur.Plan }</span>
			@ovIcon("m4 6 4 4 4-4", "h-3.5 w-3.5 shrink-0 text-mute transition-transform duration-300 ease-[cubic-bezier(.16,1,.3,1)] group-data-[open]/dd:rotate-180 motion-reduce:transition-none")
		</button>
		<div
			role="menu"
			popover="manual"
			tabindex="-1"
			data-asta-mpanel
			aria-label="Workspaces"
			if p.ID != "" {
				id={ p.ID }
			}
			class={ cx(floatPanel, "min-w-[240px] rounded-[12px]") }
		>
			if p.AccountName != "" {
				<div class="px-2.5 pb-2 pt-1.5">
					<p class="truncate text-[13px] font-medium text-ink">{ p.AccountName }</p>
					if p.AccountEmail != "" {
						<p class="truncate text-[12px] text-mute">{ p.AccountEmail }</p>
					}
				</div>
			}
			for _, w := range p.Workspaces {
				@wsRowItem(p, w, w.ID == cur.ID)
			}
			if p.CreateHref != "" || p.CreateAttrs != nil {
				@MenuItem(MenuItemProps{Href: p.CreateHref, Class: "mt-1 !h-auto gap-2.5 !rounded-[8px] !px-2 py-1.5 text-[13px] text-ink-2 focus:text-ink", Attrs: p.CreateAttrs}) {
					<span class="inline-flex items-center gap-2.5">
						<span class="grid h-8 w-8 place-items-center rounded-[8px] shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_14%,transparent)]">
							@ovIcon("M8 3.5v9M3.5 8h9", "h-4 w-4")
						</span>
						{ or(p.CreateLabel, "New workspace") }
					</span>
				}
			}
			if p.Footer != nil {
				<div class="mt-1 pt-1">
					@p.Footer
				</div>
			}
		</div>
	</div>
}

templ wsRowItem(p WorkspaceSwitcherProps, w Workspace, on bool) {
	if w.Href != "" {
		<a role="menuitemradio" tabindex="-1" href={ templ.SafeURL(w.Href) } aria-checked={ boolString(on) } data-group="workspace" data-value={ w.ID } data-ws-name={ w.Name } data-ws-plan={ w.Plan } class={ wsRow } { w.Attrs... }>
			@wsRowBody(p, w, on)
		</a>
	} else {
		<button type="button" role="menuitemradio" tabindex="-1" aria-checked={ boolString(on) } data-group="workspace" data-value={ w.ID } data-ws-name={ w.Name } data-ws-plan={ w.Plan } class={ wsRow } { w.Attrs... }>
			@wsRowBody(p, w, on)
		</button>
	}
}

templ wsRowBody(p WorkspaceSwitcherProps, w Workspace, on bool) {
	<span data-ws-logo-box class={ cx("flex shrink-0", wsLogoMd) }>
		@wsLogo(w)
	</span>
	<span class="min-w-0 flex-1">
		<span class="flex items-center gap-1.5">
			<span class="truncate text-[13px] font-medium text-ink">{ w.Name }</span>
			if w.Plan != "" {
				<span class="shrink-0 text-[11px] text-mute">{ w.Plan }</span>
			}
		</span>
		if w.Meta != "" {
			<span class="block truncate text-[12px] text-mute">{ w.Meta }</span>
		}
	</span>
	@ovIcon("M3.5 8.5l3 3 6-7", "hidden h-4 w-4 shrink-0 text-brand group-aria-checked/item:block")
	if p.Name != "" {
		<input type="hidden" name={ p.Name } value={ w.ID } disabled?={ !on }/>
	}
}

templ wsLogo(w Workspace) {
	if w.Logo != "" {
		<img src={ w.Logo } alt="" width="32" height="32" loading="lazy" class="shrink-0 object-cover"/>
	} else {
		<span aria-hidden="true" class="grid shrink-0 place-items-center bg-brand font-semibold text-white">{ sbInitial(w.Name) }</span>
	}
}
