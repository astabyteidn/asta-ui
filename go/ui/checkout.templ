package ui

import (
	"math"
	"net/http"
	"strconv"
	"strings"
)

// CheckoutItem is one line of the order.
type CheckoutItem struct {
	// ID names the line's quantity field: qty_<ID>.
	ID   string
	Name string
	// Variant is the size, colour or plan, e.g. "Oat · M".
	Variant string
	// Price is the unit price in major units, e.g. 48 or 12.5.
	Price float64
	Qty   int
	// Image is a thumbnail URL. Without it the first letter of Name shows.
	Image string
}

// CheckoutShipping is one shipping speed.
type CheckoutShipping struct {
	ID    string
	Label string
	// ETA is shown under the label, e.g. "2–4 business days".
	ETA   string
	Price float64
}

// CheckoutProps configures Checkout. Action is required. The server owns every number: read the post with
// CheckoutRead, check it, and answer with Checkout (errors or Done) or CheckoutSummary (new totals).
type CheckoutProps struct {
	// ID goes on the form. Default "checkout".
	ID string
	// Action is the URL Pay posts the whole form to. Answer with Checkout: with Errors, or with Done.
	Action string
	// QuoteAction is the URL the summary posts the form to when a quantity, the shipping speed or the promo
	// code changes. Answer with CheckoutSummary. Without it the totals only update on Pay.
	QuoteAction string
	Items       []CheckoutItem
	// ShippingOptions default to Standard (free) and Express.
	ShippingOptions []CheckoutShipping
	// Countries default to a short list. The value posts as "country".
	Countries []SelectOption
	// TaxRate is a fraction of the discounted subtotal, e.g. 0.11.
	TaxRate float64
	// PromoCode is the applied code, posted back as "promo". PromoRate is its discount as a fraction, e.g. 0.1.
	PromoCode string
	PromoRate float64
	// PromoMessage is shown under the promo field, e.g. "That code isn't valid."
	PromoMessage string
	// Values are the fields as posted: email, name, address, city, postal, country, shipping,
	// cardNumber, cardExpiry and cardCvc. Don't keep card details anywhere.
	Values map[string]string
	// Errors from the server, keyed like Values, plus "form" for a payment that failed.
	Errors map[string]string
	// Done shows the receipt instead of the form.
	Done bool
	// Currency is the symbol before amounts when Format is nil. Default "$".
	Currency string
	// Format turns an amount into text. Default: Currency, thousands separators and two decimals.
	Format func(float64) string
	Class  string
	// Attrs go on the form.
	Attrs templ.Attributes
}

// CheckoutTotals is what Checkout shows, worked out from the props.
type CheckoutTotals struct {
	Subtotal, Discount, Shipping, Tax, Total float64
}

var checkoutDefaultShipping = []CheckoutShipping{
	{ID: "standard", Label: "Standard", ETA: "3–5 business days", Price: 0},
	{ID: "express", Label: "Express", ETA: "1–2 business days", Price: 14},
}

var checkoutDefaultCountries = []SelectOption{
	{Value: "ID", Label: "Indonesia"},
	{Value: "SG", Label: "Singapore"},
	{Value: "AU", Label: "Australia"},
	{Value: "GB", Label: "United Kingdom"},
	{Value: "US", Label: "United States"},
}

func checkoutShippingOptions(p CheckoutProps) []CheckoutShipping {
	if len(p.ShippingOptions) > 0 {
		return p.ShippingOptions
	}
	return checkoutDefaultShipping
}

func checkoutCountries(p CheckoutProps) []SelectOption {
	if len(p.Countries) > 0 {
		return p.Countries
	}
	return checkoutDefaultCountries
}

// checkoutShip returns the picked shipping option, or the first one.
func checkoutShip(p CheckoutProps) CheckoutShipping {
	opts := checkoutShippingOptions(p)
	for _, s := range opts {
		if s.ID == p.Values["shipping"] {
			return s
		}
	}
	return opts[0]
}

func checkoutRound(f float64) float64 { return math.Round(f*100) / 100 }

// Totals works out the subtotal, discount, shipping, tax and total, the same way the summary shows them.
// Charge this, not a number posted by the browser.
func (p CheckoutProps) Totals() CheckoutTotals {
	var t CheckoutTotals
	for _, i := range p.Items {
		t.Subtotal += i.Price * float64(i.Qty)
	}
	t.Discount = checkoutRound(t.Subtotal * p.PromoRate)
	t.Shipping = checkoutShip(p).Price
	t.Tax = checkoutRound((t.Subtotal - t.Discount) * p.TaxRate)
	t.Total = math.Max(0, t.Subtotal-t.Discount+t.Shipping+t.Tax)
	return t
}

// CheckoutRead fills p from a Checkout post: Values from the fields and each item's Qty from qty_<ID>
// (clamped to 1–99). The promo code is posted as "promo"; checking it is up to you.
func CheckoutRead(r *http.Request, p CheckoutProps) CheckoutProps {
	p.Values = map[string]string{}
	for _, k := range []string{"email", "name", "address", "city", "postal", "country", "shipping", "cardNumber", "cardExpiry", "cardCvc"} {
		p.Values[k] = strings.TrimSpace(r.FormValue(k))
	}
	items := make([]CheckoutItem, len(p.Items))
	copy(items, p.Items)
	for i := range items {
		if q, err := strconv.Atoi(r.FormValue("qty_" + items[i].ID)); err == nil {
			items[i].Qty = min(max(q, 1), 99)
		}
	}
	p.Items = items
	return p
}

func checkoutMoney(p CheckoutProps, f float64) string {
	if p.Format != nil {
		return p.Format(f)
	}
	neg := f < 0
	s := strconv.FormatFloat(math.Abs(f), 'f', 2, 64)
	whole, frac, _ := strings.Cut(s, ".")
	var b strings.Builder
	for i, c := range whole {
		if i > 0 && (len(whole)-i)%3 == 0 {
			b.WriteByte(',')
		}
		b.WriteRune(c)
	}
	out := or(p.Currency, "$") + b.String() + "." + frac
	if neg {
		return "−" + out
	}
	return out
}

func checkoutLetter(name string) string {
	for _, r := range strings.TrimSpace(name) {
		return strings.ToUpper(string(r))
	}
	return ""
}

func checkoutID(p CheckoutProps) string { return or(p.ID, "checkout") }

func checkoutState(err string) string { return when(err != "", "error") }

func checkoutLast4(card string) string {
	d := strings.Map(func(r rune) rune {
		if r >= '0' && r <= '9' {
			return r
		}
		return -1
	}, card)
	if len(d) > 4 {
		return d[len(d)-4:]
	}
	return d
}

// Checkout is a one-page checkout: contact, shipping and payment on the left, the order on the right.
// Card fields format as you type. A quantity, the shipping speed or a promo code asks the server for new
// totals (QuoteAction), and changed amounts roll in. Pay posts everything to Action. There is no payment
// integration: wire your provider in the handler.
//
//	@ui.Checkout(ui.CheckoutProps{Action: "/pay", QuoteAction: "/quote", Items: cart, TaxRate: 0.11})
templ Checkout(p CheckoutProps) {
	{{ id := checkoutID(p) }}
	{{ t := p.Totals() }}
	<form
		id={ id }
		data-asta-checkout
		action={ templ.SafeURL(p.Action) }
		method="post"
		novalidate
		hx-post={ p.Action }
		hx-target={ "#" + id }
		hx-swap="outerHTML"
		hx-indicator="find button[type=submit]"
		class={ cx("grid w-full gap-8 text-ink md:grid-cols-[minmax(0,1fr)_340px] md:gap-10", p.Class) }
		{ p.Attrs... }
	>
		<div class="min-w-0">
			if p.Done {
				<div class="flex h-full min-h-[420px] flex-col items-start justify-center animate-[asta-blk-in_.5s_cubic-bezier(.16,1,.3,1)]" role="status">
					<span class="grid h-12 w-12 place-items-center rounded-full bg-brand text-white animate-[asta-blk-pop_.55s_.1s_cubic-bezier(.16,1,.3,1)_both]">
						<svg viewBox="0 0 16 16" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="m3.5 8.5 3 3 6-7"></path>
						</svg>
					</span>
					<h3 class="mt-6 text-[24px] font-medium tracking-[-0.03em] text-ink">Payment received</h3>
					<p class="mt-2 max-w-[360px] text-[14px] leading-relaxed text-mute">
						We charged { checkoutMoney(p, t.Total) } to the card ending { checkoutLast4(p.Values["cardNumber"]) }. A receipt is on its way to { p.Values["email"] }.
					</p>
				</div>
			} else {
				<div class="grid gap-9">
					@checkoutSection(1, "Contact") {
						@checkoutField(p, id, "email", "Email", "email", "email", "you@example.com", "", "")
					}
					@checkoutSection(2, "Shipping") {
						@checkoutField(p, id, "name", "Full name", "text", "name", "", "", "")
						@checkoutField(p, id, "address", "Address", "text", "street-address", "", "", "")
						<div class="grid grid-cols-2 gap-3">
							@checkoutField(p, id, "city", "City", "text", "address-level2", "", "", "")
							@checkoutField(p, id, "postal", "Postal code", "text", "postal-code", "", "numeric", "")
						</div>
						@Field(FieldProps{Label: "Country", For: id + "-country", Error: p.Errors["country"]}) {
							@Select(SelectProps{ID: id + "-country", Name: "country", Options: checkoutCountries(p), Value: or(p.Values["country"], checkoutCountries(p)[0].Value)})
						}
						<div role="radiogroup" aria-label="Shipping speed" class="mt-1 grid gap-2 sm:grid-cols-2">
							for _, s := range checkoutShippingOptions(p) {
								<label class="relative flex cursor-pointer items-start justify-between gap-3 rounded-[10px] p-3 shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_12%,transparent)] transition-shadow duration-300 hover:shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_26%,transparent)] has-[:checked]:shadow-[inset_0_0_0_1.5px_var(--brand)] has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-brand/50">
									<input type="radio" name="shipping" value={ s.ID } checked?={ s.ID == checkoutShip(p).ID } data-asta-checkout-recalc class="sr-only"/>
									<span>
										<span class="block text-[13.5px] text-ink">{ s.Label }</span>
										<span class="block text-[12px] text-mute">{ s.ETA }</span>
									</span>
									<span class="text-[13px] tabular-nums text-ink">
										if s.Price > 0 {
											{ checkoutMoney(p, s.Price) }
										} else {
											Free
										}
									</span>
								</label>
							}
						</div>
					}
					@checkoutSection(3, "Payment") {
						@checkoutField(p, id, "cardNumber", "Card number", "text", "cc-number", "1234 1234 1234 1234", "numeric", "card")
						<div class="grid grid-cols-2 gap-3">
							@checkoutField(p, id, "cardExpiry", "Expiry", "text", "cc-exp", "MM / YY", "numeric", "expiry")
							@checkoutField(p, id, "cardCvc", "CVC", "text", "cc-csc", "123", "numeric", "cvc")
						</div>
					}
					<div>
						@Button(ButtonProps{Type: "submit", Variant: "accent", Size: "lg", Class: "w-full"}) {
							<span>Pay</span>
							@checkoutPayTotal(id, checkoutMoney(p, t.Total), false)
						}
						if p.Errors["form"] != "" {
							<p role="alert" class="mt-3 text-center text-[12.5px] text-[#e5484d] animate-[asta-field-in_.3s_cubic-bezier(.16,1,.3,1)_both]">{ p.Errors["form"] }</p>
						} else {
							<p class="mt-3 text-center text-[12px] text-mute">Payments are encrypted. You won't be charged twice.</p>
						}
					</div>
				</div>
			}
		</div>
		@checkoutSummary(p, false)
	</form>
}

// CheckoutSummary is the order summary on its own, for the handler that answers QuoteAction.
// It also updates the amount on the Pay button.
//
//	p = ui.CheckoutRead(r, p)
//	ui.CheckoutSummary(p).Render(r.Context(), w)
templ CheckoutSummary(p CheckoutProps) {
	@checkoutSummary(p, true)
	if !p.Done {
		@checkoutPayTotal(checkoutID(p), checkoutMoney(p, p.Totals().Total), true)
	}
}

templ checkoutPayTotal(id, total string, oob bool) {
	<span
		id={ id + "-pay-total" }
		if oob {
			hx-swap-oob="true"
		}
	>{ total }</span>
}

templ checkoutSummary(p CheckoutProps, oob bool) {
	{{ id := checkoutID(p) }}
	{{ t := p.Totals() }}
	<aside
		id={ id + "-summary" }
		aria-label="Order summary"
		data-asta-checkout-summary
		if p.QuoteAction != "" {
			hx-post={ p.QuoteAction }
			hx-trigger="asta:recalc"
			hx-include={ "#" + id }
			hx-target="this"
			hx-swap="outerHTML"
			hx-sync="this:replace"
			hx-indicator="this"
		}
		class="h-max rounded-[14px] bg-paper-2 p-5 md:sticky md:top-4"
	>
		<h3 class="text-[14px] font-medium tracking-[-0.01em] text-ink">Order</h3>
		<ul class="mt-4 grid gap-4">
			for _, i := range p.Items {
				<li class="flex gap-3">
					if i.Image != "" {
						<img src={ i.Image } alt="" class="h-14 w-14 shrink-0 rounded-[10px] bg-paper object-cover"/>
					} else {
						<span aria-hidden="true" class="grid h-14 w-14 shrink-0 place-items-center rounded-[10px] bg-paper text-[15px] font-medium text-mute">{ checkoutLetter(i.Name) }</span>
					}
					<div class="min-w-0 flex-1">
						<div class="flex items-baseline justify-between gap-3">
							<p class="truncate text-[13.5px] text-ink">{ i.Name }</p>
							@checkoutAmount("line-"+i.ID, checkoutMoney(p, i.Price*float64(i.Qty)), "text-[13px] text-ink")
						</div>
						if i.Variant != "" {
							<p class="text-[12px] text-mute">{ i.Variant }</p>
						}
						<div class="-ml-1 mt-1">
							@checkoutStepper(id, i, p.Done)
						</div>
					</div>
				</li>
			}
		</ul>
		<div class="mt-5">
			if p.PromoCode != "" {
				<p class="flex items-center justify-between text-[12.5px] text-ink-2">
					<input type="hidden" name="promo" value={ p.PromoCode } data-asta-checkout-promo/>
					<span>Code <span class="font-medium text-ink">{ p.PromoCode }</span></span>
					<button type="button" data-asta-checkout-promo-remove disabled?={ p.Done } class="rounded text-mute outline-none hover:text-ink focus-visible:ring-2 focus-visible:ring-brand/50 disabled:opacity-40">Remove</button>
				</p>
			} else {
				<details class="group/promo" open?={ p.PromoMessage != "" }>
					<summary class="w-max cursor-pointer list-none rounded text-[12.5px] text-ink-2 underline decoration-[color-mix(in_srgb,var(--ink)_25%,transparent)] underline-offset-4 outline-none hover:text-ink focus-visible:ring-2 focus-visible:ring-brand/50 group-open/promo:hidden [&::-webkit-details-marker]:hidden">Add a promo code</summary>
					<div class="flex gap-2 animate-[asta-blk-in_.3s_cubic-bezier(.16,1,.3,1)]">
						@Input(InputProps{ID: id + "-promo", Name: "promo", Size: "sm", Placeholder: "Promo code", Disabled: p.Done, Attrs: templ.Attributes{"aria-label": "Promo code", "data-asta-checkout-promo": true, "autocomplete": "off"}})
						@Button(ButtonProps{Size: "sm", Variant: "outline", Disabled: p.Done, Attrs: templ.Attributes{"data-asta-checkout-apply": true}}) {
							Apply
						}
					</div>
				</details>
			}
			<p class="mt-1.5 min-h-4 text-[12px] text-mute" aria-live="polite">{ p.PromoMessage }</p>
		</div>
		<dl class="mt-3 grid gap-2">
			<div class="flex items-baseline justify-between gap-4 text-[13px]">
				<dt class="text-mute">Subtotal</dt>
				<dd>
					@checkoutAmount("subtotal", checkoutMoney(p, t.Subtotal), "text-ink")
				</dd>
			</div>
			if t.Discount > 0 {
				<div class="flex items-baseline justify-between gap-4 text-[13px] animate-[asta-blk-in_.35s_cubic-bezier(.16,1,.3,1)]">
					<dt class="text-mute">Discount</dt>
					<dd class="text-brand">
						@checkoutAmount("discount", "−"+checkoutMoney(p, t.Discount), "")
					</dd>
				</div>
			}
			<div class="flex items-baseline justify-between gap-4 text-[13px]">
				<dt class="text-mute">Shipping</dt>
				<dd class="text-ink">
					if t.Shipping > 0 {
						@checkoutAmount("shipping", checkoutMoney(p, t.Shipping), "")
					} else {
						Free
					}
				</dd>
			</div>
			if p.TaxRate > 0 {
				<div class="flex items-baseline justify-between gap-4 text-[13px]">
					<dt class="text-mute">Tax</dt>
					<dd>
						@checkoutAmount("tax", checkoutMoney(p, t.Tax), "text-ink")
					</dd>
				</div>
			}
			<div class="mt-3 flex items-baseline justify-between gap-4 pt-1">
				<dt class="text-[14px] font-medium text-ink">Total</dt>
				<dd>
					@checkoutAmount("total", checkoutMoney(p, t.Total), "text-[20px] font-medium tracking-[-0.02em] text-ink")
				</dd>
			</div>
		</dl>
	</aside>
}

// checkoutAmount is an amount blocks.js can roll when the server sends a new one for the same key.
templ checkoutAmount(key, text, class string) {
	<span data-asta-money={ key } class={ cx("inline-flex overflow-hidden tabular-nums", class) }>
		<span class="inline-block">{ text }</span>
	</span>
}

templ checkoutStepper(id string, i CheckoutItem, locked bool) {
	{{ btn := "grid h-6 w-6 place-items-center rounded-md text-ink-2 outline-none transition-colors duration-200 hover:bg-paper hover:text-ink focus-visible:ring-2 focus-visible:ring-brand/50 disabled:opacity-35 disabled:hover:bg-transparent" }}
	<div class="inline-flex items-center gap-1" role="group" aria-label={ "Quantity of " + i.Name } data-asta-checkout-qty>
		<input type="hidden" name={ "qty_" + i.ID } value={ strconv.Itoa(i.Qty) }/>
		<button type="button" id={ id + "-less-" + i.ID } class={ btn } aria-label="Fewer" data-asta-checkout-step="-1" disabled?={ locked || i.Qty <= 1 }>
			<svg viewBox="0 0 12 12" class="h-3 w-3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M2.5 6h7"></path></svg>
		</button>
		<span class="w-5 text-center text-[12.5px] tabular-nums text-ink" data-asta-checkout-qty-text>{ strconv.Itoa(i.Qty) }</span>
		<button type="button" id={ id + "-more-" + i.ID } class={ btn } aria-label="More" data-asta-checkout-step="1" disabled?={ locked || i.Qty >= 99 }>
			<svg viewBox="0 0 12 12" class="h-3 w-3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M2.5 6h7M6 2.5v7"></path></svg>
		</button>
	</div>
}

templ checkoutSection(n int, title string) {
	<fieldset class="min-w-0">
		<legend class="mb-4 flex items-center gap-2.5 text-[14px] font-medium tracking-[-0.01em] text-ink">
			<span class="grid h-5 w-5 place-items-center rounded-md bg-paper-2 text-[11px] tabular-nums text-ink-2">{ strconv.Itoa(n) }</span>
			{ title }
		</legend>
		<div class="grid gap-3">
			{ children... }
		</div>
	</fieldset>
}

templ checkoutField(p CheckoutProps, id, key, label, typ, autocomplete, placeholder, inputmode, format string) {
	{{ a := templ.Attributes{"autocomplete": autocomplete} }}
	if inputmode != "" {
		{{ a["inputmode"] = inputmode }}
	}
	if format != "" {
		{{ a["data-asta-checkout-format"] = format }}
	}
	@Field(FieldProps{Label: label, For: id + "-" + key, Error: p.Errors[key]}) {
		@Input(InputProps{ID: id + "-" + key, Name: key, Type: typ, Value: p.Values[key], Placeholder: placeholder, State: checkoutState(p.Errors[key]), Trailing: checkoutWhen(format == "card", checkoutCardGlyph()), Attrs: a})
	}
}

func checkoutWhen(ok bool, c templ.Component) templ.Component {
	if ok {
		return c
	}
	return nil
}

templ checkoutCardGlyph() {
	<svg viewBox="0 0 20 14" class="!h-3.5 !w-5" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
		<rect x=".75" y=".75" width="18.5" height="12.5" rx="2.2"></rect>
		<path d="M.75 4.5h18.5M4 9.5h4" stroke-linecap="round"></path>
	</svg>
}
