package ui

import "strconv"

// TextareaProps configures Textarea. Attrs go on the <textarea> itself (hx-post, hx-trigger, maxlength…).
type TextareaProps struct {
	ID          string
	Name        string
	Value       string
	Placeholder string
	// Rows is the starting height in lines. Default 3.
	Rows int
	// AutoGrow grows the box with its content, using CSS field-sizing. Browsers without it keep a fixed height.
	AutoGrow bool
	// MaxRows caps AutoGrow, then the box scrolls. Default 10.
	MaxRows int
	// State: "" (default) or "error".
	State    string
	Disabled bool
	Required bool
	ReadOnly bool
	// Class goes on the wrapper.
	Class string
	Attrs templ.Attributes
}

func textareaRows(p TextareaProps) string {
	if p.Rows > 0 {
		return strconv.Itoa(p.Rows)
	}
	return "3"
}

// Line height is 1.55 at 14px, and the padding adds 24px.
func textareaStyle(p TextareaProps) templ.SafeCSS {
	if !p.AutoGrow {
		return ""
	}
	rows, max := p.Rows, p.MaxRows
	if rows <= 0 {
		rows = 3
	}
	if max <= 0 {
		max = 10
	}
	return templ.SafeCSS("min-height:calc(" + strconv.Itoa(rows) + "lh + 24px);max-height:calc(" + strconv.Itoa(max) + "lh + 24px)")
}

// Textarea is a multi-line text field. Wrap it in Field for a label, a hint and a counter.
// The React version counts characters live with a ring. Here use Field's Counter, set by the server.
//
//	@ui.Textarea(ui.TextareaProps{ID: "bio", Name: "bio", Placeholder: "Tell the Astabyte team about you", AutoGrow: true})
templ Textarea(p TextareaProps) {
	<div
		class={ cx("relative w-full rounded-xl bg-paper text-ink transition-shadow duration-200",
			or(when(p.State == "error", "shadow-[inset_0_0_0_1px_#e5484d] focus-within:shadow-[inset_0_0_0_1px_#e5484d,0_0_0_4px_rgb(229_72_77/0.16)]"),
				"shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_14%,transparent)] hover:shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_24%,transparent)] focus-within:!shadow-[inset_0_0_0_1px_var(--brand),0_0_0_4px_color-mix(in_srgb,var(--brand)_16%,transparent)]"),
			when(p.Disabled, "opacity-50"), p.Class) }
	>
		<textarea
			if p.ID != "" {
				id={ p.ID }
			}
			if p.Name != "" {
				name={ p.Name }
			}
			rows={ textareaRows(p) }
			if p.Placeholder != "" {
				placeholder={ p.Placeholder }
			}
			disabled?={ p.Disabled }
			required?={ p.Required }
			readonly?={ p.ReadOnly }
			aria-invalid?={ p.State == "error" }
			class={ cx("block w-full resize-none bg-transparent px-3.5 py-3 text-[14px] leading-[1.55] outline-none placeholder:text-mute disabled:cursor-not-allowed",
				when(p.AutoGrow, "[field-sizing:content] overflow-y-auto")) }
			style={ textareaStyle(p) }
			{ p.Attrs... }
		>{ p.Value }</textarea>
	</div>
}
