package ui

import "strconv"

// RangeSliderProps configures RangeSlider.
type RangeSliderProps struct {
	// Names are the form fields of the low and high values, e.g. {"min_price", "max_price"}.
	Names [2]string
	// Value is the low and high value. Zero values mean the whole range.
	Value [2]float64
	// Min defaults to 0.
	Min float64
	// Max defaults to 100.
	Max float64
	// Step defaults to 1.
	Step float64
	// MinGap is the smallest distance the two thumbs keep between them.
	MinGap float64
	// Prefix and Suffix wrap the number in the value bubbles, e.g. "$" or "%".
	Prefix string
	Suffix string
	// Labels are the accessible names of the two thumbs. Default "Minimum" and "Maximum".
	Labels   [2]string
	Disabled bool
	Class    string
	// Attrs go on the root. Both inputs fire "change" on release: hx-post with hx-trigger="change" and hx-include="this".
	Attrs templ.Attributes
}

func rangeBounds(p RangeSliderProps) (lo, hi, mn, mx float64) {
	mn, mx = p.Min, p.Max
	if mx <= mn {
		mx = mn + 100
	}
	lo, hi = p.Value[0], p.Value[1]
	if lo == 0 && hi == 0 {
		lo, hi = mn, mx
	}
	lo = min(mx, max(mn, lo))
	hi = min(mx, max(lo, hi))
	return
}

func rangePct(v, mn, mx float64) float64 { return (v - mn) / (mx - mn) * 100 }

func rangeFill(p RangeSliderProps) templ.SafeCSS {
	lo, hi, mn, mx := rangeBounds(p)
	a, b := rangePct(lo, mn, mx), rangePct(hi, mn, mx)
	return templ.SafeCSS("transform:translateX(" + strconv.FormatFloat(a, 'f', 3, 64) + "%) scaleX(" + strconv.FormatFloat((b-a)/100, 'f', 5, 64) + ")")
}

func rangeAt(v, mn, mx float64) templ.SafeCSS {
	return templ.SafeCSS("transform:translateX(" + strconv.FormatFloat(rangePct(v, mn, mx), 'f', 3, 64) + "cqw)")
}

const (
	rangeInput = "pointer-events-none absolute inset-0 h-5 w-full appearance-none bg-transparent outline-none disabled:cursor-not-allowed " +
		"[&::-webkit-slider-runnable-track]:h-5 [&::-webkit-slider-runnable-track]:bg-transparent " +
		"[&::-webkit-slider-thumb]:pointer-events-auto [&::-webkit-slider-thumb]:h-5 [&::-webkit-slider-thumb]:w-5 [&::-webkit-slider-thumb]:cursor-grab [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:bg-paper " +
		"[&::-webkit-slider-thumb]:shadow-[0_0_0_1.5px_var(--brand),0_2px_6px_-1px_rgb(0_0_0/0.18)] [&::-webkit-slider-thumb]:transition-[scale,box-shadow] [&::-webkit-slider-thumb]:duration-200 [&::-webkit-slider-thumb]:ease-[cubic-bezier(.16,1,.3,1)] " +
		"hover:[&::-webkit-slider-thumb]:scale-105 active:[&::-webkit-slider-thumb]:scale-110 active:[&::-webkit-slider-thumb]:cursor-grabbing " +
		"focus-visible:[&::-webkit-slider-thumb]:shadow-[0_0_0_1.5px_var(--brand),0_0_0_5px_color-mix(in_srgb,var(--brand)_22%,transparent)] motion-reduce:[&::-webkit-slider-thumb]:transition-none " +
		"[&::-moz-range-track]:bg-transparent [&::-moz-range-thumb]:pointer-events-auto [&::-moz-range-thumb]:h-5 [&::-moz-range-thumb]:w-5 [&::-moz-range-thumb]:cursor-grab [&::-moz-range-thumb]:rounded-full [&::-moz-range-thumb]:border-0 [&::-moz-range-thumb]:bg-paper " +
		"[&::-moz-range-thumb]:shadow-[0_0_0_1.5px_var(--brand),0_2px_6px_-1px_rgb(0_0_0/0.18)] [&::-moz-range-thumb]:transition-[scale,box-shadow] [&::-moz-range-thumb]:duration-200 " +
		"hover:[&::-moz-range-thumb]:scale-105 active:[&::-moz-range-thumb]:scale-110 " +
		"focus-visible:[&::-moz-range-thumb]:shadow-[0_0_0_1.5px_var(--brand),0_0_0_5px_color-mix(in_srgb,var(--brand)_22%,transparent)]"
	rangeBubble = "pointer-events-none absolute bottom-full left-0 mb-2.5 -translate-x-1/2 translate-y-1 whitespace-nowrap rounded-[6px] bg-ink px-2 py-1 text-[12px] font-medium tabular-nums leading-none text-paper opacity-0 " +
		"transition-[opacity,translate] duration-200 ease-[cubic-bezier(.16,1,.3,1)] motion-reduce:transition-none"
)

// RangeSlider is two native range inputs on one track for picking a range, so both ends post with the form.
// The thumbs never cross and keep MinGap apart, and a value bubble rises over the thumb you drag, hover or focus.
//
//	@ui.RangeSlider(ui.RangeSliderProps{Names: [2]string{"min", "max"}, Value: [2]float64{20, 80}, Prefix: "$"})
templ RangeSlider(p RangeSliderProps) {
	{{ lo, hi, mn, mx := rangeBounds(p) }}
	<div
		data-asta-range
		data-gap={ sliderNum(max(0, p.MinGap)) }
		data-prefix={ p.Prefix }
		data-suffix={ p.Suffix }
		class={ cx("group/range relative w-full select-none pb-1 pt-9", when(p.Disabled, "pointer-events-none opacity-50"), p.Class) }
		{ p.Attrs... }
	>
		<div class="relative h-5">
			<div data-asta-range-track class="absolute inset-y-0 left-[10px] right-[10px] flex cursor-pointer items-center [container-type:inline-size] [touch-action:none]">
				<span aria-hidden="true" class="absolute inset-x-0 h-1 rounded-full bg-[color-mix(in_srgb,var(--ink)_12%,transparent)]"></span>
				<span aria-hidden="true" data-asta-range-fill class="absolute inset-x-0 h-1 origin-left bg-brand" style={ rangeFill(p) }></span>
				for i, v := range []float64{lo, hi} {
					<span aria-hidden="true" data-asta-range-at={ strconv.Itoa(i) } class="pointer-events-none absolute left-0 top-0 h-full w-0" style={ rangeAt(v, mn, mx) }>
						<span class={ cx(rangeBubble, rangeShow(i)) } data-asta-range-bubble>{ p.Prefix + sliderNum(v) + p.Suffix }</span>
					</span>
				}
			</div>
			for i, v := range []float64{lo, hi} {
				<input
					type="range"
					if p.Names[i] != "" {
						name={ p.Names[i] }
					}
					min={ sliderNum(mn) }
					max={ sliderNum(mx) }
					step={ sliderNum(sliderStep(SliderProps{Step: p.Step})) }
					value={ sliderNum(v) }
					aria-label={ or(p.Labels[i], []string{"Minimum", "Maximum"}[i]) }
					aria-valuetext={ p.Prefix + sliderNum(v) + p.Suffix }
					disabled?={ p.Disabled }
					data-asta-range-input={ strconv.Itoa(i) }
					class={ cx(rangeInput, when(i == 0 && lo >= mx, "z-10")) }
				/>
			}
		</div>
	</div>
}

// rangeShow lifts a bubble while its thumb is hovered, dragged or focused from the keyboard.
func rangeShow(i int) string {
	if i == 0 {
		return "group-has-[[data-asta-range-input='0']:hover]/range:translate-y-0 group-has-[[data-asta-range-input='0']:hover]/range:opacity-100 " +
			"group-has-[[data-asta-range-input='0']:active]/range:translate-y-0 group-has-[[data-asta-range-input='0']:active]/range:opacity-100 " +
			"group-has-[[data-asta-range-input='0']:focus-visible]/range:translate-y-0 group-has-[[data-asta-range-input='0']:focus-visible]/range:opacity-100"
	}
	return "group-has-[[data-asta-range-input='1']:hover]/range:translate-y-0 group-has-[[data-asta-range-input='1']:hover]/range:opacity-100 " +
		"group-has-[[data-asta-range-input='1']:active]/range:translate-y-0 group-has-[[data-asta-range-input='1']:active]/range:opacity-100 " +
		"group-has-[[data-asta-range-input='1']:focus-visible]/range:translate-y-0 group-has-[[data-asta-range-input='1']:focus-visible]/range:opacity-100"
}
