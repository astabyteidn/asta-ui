package ui

// SelectOption is one choice in a Select.
type SelectOption struct {
	Value    string
	Label    string
	Disabled bool
}

// SelectProps configures Select. Attrs go on the <select> itself (hx-get, hx-trigger…).
type SelectProps struct {
	ID      string
	Name    string
	Options []SelectOption
	// Value is the selected option's value.
	Value string
	// Placeholder shows while nothing is picked. It can't be picked again.
	Placeholder string
	// Label is the accessible name, for selects without a visible label.
	Label string
	// Size: "md" (default) or "sm".
	Size string
	// State: "" (default) or "error".
	State    string
	Disabled bool
	Required bool
	// Class goes on the wrapper.
	Class string
	Attrs templ.Attributes
}

var selectSize = map[string]string{
	"sm": "h-8 rounded-md pl-2.5 pr-8 text-[13px]",
	"md": "h-10 rounded-lg pl-3 pr-9 text-[14px]",
}

var selectRing = map[string]string{
	"default": "shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_14%,transparent)] hover:shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_24%,transparent)] " +
		"focus:!shadow-[inset_0_0_0_1px_var(--brand),0_0_0_3px_color-mix(in_srgb,var(--brand)_18%,transparent)]",
	"error": "shadow-[inset_0_0_0_1px_#e5484d] focus:shadow-[inset_0_0_0_1px_#e5484d,0_0_0_3px_rgb(229_72_77/0.16)]",
}

// Select is the native <select>, styled like the kit trigger with a chevron.
// The list itself is the browser's own, so it has no search, icons or hints like the React version.
//
//	@ui.Select(ui.SelectProps{ID: "plan", Name: "plan", Placeholder: "Pick a plan", Options: []ui.SelectOption{{Value: "pro", Label: "Pro"}}})
templ Select(p SelectProps) {
	<div class={ cx("group/sel relative w-full", p.Class) }>
		<select
			if p.ID != "" {
				id={ p.ID }
			}
			if p.Name != "" {
				name={ p.Name }
			}
			if p.Label != "" {
				aria-label={ p.Label }
			}
			disabled?={ p.Disabled }
			required?={ p.Required }
			aria-invalid?={ p.State == "error" }
			class={ cx("w-full cursor-pointer appearance-none truncate bg-paper text-ink outline-none transition-shadow duration-200",
				"disabled:cursor-not-allowed disabled:opacity-45",
				"[&:has(option[value='']:checked)]:text-mute [&_option]:bg-paper [&_option]:text-ink",
				pick(selectSize, p.Size, "md"), pick(selectRing, p.State, "default")) }
			{ p.Attrs... }
		>
			if p.Placeholder != "" {
				<option value="" disabled hidden selected?={ !selectHas(p.Options, p.Value) }>{ p.Placeholder }</option>
			}
			for _, o := range p.Options {
				<option value={ o.Value } selected?={ o.Value == p.Value } disabled?={ o.Disabled }>{ o.Label }</option>
			}
		</select>
		<svg
			viewBox="0 0 16 16"
			class={ cx("pointer-events-none absolute top-1/2 h-4 w-4 -translate-y-1/2 text-mute group-has-[select:disabled]/sel:opacity-45",
				or(when(p.Size == "sm", "right-2.5"), "right-3")) }
			fill="none"
			stroke="currentColor"
			stroke-width="1.6"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<path d="m4 6 4 4 4-4"></path>
		</svg>
	</div>
}

func selectHas(opts []SelectOption, v string) bool {
	if v == "" {
		return false
	}
	for _, o := range opts {
		if o.Value == v {
			return true
		}
	}
	return false
}
