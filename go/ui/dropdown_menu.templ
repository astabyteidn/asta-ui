package ui

// DropdownMenuProps configures DropdownMenu. Children are MenuItem, MenuCheckbox, MenuRadio, MenuSub, MenuLabel and MenuSeparator.
type DropdownMenuProps struct {
	// ID names the menu panel. The trigger gets ID + "-trigger". Optional, but it wires aria-controls.
	ID string
	// Label is the trigger text.
	Label string
	// Icon sits before the label, or alone with IconOnly.
	Icon templ.Component
	// IconOnly makes a square trigger. Set AriaLabel too.
	IconOnly bool
	// AriaLabel names the trigger when its content is only an icon.
	AriaLabel string
	// Variant is the trigger's button variant. Default "outline".
	Variant string
	// Size is the trigger's button size. Default "md".
	Size string
	// Align: "start" (default) lines the menu up with the trigger's left edge, "end" with its right edge.
	Align string
	// NoChevron hides the arrow after the label.
	NoChevron bool
	// MenuClass goes on the menu panel, e.g. "min-w-[280px]".
	MenuClass string
	// Class goes on the root.
	Class string
	// Attrs go on the root.
	Attrs templ.Attributes
}

// MenuSubProps configures MenuSub. Children are the items of the submenu.
type MenuSubProps struct {
	// Label is the text of the item that opens the submenu.
	Label string
	// Icon sits before the label.
	Icon templ.Component
	// Disabled greys it out and skips it in keyboard navigation.
	Disabled bool
	// MenuClass goes on the submenu panel.
	MenuClass string
	// Class goes on the item.
	Class string
	// Attrs go on the item.
	Attrs templ.Attributes
}

// MenuCheckboxProps configures MenuCheckbox. Children are the label.
type MenuCheckboxProps struct {
	// Checked is the initial state.
	Checked bool
	// Name and Value add a hidden input that is sent with the closest form (or hx-include) while checked.
	Name string
	// Value is posted under Name when selected.
	Value string
	// Shortcut is shown on the right. Display only.
	Shortcut string
	// Disabled greys it out and skips it in keyboard navigation.
	Disabled bool
	// KeepOpen leaves the menu open after a click, so several boxes can be ticked in a row.
	KeepOpen bool
	// Class is merged onto the root element.
	Class string
	// Attrs go on the item. It fires "asta:change" (detail: checked, value) after it toggles,
	// so hx-trigger="asta:change" sends the new state.
	Attrs templ.Attributes
}

// MenuRadioProps configures MenuRadio. Children are the label.
type MenuRadioProps struct {
	// Name groups the radios of one panel. It is also the hidden input's name.
	Name string
	// Value is sent while this radio is checked.
	Value string
	// Checked is the initial state.
	Checked bool
	// Shortcut is the key hint shown on the right; display only.
	Shortcut string
	// Disabled greys it out and skips it in keyboard navigation.
	Disabled bool
	// KeepOpen leaves the menu open after a click.
	KeepOpen bool
	// Class is merged onto the root element.
	Class string
	// Attrs go on the item. It fires "asta:change" when it becomes checked.
	Attrs templ.Attributes
}

const (
	// floatPanel is the shared surface of the top-layer menus (dropdown, context menu, submenus).
	floatPanel = "asta-float fixed inset-auto m-0 max-w-[calc(100vw-16px)] overflow-visible rounded-xl bg-paper p-1.5 text-left text-ink outline-none " +
		"shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_10%,transparent),0_12px_32px_-12px_rgb(0_0_0/0.28),0_4px_10px_-6px_rgb(0_0_0/0.12)]"
)

// DropdownMenu is Menu with more item kinds: checkbox and radio items, and submenus that open to the side.
// The panel lives in the top layer (the popover attribute), so a scroll box or a table never cuts it off,
// and it flips up when there is no room below. Arrows, Home, End, type-ahead, Escape, outside clicks and
// focus return work, also after an htmx swap. Use the plain Menu when you only need actions.
//
//	@ui.DropdownMenu(ui.DropdownMenuProps{ID: "view", Label: "View"}) {
//		@ui.MenuCheckbox(ui.MenuCheckboxProps{Checked: true, Name: "grid", Value: "on"}) { Show grid }
//		@ui.MenuSub(ui.MenuSubProps{Label: "Sort by"}) {
//			@ui.MenuRadio(ui.MenuRadioProps{Name: "sort", Value: "name", Checked: true}) { Name }
//			@ui.MenuRadio(ui.MenuRadioProps{Name: "sort", Value: "date"}) { Date }
//		}
//	}
templ DropdownMenu(p DropdownMenuProps) {
	<div
		data-asta-dropdown
		if p.Align == "end" {
			data-align="end"
		}
		class={ cx("group/dd relative inline-flex", p.Class) }
		{ p.Attrs... }
	>
		<button
			type="button"
			data-asta-dropdown-trigger
			aria-haspopup="menu"
			aria-expanded="false"
			if p.ID != "" {
				id={ p.ID + "-trigger" }
				aria-controls={ p.ID }
			}
			if p.AriaLabel != "" {
				aria-label={ p.AriaLabel }
			}
			class={ cx(ButtonClass(ButtonProps{Variant: or(p.Variant, "outline"), Size: p.Size, IconOnly: p.IconOnly}), "group-data-[open]/dd:bg-paper-2") }
		>
			if p.Icon != nil {
				<span class={ cx("inline-flex shrink-0 [&_svg]:h-[1.1em] [&_svg]:w-[1.1em]", when(!p.IconOnly, "-ml-0.5")) }>
					@p.Icon
				</span>
			}
			{ p.Label }
			if !p.NoChevron && !p.IconOnly {
				@ovIcon("m4 6 4 4 4-4", "-mr-1 h-3.5 w-3.5 text-mute transition-transform duration-300 ease-[cubic-bezier(.16,1,.3,1)] group-data-[open]/dd:rotate-180 motion-reduce:transition-none")
			}
		</button>
		<div
			role="menu"
			popover="manual"
			tabindex="-1"
			data-asta-mpanel
			if p.ID != "" {
				id={ p.ID }
				aria-labelledby={ p.ID + "-trigger" }
			}
			class={ cx(floatPanel, "min-w-[232px]", p.MenuClass) }
		>
			{ children... }
		</div>
	</div>
}

// MenuSub is an item that opens a submenu to its side, on hover, click or the right arrow.
// The left arrow or Escape goes back. It works in DropdownMenu and ContextMenu.
templ MenuSub(p MenuSubProps) {
	<div class="relative" data-asta-menu-sub>
		<button
			type="button"
			role="menuitem"
			tabindex="-1"
			aria-haspopup="menu"
			aria-expanded="false"
			disabled?={ p.Disabled }
			class={ cx(menuItemClass(MenuItemProps{}), "aria-expanded:bg-paper-2", p.Class) }
			{ p.Attrs... }
		>
			if p.Icon != nil {
				<span class="inline-flex h-4 w-4 shrink-0 text-mute group-hover/item:text-ink group-focus/item:text-ink group-aria-expanded/item:text-ink [&_svg]:h-4 [&_svg]:w-4">
					@p.Icon
				</span>
			}
			<span class="flex-1 truncate">{ p.Label }</span>
			@ovIcon("m6 4 4 4-4 4", "-mr-1 h-3.5 w-3.5 text-mute")
		</button>
		<div role="menu" popover="manual" tabindex="-1" data-asta-mpanel aria-label={ p.Label } class={ cx(floatPanel, "min-w-[200px]", p.MenuClass) }>
			{ children... }
		</div>
	</div>
}

// MenuCheckbox is an item with a check mark that toggles on click.
//
//	@ui.MenuCheckbox(ui.MenuCheckboxProps{Checked: true, KeepOpen: true}) { Show minimap }
templ MenuCheckbox(p MenuCheckboxProps) {
	<button
		type="button"
		role="menuitemcheckbox"
		tabindex="-1"
		aria-checked={ boolString(p.Checked) }
		disabled?={ p.Disabled }
		data-keep-open?={ p.KeepOpen }
		if p.Value != "" {
			data-value={ p.Value }
		}
		class={ menuItemClass(MenuItemProps{Class: p.Class}) }
		{ p.Attrs... }
	>
		<span class="inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-[5px] text-ink shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_18%,transparent)] transition-colors duration-150 group-aria-checked/item:bg-brand group-aria-checked/item:text-white group-aria-checked/item:shadow-none">
			@ovIcon("m4 8.5 2.5 2.5L12 5.5", "h-3 w-3 scale-50 opacity-0 transition-[opacity,transform] duration-200 ease-[cubic-bezier(.16,1,.3,1)] group-aria-checked/item:scale-100 group-aria-checked/item:opacity-100 motion-reduce:transition-none")
		</span>
		<span class="flex-1 truncate">
			{ children... }
		</span>
		if p.Shortcut != "" {
			<kbd class="font-sans text-[11.5px] tracking-wide text-mute">{ p.Shortcut }</kbd>
		}
		if p.Name != "" {
			<input type="hidden" name={ p.Name } value={ or(p.Value, "on") } disabled?={ !p.Checked }/>
		}
	</button>
}

// MenuRadio is one choice of a group of items that share a Name. Picking it unchecks the others.
//
//	@ui.MenuRadio(ui.MenuRadioProps{Name: "density", Value: "compact"}) { Compact }
templ MenuRadio(p MenuRadioProps) {
	<button
		type="button"
		role="menuitemradio"
		tabindex="-1"
		aria-checked={ boolString(p.Checked) }
		disabled?={ p.Disabled }
		data-keep-open?={ p.KeepOpen }
		data-group={ p.Name }
		data-value={ p.Value }
		class={ menuItemClass(MenuItemProps{Class: p.Class}) }
		{ p.Attrs... }
	>
		<span class="inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-full shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_18%,transparent)] transition-shadow duration-150 group-aria-checked/item:shadow-[inset_0_0_0_1.5px_var(--brand)]">
			<span class="h-2 w-2 scale-0 rounded-full bg-brand transition-transform duration-200 ease-[cubic-bezier(.16,1,.3,1)] group-aria-checked/item:scale-100 motion-reduce:transition-none"></span>
		</span>
		<span class="flex-1 truncate">
			{ children... }
		</span>
		if p.Shortcut != "" {
			<kbd class="font-sans text-[11.5px] tracking-wide text-mute">{ p.Shortcut }</kbd>
		}
		if p.Name != "" {
			<input type="hidden" name={ p.Name } value={ p.Value } disabled?={ !p.Checked }/>
		}
	</button>
}

// ovIcon is a 16px stroke icon from one path, shared by the overlay components.
templ ovIcon(d, class string) {
	<svg viewBox="0 0 16 16" class={ class } fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d={ d }></path>
	</svg>
}
