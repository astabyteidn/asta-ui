package ui

import (
	"strconv"
	"strings"
	"time"
)

// DatePickerProps configures DatePicker.
type DatePickerProps struct {
	// ID prefixes the ids inside. Default "date".
	ID string
	// Name is the form field. It posts yyyy-mm-dd, or "start/end" with Range.
	Name string
	// Value is yyyy-mm-dd, or "yyyy-mm-dd/yyyy-mm-dd" with Range.
	Value string
	// Range picks a start and an end, with a soft band between them.
	Range bool
	// Min and Max (yyyy-mm-dd) bound the days that can be picked.
	Min string
	Max string
	// Locale is a BCP 47 tag for month and weekday names, e.g. "en-GB" or "id-ID". Default "en-US".
	Locale string
	// WeekStartsOn: 0 = Sunday (default), 1 = Monday.
	WeekStartsOn int
	// Placeholder defaults to "Pick a date" ("Pick dates" with Range).
	Placeholder string
	// Label is the accessible name of the trigger.
	Label string
	// Size: "sm" or "md" (default).
	Size     string
	Disabled bool
	Class    string
	// Attrs go on the hidden input, which fires "change" when a date is picked: hx-get with hx-trigger="change".
	Attrs templ.Attributes
}

func dateParse(s string) (time.Time, bool) {
	t, err := time.Parse("2006-01-02", strings.TrimSpace(s))
	return t, err == nil
}

// dateShown is the trigger text before the script formats it in the page's locale.
func dateShown(p DatePickerProps) string {
	if !p.Range {
		if t, ok := dateParse(p.Value); ok {
			return t.Format("Jan 2, 2006")
		}
		return ""
	}
	a, b, _ := strings.Cut(p.Value, "/")
	ta, oka := dateParse(a)
	tb, okb := dateParse(b)
	if oka && okb {
		return ta.Format("Jan 2, 2006") + " – " + tb.Format("Jan 2, 2006")
	}
	return ""
}

func dateValue(p DatePickerProps) string {
	if dateShown(p) == "" {
		return ""
	}
	return strings.TrimSpace(p.Value)
}

func datePlaceholder(p DatePickerProps) string {
	if p.Placeholder != "" {
		return p.Placeholder
	}
	return or(when(p.Range, "Pick dates"), "Pick a date")
}

// DatePicker is a date field that opens a month calendar. Arrow keys move by day and week, Page Up/Down by month
// (Shift for a year), Home/End to the week's edges, Enter picks and Escape closes. Range picks a start and an end.
// It posts a hidden yyyy-mm-dd value, so the server never parses a locale's format.
//
//	@ui.DatePicker(ui.DatePickerProps{ID: "due", Name: "due", Label: "Due date", Min: "2026-01-01"})
templ DatePicker(p DatePickerProps) {
	{{ id, shown := or(p.ID, "date"), dateShown(p) }}
	<div
		data-asta-date={ or(when(p.Range, "range"), "single") }
		data-locale={ or(p.Locale, "en-US") }
		data-week={ strconv.Itoa(min(1, max(0, p.WeekStartsOn))) }
		data-min={ p.Min }
		data-max={ p.Max }
		data-placeholder={ datePlaceholder(p) }
		class={ cx("group/date relative w-full", p.Class) }
	>
		<button
			type="button"
			id={ id }
			disabled?={ p.Disabled }
			if p.Label != "" {
				aria-label={ p.Label }
			}
			aria-haspopup="dialog"
			aria-expanded="false"
			aria-controls={ id + "-cal" }
			data-asta-date-trigger
			class={ cx("flex w-full items-center gap-2 bg-paper text-left outline-none transition-shadow duration-200 focus-visible:ring-2 focus-visible:ring-brand/50 disabled:cursor-not-allowed disabled:opacity-45",
				"shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_14%,transparent)] hover:shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_24%,transparent)]",
				"group-data-[open]/date:!shadow-[inset_0_0_0_1px_var(--brand),0_0_0_3px_color-mix(in_srgb,var(--brand)_18%,transparent)]",
				or(when(p.Size == "sm", "h-8 rounded-md px-2.5 text-[13px]"), "h-10 rounded-lg px-3 text-[14px]")) }
		>
			<svg viewBox="0 0 16 16" class="h-4 w-4 shrink-0 text-mute" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
				<rect x="2.5" y="3.5" width="11" height="10" rx="2"></rect>
				<path d="M2.5 6.5h11M5.5 2v3M10.5 2v3"></path>
			</svg>
			<span data-asta-date-text class={ cx("min-w-0 flex-1 truncate tabular-nums", or(when(shown != "", "text-ink"), "text-mute")) }>{ or(shown, datePlaceholder(p)) }</span>
		</button>
		<input type="hidden" name={ p.Name } value={ dateValue(p) } data-asta-date-value { p.Attrs... }/>
		<div
			id={ id + "-cal" }
			role="dialog"
			hidden
			aria-label={ or(p.Label, "Choose a date") }
			data-asta-date-cal
			class="asta-date-cal absolute left-0 top-full z-50 mt-2 w-[296px] max-w-[calc(100vw-32px)] origin-top-left rounded-xl bg-paper p-3 outline-none shadow-[0_0_0_1px_color-mix(in_srgb,var(--ink)_10%,transparent),0_12px_32px_-8px_rgb(0_0_0/0.22),0_4px_8px_-4px_rgb(0_0_0/0.08)]"
		></div>
	</div>
}
