package ui

import "strconv"

// AIChatMessage is one message of an AIChat.
type AIChatMessage struct {
	// Role: "user" or "assistant".
	Role    string
	Content string
	// Failed marks a reply that went wrong. Content holds whatever arrived before.
	Failed bool
	// Stopped marks a reply that was cut short.
	Stopped bool
	// Poll streams a reply with plain htmx: the message fetches this URL (hx-get) shortly after it lands and
	// swaps itself with the answer. Answer with the message so far and Poll set again, and with Poll empty
	// once it is finished. An empty Content with Poll shows the thinking dots.
	Poll string
	// Stream streams a reply with Server-Sent Events, no htmx extension needed: blocks.js opens an
	// EventSource on this URL and appends each message's data to the reply. Send an event named "done" to end it.
	Stream string
}

// AIChatProps configures AIChat. Action is required.
type AIChatProps struct {
	// ID goes on the panel. The list of messages is ID + "-list". Default "ai-chat".
	ID string
	// Title is shown in the header. Default "Assistant".
	Title string
	// Greeting is shown while the conversation is empty. Default "How can I help?".
	Greeting string
	// Suggestions are prompt chips shown while the conversation is empty. A click sends one.
	Suggestions []string
	// Placeholder of the message box. Default "Ask anything".
	Placeholder string
	// Messages so far, oldest first.
	Messages []AIChatMessage
	// Action is the URL the composer posts to. The prompt is posted as Name.
	// Answer with AIChatMessages holding the reply only: the browser draws the person's own message
	// as soon as it is sent. htmx appends the answer to the list (hx-swap="beforeend").
	Action string
	// Name of the posted prompt. Default "prompt".
	Name string
	// Note is the small print under the composer. Default "Replies can be wrong. Check anything important."
	// Use "-" to hide it.
	Note string
	// Class goes on the panel, e.g. "h-[600px]" to change the height (default 540px).
	Class string
	// Attrs go on the panel.
	Attrs templ.Attributes
}

func aiChatID(p AIChatProps) string { return or(p.ID, "ai-chat") }

const (
	aiChatPanel = "flex h-[540px] w-full flex-col overflow-hidden rounded-[14px] bg-paper text-ink " +
		"shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_9%,transparent),0_1px_2px_rgb(0_0_0/0.04)]"
)

// AIChat is an assistant chat panel: a scrolling message list and a composer that posts with htmx.
// Enter sends, Shift+Enter adds a line, and the list follows new messages unless the reader scrolled up.
// Replies can stream in with Poll (plain htmx) or Stream (Server-Sent Events). Without JavaScript the
// composer is a plain form, so answer a non-htmx post with the whole page.
//
//	@ui.AIChat(ui.AIChatProps{Action: "/chat", Messages: history, Suggestions: []string{"Summarise this week"}})
//
// The handler appends the reply:
//
//	ui.AIChatMessages(ui.AIChatMessage{Role: "assistant", Content: reply}).Render(r.Context(), w)
templ AIChat(p AIChatProps) {
	{{ id := aiChatID(p) }}
	<div id={ id } data-asta-chat class={ cx(aiChatPanel, p.Class) } { p.Attrs... }>
		<p class="sr-only" aria-live="polite" data-asta-chat-status></p>
		<header class="flex items-center gap-2.5 px-5 pb-3 pt-4">
			@aiChatMark()
			<h3 class="text-[14px] font-medium tracking-[-0.01em] text-ink">{ or(p.Title, "Assistant") }</h3>
		</header>
		<div data-asta-chat-log role="log" aria-label="Conversation" class="relative min-h-0 flex-1 overflow-y-auto px-5 [scrollbar-width:thin]">
			<div data-asta-chat-empty class="flex h-full flex-col items-center justify-center pb-6 text-center animate-[asta-blk-in_.5s_cubic-bezier(.16,1,.3,1)]">
				<p class="text-[22px] font-medium tracking-[-0.03em] text-ink">{ or(p.Greeting, "How can I help?") }</p>
				if len(p.Suggestions) > 0 {
					<div class="mt-6 flex max-w-[440px] flex-wrap justify-center gap-2">
						for i, s := range p.Suggestions {
							<button
								type="button"
								data-asta-chat-suggest={ s }
								class="rounded-lg bg-paper-2 px-3 py-2 text-left text-[13px] leading-snug text-ink-2 outline-none transition-[color,background-color,transform] duration-300 hover:-translate-y-px hover:text-ink focus-visible:ring-2 focus-visible:ring-brand/50"
								style={ aiChatDelay(i) }
							>{ s }</button>
						}
					</div>
				}
			</div>
			<ol id={ id + "-list" } data-asta-chat-list class="flex flex-col gap-6 py-2 empty:py-0">
				for _, m := range p.Messages {
					@aiChatItem(m, false)
				}
			</ol>
		</div>
		<template data-asta-chat-pending>
			@aiChatItem(AIChatMessage{Role: "user"}, true)
			@aiChatItem(AIChatMessage{Role: "assistant", Stream: "pending"}, true)
		</template>
		<form
			action={ templ.SafeURL(p.Action) }
			method="post"
			hx-post={ p.Action }
			hx-target={ "#" + id + "-list" }
			hx-swap="beforeend"
			hx-indicator="find [data-asta-chat-send]"
			data-asta-chat-form
			class="px-4 pb-4 pt-2"
		>
			<div class="flex items-end gap-2 rounded-xl bg-paper p-1.5 pl-3.5 shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_12%,transparent)] transition-shadow duration-200 focus-within:shadow-[inset_0_0_0_1px_var(--brand),0_0_0_3px_color-mix(in_srgb,var(--brand)_14%,transparent)]">
				<label for={ id + "-input" } class="sr-only">Message</label>
				<textarea
					id={ id + "-input" }
					name={ or(p.Name, "prompt") }
					rows="1"
					placeholder={ or(p.Placeholder, "Ask anything") }
					data-asta-chat-input
					class="block max-h-36 min-h-[36px] flex-1 resize-none bg-transparent py-2 text-[14px] leading-relaxed text-ink outline-none [field-sizing:content] placeholder:text-mute"
				></textarea>
				<button
					type="submit"
					aria-label="Send"
					data-asta-chat-send
					class="group/send relative grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-brand text-white outline-none transition-[opacity,transform] duration-200 active:scale-95 disabled:opacity-35 focus-visible:ring-2 focus-visible:ring-brand/50 focus-visible:ring-offset-2 focus-visible:ring-offset-paper [&.htmx-request]:pointer-events-none"
				>
					<svg viewBox="0 0 16 16" class="h-4 w-4 transition-opacity group-[.htmx-request]/send:opacity-0" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M8 13V3M3.5 7.5 8 3l4.5 4.5"></path>
					</svg>
					<span class="absolute inset-0 grid place-items-center opacity-0 transition-opacity group-[.htmx-request]/send:opacity-100" aria-hidden="true">
						@spinnerIcon("h-4 w-4")
					</span>
				</button>
			</div>
			if p.Note != "-" {
				<p class="mt-2 text-center text-[11.5px] text-mute">{ or(p.Note, "Replies can be wrong. Check anything important.") }</p>
			}
		</form>
	</div>
}

func aiChatDelay(i int) templ.SafeCSS {
	return templ.SafeCSS("animation:asta-blk-in .5s cubic-bezier(.16,1,.3,1) " + strconv.Itoa(80+i*50) + "ms both")
}

// AIChatMessages renders messages as list items, for the handler that answers the composer.
//
//	ui.AIChatMessages(ui.AIChatMessage{Role: "assistant", Content: "Here is the summary."}).Render(ctx, w)
templ AIChatMessages(msgs ...AIChatMessage) {
	for _, m := range msgs {
		@aiChatItem(m, true)
	}
}

templ aiChatItem(m AIChatMessage, fresh bool) {
	if m.Role == "user" {
		<li data-role="user" class={ cx("flex justify-end", when(fresh, "animate-[asta-blk-in_.4s_cubic-bezier(.16,1,.3,1)]")) }>
			<p class="max-w-[80%] whitespace-pre-wrap rounded-xl bg-paper-2 px-3.5 py-2.5 text-[14px] leading-relaxed text-ink">{ m.Content }</p>
		</li>
	} else {
		{{ live := m.Poll != "" || m.Stream != "" }}
		<li
			data-role="assistant"
			class={ cx("group/msg flex gap-3", when(fresh && m.Poll == "", "animate-[asta-blk-in_.4s_cubic-bezier(.16,1,.3,1)]")) }
			if m.Poll != "" {
				hx-get={ m.Poll }
				hx-trigger="load delay:300ms"
				hx-swap="outerHTML"
			}
			if m.Stream != "" {
				data-asta-chat-stream={ m.Stream }
			}
			if live {
				aria-busy="true"
			}
		>
			@aiChatMark()
			<div class="min-w-0 flex-1 pt-0.5">
				if live && m.Content == "" {
					@aiChatDots()
				}
				<p data-asta-chat-text class={ cx("whitespace-pre-wrap text-[14px] leading-relaxed text-ink", when(live && m.Content == "", "hidden")) }>{ m.Content }</p>
				if m.Failed || m.Stopped {
					<p class="mt-1.5 text-[12.5px] text-mute">{ or(when(m.Failed, "Something went wrong. Try again."), "Stopped.") }</p>
				}
				if !live {
					<div class="-ml-1.5 mt-1.5 flex items-center gap-0.5 opacity-0 transition-opacity duration-300 group-hover/msg:opacity-100 group-last/msg:opacity-100 focus-within:opacity-100">
						if m.Content != "" {
							<button
								type="button"
								aria-label="Copy"
								title="Copy"
								data-asta-chat-copy
								class="group/copy grid h-7 w-7 place-items-center rounded-md text-mute outline-none transition-colors duration-200 hover:bg-paper-2 hover:text-ink focus-visible:ring-2 focus-visible:ring-brand/50"
							>
								<svg viewBox="0 0 16 16" class="h-3.5 w-3.5 group-data-[copied]/copy:hidden" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<rect x="5.5" y="5.5" width="8" height="8" rx="1.8"></rect>
									<path d="M10.5 5.5V4a1.5 1.5 0 0 0-1.5-1.5H4A1.5 1.5 0 0 0 2.5 4v5A1.5 1.5 0 0 0 4 10.5h1.5"></path>
								</svg>
								<svg viewBox="0 0 16 16" class="hidden h-3.5 w-3.5 animate-[asta-scale-in_.3s_cubic-bezier(.16,1,.3,1)] group-data-[copied]/copy:block" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="m3.5 8.5 3 3 6-7"></path>
								</svg>
							</button>
						}
					</div>
				}
			</div>
		</li>
	}
}

templ aiChatDots() {
	<span role="img" data-asta-chat-dots class="inline-flex h-6 items-center gap-1" aria-label="Thinking">
		<span class="h-1.5 w-1.5 rounded-full bg-mute animate-[asta-blk-dot_1.1s_cubic-bezier(.16,1,.3,1)_infinite]"></span>
		<span class="h-1.5 w-1.5 rounded-full bg-mute animate-[asta-blk-dot_1.1s_cubic-bezier(.16,1,.3,1)_140ms_infinite]"></span>
		<span class="h-1.5 w-1.5 rounded-full bg-mute animate-[asta-blk-dot_1.1s_cubic-bezier(.16,1,.3,1)_280ms_infinite]"></span>
	</span>
}

templ aiChatMark() {
	<span aria-hidden="true" class="grid h-7 w-7 shrink-0 place-items-center rounded-lg bg-[color-mix(in_srgb,var(--brand)_10%,transparent)] text-brand">
		<svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="currentColor">
			<path d="M8 1.5c.4 2.9 1.6 4.1 4.5 4.5-2.9.4-4.1 1.6-4.5 4.5-.4-2.9-1.6-4.1-4.5-4.5C6.4 5.6 7.6 4.4 8 1.5Z"></path>
			<path d="M12.5 10c.2 1.4.8 2 2.2 2.2-1.4.2-2 .8-2.2 2.2-.2-1.4-.8-2-2.2-2.2 1.4-.2 2-.8 2.2-2.2Z" opacity=".55"></path>
		</svg>
	</span>
}
