package ui

import "strconv"

// PasswordRule is one rule of a PasswordInput. Pattern is a JavaScript regular expression the password must match.
type PasswordRule struct {
	Label   string
	Pattern string
}

// DefaultPasswordRules are the rules PasswordInput checks when Rules is nil.
var DefaultPasswordRules = []PasswordRule{
	{Label: "At least 8 characters", Pattern: "^[\\s\\S]{8,}$"},
	{Label: "One uppercase letter", Pattern: "[A-Z]"},
	{Label: "One number", Pattern: "\\d"},
	{Label: "One symbol", Pattern: "[^A-Za-z0-9]"},
}

// PasswordInputProps configures PasswordInput.
type PasswordInputProps struct {
	// ID is the input's id. Default "password".
	ID   string
	Name string
	// Label is shown above the field. Default "Password".
	Label       string
	Placeholder string
	// Autocomplete defaults to "new-password". Use "current-password" on a sign-in form.
	Autocomplete string
	Required     bool
	Disabled     bool
	// Rules are checked as you type. Nil means DefaultPasswordRules. They are hints only; check again on the server.
	Rules []PasswordRule
	// NoMeter hides the strength meter.
	NoMeter bool
	// NoChecklist hides the rule list.
	NoChecklist bool
	Class       string
	// Attrs go on the <input>.
	Attrs templ.Attributes
}

func passwordRules(p PasswordInputProps) []PasswordRule {
	if p.Rules == nil {
		return DefaultPasswordRules
	}
	return p.Rules
}

func passwordDelay(i int) templ.SafeCSS {
	return templ.SafeCSS("transition-delay:" + strconv.Itoa(i*40) + "ms")
}

// PasswordInput is a password field with a show/hide eye that morphs, a strength meter whose segments fill as rules
// pass (blue once all pass) and a checklist that ticks each rule off. Rules are plain label + regex pairs.
//
//	@ui.PasswordInput(ui.PasswordInputProps{ID: "pw", Name: "password", Required: true})
templ PasswordInput(p PasswordInputProps) {
	{{ id := or(p.ID, "password") }}
	{{ rules := passwordRules(p) }}
	<div data-asta-password data-strength="0" class={ cx("group/pw flex w-full flex-col gap-2", p.Class) }>
		<label for={ id } class="text-[13px] font-medium text-ink">{ or(p.Label, "Password") }</label>
		<div
			class={ cx("flex h-10 items-center gap-2 rounded-lg bg-paper pl-3 pr-1 transition-shadow duration-200",
				"shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_14%,transparent)] hover:shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_24%,transparent)]",
				"focus-within:!shadow-[inset_0_0_0_1px_var(--brand),0_0_0_4px_color-mix(in_srgb,var(--brand)_16%,transparent)]",
				when(p.Disabled, "pointer-events-none opacity-50")) }
		>
			<input
				id={ id }
				name={ p.Name }
				type="password"
				placeholder={ p.Placeholder }
				autocomplete={ or(p.Autocomplete, "new-password") }
				spellcheck="false"
				autocapitalize="off"
				required?={ p.Required }
				disabled?={ p.Disabled }
				if !p.NoMeter || !p.NoChecklist {
					aria-describedby={ id + "-help" }
				}
				data-asta-password-input
				class="h-full min-w-0 flex-1 bg-transparent text-[14px] tracking-[0.01em] text-ink outline-none placeholder:text-mute"
				{ p.Attrs... }
			/>
			<button
				type="button"
				aria-label="Show password"
				aria-pressed="false"
				aria-controls={ id }
				data-asta-password-toggle
				class="group/eye flex h-8 w-8 shrink-0 items-center justify-center rounded-md text-mute outline-none transition-colors duration-200 hover:text-ink focus-visible:ring-2 focus-visible:ring-brand/50"
			>
				<svg viewBox="0 0 20 20" class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M2.5 10s2.7-5 7.5-5 7.5 5 7.5 5-2.7 5-7.5 5-7.5-5-7.5-5Z"></path>
					<circle cx="10" cy="10" r="2.2" class="origin-center scale-[.55] transition-transform duration-300 ease-[cubic-bezier(.16,1,.3,1)] [transform-box:fill-box] group-aria-pressed/eye:scale-100 motion-reduce:transition-none"></circle>
					<path d="M4 3.5 16 16.5" pathLength="1" class="asta-pw-slash"></path>
				</svg>
			</button>
		</div>
		if !p.NoMeter || !p.NoChecklist {
			<div id={ id + "-help" } class="flex flex-col gap-3 pt-1">
				if !p.NoMeter {
					<div class="flex items-center gap-3">
						<div aria-hidden="true" class="flex flex-1 gap-1.5">
							for i := range rules {
								<span class="relative h-1 flex-1 overflow-hidden rounded-full bg-[color-mix(in_srgb,var(--ink)_10%,transparent)]">
									<span
										data-asta-password-seg
										class="absolute inset-0 origin-left scale-x-0 rounded-full bg-ink transition-[transform,background-color] duration-500 ease-[cubic-bezier(.16,1,.3,1)] data-[on]:scale-x-100 group-data-[strong]/pw:bg-brand motion-reduce:transition-none"
										style={ passwordDelay(i) }
									></span>
								</span>
							}
						</div>
						<span aria-live="polite" data-asta-password-word class="w-12 text-right text-[12px] tabular-nums text-mute transition-colors duration-300 group-data-[strong]/pw:text-brand"></span>
					</div>
				}
				if !p.NoChecklist {
					<ul class="grid gap-1.5 sm:grid-cols-2">
						for _, r := range rules {
							<li data-asta-password-rule={ r.Pattern } class="group/rule flex items-center gap-2 text-[12.5px] text-mute transition-colors duration-300 data-[on]:text-ink">
								<span class="relative flex h-4 w-4 shrink-0 items-center justify-center rounded-full shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_20%,transparent)] transition-[background-color,box-shadow] duration-300 group-data-[on]/rule:bg-brand group-data-[on]/rule:text-white group-data-[on]/rule:shadow-none">
									<svg viewBox="0 0 16 16" class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<path d="m3.5 8.5 3 3 6-7" pathLength="1" class="asta-pw-tick"></path>
									</svg>
								</span>
								{ r.Label }
								<span class="sr-only" data-asta-password-said>, not yet</span>
							</li>
						}
					</ul>
				} else {
					for _, r := range rules {
						<span hidden data-asta-password-rule={ r.Pattern }></span>
					}
				}
			</div>
		}
	</div>
}
