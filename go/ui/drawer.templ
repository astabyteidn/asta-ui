package ui

// DrawerProps configures Drawer. Children are the body, which scrolls when it is long.
type DrawerProps struct {
	// ID is required. Buttons open it with Opens(ID), handlers with ui.OpenDialog(w, ID).
	ID string
	// Side is the edge it slides in from: "right" (default), "left" or "bottom".
	Side string
	// Title is the heading text.
	Title string
	// Description is the muted line under the title.
	Description string
	// Footer is a row of buttons pinned to the bottom: stacked on phones, right-aligned from sm.
	Footer templ.Component
	// Open shows it as soon as the page (or the htmx swap) loads.
	Open bool
	// NoDrag turns off drag-to-close on a bottom sheet.
	NoDrag bool
	// Class goes on the sheet, e.g. "w-[min(480px,calc(100%-48px))]".
	Class string
	// Attrs are spread onto the root element (hx-*, data-*).
	Attrs templ.Attributes
}

var drawerSide = map[string]string{
	"right":  "m-0 max-w-none top-2 bottom-auto right-2 left-auto h-[calc(100%-16px)] w-[min(400px,calc(100%-48px))]",
	"left":   "m-0 max-w-none top-2 bottom-auto left-2 right-auto h-[calc(100%-16px)] w-[min(400px,calc(100%-48px))]",
	"bottom": "my-0 mx-auto top-auto bottom-2 inset-x-2 h-auto w-[calc(100%-16px)] max-w-[520px]",
}

func drawerKey(side string) string {
	if _, ok := drawerSide[side]; ok {
		return side
	}
	return "right"
}

// Drawer is a side sheet on the native <dialog>: it slides in from the right, the left or the bottom over a
// fading backdrop. Escape or a click on the backdrop closes it, focus stays inside while it is open and goes
// back to the opener after. A bottom sheet has a handle you can drag down to dismiss. It opens and closes
// like Dialog, so ui.CloseDialog(w, id) closes it after a form inside saves.
//
//	@ui.Button(ui.ButtonProps{Attrs: ui.Opens("filters")}) { Filters }
//	@ui.Drawer(ui.DrawerProps{ID: "filters", Title: "Filters", Footer: filterButtons()}) {
//		<form id="filter-form" hx-get="/items" hx-target="#items">…</form>
//	}
templ Drawer(p DrawerProps) {
	{{ side := drawerKey(p.Side) }}
	<dialog
		id={ p.ID }
		data-side={ side }
		class={ cx("asta-dialog asta-drawer fixed max-h-none overflow-hidden rounded-[14px] bg-paper p-0 text-ink outline-none",
			"shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_8%,transparent),0_24px_64px_-24px_color-mix(in_srgb,var(--ink)_45%,transparent)]",
			drawerSide[side], p.Class) }
		if p.Title != "" {
			aria-labelledby={ p.ID + "-title" }
		}
		if p.Description != "" {
			aria-describedby={ p.ID + "-desc" }
		}
		data-asta-autoopen?={ p.Open }
		{ p.Attrs... }
	>
		<div class={ cx("flex flex-col", when(side != "bottom", "h-full"), when(side == "bottom", "max-h-[calc(100dvh-56px)]")) }>
			if side == "bottom" {
				<div
					aria-hidden="true"
					if !p.NoDrag {
						data-asta-drawer-handle
					}
					class={ cx("flex shrink-0 justify-center pb-1 pt-2.5 [touch-action:none]", when(!p.NoDrag, "cursor-grab active:cursor-grabbing")) }
				>
					<span class="h-1 w-9 rounded-full bg-[color-mix(in_srgb,var(--ink)_16%,transparent)]"></span>
				</div>
			}
			<div class={ cx("flex shrink-0 items-start justify-between gap-4 pl-5 pr-14", or(when(side == "bottom", "pt-2"), "pt-5")) }>
				<div class="min-w-0">
					if p.Title != "" {
						<h2 id={ p.ID + "-title" } class="text-[16px] font-medium tracking-[-0.02em] text-ink">{ p.Title }</h2>
					}
					if p.Description != "" {
						<p id={ p.ID + "-desc" } class="mt-1 text-[13.5px] leading-relaxed text-mute">{ p.Description }</p>
					}
				</div>
			</div>
			<div class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-5 pb-5 pt-4">
				{ children... }
			</div>
			if p.Footer != nil {
				<div class="flex shrink-0 flex-col-reverse gap-2 px-5 pb-5 sm:flex-row sm:justify-end">
					@p.Footer
				</div>
			}
		</div>
		// Last in the DOM, so the dialog focuses the first field of the body rather than ×.
		<button
			type="button"
			data-asta-close
			aria-label="Close"
			class={ cx("absolute right-3.5 flex h-8 w-8 items-center justify-center rounded-lg text-mute outline-none transition-colors duration-200 hover:bg-paper-2 hover:text-ink focus-visible:ring-2 focus-visible:ring-brand/50",
				or(when(side == "bottom", "top-[22px]"), "top-4")) }
		>
			@ovIcon("m4 4 8 8M12 4l-8 8", "h-3.5 w-3.5")
		</button>
	</dialog>
}
