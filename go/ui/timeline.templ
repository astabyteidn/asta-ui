package ui

import "strconv"

// TimelineItem is one event in a Timeline.
type TimelineItem struct {
	Title       string
	Description string
	// Time is a short label on the right, e.g. "09:41" or "Mon 12".
	Time string
	// State: "done" (default), "active" (a soft blue pulse) or "pending" (a hollow dot, muted text).
	State string
}

// TimelineProps configures Timeline.
type TimelineProps struct {
	Items []TimelineItem
	// Static turns off the reveal. By default items rise in one after another when the list scrolls into view.
	Static bool
	// Label is the list's accessible name. Default "Timeline".
	Label string
	Class string
	Attrs templ.Attributes
}

func tlState(s string) string {
	if s == "active" || s == "pending" {
		return s
	}
	return "done"
}

// tlTravelled reports whether the line under item i is drawn: it is done and the next step has started.
func tlTravelled(items []TimelineItem, i int) bool {
	if tlState(items[i].State) != "done" || i+1 >= len(items) {
		return false
	}
	return tlState(items[i+1].State) != "pending"
}

func tlDelay(ms int) templ.SafeCSS {
	return templ.SafeCSS("animation-delay:" + strconv.Itoa(ms) + "ms")
}

var tlDot = map[string]string{
	"done":    "bg-ink",
	"active":  "bg-brand shadow-[0_0_0_4px_color-mix(in_srgb,var(--brand)_16%,transparent)]",
	"pending": "bg-paper shadow-[inset_0_0_0_1.5px_color-mix(in_srgb,var(--ink)_22%,transparent)]",
}

var tlSR = map[string]string{"done": ", done", "active": ", in progress", "pending": ", not started"}

// Timeline is a vertical list of events with dots on a connector line. Items rise in one after another when the
// list scrolls into view, the line between finished steps draws down, and the active step pulses softly.
//
//	@ui.Timeline(ui.TimelineProps{Items: []ui.TimelineItem{
//		{Title: "Order placed", Time: "09:12"},
//		{Title: "Packed", Time: "11:40", State: "active"},
//		{Title: "Delivered", State: "pending"},
//	}})
templ Timeline(p TimelineProps) {
	<ol
		data-asta-timeline
		if p.Static {
			data-inview="true"
		} else {
			data-inview="false"
		}
		aria-label={ or(p.Label, "Timeline") }
		class={ cx("asta-timeline flex flex-col", p.Class) }
		{ p.Attrs... }
	>
		for i, item := range p.Items {
			{{ st := tlState(item.State) }}
			{{ last := i == len(p.Items)-1 }}
			<li
				if st == "active" {
					aria-current="step"
				}
				class={ cx("relative flex gap-3.5", when(!p.Static, "asta-timeline-a animate-[asta-timeline-in_.6s_cubic-bezier(.16,1,.3,1)_both]")) }
				if !p.Static {
					style={ tlDelay(i * 90) }
				}
			>
				<div class="relative flex w-5 shrink-0 flex-col items-center">
					<span class="relative flex h-5 w-5 items-center justify-center">
						if st == "active" {
							<span aria-hidden="true" class="asta-timeline-ping absolute h-2.5 w-2.5 animate-[asta-timeline-ping_2.4s_cubic-bezier(.16,1,.3,1)_infinite] rounded-full bg-brand"></span>
						}
						<span aria-hidden="true" class={ cx("relative h-2.5 w-2.5 rounded-full", tlDot[st]) }></span>
					</span>
					if !last {
						<span aria-hidden="true" class="relative -mb-0.5 mt-0.5 w-px flex-1 overflow-hidden bg-[color-mix(in_srgb,var(--ink)_12%,transparent)]">
							if tlTravelled(p.Items, i) {
								<span
									class={ cx("absolute inset-0 origin-top bg-ink", when(!p.Static, "asta-timeline-a animate-[asta-timeline-line_.7s_cubic-bezier(.16,1,.3,1)_both]")) }
									if !p.Static {
										style={ tlDelay(i*90 + 200) }
									}
								></span>
							}
						</span>
					}
				</div>
				<div class={ cx("min-w-0 flex-1", when(!last, "pb-6")) }>
					<div class="flex items-baseline justify-between gap-4">
						<p class={ cx("text-[14px] font-medium leading-5 tracking-[-0.01em]", or(when(st == "pending", "text-mute"), "text-ink")) }>
							{ item.Title }
							<span class="sr-only">{ tlSR[st] }</span>
						</p>
						if item.Time != "" {
							<span class={ cx("shrink-0 text-[12px] tabular-nums", or(when(st == "active", "text-brand"), "text-mute")) }>{ item.Time }</span>
						}
					</div>
					if item.Description != "" {
						<div class="mt-0.5 text-[13px] leading-relaxed text-mute">{ item.Description }</div>
					}
				</div>
			</li>
		}
	</ol>
}
