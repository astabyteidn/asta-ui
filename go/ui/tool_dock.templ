package ui

// ToolDockProps configures ToolDock.
type ToolDockProps struct {
	// ID names the toolbar. Optional.
	ID string
	// Tools in order. A DockTool with Separator set draws a thin rule between groups.
	Tools []DockTool
	// Value is the ID of the active tool. Default the first one that is not disabled.
	Value string
	// Name adds a hidden input with this name and the active tool's ID, for a surrounding form.
	Name string
	// NoHotkeys turns off picking a tool by pressing its Shortcut anywhere on the page.
	NoHotkeys bool
	// Tooltip is where the labels open: "top" (default) or "bottom".
	Tooltip string
	// Label is the accessible name of the toolbar. Default "Tools".
	Label string
	// Class is merged onto the root element.
	Class string
	// Attrs go on the toolbar. Picking a tool fires "asta:change" (detail: value) on it.
	Attrs templ.Attributes
}

// DockTool is one tool of ToolDock.
type DockTool struct {
	// ID identifies it.
	ID string
	// Label is the visible text.
	Label string
	// Icon is an optional leading icon.
	Icon templ.Component
	// Shortcut is a single key such as "V". It is shown in the tooltip and picks the tool from anywhere.
	Shortcut string
	// Disabled greys it out and skips it in keyboard navigation.
	Disabled bool
	// Separator makes this entry a thin rule instead of a tool.
	Separator bool
	// Attrs go on the tool's button, e.g. hx-post.
	Attrs templ.Attributes
}

func dockValue(p ToolDockProps) string {
	if p.Value != "" {
		return p.Value
	}
	for _, t := range p.Tools {
		if !t.Separator && !t.Disabled {
			return t.ID
		}
	}
	return ""
}

func dockTabIndex(on bool) string {
	if on {
		return "0"
	}
	return "-1"
}

// ToolDock is the floating tool bar of a design editor. A highlight slides to the active tool, each tool shows
// its name and shortcut on hover or focus, ← → move between tools, and single-key shortcuts work from anywhere
// on the page unless someone is typing.
//
//	@ui.ToolDock(ui.ToolDockProps{Tools: []ui.DockTool{{ID: "move", Label: "Move", Icon: moveIcon(), Shortcut: "V"}, {Separator: true}, …}})
templ ToolDock(p ToolDockProps) {
	{{ val := dockValue(p) }}
	<div
		role="toolbar"
		aria-label={ or(p.Label, "Tools") }
		data-asta-tooldock
		if p.ID != "" {
			id={ p.ID }
		}
		data-hotkeys?={ !p.NoHotkeys }
		class={ cx("relative inline-flex items-center gap-0.5 rounded-[12px] bg-paper p-1",
			"shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_10%,transparent),0_12px_32px_-14px_rgb(0_0_0/0.3),0_2px_6px_-3px_rgb(0_0_0/0.12)]", p.Class) }
		{ p.Attrs... }
	>
		<span data-asta-tooldock-pill aria-hidden="true" class="pointer-events-none absolute left-0 top-1 h-[calc(100%-8px)] w-9 rounded-[8px] bg-brand opacity-0 transition-transform duration-300 ease-[cubic-bezier(.16,1,.3,1)] motion-reduce:transition-none"></span>
		for _, t := range p.Tools {
			if t.Separator {
				<span aria-hidden="true" class="mx-1 h-5 w-px bg-[color-mix(in_srgb,var(--ink)_12%,transparent)]"></span>
			} else {
				<span class="group/tool relative">
					<button
						type="button"
						data-tool={ t.ID }
						aria-label={ t.Label }
						aria-pressed={ boolString(t.ID == val) }
						if t.Shortcut != "" {
							aria-keyshortcuts={ t.Shortcut }
							data-shortcut={ t.Shortcut }
						}
						disabled?={ t.Disabled }
						tabindex={ dockTabIndex(t.ID == val) }
						class="relative grid h-9 w-9 cursor-pointer place-items-center rounded-[8px] text-ink-2 outline-none transition-colors duration-150 hover:bg-[color-mix(in_srgb,var(--ink)_7%,transparent)] hover:text-ink focus-visible:shadow-[0_0_0_2px_var(--paper),0_0_0_4px_var(--brand)] disabled:cursor-not-allowed disabled:opacity-35 aria-pressed:text-white aria-pressed:hover:bg-transparent aria-pressed:hover:text-white"
						{ t.Attrs... }
					>
						<span class="h-[18px] w-[18px] [&>svg]:h-full [&>svg]:w-full">
							if t.Icon != nil {
								@t.Icon
							}
						</span>
					</button>
					<span
						aria-hidden="true"
						class={ cx("pointer-events-none absolute left-1/2 z-10 flex -translate-x-1/2 items-center gap-2 whitespace-nowrap rounded-[7px] bg-ink px-2 py-1 text-[12px] text-paper opacity-0 transition-[opacity,translate] duration-150",
							"group-hover/tool:translate-y-0 group-hover/tool:opacity-100 group-has-[:focus-visible]/tool:translate-y-0 group-has-[:focus-visible]/tool:opacity-100",
							or(when(p.Tooltip == "bottom", "top-full mt-2 -translate-y-1"), "bottom-full mb-2 translate-y-1")) }
					>
						{ t.Label }
						if t.Shortcut != "" {
							<span class="rounded-[4px] bg-[color-mix(in_srgb,var(--paper)_18%,transparent)] px-1 font-mono text-[10.5px]">{ t.Shortcut }</span>
						}
					</span>
				</span>
			}
		}
		if p.Name != "" {
			<input type="hidden" name={ p.Name } value={ val }/>
		}
	</div>
}
