package ui

import "strconv"

// TableProps configures Table. Children are THead and TBody.
type TableProps struct {
	// Label is the table's accessible name.
	Label string
	// MaxHeight scrolls the body past this height, e.g. "420px". The header sticks while you scroll.
	MaxHeight string
	// Class goes on the outer frame.
	Class string
	// Attrs go on the <table>.
	Attrs templ.Attributes
}

// THProps configures TH. Every field is optional.
type THProps struct {
	// Align: "left" (default), "center" or "right".
	Align string
	// Width is a CSS width, e.g. "120px" or "30%".
	Width string
	// SortHref makes the header a sort link. Your handler decides the next order.
	SortHref string
	// Sort is this column's current order: "asc", "desc" or "" (not sorted by it).
	Sort  string
	Class string
	Attrs templ.Attributes
}

// TRProps configures TR. Every field is optional.
type TRProps struct {
	// Selected tints the row with the brand colour.
	Selected bool
	Class    string
	// Attrs go on the <tr>, e.g. an id for hx-target or hx-get to open the row.
	Attrs templ.Attributes
}

// TDProps configures TD. Every field is optional.
type TDProps struct {
	// Align: "left" (default), "center" or "right". Right-aligned cells use tabular figures.
	Align string
	// Wrap lets long text wrap. Cells stay on one line by default.
	Wrap  bool
	Class string
	Attrs templ.Attributes
}

// TableEmptyProps configures TableEmpty. Children go under the text, e.g. a button.
type TableEmptyProps struct {
	// Cols is the number of columns, so the cell spans the table.
	Cols int
	// Title is a short heading. Without it only Text shows.
	Title string
	// Text defaults to "No rows yet.".
	Text string
}

var tableAlign = map[string]string{"left": "text-left", "center": "text-center", "right": "text-right"}

// optArg returns the first optional argument, or the zero value.
func optArg[T any](p []T) T {
	var zero T
	if len(p) > 0 {
		return p[0]
	}
	return zero
}

func tableStyle(maxHeight string) templ.SafeCSS {
	if maxHeight == "" {
		return ""
	}
	return templ.SafeCSS("max-height:" + maxHeight + ";")
}

func thSort(p THProps) string {
	switch {
	case p.Sort == "asc":
		return "ascending"
	case p.Sort == "desc":
		return "descending"
	case p.SortHref != "":
		return "none"
	}
	return ""
}

// Table is a framed, scrollable table for server-rendered rows. Rows fade in when they arrive, also after an htmx swap.
//
//	@ui.Table(ui.TableProps{Label: "Invoices"}) {
//		@ui.THead() {
//			@ui.TH(ui.THProps{SortHref: "?sort=client", Sort: "asc"}) { Client }
//			@ui.TH(ui.THProps{Align: "right"}) { Amount }
//		}
//		@ui.TBody(templ.Attributes{"id": "invoices"}) {
//			for _, inv := range invoices {
//				@ui.TR() {
//					@ui.TD() { { inv.Client } }
//					@ui.TD(ui.TDProps{Align: "right"}) { { inv.Amount } }
//				}
//			}
//		}
//	}
templ Table(p TableProps) {
	<div class={ cx("relative rounded-xl bg-paper after:pointer-events-none after:absolute after:inset-0 after:z-20 after:rounded-xl after:shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_10%,transparent)]", p.Class) }>
		<div class="overflow-auto rounded-xl" style={ tableStyle(p.MaxHeight) }>
			<table aria-label={ p.Label } class="w-full border-separate border-spacing-0 text-[13.5px]" { p.Attrs... }>
				{ children... }
			</table>
		</div>
	</div>
}

// THead is the header row. Children are TH cells.
templ THead() {
	<thead>
		<tr>
			{ children... }
		</tr>
	</thead>
}

// TH is a header cell. With SortHref it is a link with an arrow that shows the current order.
templ TH(opt ...THProps) {
	{{ p := optArg(opt) }}
	<th
		scope="col"
		if s := thSort(p); s != "" {
			aria-sort={ s }
		}
		if p.Width != "" {
			style={ templ.SafeCSS("width:" + p.Width + ";") }
		}
		class={ cx("sticky top-0 z-10 whitespace-nowrap bg-paper-2 px-4 py-2.5 text-[12px] font-medium text-mute", pick(tableAlign, p.Align, "left"), p.Class) }
		{ p.Attrs... }
	>
		if p.SortHref != "" {
			<a
				href={ templ.SafeURL(p.SortHref) }
				class={ cx("group/sort -mx-1.5 inline-flex items-center gap-1 rounded-md px-1.5 py-0.5 outline-none transition-colors duration-150 hover:text-ink focus-visible:ring-2 focus-visible:ring-brand/50",
					when(p.Sort != "", "text-ink"), when(p.Align == "right", "flex-row-reverse")) }
			>
				{ children... }
				<svg
					viewBox="0 0 16 16"
					class={ cx("h-3 w-3 transition-[transform,opacity] duration-300 ease-[cubic-bezier(.16,1,.3,1)] motion-reduce:transition-none",
						when(p.Sort == "", "opacity-0 group-hover/sort:opacity-40 group-focus-visible/sort:opacity-40"), when(p.Sort == "desc", "rotate-180")) }
					fill="none"
					stroke="currentColor"
					stroke-width="1.8"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M8 12.5v-9M4.5 7 8 3.5 11.5 7"></path>
				</svg>
			</a>
		} else {
			{ children... }
		}
	</th>
}

// TBody holds the rows. Pass attributes such as an id to make it an hx-target.
templ TBody(attrs ...templ.Attributes) {
	<tbody { optArg(attrs)... }>
		{ children... }
	</tbody>
}

// TR is a body row. Children are TD cells.
templ TR(opt ...TRProps) {
	{{ p := optArg(opt) }}
	<tr
		class={ cx("group/row",
			"[transition:background-color_150ms,opacity_420ms_cubic-bezier(.16,1,.3,1),translate_420ms_cubic-bezier(.16,1,.3,1)] starting:translate-y-1.5 starting:opacity-0 motion-reduce:[transition:background-color_150ms]",
			when(p.Selected, "bg-[color-mix(in_srgb,var(--brand)_7%,transparent)]"),
			when(!p.Selected, "hover:bg-[color-mix(in_srgb,var(--ink)_3%,transparent)]"), p.Class) }
		{ p.Attrs... }
	>
		{ children... }
	</tr>
}

// TD is a body cell.
templ TD(opt ...TDProps) {
	{{ p := optArg(opt) }}
	<td class={ cx("px-4 py-3 align-middle text-ink-2", pick(tableAlign, p.Align, "left"), when(!p.Wrap, "whitespace-nowrap"), when(p.Align == "right", "tabular-nums"), p.Class) } { p.Attrs... }>
		{ children... }
	</td>
}

// TableEmpty is a row that says there is nothing to show. Use it in TBody when there are no rows.
//
//	@ui.TableEmpty(ui.TableEmptyProps{Cols: 4, Title: "No matches", Text: "Nothing matches “astabyte”."})
templ TableEmpty(p TableEmptyProps) {
	<tr>
		<td colspan={ strconv.Itoa(max(1, p.Cols)) } class="px-4 py-14 text-center">
			if p.Title != "" {
				<div class="mx-auto flex max-w-[260px] flex-col items-center gap-1.5">
					<span class="grid h-10 w-10 place-items-center rounded-[10px] bg-paper-2 text-mute">
						<svg viewBox="0 0 16 16" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
							<circle cx="7" cy="7" r="4.5"></circle>
							<path d="m10.5 10.5 3 3M5.5 7h3"></path>
						</svg>
					</span>
					<p class="mt-1.5 text-[14px] font-medium text-ink">{ p.Title }</p>
					if p.Text != "" {
						<p class="text-[13px] text-mute">{ p.Text }</p>
					}
					<div class="mt-2 empty:hidden">
						{ children... }
					</div>
				</div>
			} else {
				<p class="text-[13.5px] text-mute">{ or(p.Text, "No rows yet.") }</p>
				<div class="mt-3 empty:hidden">
					{ children... }
				</div>
			}
		</td>
	</tr>
}
