package ui

// AccordionItem is one question of Accordion.
type AccordionItem struct {
	Title   string
	Content templ.Component
	// Open shows it open on load.
	Open bool
	// Attrs go on the <details>, e.g. an id.
	Attrs templ.Attributes
}

// AccordionProps configures Accordion.
type AccordionProps struct {
	Items []AccordionItem
	// Name groups the items so only one stays open at a time. Empty lets several stay open.
	Name  string
	Class string
	Attrs templ.Attributes
}

// AccordionDetailsProps configures AccordionDetails, for when you lay out items yourself.
type AccordionDetailsProps struct {
	Title string
	// Name groups items so only one stays open at a time. Give every item in the group the same Name.
	Name string
	Open bool
	// Class goes on the <details>.
	Class string
	Attrs templ.Attributes
}

// The answer fades and rises in through ::details-content. Browsers without it open the answer instantly.
const (
	accordionReveal = "details-content:-translate-y-1 details-content:opacity-0 details-content:[transition:opacity_.45s_cubic-bezier(.16,1,.3,1),translate_.45s_cubic-bezier(.16,1,.3,1),content-visibility_.45s_allow-discrete] " +
		"open:details-content:translate-y-0 open:details-content:opacity-100 motion-reduce:details-content:transition-none"
)

// Accordion is a list of questions built on native <details>. It works without JavaScript.
// The plus turns into a minus, and the answer fades in.
//
//	@ui.Accordion(ui.AccordionProps{Name: "faq", Items: []ui.AccordionItem{
//		{Title: "What does Astabyte build?", Content: templ.Raw("Sites, apps and design systems."), Open: true},
//		{Title: "How long does a project take?", Content: templ.Raw("Most take six to ten weeks.")},
//	}})
templ Accordion(p AccordionProps) {
	<div class={ cx("flex w-full flex-col gap-1.5", p.Class) } { p.Attrs... }>
		for _, it := range p.Items {
			@AccordionDetails(AccordionDetailsProps{Title: it.Title, Name: p.Name, Open: it.Open, Attrs: it.Attrs}) {
				if it.Content != nil {
					@it.Content
				}
			}
		}
		{ children... }
	</div>
}

// AccordionDetails is one item. Children are the answer. Use it inside Accordion or any column.
//
//	@ui.AccordionDetails(ui.AccordionDetailsProps{Title: "Can I pay monthly?", Name: "billing"}) { Yes. }
templ AccordionDetails(p AccordionDetailsProps) {
	<details
		name={ p.Name }
		open?={ p.Open }
		class={ cx("group/acc rounded-xl bg-paper-2 transition-[background-color,box-shadow] duration-300",
			"open:bg-paper open:shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_10%,transparent),0_8px_24px_-14px_rgb(0_0_0/0.25)]",
			accordionReveal, p.Class) }
		{ p.Attrs... }
	>
		<summary class="group flex w-full cursor-pointer list-none items-center justify-between gap-4 rounded-xl px-4 py-3.5 text-left text-[14.5px] font-medium tracking-[-0.01em] text-ink outline-none focus-visible:ring-2 focus-visible:ring-brand/50 [&::-webkit-details-marker]:hidden">
			{ p.Title }
			<span aria-hidden="true" class="relative flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-paper text-ink-2 transition-colors duration-300 group-hover:text-ink group-open/acc:bg-ink group-open/acc:text-paper">
				<span class="absolute h-[1.5px] w-2.5 rounded-full bg-current"></span>
				<span class="absolute h-2.5 w-[1.5px] rounded-full bg-current transition-transform duration-500 ease-[cubic-bezier(.16,1,.3,1)] group-open/acc:rotate-90 group-open/acc:scale-y-0 motion-reduce:transition-none"></span>
			</span>
		</summary>
		<div class="px-4 pb-4 text-[14px] leading-relaxed text-ink-2">
			{ children... }
		</div>
	</details>
}
