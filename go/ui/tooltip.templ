package ui

// TooltipProps configures Tooltip. Children are the trigger, a focusable element such as a button or a link.
type TooltipProps struct {
	// ID is the tooltip's id. Put aria-describedby with this id on the trigger.
	ID   string
	Text string
	// Side: "top" (default), "right", "bottom" or "left".
	Side string
	// Shortcut is shown at the end, e.g. "⌘S".
	Shortcut string
	// Instant shows it without the short hover delay.
	Instant bool
	// BubbleClass goes on the tooltip bubble.
	BubbleClass string
	// Class goes on the wrapper.
	Class string
	// Attrs go on the wrapper.
	Attrs templ.Attributes
}

// Each side sets where the bubble sits, where it grows from, the small offset it slides in from, and the arrow.
var tooltipSide = map[string]string{
	"top":    "bottom-full left-1/2 mb-2 origin-bottom -translate-x-1/2 translate-y-1",
	"bottom": "top-full left-1/2 mt-2 origin-top -translate-x-1/2 -translate-y-1",
	"left":   "right-full top-1/2 mr-2 origin-right -translate-y-1/2 translate-x-1",
	"right":  "left-full top-1/2 ml-2 origin-left -translate-y-1/2 -translate-x-1",
}

var tooltipShown = map[string]string{
	"top":    "group-hover/tip:translate-y-0 group-has-[:focus-visible]/tip:translate-y-0",
	"bottom": "group-hover/tip:translate-y-0 group-has-[:focus-visible]/tip:translate-y-0",
	"left":   "group-hover/tip:translate-x-0 group-has-[:focus-visible]/tip:translate-x-0",
	"right":  "group-hover/tip:translate-x-0 group-has-[:focus-visible]/tip:translate-x-0",
}

var tooltipArrow = map[string]string{
	"top":    "left-1/2 top-full -mt-1 -translate-x-1/2",
	"bottom": "left-1/2 bottom-full -mb-1 -translate-x-1/2",
	"left":   "left-full top-1/2 -ml-1 -translate-y-1/2",
	"right":  "right-full top-1/2 -mr-1 -translate-y-1/2",
}

func tooltipKey(side string) string {
	if _, ok := tooltipSide[side]; ok {
		return side
	}
	return "top"
}

// Tooltip shows a short label on hover or keyboard focus. It is CSS only, so it works in any swap.
// Hover waits a moment before it shows. Keyboard focus shows it at once.
//
//	@ui.Tooltip(ui.TooltipProps{ID: "tip-save", Text: "Save draft", Shortcut: "⌘S"}) {
//		@ui.Button(ui.ButtonProps{IconOnly: true, IconLeft: saveIcon(), Attrs: templ.Attributes{"aria-label": "Save", "aria-describedby": "tip-save"}})
//	}
templ Tooltip(p TooltipProps) {
	{{ side := tooltipKey(p.Side) }}
	<span class={ cx("group/tip relative inline-flex", p.Class) } { p.Attrs... }>
		{ children... }
		<span
			id={ p.ID }
			role="tooltip"
			class={ cx("pointer-events-none absolute z-50 flex w-max max-w-[240px] select-none items-center gap-2 rounded-lg bg-ink px-2.5 py-1.5 text-[12px] font-medium leading-snug text-paper",
				"shadow-[0_6px_20px_-6px_rgb(0_0_0/0.35)] scale-95 opacity-0",
				"transition-[opacity,scale,translate] duration-200 ease-[cubic-bezier(.16,1,.3,1)] motion-reduce:transition-none",
				"group-hover/tip:scale-100 group-hover/tip:opacity-100 group-has-[:focus-visible]/tip:scale-100 group-has-[:focus-visible]/tip:opacity-100 group-has-[:focus-visible]/tip:delay-0",
				when(!p.Instant, "group-hover/tip:delay-400"),
				tooltipSide[side], tooltipShown[side], p.BubbleClass) }
		>
			{ p.Text }
			if p.Shortcut != "" {
				<kbd class="rounded bg-paper/15 px-1 font-sans text-[11px] text-paper/80">{ p.Shortcut }</kbd>
			}
			<span aria-hidden="true" class={ cx("absolute h-2 w-2 rotate-45 rounded-[1px] bg-ink", tooltipArrow[side]) }></span>
		</span>
	</span>
}
