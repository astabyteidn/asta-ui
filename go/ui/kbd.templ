package ui

import "strings"

// KbdProps configures Kbd. Every field is optional.
type KbdProps struct {
	// Size: "sm", "md" (default) or "lg".
	Size string
	// Pressed forces the pressed look.
	Pressed bool
	Class   string
	Attrs   templ.Attributes
}

var kbdSize = map[string]string{
	"sm": "h-5 min-w-5 px-1 text-[11px] rounded-[5px]",
	"md": "h-7 min-w-7 px-1.5 text-[12.5px] rounded-[7px]",
	"lg": "h-10 min-w-10 px-2.5 text-[15px] rounded-[10px]",
}

const (
	kbdBase = "inline-flex select-none items-center justify-center bg-paper font-sans font-medium text-ink-2 " +
		"shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_14%,transparent),inset_0_-2px_0_color-mix(in_srgb,var(--ink)_12%,transparent)] " +
		"transition-[transform,box-shadow,background-color,color] duration-100 ease-out " +
		"data-[pressed]:translate-y-px data-[pressed]:bg-paper-2 data-[pressed]:text-brand data-[pressed]:shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--brand)_45%,transparent)]"
)

// Kbd is a key cap. A thicker bottom edge sinks when it is pressed.
// It does not listen to the real keyboard. That needs JavaScript.
//
//	@ui.Kbd(ui.KbdProps{}) { ⌘ }
templ Kbd(p KbdProps) {
	<kbd class={ cx(kbdBase, pick(kbdSize, p.Size, "md"), p.Class) } data-pressed?={ p.Pressed } { p.Attrs... }>
		{ children... }
	</kbd>
}

// KbdComboProps configures KbdCombo.
type KbdComboProps struct {
	// Keys are the caps in order, e.g. []string{"⌘", "K"}.
	Keys []string
	// Size: "sm", "md" (default) or "lg".
	Size string
	// Separator is shown between caps, e.g. "+" or "then". Empty shows none.
	Separator string
	Class     string
	Attrs     templ.Attributes
}

// KbdCombo is a shortcut made of several keys.
//
//	@ui.KbdCombo(ui.KbdComboProps{Keys: []string{"⌘", "K"}})
templ KbdCombo(p KbdComboProps) {
	<span class={ cx("inline-flex items-center gap-1", p.Class) } aria-label={ strings.Join(p.Keys, " + ") } { p.Attrs... }>
		for i, k := range p.Keys {
			<span class="inline-flex items-center gap-1">
				if i > 0 && p.Separator != "" {
					<span class="text-[12px] text-mute" aria-hidden="true">{ p.Separator }</span>
				}
				@Kbd(KbdProps{Size: p.Size}) {
					{ k }
				}
			</span>
		}
	</span>
}
