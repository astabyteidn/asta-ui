package ui

import "strconv"

// Crumb is one step of a Breadcrumb.
type Crumb struct {
	Label string
	// Href makes it a link. The last crumb is the current page and never links.
	Href string
	Icon templ.Component
	// Attrs go on the link, e.g. hx-get with hx-target.
	Attrs templ.Attributes
}

// BreadcrumbProps configures Breadcrumb.
type BreadcrumbProps struct {
	// Items run from the root to the current page.
	Items []Crumb
	// Max caps the visible crumbs. The middle ones fold into a menu behind an ellipsis. 0 never folds.
	Max int
	// Separator goes between crumbs. Default a slim chevron.
	Separator templ.Component
	// Label is the accessible name. Default "Breadcrumb".
	Label string
	Class string
	Attrs templ.Attributes
}

const crumbLink = "flex min-w-0 items-center gap-1.5 rounded-md text-mute outline-none transition-colors hover:text-ink focus-visible:text-ink focus-visible:ring-2 focus-visible:ring-brand/50"

const crumbRow = "flex w-full min-w-0 items-center gap-2 rounded-md px-2.5 py-1.5 text-left text-[13px] text-ink-2 outline-none transition-colors hover:bg-paper-2 hover:text-ink focus-visible:bg-paper-2 focus-visible:text-ink"

type crumbSlot struct {
	crumb  Crumb
	more   bool
	folded []Crumb
}

// crumbSlots keeps the root and the nearest parents, folding the rest into one "more" slot.
func crumbSlots(items []Crumb, limit int) []crumbSlot {
	out := make([]crumbSlot, 0, len(items))
	if limit > 0 && len(items) > max(limit, 2) {
		hidden := len(items) - max(limit, 2)
		out = append(out, crumbSlot{crumb: items[0]}, crumbSlot{more: true, folded: items[1 : 1+hidden]})
		for _, c := range items[1+hidden:] {
			out = append(out, crumbSlot{crumb: c})
		}
		return out
	}
	for _, c := range items {
		out = append(out, crumbSlot{crumb: c})
	}
	return out
}

func crumbLiClass(i, n int, more bool) string {
	switch {
	case more || i == 0:
		return "flex min-w-0 shrink-0 items-center gap-1.5"
	case i == n-1:
		return "flex min-w-8 shrink items-center gap-1.5"
	default:
		return "flex min-w-0 shrink-[2] items-center gap-1.5"
	}
}

// Breadcrumb is a trail back to the root. The last item is the current page. Long labels truncate.
// With Max set, the middle items fold into a menu, keeping the root and the nearest parents in view.
//
//	@ui.Breadcrumb(ui.BreadcrumbProps{Max: 4, Items: []ui.Crumb{
//		{Label: "Astabyte", Href: "/"}, {Label: "Projects", Href: "/projects"}, {Label: "Website", Href: "/projects/website"}, {Label: "Settings"},
//	}})
templ Breadcrumb(p BreadcrumbProps) {
	{{ slots := crumbSlots(p.Items, p.Max) }}
	<nav aria-label={ or(p.Label, "Breadcrumb") } class={ cx("relative min-w-0 text-[13.5px]", p.Class) } { p.Attrs... }>
		<ol class="flex min-w-0 items-center gap-1.5">
			for i, s := range slots {
				<li class={ crumbLiClass(i, len(slots), s.more) }>
					if s.more {
						@crumbMore(s.folded)
					} else if i == len(slots)-1 {
						<span aria-current="page" class="flex min-w-0 items-center gap-1.5 font-medium text-ink">
							@crumbBody(s.crumb, "")
						</span>
					} else if s.crumb.Href != "" {
						<a href={ templ.SafeURL(s.crumb.Href) } class={ crumbLink } { s.crumb.Attrs... }>
							@crumbBody(s.crumb, "")
						</a>
					} else if len(s.crumb.Attrs) > 0 {
						<button type="button" class={ crumbLink } { s.crumb.Attrs... }>
							@crumbBody(s.crumb, "")
						</button>
					} else {
						<span class="flex min-w-0 items-center gap-1.5 text-mute">
							@crumbBody(s.crumb, "")
						</span>
					}
					if i < len(slots)-1 {
						<span aria-hidden="true" class="flex shrink-0 text-[color-mix(in_srgb,var(--ink)_28%,transparent)]">
							if p.Separator != nil {
								@p.Separator
							} else {
								<svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
									<path d="m6 3.5 4.5 4.5L6 12.5"></path>
								</svg>
							}
						</span>
					}
				</li>
			}
		</ol>
	</nav>
}

templ crumbBody(c Crumb, iconClass string) {
	if c.Icon != nil {
		<span class={ cx("flex shrink-0", iconClass) }>
			@c.Icon
		</span>
	}
	<span class="truncate">{ c.Label }</span>
}

// crumbMore uses the Menu contract of asta.js, so it opens, closes and takes arrow keys like any Menu.
templ crumbMore(items []Crumb) {
	<div data-asta-menu class="group/menu relative flex">
		<button
			type="button"
			data-asta-menu-trigger
			aria-haspopup="menu"
			aria-expanded="false"
			aria-label={ "Show " + strconv.Itoa(len(items)) + " more" }
			class="flex h-6 w-7 items-center justify-center rounded-md text-mute outline-none transition-colors hover:bg-paper-2 hover:text-ink focus-visible:ring-2 focus-visible:ring-brand/50 group-data-[open]/menu:bg-paper-2 group-data-[open]/menu:text-ink"
		>
			<svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="currentColor" aria-hidden="true">
				<circle cx="3.5" cy="8" r="1.25"></circle>
				<circle cx="8" cy="8" r="1.25"></circle>
				<circle cx="12.5" cy="8" r="1.25"></circle>
			</svg>
		</button>
		<div role="menu" hidden aria-label="Hidden pages" class="absolute left-0 top-full z-50 mt-1.5 flex w-max min-w-40 max-w-64 flex-col rounded-[10px] bg-paper p-1 shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_10%,transparent),0_14px_32px_-14px_rgb(0_0_0/0.3)]">
			for _, c := range items {
				if c.Href != "" {
					<a role="menuitem" tabindex="-1" href={ templ.SafeURL(c.Href) } class={ crumbRow } { c.Attrs... }>
						@crumbBody(c, "text-mute")
					</a>
				} else {
					<button type="button" role="menuitem" tabindex="-1" class={ crumbRow } { c.Attrs... }>
						@crumbBody(c, "text-mute")
					</button>
				}
			}
		</div>
	</div>
}
