package ui

import "strconv"

// InlineEditProps configures InlineEdit.
type InlineEditProps struct {
	// Name is the field the text posts as.
	Name  string
	Value string
	// Label is the accessible name, e.g. "Project name". Required.
	Label string
	// Placeholder shows when the value is empty. Default "Empty".
	Placeholder string
	// Required stops empty text from being saved. The old text comes back.
	Required  bool
	MaxLength int
	// CancelOnBlur drops the edit when focus leaves the field. By default leaving saves.
	CancelOnBlur bool
	// Size: "sm", "md" (default) or "lg".
	Size     string
	Disabled bool
	Class    string
	// Attrs go on the <input>. A save fires "asta:save" on it, so hx-post with hx-trigger="asta:save" saves to the server.
	// While that request runs the field stays open; if it fails, editing stays open to try again.
	Attrs templ.Attributes
}

var inlineText = map[string]string{"sm": "text-[13px]", "md": "text-[14.5px]", "lg": "text-[20px] font-medium tracking-[-0.02em]"}

const inlineBox = "-mx-2 rounded-[7px] px-2 py-1"

// InlineEdit is text that turns into a field when you click it or press Enter. Enter saves, Esc puts the old text
// back, and a small tick fades in beside the text once it's saved.
//
//	@ui.InlineEdit(ui.InlineEditProps{Name: "name", Label: "Project name", Value: "Astabyte site", Attrs: templ.Attributes{"hx-post": "/projects/1/name", "hx-trigger": "asta:save"}})
templ InlineEdit(p InlineEditProps) {
	{{ ph := or(p.Placeholder, "Empty") }}
	<span
		data-asta-inline
		if p.Required {
			data-required
		}
		if p.CancelOnBlur {
			data-cancel-on-blur
		}
		class={ cx("group/ie relative inline-flex max-w-full items-center gap-1.5", pick(inlineText, p.Size, "md"), p.Class) }
	>
		<button
			type="button"
			data-asta-inline-view
			disabled?={ p.Disabled }
			aria-label={ p.Label + ": " + or(p.Value, ph) + ". Edit" }
			class={ cx("group/iev inline-flex min-w-0 max-w-full items-center gap-2 text-left outline-none transition-colors duration-200 hover:bg-paper-2 focus-visible:ring-2 focus-visible:ring-brand/50 disabled:pointer-events-none group-data-[editing]/ie:hidden",
				or(when(p.Value != "", "text-ink"), "text-mute"), inlineBox) }
		>
			<span class="truncate" data-asta-inline-text>{ or(p.Value, ph) }</span>
			<svg viewBox="0 0 16 16" class="h-[0.85em] w-[0.85em] shrink-0 -translate-x-0.5 text-mute opacity-0 transition-[opacity,translate] duration-200 ease-[cubic-bezier(.16,1,.3,1)] group-hover/iev:translate-x-0 group-hover/iev:opacity-100 group-focus-visible/iev:translate-x-0 group-focus-visible/iev:opacity-100 motion-reduce:transition-none" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M10.5 2.5l3 3L6 13H3v-3l7.5-7.5z"></path>
			</svg>
		</button>
		<span class="hidden min-w-[6ch] max-w-full group-data-[editing]/ie:inline-grid">
			<span aria-hidden="true" data-asta-inline-sizer class={ cx("invisible col-start-1 row-start-1 whitespace-pre", inlineBox) }>{ or(p.Value, ph) + " " }</span>
			<input
				name={ p.Name }
				value={ p.Value }
				data-asta-inline-input
				data-saved={ p.Value }
				aria-label={ p.Label }
				placeholder={ ph }
				if p.MaxLength > 0 {
					maxlength={ strconv.Itoa(p.MaxLength) }
				}
				disabled?={ p.Disabled }
				class={ cx("col-start-1 row-start-1 w-full min-w-0 bg-paper text-ink outline-none transition-[box-shadow,opacity] duration-200 placeholder:text-mute [&.htmx-request]:opacity-60",
					"shadow-[inset_0_0_0_1.5px_var(--brand),0_0_0_4px_color-mix(in_srgb,var(--brand)_14%,transparent)]", inlineBox) }
				{ p.Attrs... }
			/>
		</span>
		<svg viewBox="0 0 16 16" data-asta-inline-tick class="hidden h-[0.9em] w-[0.9em] shrink-0 text-brand" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="m3.5 8.5 3 3 6-7"></path>
		</svg>
		<span class="hidden shrink-0 text-[12px] text-mute group-data-[failed]/ie:group-data-[editing]/ie:inline">Couldn't save</span>
		<span role="status" class="sr-only" data-asta-inline-status></span>
	</span>
}
