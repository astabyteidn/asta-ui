package ui

// HeadProps configures Head.
type HeadProps struct {
	// NoHTMX leaves htmx out, e.g. when you load your own copy.
	NoHTMX bool
}

// Head links the embedded stylesheet, the Astabyte script and htmx. Put it inside <head>.
// Add class="dark" to <html> for the dark theme.
templ Head(p ...HeadProps) {
	<link rel="stylesheet" href={ AssetURL("asta.css") }/>
	if len(p) == 0 || !p[0].NoHTMX {
		<script src={ AssetURL("htmx.min.js") } defer></script>
	}
	<script src={ AssetURL("asta.js") } defer></script>
}
