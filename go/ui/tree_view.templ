package ui

import "strconv"

// TreeNode is one folder or file in a TreeView.
type TreeNode struct {
	// ID is required and unique in the tree. It is what selection reports.
	ID    string
	Label string
	// Icon replaces the default folder or file icon.
	Icon templ.Component
	// Meta is muted text on the right, e.g. a size or a count.
	Meta string
	// Children makes the node a folder.
	Children []TreeNode
	// Folder makes the node a folder even with no Children, e.g. an empty one.
	Folder bool
	// ChildrenURL loads the children with hx-get the first time the folder opens.
	// Respond with ui.TreeItems for the next level.
	ChildrenURL string
	// Expanded starts the folder open.
	Expanded bool
	Disabled bool
	// Attrs go on the row, e.g. hx-get and hx-target to open the file when it is chosen.
	Attrs templ.Attributes
}

// TreeViewProps configures TreeView.
type TreeViewProps struct {
	Nodes []TreeNode
	// Selected is the ID of the selected node.
	Selected string
	// Label is the tree's accessible name.
	Label string
	// Name adds a hidden input with this name that holds the selected ID, so the tree posts with a form.
	Name string
	// Class goes on the tree.
	Class string
	// Attrs go on the tree. It fires "asta:select" with detail {id} when a node is chosen.
	Attrs templ.Attributes
}

// TreeItemsProps configures TreeItems.
type TreeItemsProps struct {
	Nodes []TreeNode
	// Level is the depth of these nodes. The top is 1, so children of a top folder are 2.
	Level int
	// Selected is the ID of the selected node, if it is among them.
	Selected string
}

func (n TreeNode) folder() bool { return n.Folder || n.Children != nil || n.ChildrenURL != "" }

func treeTab(nodes []TreeNode, sel string) string {
	if sel != "" && treeVisible(nodes, sel) {
		return sel
	}
	if len(nodes) > 0 {
		return nodes[0].ID
	}
	return ""
}

// treeVisible reports whether the node is on screen: its ancestors are all open.
func treeVisible(nodes []TreeNode, id string) bool {
	for _, n := range nodes {
		if n.ID == id {
			return true
		}
		if n.Expanded && treeVisible(n.Children, id) {
			return true
		}
	}
	return false
}

func treePad(level int) templ.SafeCSS {
	return templ.SafeCSS("padding-left:" + strconv.Itoa(8+(level-1)*18) + "px")
}

const treeRow = "group/row flex h-8 select-none items-center gap-2 rounded-lg pr-2.5 text-[13px] transition-colors duration-150 " +
	"data-[selected]:bg-paper-2 data-[selected]:text-ink"

	// TreeView is nested folders and files as a WAI-ARIA tree. Click a row to select it, or a folder to open it too.
	// The chevron turns and the children fade in. Keys: Up and Down, Right to open or step in, Left to close or step out,
	// Home and End, * to open siblings, Enter and Space to select, and type-ahead on labels.
	// Folders with ChildrenURL load their children the first time they open.
	//
	//	@ui.TreeView(ui.TreeViewProps{Label: "Files", Selected: "readme", Nodes: []ui.TreeNode{
	//		{ID: "src", Label: "src", Expanded: true, Children: []ui.TreeNode{{ID: "main", Label: "main.go", Meta: "2 KB"}}},
	//		{ID: "docs", Label: "docs", ChildrenURL: "/tree?dir=docs"},
	//		{ID: "readme", Label: "README.md"},
	//	}})

templ TreeView(p TreeViewProps) {
	<ul role="tree" data-asta-tree data-tab={ treeTab(p.Nodes, p.Selected) } aria-label={ p.Label } class={ cx("flex flex-col gap-px", p.Class) } { p.Attrs... }>
		if p.Name != "" {
			<input type="hidden" name={ p.Name } value={ p.Selected } data-asta-tree-value/>
		}
		@treeItems(p.Nodes, 1, p.Selected, treeTab(p.Nodes, p.Selected))
	</ul>
}

// TreeItems renders one level of nodes. Return it from a ChildrenURL handler.
//
//	ui.TreeItems(ui.TreeItemsProps{Nodes: kids, Level: 2}).Render(r.Context(), w)
templ TreeItems(p TreeItemsProps) {
	@treeItems(p.Nodes, max(1, p.Level), p.Selected, "")
}

templ treeItems(nodes []TreeNode, level int, sel, tab string) {
	for i, n := range nodes {
		{{ folder := n.folder() }}
		{{ open := folder && n.Expanded }}
		<li
			role="treeitem"
			data-id={ n.ID }
			if tab == n.ID {
				tabindex="0"
			} else {
				tabindex="-1"
			}
			aria-level={ strconv.Itoa(level) }
			aria-setsize={ strconv.Itoa(len(nodes)) }
			aria-posinset={ strconv.Itoa(i + 1) }
			if folder {
				aria-expanded={ strconv.FormatBool(open) }
			}
			aria-selected={ strconv.FormatBool(sel == n.ID) }
			if n.Disabled {
				aria-disabled="true"
			}
			style={ templ.SafeCSS("--i:" + strconv.Itoa(min(i, 8))) }
			class="outline-none [&:focus-visible>div:first-child]:ring-2 [&:focus-visible>div:first-child]:ring-inset [&:focus-visible>div:first-child]:ring-brand/50"
		>
			<div
				data-asta-tree-row
				data-selected?={ sel == n.ID }
				data-open?={ open }
				style={ treePad(level) }
				class={ cx(treeRow, or(when(n.Disabled, "cursor-not-allowed text-mute opacity-50"), "cursor-pointer text-ink-2 hover:bg-[color-mix(in_srgb,var(--paper-2)_60%,transparent)] hover:text-ink")) }
				{ n.Attrs... }
			>
				<span data-asta-tree-chevron aria-hidden="true" class="grid h-4 w-4 shrink-0 place-items-center text-mute">
					if folder {
						<svg viewBox="0 0 16 16" class="h-3 w-3 transition-transform duration-300 ease-[cubic-bezier(.16,1,.3,1)] group-data-[open]/row:rotate-90 motion-reduce:transition-none" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
							<path d="m6 4 4 4-4 4"></path>
						</svg>
					}
				</span>
				<span class="inline-flex h-4 w-4 shrink-0 text-mute transition-colors group-hover/row:text-ink-2 group-data-[selected]/row:!text-brand [&_svg]:h-4 [&_svg]:w-4">
					if n.Icon != nil {
						@n.Icon
					} else if folder {
						<svg viewBox="0 0 16 16" class="group-data-[open]/row:hidden" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true">
							<path d="M2 4.5a1 1 0 0 1 1-1h3L7.5 5H13a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1v-7.5Z"></path>
						</svg>
						<svg viewBox="0 0 16 16" class="hidden group-data-[open]/row:block" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true">
							<path d="M2 12.5v-8a1 1 0 0 1 1-1h3l1.5 1.5H12a1 1 0 0 1 1 1V7M2 12.5 3.8 8a1 1 0 0 1 .9-.6h9.1a.6.6 0 0 1 .6.8l-1.6 4.3h-11Z"></path>
						</svg>
					} else {
						<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true">
							<path d="M4 2.5h5L12.5 6v7.5H4zM9 2.5V6h3.5"></path>
						</svg>
					}
				</span>
				<span class="flex-1 truncate">{ n.Label }</span>
				if n.Meta != "" {
					<span class="shrink-0 text-[11.5px] tabular-nums text-mute">{ n.Meta }</span>
				}
			</div>
			if folder {
				<ul
					role="group"
					hidden?={ !open }
					class="flex flex-col gap-px pt-px empty:hidden"
					if n.ChildrenURL != "" && len(n.Children) == 0 {
						hx-get={ n.ChildrenURL }
						hx-trigger="asta:expand once"
						hx-swap="innerHTML"
						data-asta-tree-lazy
					}
				>
					if n.ChildrenURL != "" && len(n.Children) == 0 {
						<li role="none" class="flex h-8 items-center gap-2 text-[12.5px] text-mute" style={ treePad(level + 1) }>
							@spinnerIcon("h-3.5 w-3.5")
							Loading…
						</li>
					} else {
						@treeItems(n.Children, level+1, sel, "")
					}
				</ul>
			}
		</li>
	}
}
