package ui

import (
	"slices"
	"strconv"
)

// ComboboxOption is one choice in a Combobox.
type ComboboxOption struct {
	Value string
	Label string
	// Hint is muted text on the right, e.g. a count.
	Hint     string
	Icon     templ.Component
	Disabled bool
}

// ComboboxProps configures Combobox.
type ComboboxProps struct {
	// ID prefixes the ids inside. Set it when a page has more than one combobox. Default "combobox".
	ID string
	// Name is the form field. It posts from hidden inputs: one, or one per pick with Multiple.
	Name    string
	Options []ComboboxOption
	// Value is the picked option in single mode.
	Value string
	// Values are the picked options with Multiple.
	Values []string
	// Multiple turns picks into chips inside the field.
	Multiple bool
	// Placeholder defaults to "Search…".
	Placeholder string
	// Label is the accessible name.
	Label string
	// EmptyText shows when nothing matches. Default "No results".
	EmptyText string
	Disabled  bool
	Class     string
	// Attrs go on the root. It fires "change" on every pick: hx-post with hx-trigger="change" and hx-include="this".
	Attrs templ.Attributes
}

func comboOn(p ComboboxProps, v string) bool {
	if p.Multiple {
		return slices.Contains(p.Values, v)
	}
	return p.Value != "" && p.Value == v
}

func comboLabel(p ComboboxProps) string {
	if p.Multiple {
		return ""
	}
	for _, o := range p.Options {
		if o.Value == p.Value {
			return o.Label
		}
	}
	return ""
}

func comboPicked(p ComboboxProps) []ComboboxOption {
	var out []ComboboxOption
	for _, v := range p.Values {
		for _, o := range p.Options {
			if o.Value == v {
				out = append(out, o)
			}
		}
	}
	return out
}

const (
	comboList = "absolute inset-x-0 top-full z-50 mt-1.5 max-h-64 origin-top overflow-y-auto rounded-xl bg-paper p-1 outline-none [scrollbar-width:thin] " +
		"shadow-[0_0_0_1px_color-mix(in_srgb,var(--ink)_10%,transparent),0_12px_32px_-8px_rgb(0_0_0/0.22),0_4px_8px_-4px_rgb(0_0_0/0.08)]"
)

// Combobox is a searchable select. Type to filter, arrows to move, Enter to pick, Escape to close. Matches are
// substring and case-insensitive, with the typed part in bold. With Multiple, picks become chips: click × or press
// Backspace on an empty field to remove the last one. The options are all rendered on the server and filtered in the browser.
//
//	@ui.Combobox(ui.ComboboxProps{ID: "lang", Name: "lang", Label: "Language", Options: []ui.ComboboxOption{{Value: "go", Label: "Go"}, {Value: "ts", Label: "TypeScript"}}})
templ Combobox(p ComboboxProps) {
	{{ id := or(p.ID, "combobox") }}
	<div
		data-asta-combo={ or(when(p.Multiple, "multiple"), "single") }
		data-name={ p.Name }
		class={ cx("group/combo relative w-full", p.Class) }
		{ p.Attrs... }
	>
		<div
			data-asta-combo-box
			class={ cx("flex min-h-10 w-full flex-wrap items-center gap-1 rounded-lg bg-paper py-1 pl-1.5 pr-1 transition-shadow duration-200",
				"shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_14%,transparent)] hover:shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_24%,transparent)]",
				"focus-within:!shadow-[inset_0_0_0_1px_var(--brand),0_0_0_3px_color-mix(in_srgb,var(--brand)_18%,transparent)]",
				when(p.Disabled, "cursor-not-allowed opacity-45")) }
		>
			if p.Multiple {
				for _, o := range comboPicked(p) {
					@comboChip(p.Name, o)
				}
			}
			<input
				id={ id }
				data-asta-combo-input
				value={ comboLabel(p) }
				disabled?={ p.Disabled }
				placeholder={ comboPlaceholder(p) }
				data-placeholder={ or(p.Placeholder, "Search…") }
				role="combobox"
				if p.Label != "" {
					aria-label={ p.Label }
				}
				aria-expanded="false"
				aria-controls={ id + "-list" }
				aria-autocomplete="list"
				autocomplete="off"
				spellcheck="false"
				class="h-8 min-w-[6rem] flex-1 bg-transparent px-1.5 text-[14px] text-ink outline-none placeholder:text-mute disabled:cursor-not-allowed"
			/>
			<button
				type="button"
				tabindex="-1"
				disabled?={ p.Disabled }
				aria-label="Open list"
				data-asta-combo-toggle
				class="ml-auto flex h-8 w-8 shrink-0 items-center justify-center rounded-md text-mute outline-none transition-colors hover:bg-paper-2 hover:text-ink"
			>
				<svg viewBox="0 0 16 16" class="h-4 w-4 transition-transform duration-300 ease-[cubic-bezier(.16,1,.3,1)] group-data-[open]/combo:rotate-180" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="m4 6 4 4 4-4"></path>
				</svg>
			</button>
		</div>
		if p.Name != "" && !p.Multiple {
			<input type="hidden" name={ p.Name } value={ when(comboLabel(p) != "", p.Value) } data-asta-combo-value/>
		}
		<ul
			id={ id + "-list" }
			role="listbox"
			hidden
			if p.Label != "" {
				aria-label={ p.Label }
			}
			aria-multiselectable?={ p.Multiple }
			class={ comboList }
		>
			for i, o := range p.Options {
				<li
					id={ id + "-o-" + strconv.Itoa(i) }
					role="option"
					data-value={ o.Value }
					data-label={ o.Label }
					aria-selected={ strconv.FormatBool(comboOn(p, o.Value)) }
					aria-disabled?={ o.Disabled }
					class="group/opt flex cursor-pointer select-none items-center gap-2.5 rounded-md px-2.5 py-2 text-[14px] text-ink-2 transition-colors duration-150 data-[active]:bg-paper-2 data-[active]:text-ink aria-disabled:cursor-not-allowed aria-disabled:opacity-40"
				>
					if o.Icon != nil {
						<span class="inline-flex shrink-0 [&_svg]:h-4 [&_svg]:w-4" data-asta-combo-icon>
							@o.Icon
						</span>
					}
					<span class="min-w-0 flex-1 truncate" data-asta-combo-text>{ o.Label }</span>
					if o.Hint != "" {
						<span class="text-[12px] tabular-nums text-mute">{ o.Hint }</span>
					}
					<svg viewBox="0 0 16 16" class="h-4 w-4 shrink-0 scale-75 text-brand opacity-0 transition-[opacity,transform] duration-200 ease-[cubic-bezier(.16,1,.3,1)] group-aria-selected/opt:scale-100 group-aria-selected/opt:opacity-100" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="m3.5 8.5 3 3 6-7"></path>
					</svg>
				</li>
			}
			<li role="presentation" hidden data-asta-combo-empty class="flex flex-col items-center gap-1 px-2.5 py-6 text-center">
				<span class="text-[13px] text-ink-2">{ or(p.EmptyText, "No results") }</span>
				<span class="text-[12px] text-mute" data-asta-combo-query></span>
			</li>
		</ul>
		if p.Multiple {
			<template data-asta-combo-tpl>
				@comboChip(p.Name, ComboboxOption{})
			</template>
		}
	</div>
}

func comboPlaceholder(p ComboboxProps) string {
	if p.Multiple && len(comboPicked(p)) > 0 {
		return ""
	}
	return or(p.Placeholder, "Search…")
}

// comboChip is one pick with Multiple. The template copy is cloned by forms.js.
templ comboChip(name string, o ComboboxOption) {
	<span data-asta-combo-chip={ o.Value } class="asta-combo-chip inline-flex h-7 items-center gap-1 rounded-md bg-paper-2 pl-2 pr-0.5 text-[13px] text-ink">
		if o.Icon != nil {
			<span class="inline-flex shrink-0 [&_svg]:h-3.5 [&_svg]:w-3.5">
				@o.Icon
			</span>
		}
		<span data-asta-combo-chip-text>{ o.Label }</span>
		<button
			type="button"
			tabindex="-1"
			aria-label={ "Remove " + o.Label }
			data-asta-combo-remove
			class="flex h-6 w-6 items-center justify-center rounded-[5px] text-mute outline-none transition-colors hover:bg-[color-mix(in_srgb,var(--ink)_8%,transparent)] hover:text-ink"
		>
			<svg viewBox="0 0 16 16" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="m4.5 4.5 7 7M11.5 4.5l-7 7"></path></svg>
		</button>
		if name != "" {
			<input type="hidden" name={ name } value={ o.Value }/>
		}
	</span>
}
