package ui

import "strconv"

// HoverCardProps configures HoverCard. Children are the card content.
type HoverCardProps struct {
	// ID is required. Put HoverCardTarget(ID) on the link it previews, and render the card right after it,
	// so Tab steps from the link into the card.
	ID string
	// Side: "bottom" (default) or "top". It flips when there is no room.
	Side string
	// Align: "center" (default), "start" or "end".
	Align string
	// Offset is the gap to the trigger in px. Default 8.
	Offset int
	// OpenDelay is how long a hover waits before the card opens, in ms. Default 500.
	OpenDelay int
	// CloseDelay is how long the card stays after the pointer leaves, in ms. Default 220.
	CloseDelay int
	// Label is the accessible name of the card.
	Label string
	// Class goes on the card (width, padding).
	Class string
	// Attrs are spread onto the root element (hx-*, data-*).
	Attrs templ.Attributes
}

// HoverCardTarget returns the attributes that make a link (or any focusable element) open the hover card with this id.
func HoverCardTarget(id string) templ.Attributes {
	return templ.Attributes{"data-asta-hovercard-for": id}
}

// HoverCard is a preview card for a link, like a profile peek. It opens after a short hover or on keyboard
// focus, and stays open while the pointer travels into it, so what's inside can be used. It lifts in, flips
// when there is no room, and closes on leave, blur or Escape. A tap on touch just follows the link.
//
//	<a href="/people/sam" { ui.HoverCardTarget("sam")... }>Sam Rivera</a>
//	@ui.HoverCard(ui.HoverCardProps{ID: "sam", Label: "Sam Rivera"}) { … }
templ HoverCard(p HoverCardProps) {
	<div
		id={ p.ID }
		popover="manual"
		role="dialog"
		aria-modal="false"
		data-asta-hovercard
		data-side={ or(p.Side, "bottom") }
		data-align={ or(p.Align, "center") }
		if p.Offset > 0 {
			data-offset={ strconv.Itoa(p.Offset) }
		}
		if p.OpenDelay > 0 {
			data-open-delay={ strconv.Itoa(p.OpenDelay) }
		}
		if p.CloseDelay > 0 {
			data-close-delay={ strconv.Itoa(p.CloseDelay) }
		}
		if p.Label != "" {
			aria-label={ p.Label }
		}
		class={ cx("asta-float asta-lift fixed inset-auto m-0 w-[300px] max-w-[calc(100vw-16px)] overflow-visible rounded-xl bg-paper p-4 text-ink outline-none",
			"shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_10%,transparent),0_18px_44px_-16px_rgb(0_0_0/0.32),0_4px_10px_-6px_rgb(0_0_0/0.12)]",
			"before:absolute before:inset-x-0 before:h-[var(--asta-gap,10px)] before:content-[''] data-[placed=bottom]:before:bottom-full data-[placed=top]:before:top-full", p.Class) }
		{ p.Attrs... }
	>
		{ children... }
	</div>
}
