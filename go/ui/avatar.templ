package ui

import (
	"strconv"
	"strings"
	"unicode"
)

// AvatarProps configures Avatar. Name is required.
type AvatarProps struct {
	// Name is the accessible name and the source of the initials and fill colour.
	Name string
	// Src is the image URL. Initials show underneath it while it loads or if it fails.
	Src string
	// Size: "xs", "sm", "md" (default), "lg" or "xl".
	Size string
	// Status: "", "online", "away", "busy" or "offline".
	Status string
	// Shape: "circle" (default) or "square" for teams and workspaces.
	Shape string
	Class string
	Attrs templ.Attributes
}

type avatarDim struct{ box, text, dot string }

var avatarSize = map[string]avatarDim{
	"xs": {"h-6 w-6", "text-[10px]", "h-1.5 w-1.5"},
	"sm": {"h-8 w-8", "text-[12px]", "h-2 w-2"},
	"md": {"h-10 w-10", "text-[14px]", "h-2.5 w-2.5"},
	"lg": {"h-12 w-12", "text-[16px]", "h-3 w-3"},
	"xl": {"h-16 w-16", "text-[20px]", "h-3.5 w-3.5"},
}

func avatarDims(size string) avatarDim {
	if d, ok := avatarSize[size]; ok {
		return d
	}
	return avatarSize["md"]
}

var avatarStatus = map[string]string{
	"online":  "background:#30a46c",
	"away":    "background:#f5a524",
	"busy":    "background:#e5484d",
	"offline": "background:var(--mute)",
}

// Fallback fills. The name picks one, so the same person always gets the same colour.
var avatarFills = []string{
	"bg-ink text-paper",
	"bg-brand text-white",
	"bg-paper-2 text-ink shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_14%,transparent)]",
	"bg-[color-mix(in_srgb,var(--brand)_14%,var(--paper))] text-brand",
	"bg-[color-mix(in_srgb,var(--ink)_70%,var(--paper))] text-paper",
}

// Initials returns up to two capital letters from a name, e.g. "Asta Byte" → "AB".
func Initials(name string) string {
	var b strings.Builder
	for i, w := range strings.Fields(name) {
		if i == 2 {
			break
		}
		r := []rune(w)
		b.WriteRune(unicode.ToUpper(r[0]))
	}
	return b.String()
}

// AvatarFill returns the fallback fill classes for a name. The same name always gets the same fill.
func AvatarFill(name string) string {
	n := 0
	for _, c := range name {
		n += int(c)
	}
	return avatarFills[n%len(avatarFills)]
}

func avatarLabel(p AvatarProps) string {
	if p.Status != "" {
		return p.Name + " (" + p.Status + ")"
	}
	return p.Name
}

// Avatar is a person or a workspace. Initials on a fill picked from the name sit under the image.
// If the image fails to load, the browser draws nothing for it, so the initials show through.
//
//	@ui.Avatar(ui.AvatarProps{Name: "Asta Byte", Src: "/img/asta.jpg", Status: "online"})
templ Avatar(p AvatarProps) {
	{{ d := avatarDims(p.Size) }}
	{{ round := or(when(p.Shape == "square", "rounded-[30%]"), "rounded-full") }}
	<span class={ cx("relative inline-flex shrink-0", d.box, p.Class) } role="img" aria-label={ avatarLabel(p) } { p.Attrs... }>
		<span class={ cx("relative flex h-full w-full select-none items-center justify-center overflow-hidden font-medium tracking-[-0.02em]", round, d.text, AvatarFill(p.Name)) }>
			{ Initials(p.Name) }
			if p.Src != "" {
				<img src={ p.Src } alt="" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover"/>
			}
		</span>
		if s, ok := avatarStatus[p.Status]; ok {
			<span aria-hidden="true" class={ cx("absolute rounded-full shadow-[0_0_0_2px_var(--paper)]", d.dot, or(when(p.Shape == "square", "-bottom-0.5 -right-0.5"), "bottom-0 right-0")) } style={ templ.SafeCSS(s) }></span>
		}
	</span>
}

// AvatarPerson is one face in an AvatarGroup.
type AvatarPerson struct {
	Name string
	// Src is the image URL. Initials show if it is empty or fails.
	Src string
}

// AvatarGroupProps configures AvatarGroup.
type AvatarGroupProps struct {
	People []AvatarPerson
	// Max is how many faces show before the rest fold into "+N". Default 4.
	Max int
	// Size: "sm", "md" (default) or "lg".
	Size string
	// Label names the group for screen readers. Default "N people".
	Label string
	// OverflowAttrs makes "+N" a button with these attributes, e.g. ui.Opens("members").
	OverflowAttrs templ.Attributes
	Class         string
	Attrs         templ.Attributes
}

type avatarGroupDim struct{ box, text, overlap string }

var avatarGroupSize = map[string]avatarGroupDim{
	"sm": {"h-7 w-7", "text-[11px]", "-ml-2"},
	"md": {"h-9 w-9", "text-[13px]", "-ml-2.5"},
	"lg": {"h-11 w-11", "text-[15px]", "-ml-3"},
}

func avatarGroupDims(size string) avatarGroupDim {
	if d, ok := avatarGroupSize[size]; ok {
		return d
	}
	return avatarGroupSize["md"]
}

// avatarGroupSplit returns the faces to show and the ones folded into "+N".
// Showing "+1" would hide a face that fits in the same space, so only two or more fold.
func avatarGroupSplit(p AvatarGroupProps) ([]AvatarPerson, []AvatarPerson) {
	max := p.Max
	if max <= 0 {
		max = 4
	}
	if len(p.People)-max <= 1 {
		return p.People, nil
	}
	return p.People[:max], p.People[max:]
}

func avatarGroupLabel(p AvatarGroupProps) string {
	if p.Label != "" {
		return p.Label
	}
	if len(p.People) == 1 {
		return "1 person"
	}
	return strconv.Itoa(len(p.People)) + " people"
}

func avatarRestText(rest []AvatarPerson) string {
	names := make([]string, 0, 3)
	for i, r := range rest {
		if i == 3 {
			break
		}
		names = append(names, r.Name)
	}
	s := strings.Join(names, ", ")
	if len(rest) > 3 {
		s += " and " + strconv.Itoa(len(rest)-3) + " more"
	}
	return s
}

func avatarGroupLi(i int, overlap string) string {
	return cx("relative transition-[translate] duration-500 ease-[cubic-bezier(.16,1,.3,1)] motion-reduce:transition-none",
		"group-hover/stack:translate-x-[calc(var(--i)*5px)] group-focus-within/stack:translate-x-[calc(var(--i)*5px)]",
		"hover:z-10 focus-within:z-10 [&:hover>*]:-translate-y-1 [&:focus-within>*]:-translate-y-1",
		when(i > 0, overlap))
}

func avatarGroupVar(i int) templ.SafeCSS {
	return templ.SafeCSS("--i:" + strconv.Itoa(i))
}

const (
	avatarFace = "group/face relative block rounded-full outline-none shadow-[0_0_0_2px_var(--paper)] focus-visible:shadow-[0_0_0_2px_var(--paper),0_0_0_4px_var(--brand)] " +
		"transition-[translate] duration-300 ease-[cubic-bezier(.16,1,.3,1)] motion-reduce:transition-none"
)

// AvatarGroup is a row of overlapping avatars. Hover the row and it spreads a little.
// Hover one face and it lifts and shows the name. People past Max fold into "+N".
// The names show on hover only. Screen readers get every name from the labels.
//
//	@ui.AvatarGroup(ui.AvatarGroupProps{People: team, Max: 3, OverflowAttrs: ui.Opens("members")})
templ AvatarGroup(p AvatarGroupProps) {
	{{ d := avatarGroupDims(p.Size) }}
	{{ shown, rest := avatarGroupSplit(p) }}
	if len(p.People) > 0 {
		<ul aria-label={ avatarGroupLabel(p) } class={ cx("group/stack flex items-center", p.Class) } { p.Attrs... }>
			for i, person := range shown {
				<li class={ avatarGroupLi(i, d.overlap) } style={ avatarGroupVar(i) }>
					<span role="img" aria-label={ person.Name } class={ cx(avatarFace, d.box) }>
						<span class={ cx("relative flex h-full w-full select-none items-center justify-center overflow-hidden rounded-full font-medium tracking-[-0.02em]", AvatarFill(person.Name), d.text) }>
							{ Initials(person.Name) }
							if person.Src != "" {
								<img src={ person.Src } alt="" loading="lazy" decoding="async" draggable="false" class="absolute inset-0 h-full w-full object-cover"/>
							}
						</span>
						@avatarTip(person.Name)
					</span>
				</li>
			}
			if len(rest) > 0 {
				{{ overflow := cx(avatarFace, "flex items-center justify-center bg-paper-2 font-medium tabular-nums text-ink-2", d.box, d.text) }}
				<li class={ avatarGroupLi(len(shown), d.overlap) } style={ avatarGroupVar(len(shown)) }>
					if p.OverflowAttrs != nil {
						<button type="button" aria-label={ strconv.Itoa(len(rest)) + " more: " + avatarRestText(rest) } class={ cx(overflow, "transition-[translate,color] hover:text-ink") } { p.OverflowAttrs... }>
							+{ strconv.Itoa(len(rest)) }
							@avatarTip(avatarRestText(rest))
						</button>
					} else {
						<span role="img" aria-label={ strconv.Itoa(len(rest)) + " more: " + avatarRestText(rest) } class={ overflow }>
							+{ strconv.Itoa(len(rest)) }
							@avatarTip(avatarRestText(rest))
						</span>
					}
				</li>
			}
		</ul>
	}
}

templ avatarTip(text string) {
	<span aria-hidden="true" class="pointer-events-none absolute bottom-full left-1/2 z-20 mb-2 max-w-[220px] -translate-x-1/2 translate-y-1 truncate whitespace-nowrap rounded-[6px] bg-ink px-2 py-1 text-[12px] font-medium leading-none text-paper opacity-0 transition-[opacity,translate] duration-200 ease-[cubic-bezier(.16,1,.3,1)] group-hover/face:translate-y-0 group-hover/face:opacity-100 group-focus-visible/face:translate-y-0 group-focus-visible/face:opacity-100 motion-reduce:transition-none">{ text }</span>
}
