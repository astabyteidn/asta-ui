package ui

import "strconv"

// PopoverProps configures Popover. Children are the panel content.
type PopoverProps struct {
	// ID is required. Put PopoverTarget(ID) on the button that opens it.
	ID string
	// Side: "bottom" (default), "top", "right" or "left". It flips when there is no room.
	Side string
	// Align: "center" (default), "start" or "end".
	Align string
	// Offset is the gap to the trigger in px. Default 8.
	Offset int
	// Arrow draws a small arrow that points at the trigger.
	Arrow bool
	// Label is the accessible name of the panel.
	Label string
	// Class goes on the panel (padding, width).
	Class string
	// Attrs are spread onto the root element (hx-*, data-*).
	Attrs templ.Attributes
}

// PopoverTarget returns the attributes that make a button open and close the popover with this id.
// Without JavaScript the browser still toggles it, centred on the page.
//
//	@ui.Button(ui.ButtonProps{Variant: "outline", Attrs: ui.PopoverTarget("share")}) { Share }
func PopoverTarget(id string) templ.Attributes {
	return templ.Attributes{"popovertarget": id, "aria-haspopup": "dialog"}
}

// Popover is a click-to-open panel anchored to its trigger, built on the native popover attribute: it sits in
// the top layer, closes on an outside click or Escape, and hands focus back to the trigger. Pick a side and an
// alignment; it flips when there is no room and slides to stay on screen. It grows out of the trigger.
//
//	@ui.Button(ui.ButtonProps{Variant: "outline", Attrs: ui.PopoverTarget("share")}) { Share }
//	@ui.Popover(ui.PopoverProps{ID: "share", Label: "Share", Arrow: true, Class: "w-[280px]"}) {
//		<p>Anyone with the link can view.</p>
//	}
templ Popover(p PopoverProps) {
	<div
		id={ p.ID }
		popover="auto"
		role="dialog"
		tabindex="-1"
		data-asta-popover
		data-side={ or(p.Side, "bottom") }
		data-align={ or(p.Align, "center") }
		if p.Offset > 0 {
			data-offset={ strconv.Itoa(p.Offset) }
		}
		if p.Label != "" {
			aria-label={ p.Label }
		}
		class={ cx("asta-float fixed inset-auto m-0 w-max max-w-[calc(100vw-16px)] overflow-visible rounded-xl bg-paper p-3 text-ink outline-none",
			"shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_10%,transparent),0_14px_36px_-14px_rgb(0_0_0/0.3),0_4px_10px_-6px_rgb(0_0_0/0.12)]", p.Class) }
		{ p.Attrs... }
	>
		if p.Arrow {
			<svg data-asta-arrow width="14" height="7" viewBox="0 0 14 7" aria-hidden="true" class="pointer-events-none absolute left-0 top-0 origin-center">
				<path d="M0 7 7 .8 14 7z" class="fill-paper"></path>
				<path d="M0 7 7 .8 14 7" fill="none" stroke-width="1" class="stroke-[color-mix(in_srgb,var(--ink)_12%,transparent)]"></path>
			</svg>
		}
		{ children... }
	</div>
}
