package ui

import (
	"fmt"
	"strconv"
)

// ImageCompareProps configures ImageCompare. Give it Before and After as image URLs or as components.
type ImageCompareProps struct {
	// Before is the image URL shown left of the handle. BeforeContent replaces it with any component.
	Before        string
	BeforeContent templ.Component
	// After is the image URL shown right of the handle. AfterContent replaces it with any component.
	After        string
	AfterContent templ.Component
	// BeforeLabel and AfterLabel are the corner tags. Default "Before" and "After".
	BeforeLabel string
	AfterLabel  string
	// BeforeAlt and AfterAlt are the alt texts of the images.
	BeforeAlt string
	AfterAlt  string
	// Value is the start position of the handle from the left, 0–100. 0 means 50.
	Value float64
	// Step is the arrow-key step in percent. Default 2. Page Up and Page Down move ten steps.
	Step float64
	// Label is the handle's accessible name. Default "Comparison position".
	Label string
	// Class goes on the frame: aspect ratio, radius, width. Default aspect 4/3.
	Class string
	// Attrs go on the frame. It fires "asta:change" with detail {value} when the handle moves.
	Attrs templ.Attributes
}

func cmpPos(p ImageCompareProps) float64 {
	if p.Value <= 0 {
		return 50
	}
	return min(100, p.Value)
}

func cmpStyle(pos float64) templ.SafeCSS {
	return templ.SafeCSS("--pos:" + strconv.FormatFloat(pos, 'f', 1, 64))
}

func cmpText(p ImageCompareProps, pos float64) string {
	return fmt.Sprintf("%d%% %s, %d%% %s", int(pos+0.5), or(p.BeforeLabel, "Before"), int(100-pos+0.5), or(p.AfterLabel, "After"))
}

const cmpTag = "pointer-events-none absolute top-3 rounded-md bg-paper/80 px-2 py-1 text-[11.5px] font-medium text-ink backdrop-blur transition-opacity duration-300"

// ImageCompare is a before/after slider. Drag anywhere on the frame, or focus the handle and use the arrows,
// Home and End. Nothing is clipped: the before layer sits in a window that slides with the handle while the
// picture inside slides the other way, so only transforms move. Vertical swipes still scroll the page.
//
//	@ui.ImageCompare(ui.ImageCompareProps{Before: "/img/raw.jpg", After: "/img/graded.jpg", BeforeAlt: "Raw", AfterAlt: "Graded"})
templ ImageCompare(p ImageCompareProps) {
	{{ pos := cmpPos(p) }}
	<div
		data-asta-compare
		data-step={ strconv.FormatFloat(or64(p.Step, 2), 'f', -1, 64) }
		data-before={ or(p.BeforeLabel, "Before") }
		data-after={ or(p.AfterLabel, "After") }
		data-hide-before?={ pos < 18 }
		data-hide-after?={ pos > 82 }
		style={ cmpStyle(pos) }
		class={ cx("asta-compare group/compare relative aspect-[4/3] w-full cursor-ew-resize touch-pan-y select-none overflow-hidden rounded-xl bg-paper-2", p.Class) }
		{ p.Attrs... }
	>
		<div class="absolute inset-0">
			@cmpFill(p.After, p.AfterContent, p.AfterAlt)
		</div>
		<div class="asta-compare-win absolute inset-0 overflow-hidden">
			<div class="asta-compare-pic absolute inset-0">
				@cmpFill(p.Before, p.BeforeContent, p.BeforeAlt)
			</div>
		</div>
		<span class={ cx(cmpTag, "left-3 group-data-[hide-before]/compare:opacity-0") }>{ or(p.BeforeLabel, "Before") }</span>
		<span class={ cx(cmpTag, "right-3 group-data-[hide-after]/compare:opacity-0") }>{ or(p.AfterLabel, "After") }</span>
		<div class="asta-compare-track pointer-events-none absolute inset-0">
			<div class="absolute inset-y-0 left-0 w-0.5 -translate-x-1/2 bg-paper shadow-[0_0_0_0.5px_rgb(0_0_0/0.12)]"></div>
			<div
				data-asta-compare-handle
				role="slider"
				tabindex="0"
				aria-label={ or(p.Label, "Comparison position") }
				aria-valuemin="0"
				aria-valuemax="100"
				aria-valuenow={ strconv.Itoa(int(pos + 0.5)) }
				aria-valuetext={ cmpText(p, pos) }
				aria-orientation="horizontal"
				class="pointer-events-auto absolute left-0 top-1/2 grid h-9 w-9 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-paper text-ink outline-none shadow-[0_6px_18px_-6px_rgb(0_0_0/0.4),0_0_0_1px_rgb(0_0_0/0.06)] focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2 focus-visible:ring-offset-paper"
			>
				<svg viewBox="0 0 20 20" class="h-4 w-4 transition-transform duration-300 ease-[cubic-bezier(.16,1,.3,1)] group-hover/compare:scale-110 group-data-[dragging]/compare:!scale-90" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M7.5 6 3.5 10l4 4M12.5 6l4 4-4 4"></path>
				</svg>
			</div>
		</div>
	</div>
}

templ cmpFill(src string, c templ.Component, alt string) {
	if c != nil {
		@c
	} else if src != "" {
		<img src={ src } alt={ alt } draggable="false" class="pointer-events-none h-full w-full select-none object-cover"/>
	}
}

func or64(a, b float64) float64 {
	if a > 0 {
		return a
	}
	return b
}
