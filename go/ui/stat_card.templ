package ui

import (
	"fmt"
	"math"
)

// StatCardProps configures StatCard. Label and Value are required.
type StatCardProps struct {
	Label string
	// Value is shown as is, so format it first, e.g. "$12,480" or "98.2%".
	Value string
	// Delta is the change in percent. Up reads blue, down stays neutral. Set ShowDelta to show it.
	Delta     float64
	ShowDelta bool
	// DeltaLabel says what the delta compares against, e.g. "vs last week".
	DeltaLabel string
	// Data is the sparkline, oldest first. It needs two points or more.
	Data  []float64
	Class string
	Attrs templ.Attributes
}

const statW, statH = 96.0, 32.0

type statSpark struct {
	line, area string
	x, y       string
}

// statPath draws a smooth line through the points, with quadratic curves through the midpoints.
func statPath(data []float64) statSpark {
	lo, hi := math.Inf(1), math.Inf(-1)
	for _, v := range data {
		lo, hi = math.Min(lo, v), math.Max(hi, v)
	}
	span := hi - lo
	if span == 0 {
		span = 1
	}
	n := float64(len(data) - 1)
	xs := make([]float64, len(data))
	ys := make([]float64, len(data))
	for i, v := range data {
		xs[i] = float64(i)/n*(statW-4) + 2
		ys[i] = statH - 3 - (v-lo)/span*(statH-6)
	}
	d := fmt.Sprintf("M%.1f %.1f", xs[0], ys[0])
	for i := 1; i < len(data)-1; i++ {
		d += fmt.Sprintf(" Q%.1f %.1f %.1f %.1f", xs[i], ys[i], (xs[i]+xs[i+1])/2, (ys[i]+ys[i+1])/2)
	}
	last := len(data) - 1
	d += fmt.Sprintf(" L%.1f %.1f", xs[last], ys[last])
	return statSpark{
		line: d,
		area: d + fmt.Sprintf(" L%.1f %.0f L%.1f %.0f Z", xs[last], statH, xs[0], statH),
		x:    fmt.Sprintf("%.1f", xs[last]),
		y:    fmt.Sprintf("%.1f", ys[last]),
	}
}

func statUp(p StatCardProps) bool {
	if p.ShowDelta {
		return p.Delta > 0
	}
	return len(p.Data) > 1 && p.Data[len(p.Data)-1] > p.Data[0]
}

func statDelta(d float64) string {
	sign := ""
	if d > 0 {
		sign = "+"
	} else if d < 0 {
		sign = "−"
	}
	return fmt.Sprintf("%s%.1f%%", sign, math.Abs(d))
}

func statDeltaWord(d float64) string {
	switch {
	case d > 0:
		return "Up"
	case d < 0:
		return "Down"
	}
	return "No change"
}

// StatCard is a KPI tile: a label, a value, a delta and a tiny sparkline. Up reads blue, down stays neutral.
// The sparkline fades in and its end dot pops. The React count-up and line draw need JavaScript, so they are left out.
//
//	@ui.StatCard(ui.StatCardProps{Label: "Revenue", Value: "$12,480", Delta: 8.2, ShowDelta: true, DeltaLabel: "vs last week", Data: []float64{4, 6, 5, 8, 9}})
templ StatCard(p StatCardProps) {
	{{ up := statUp(p) }}
	<div class={ cx("flex flex-col gap-3 rounded-xl bg-paper-2 p-5 motion-reduce:[&_*]:!animate-none", p.Class) } { p.Attrs... }>
		<p class="text-[13px] text-mute">{ p.Label }</p>
		<div class="flex items-end justify-between gap-4">
			<p class="text-[28px] font-medium leading-none tracking-[-0.04em] text-ink tabular-nums">{ p.Value }</p>
			if len(p.Data) > 1 {
				{{ s := statPath(p.Data) }}
				<svg viewBox="0 0 96 32" width="96" height="32" class={ cx("shrink-0 overflow-visible", or(when(up, "text-brand"), "text-mute")) } aria-hidden="true">
					<g class="animate-[asta-fade_.9s_cubic-bezier(.16,1,.3,1)_both]">
						<path d={ s.area } fill="currentColor" opacity="0.1"></path>
						<path d={ s.line } fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
					</g>
					<circle cx={ s.x } cy={ s.y } r="2.25" fill="currentColor" class="origin-center animate-[asta-pop_.5s_cubic-bezier(.16,1,.3,1)_.5s_both] [transform-box:fill-box]"></circle>
				</svg>
			}
		</div>
		if p.ShowDelta {
			<p class="flex items-center gap-1.5 text-[12.5px]">
				<span class={ cx("inline-flex items-center gap-0.5 font-medium tabular-nums", or(when(up, "text-brand"), "text-mute")) }>
					<svg viewBox="0 0 12 12" class={ cx("h-3 w-3", when(p.Delta < 0, "rotate-180"), when(p.Delta == 0, "hidden")) } fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M6 9.5v-7M2.75 5.5 6 2.25 9.25 5.5"></path>
					</svg>
					<span class="sr-only">{ statDeltaWord(p.Delta) }</span>
					{ statDelta(p.Delta) }
				</span>
				if p.DeltaLabel != "" {
					<span class="text-mute">{ p.DeltaLabel }</span>
				}
			</p>
		}
	</div>
}
