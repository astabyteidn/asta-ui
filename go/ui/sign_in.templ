package ui

// SignInProvider is one social sign-in button.
type SignInProvider struct {
	// Name picks the built-in glyph: "google" or "github". Other names show no glyph unless Icon is set.
	Name string
	// Label is the button text, e.g. "Google". Empty uses "Google" or "GitHub" for the built-in names.
	Label string
	// Href is where the button goes, e.g. "/auth/google".
	Href string
	// Icon replaces the built-in glyph.
	Icon templ.Component
}

// SignInProps configures SignIn. Action is required.
type SignInProps struct {
	// ID goes on the card. The form swaps the whole card with the server's answer. Default "sign-in".
	ID string
	// Title is the heading. Default "Welcome back".
	Title string
	// Subtitle sits under the title. Default "Sign in to continue to your workspace."
	Subtitle string
	// Action is the URL the form posts to, with htmx (hx-post) and without (action).
	// Answer with SignIn again: with Errors to show them, or with Done to show the signed-in state.
	Action string
	// Email keeps what the person typed when the server answers with errors.
	Email string
	// Errors from the server, keyed "email", "password" and "form" (a message over the button).
	Errors map[string]string
	// Providers are the social buttons over the form. None by default.
	Providers []SignInProvider
	// ForgotHref shows a "Forgot password?" link.
	ForgotHref string
	// SignUpHref shows "New here? Create an account" under the button.
	SignUpHref string
	// Remember shows a "Remember me" box, posted as remember=on. RememberChecked ticks it.
	Remember        bool
	RememberChecked bool
	// Done shows the signed-in state instead of the form.
	Done bool
	// SignOutHref shows a "Sign out" button in the signed-in state.
	SignOutHref string
	Class       string
	// Attrs go on the card.
	Attrs templ.Attributes
}

const (
	signInCard = "relative w-full max-w-[380px] overflow-hidden rounded-xl bg-paper p-6 text-ink sm:p-7 " +
		"shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_10%,transparent),0_1px_2px_rgb(0_0_0/0.04),0_18px_40px_-20px_rgb(0_0_0/0.25)]"
)

func signInID(p SignInProps) string { return or(p.ID, "sign-in") }

func signInState(err string) string { return when(err != "", "error") }

// signInShake replays a short shake each time the server answers with an error for the field.
func signInShake(err string) string {
	return when(err != "", "animate-[asta-blk-shake_.42s_cubic-bezier(.16,1,.3,1)] motion-reduce:animate-none")
}

// SignIn is an email and password card with optional social buttons. It is a real form, so it works without
// JavaScript too. With htmx the server's answer replaces the card: errors shake their field once, and Done
// morphs into the signed-in state.
//
//	@ui.SignIn(ui.SignInProps{Action: "/sign-in", Email: email, Errors: errs, Remember: true, ForgotHref: "/forgot"})
templ SignIn(p SignInProps) {
	{{ id := signInID(p) }}
	<div id={ id } data-asta-sign-in class={ cx(signInCard, p.Class) } { p.Attrs... }>
		if p.Done {
			<div class="flex min-h-[380px] flex-col items-center justify-center text-center animate-[asta-blk-pop_.5s_cubic-bezier(.16,1,.3,1)_both] motion-reduce:animate-none" role="status">
				<span class="flex h-14 w-14 items-center justify-center rounded-full bg-[#30a46c] text-white">
					<svg viewBox="0 0 24 24" class="h-7 w-7 animate-[asta-blk-pop_.5s_.15s_cubic-bezier(.16,1,.3,1)_both] motion-reduce:animate-none" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M5 12.5l4.5 4.5L19 7.5"></path>
					</svg>
				</span>
				<h3 class="mt-5 text-[20px] font-medium tracking-[-0.02em] text-ink">You're in</h3>
				if p.Email != "" {
					<p class="mt-1.5 max-w-[26ch] text-[14px] leading-snug text-mute">
						Signed in as <span class="text-ink">{ p.Email }</span>.
					</p>
				}
				if p.SignOutHref != "" {
					@Button(ButtonProps{Variant: "soft", Size: "sm", Href: p.SignOutHref, Class: "mt-6"}) {
						Sign out
					}
				}
			</div>
		} else {
			<form
				action={ templ.SafeURL(p.Action) }
				method="post"
				novalidate
				hx-post={ p.Action }
				hx-target={ "#" + id }
				hx-swap="outerHTML"
				hx-indicator="find button[type=submit]"
				class="flex flex-col"
			>
				<h3 class="text-[20px] font-medium tracking-[-0.02em] text-ink">{ or(p.Title, "Welcome back") }</h3>
				<p class="mt-1 text-[14px] leading-snug text-mute">{ or(p.Subtitle, "Sign in to continue to your workspace.") }</p>
				if len(p.Providers) > 0 {
					<div class={ cx("mt-6 grid gap-2", when(len(p.Providers) > 1, "grid-cols-2")) }>
						for _, pr := range p.Providers {
							@Button(ButtonProps{Variant: "outline", Href: pr.Href, IconLeft: signInGlyph(pr)}) {
								{ signInLabel(pr) }
							}
						}
					</div>
					<div class="my-5 flex items-center gap-3 text-[12px] text-mute" aria-hidden="true">
						<span class="h-px flex-1 bg-[color-mix(in_srgb,var(--ink)_10%,transparent)]"></span>
						or
						<span class="h-px flex-1 bg-[color-mix(in_srgb,var(--ink)_10%,transparent)]"></span>
					</div>
				} else {
					<div class="h-6"></div>
				}
				<div class="flex flex-col gap-3">
					@Field(FieldProps{Label: "Email", For: id + "-email", Error: p.Errors["email"]}) {
						<div class={ signInShake(p.Errors["email"]) }>
							@Input(InputProps{ID: id + "-email", Name: "email", Type: "email", Value: p.Email, Placeholder: "you@company.com", State: signInState(p.Errors["email"]), Attrs: templ.Attributes{"autocomplete": "email"}})
						</div>
					}
					@Field(FieldProps{Label: "Password", For: id + "-password", Error: p.Errors["password"]}) {
						<div class={ signInShake(p.Errors["password"]) }>
							@Input(InputProps{ID: id + "-password", Name: "password", Type: "password", Placeholder: "At least 8 characters", State: signInState(p.Errors["password"]), Trailing: signInReveal(), Class: "pr-1", Attrs: templ.Attributes{"autocomplete": "current-password"}})
						</div>
					}
				</div>
				if p.Remember || p.ForgotHref != "" {
					<div class="mt-3 flex items-center justify-between gap-3 text-[13px]">
						if p.Remember {
							@Checkbox(CheckboxProps{ID: id + "-remember", Name: "remember", Label: "Remember me", Checked: p.RememberChecked, Class: "[&_span.block]:text-[13px] [&_span.block]:text-ink-2"})
						} else {
							<span></span>
						}
						if p.ForgotHref != "" {
							<a href={ templ.SafeURL(p.ForgotHref) } class="text-brand outline-none hover:underline focus-visible:underline">Forgot password?</a>
						}
					</div>
				}
				if p.Errors["form"] != "" {
					<p role="alert" class="mt-4 rounded-lg bg-[#e5484d]/10 px-3 py-2 text-[13px] text-[#e5484d] animate-[asta-field-in_.3s_cubic-bezier(.16,1,.3,1)_both]">{ p.Errors["form"] }</p>
				}
				@Button(ButtonProps{Type: "submit", Class: "mt-5 w-full"}) {
					Sign in
				}
				if p.SignUpHref != "" {
					<p class="mt-4 text-center text-[13px] text-mute">
						New here?
						<a href={ templ.SafeURL(p.SignUpHref) } class="font-medium text-ink outline-none hover:underline focus-visible:underline">Create an account</a>
					</p>
				}
			</form>
		}
	</div>
}

// signInReveal shows and hides the password. blocks.js swaps the input type.
templ signInReveal() {
	<button
		type="button"
		data-asta-reveal
		aria-label="Show password"
		aria-pressed="false"
		class="group/rev flex h-8 w-8 items-center justify-center rounded-lg text-mute outline-none transition-colors hover:bg-paper-2 hover:text-ink focus-visible:ring-2 focus-visible:ring-brand/50"
	>
		<svg viewBox="0 0 16 16" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
			<path d="M1.5 8S4 3.5 8 3.5 14.5 8 14.5 8 12 12.5 8 12.5 1.5 8 1.5 8Z"></path>
			<circle cx="8" cy="8" r="2"></circle>
			<path d="M2.5 13.5l11-11" class="origin-center transition-[opacity,transform] duration-300 ease-[cubic-bezier(.16,1,.3,1)] group-aria-pressed/rev:scale-0 group-aria-pressed/rev:opacity-0"></path>
		</svg>
	</button>
}

// signInLabel keeps every provider button named, so a missing Label never leaves an icon-only button.
func signInLabel(pr SignInProvider) string {
	if pr.Label != "" {
		return pr.Label
	}
	switch pr.Name {
	case "google":
		return "Google"
	case "github":
		return "GitHub"
	}
	return pr.Name
}

func signInGlyph(pr SignInProvider) templ.Component {
	if pr.Icon != nil {
		return pr.Icon
	}
	switch pr.Name {
	case "google":
		return signInGoogle()
	case "github":
		return signInGitHub()
	}
	return nil
}

templ signInGoogle() {
	<svg viewBox="0 0 16 16" aria-hidden="true">
		<path fill="currentColor" d="M8 6.6v2.9h4.1A4.3 4.3 0 0 1 8 12.4a4.4 4.4 0 0 1 0-8.8c1.1 0 2.1.4 2.9 1.1l2-2A7.3 7.3 0 0 0 8 .7a7.3 7.3 0 1 0 0 14.6c4.2 0 7-3 7-7.1 0-.5 0-1-.1-1.5H8Z"></path>
	</svg>
}

templ signInGitHub() {
	<svg viewBox="0 0 16 16" aria-hidden="true">
		<path fill="currentColor" d="M8 .5a7.5 7.5 0 0 0-2.4 14.6c.4.1.5-.2.5-.4v-1.4c-2.1.5-2.5-.9-2.5-.9-.4-.9-.9-1.1-.9-1.1-.7-.5 0-.5 0-.5.8.1 1.2.8 1.2.8.7 1.2 1.8.8 2.2.6.1-.5.3-.8.5-1-1.7-.2-3.4-.8-3.4-3.7 0-.8.3-1.5.8-2-.1-.2-.3-1 .1-2 0 0 .6-.2 2.1.8a7 7 0 0 1 3.8 0c1.4-1 2.1-.8 2.1-.8.4 1 .2 1.8.1 2 .5.5.8 1.2.8 2 0 2.9-1.8 3.5-3.4 3.7.3.2.5.7.5 1.4v2.1c0 .2.1.5.5.4A7.5 7.5 0 0 0 8 .5Z"></path>
	</svg>
}
