package ui

import "encoding/json"

// DialogProps configures Dialog.
type DialogProps struct {
	// ID is required. Buttons open it with Opens(ID).
	ID          string
	Title       string
	Description string
	// Open shows it as soon as the page (or the htmx swap) loads.
	Open bool
	// NoClose hides the × button. Escape and a click outside still close it.
	NoClose bool
	// Class goes on the panel, e.g. "max-w-[520px]".
	Class string
	Attrs templ.Attributes
}

// Opens returns attributes that make any element open the dialog with this id on click.
//
//	@ui.Button(ui.ButtonProps{Attrs: ui.Opens("invite")}) { Invite }
func Opens(id string) templ.Attributes { return templ.Attributes{"data-asta-open": id} }

// Closes returns attributes that make an element inside a dialog close it on click.
func Closes() templ.Attributes { return templ.Attributes{"data-asta-close": true} }

// Dialog is a modal built on the native <dialog>: focus is trapped, Escape closes it, and it animates in and out.
// Put a form with hx-post inside it, and call ui.CloseDialog(w, id) from the handler when it saves.
templ Dialog(p DialogProps) {
	<dialog
		id={ p.ID }
		class={ cx("asta-dialog m-auto w-[calc(100%-2rem)] max-w-[400px] rounded-2xl bg-paper p-6 text-ink outline-none", "shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--ink)_8%,transparent),0_24px_60px_-20px_rgb(0_0_0/0.45)]", p.Class) }
		if p.Title != "" {
			aria-labelledby={ p.ID + "-title" }
		}
		if p.Description != "" {
			aria-describedby={ p.ID + "-desc" }
		}
		data-asta-autoopen?={ p.Open }
		{ p.Attrs... }
	>
		if !p.NoClose {
			<button type="button" data-asta-close aria-label="Close" class="absolute right-3.5 top-3.5 flex h-8 w-8 items-center justify-center rounded-full text-mute outline-none transition-colors hover:bg-paper-2 hover:text-ink focus-visible:ring-2 focus-visible:ring-brand/50">
				<svg viewBox="0 0 14 14" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
					<path d="M3 3l8 8M11 3 3 11"></path>
				</svg>
			</button>
		}
		if p.Title != "" {
			<h2 id={ p.ID + "-title" } class="pr-8 text-[18px] font-medium tracking-[-0.02em] text-ink">{ p.Title }</h2>
		}
		if p.Description != "" {
			<p id={ p.ID + "-desc" } class="mt-1.5 text-[14px] leading-relaxed text-mute">{ p.Description }</p>
		}
		<div class="mt-5">
			{ children... }
		</div>
	</dialog>
}

// DialogFooter lines up a dialog's buttons: stacked on phones, right-aligned from sm.
templ DialogFooter() {
	<div class="mt-6 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
		{ children... }
	</div>
}

// Flash shows toasts when the page loads, e.g. after a redirect. Render it anywhere in <body>.
// For htmx requests use ui.Toast(w, …) instead.
templ Flash(msgs ...ToastMsg) {
	if len(msgs) > 0 {
		<template data-asta-toast={ toastJSON(msgs) }></template>
	}
}

func toastJSON(msgs []ToastMsg) string {
	b, _ := json.Marshal(msgs)
	return string(b)
}
